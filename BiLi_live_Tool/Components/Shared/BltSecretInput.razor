@* 脱敏输入框：默认以 ● 显示（用 -webkit-text-security，避免浏览器密码管理器弹窗），
   右侧小眼睛切换明文；支持单行 input 与多行 textarea（多行时眼睛在右上角）。 *@
<div class="blt-secret-wrap @(Multiline ? "multiline" : "")">
    @if (Multiline)
    {
        <textarea class="blt-input mono blt-secret @(_show ? "reveal" : "")" rows="4"
                  style="min-height:76px" disabled="@Disabled" placeholder="@Placeholder"
                  value="@Value" @oninput="OnInput" data-tip="@Tip"></textarea>
    }
    else
    {
        <input class="blt-input mono blt-secret @(_show ? "reveal" : "")" type="text"
               disabled="@Disabled" placeholder="@Placeholder"
               value="@Value" @oninput="OnInput" data-tip="@Tip" />
    }
    <button type="button" class="blt-secret-eye" title="@(_show ? "隐藏（显示为 ●）" : "显示明文")"
            @onclick="Toggle" @onclick:preventDefault="true">
        <BltIcon Name="@(_show ? "eye-off" : "eye")" />
    </button>
</div>

@code {
    [Parameter] public string Value { get; set; } = "";
    [Parameter] public EventCallback<string> ValueChanged { get; set; }
    [Parameter] public string Placeholder { get; set; } = "";
    [Parameter] public string Tip { get; set; } = "";
    [Parameter] public bool Multiline { get; set; }
    [Parameter] public bool Disabled { get; set; }

    private bool _show;

    private async Task OnInput(ChangeEventArgs e)
    {
        Value = e.Value?.ToString() ?? "";
        await ValueChanged.InvokeAsync(Value);
    }

    private void Toggle() => _show = !_show;
}
