@page "/danmu"
@using System.Text.Json
@using System.Text.Json.Nodes
@using BiLi_live_Tool.Services
@inject KestrelHost Api
@inject AppConfig Config
@inject IJSRuntime JS
@inject EventHub Hub

<div class="blt-pagehead"><h1>弹幕显示浮层</h1><span class="en">DANMU OVERLAY · 现代化重构版</span></div>

<div class="blt-obs-hero" style="margin-bottom:14px;padding:12px 16px;background:linear-gradient(135deg, rgba(59,130,246,0.12) 0%, rgba(99,102,241,0.08) 100%);border:1.5px solid rgba(59,130,246,0.45);border-radius:var(--r);box-shadow:0 4px 18px rgba(59,130,246,0.08);display:flex;align-items:center;justify-content:space-between;gap:16px;flex-wrap:wrap">
    <div style="display:flex;align-items:center;gap:12px;flex:1;min-width:320px">
        <div style="width:40px;height:40px;border-radius:10px;background:#3b82f6;color:#ffffff;display:flex;align-items:center;justify-content:center;font-size:20px;flex-shrink:0;box-shadow:0 3px 10px rgba(59,130,246,0.35)">
            📡
        </div>
        <div style="flex:1;min-width:0">
            <div style="display:flex;align-items:center;gap:8px;margin-bottom:4px;flex-wrap:wrap">
                <span style="font-weight:700;font-size:14px;color:var(--ink-1)">OBS 专用浏览器源链接</span>
                <span style="font-size:11px;padding:1px 8px;border-radius:10px;background:@(_cfg.Enabled ? "rgba(46,204,113,0.18)" : "rgba(156,163,175,0.2)");color:@(_cfg.Enabled ? "#2ecc71" : "var(--ink-3)");font-weight:700">
                    @(_cfg.Enabled ? "● 服务运行中" : "○ 未启用")
                </span>
                <span style="font-size:11px;color:var(--ink-3)">当前模版: <b style="color:var(--accent,#3b82f6)">@GetCurrentThemeDisplayName()</b></span>
            </div>
            <div style="display:flex;align-items:center;gap:8px;background:var(--bg-1);border:1px solid var(--line);border-radius:6px;padding:5px 12px">
                <span class="mono" style="font-size:12px;color:var(--accent,#3b82f6);font-weight:700;word-break:break-all;user-select:all;letter-spacing:0.3px">
                    @OverlayUrl()
                </span>
            </div>
        </div>
    </div>
    <div style="display:flex;align-items:center;gap:8px;flex-shrink:0;flex-wrap:wrap">
        <button class="blt-btn blue" style="padding:6px 16px;font-weight:700;font-size:13px;display:flex;align-items:center;gap:6px;box-shadow:0 2px 10px rgba(59,130,246,0.25)" @onclick="CopyOverlayUrl">
            <BltIcon Name="copy" /> 复制 OBS 链接
        </button>
        <a class="blt-btn" style="padding:6px 12px;font-size:12px;text-decoration:none;display:flex;align-items:center;gap:6px" href="@OverlayUrl()" target="_blank" rel="noopener">
            <BltIcon Name="external" /> 浏览器预览
        </a>
        <button class="blt-btn subtle" style="padding:6px 12px;font-size:12px" @onclick="ResetCurrentThemeDefaults">恢复默认</button>
        <button class="blt-btn blue" style="padding:6px 14px;font-weight:700;font-size:12px" @onclick="SaveConfig">保存配置</button>
    </div>
</div>

@if (!string.IsNullOrEmpty(_note))
{
    <div style="margin-bottom:10px;padding:6px 12px;border-radius:var(--r);font-size:12px;background:@(_noteOk ? "rgba(46,204,113,0.15)" : "rgba(231,76,60,0.15)");border:1px solid @(_noteOk ? "rgba(46,204,113,0.4)" : "rgba(231,76,60,0.4)");color:@(_noteOk ? "#2ecc71" : "#e74c3c")">
        @_note
    </div>
}

@* 快捷测试工具条 *@
<div style="margin-bottom:12px;padding:8px 12px;background:var(--bg-card);border:1px solid var(--line);border-radius:var(--r);display:flex;align-items:center;gap:6px;flex-wrap:wrap">
    <span style="font-size:12px;font-weight:600;color:var(--ink-2);margin-right:4px"><BltIcon Emoji="🧪" /> 仿真测试：</span>
    <button class="blt-btn" style="padding:2px 9px;font-size:11px" @onclick="SendTestDanmu">普通弹幕</button>
    <button class="blt-btn" style="padding:2px 9px;font-size:11px" @onclick="SendTestEmoteDanmu">表情弹幕</button>
    <button class="blt-btn amber" style="padding:2px 9px;font-size:11px" @onclick="SendTestGuardDanmu">舰长弹幕</button>
    <button class="blt-btn" style="padding:2px 9px;font-size:11px;background:rgba(255,77,109,0.2);color:#ff4d6d;border:1px solid rgba(255,77,109,0.4)" @onclick="SendTestGovernorDanmu">总督弹幕</button>
    <button class="blt-btn" style="padding:2px 9px;font-size:11px;background:rgba(255,193,7,0.2);color:#ffb300;border:1px solid rgba(255,193,7,0.4)" @onclick="SendTestGift">🎁 测试送礼</button>
    <button class="blt-btn" style="padding:2px 9px;font-size:11px;background:rgba(233,30,99,0.2);color:#e91e63;border:1px solid rgba(233,30,99,0.4)" @onclick="SendTestSuperChat">💬 醒目留言(SC)</button>
    <button class="blt-btn" style="padding:2px 9px;font-size:11px;background:rgba(156,39,176,0.2);color:#ab47bc;border:1px solid rgba(156,39,176,0.4)" @onclick="SendTestGuardBuy">👑 开通大航海</button>
    <button class="blt-btn" style="padding:2px 9px;font-size:11px;background:rgba(156,163,175,0.18);border:1px solid rgba(156,163,175,0.35)" @onclick="SendTestEntryDanmu">🚪 进房播报</button>
</div>

<div class="blt-grid blt-cols-2" style="align-items:start">
    @* ── 左侧：现代四大模块 Tab 控制台 ── *@
    <div>
        @* Tab 顶层切换栏 *@
        <div style="display:flex;gap:6px;margin-bottom:12px;border-bottom:1px solid var(--line);padding-bottom:10px">
            <button class="blt-btn @(_activeTab == "theme" ? "blue" : "subtle")" style="font-weight:600;padding:5px 14px" @onclick='() => _activeTab = "theme"'>
                <BltIcon Emoji="🎨" /> 样式中心
            </button>
            <button class="blt-btn @(_activeTab == "basic" ? "blue" : "subtle")" style="font-weight:600;padding:5px 14px" @onclick='() => _activeTab = "basic"'>
                <BltIcon Emoji="⚙️" /> 基础控制
            </button>
            <button class="blt-btn @(_activeTab == "advanced" ? "blue" : "subtle")" style="font-weight:600;padding:5px 14px" @onclick='() => _activeTab = "advanced"'>
                <BltIcon Emoji="🚀" /> 进阶与特效
            </button>
            <button class="blt-btn @(_activeTab == "manage" ? "blue" : "subtle")" style="font-weight:600;padding:5px 14px" @onclick='() => _activeTab = "manage"'>
                <BltIcon Emoji="💾" /> 备份与管理
            </button>
        </div>

        @if (_activeTab == "theme")
        {
            @* ── Tab 1: 样式中心（统一皮肤库下拉栏选择） ── *@
            <div class="blt-panel" style="margin-bottom:12px">
                <div class="blt-panel-head">
                    <span class="t"><BltIcon Emoji="🎨" /> 弹幕皮肤与模版库 (共 41 款精品样式)</span>
                    <span class="en">SKIN & TEMPLATE LIBRARY</span>
                </div>
                <div class="blt-panel-body">
                    <p style="font-size:12px;color:var(--ink-3);margin-top:0;margin-bottom:12px">
                        包含拉普拉斯 (Laplace) 13 款经典热门气泡/描边模板与本地自研 28 款经典矢量皮肤。直接在下方选择即可实时预览与应用：
                    </p>

                    @* 统一选择下拉框 *@
                    <div style="margin-bottom:12px">
                        <label class="blt-label" style="font-size:13px;font-weight:700">切换当前生效的皮肤/模版</label>
                        <select class="blt-input" style="font-weight:600;font-size:13px;padding:8px 12px;background:var(--bg-2);border:2px solid var(--accent,#3b82f6)" value="@GetUnifiedThemeValue()" @onchange="OnUnifiedThemeSelected">
                            <optgroup label="🌟 拉普拉斯 (Laplace) 精品热门模板 (13 款)">
                                @foreach (var tmpl in LaplaceThemes)
                                {
                                    <option value="@($"laplace:{tmpl.Id}")">★ [Laplace] @tmpl.Name</option>
                                }
                            </optgroup>
                            <optgroup label="🎨 本地自研经典矢量皮肤库 (28 款)">
                                @foreach (var skin in ClassicSkins)
                                {
                                    <option value="@($"classic:{skin.Id}")">🎨 [自研] @skin.Name</option>
                                }
                            </optgroup>
                        </select>
                    </div>

                    @* 当前选中模版概览卡片 *@
                    <div style="padding:12px 14px;border-radius:var(--r);background:var(--bg-2);border:1px solid var(--line);display:flex;align-items:center;justify-content:space-between;gap:12px">
                        <div style="flex:1;min-width:0">
                            <div style="display:flex;align-items:center;gap:6px;margin-bottom:4px;flex-wrap:wrap">
                                <span style="font-weight:700;font-size:14px;color:var(--accent,#3b82f6)">@GetCurrentThemeDisplayName()</span>
                                <span style="font-size:11px;padding:2px 8px;border-radius:10px;background:rgba(59,130,246,0.15);color:#3b82f6;font-weight:700">
                                    @(_cfg.ThemeType == "laplace" ? "Laplace 模板" : "自研矢量皮肤")
                                </span>
                            </div>
                            <div style="font-size:12px;color:var(--ink-2);line-height:1.4">
                                @GetCurrentThemeDesc()
                            </div>
                        </div>
                        <button class="blt-btn subtle" style="padding:4px 12px;font-size:11px;flex-shrink:0" @onclick="ResetCurrentThemeDefaults">
                            恢复此模版默认值
                        </button>
                    </div>
                </div>
            </div>

            @* 2. 配色模式与画布尺寸控制 *@
            <div class="blt-panel" style="margin-bottom:12px">
                <div class="blt-panel-head">
                    <span class="t"><BltIcon Emoji="📐" /> 配色方案与画布尺寸</span>
                    <span class="en">COLOR & CANVAS SIZE</span>
                </div>
                <div class="blt-panel-body">
                    <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:10px">
                        <div>
                            <label class="blt-label">深浅色模式 (Scheme)</label>
                            <select class="blt-input" @bind="_cfg.ColorScheme">
                                <option value="dark">极夜深色 (Dark) · 推荐游戏/夜间场景</option>
                                <option value="light">清透浅色 (Light) · 适配高光亮色背景</option>
                            </select>
                        </div>
                        <div>
                            <label class="blt-label">常驻固定底框背景开关</label>
                            <div style="padding-top:6px">
                                <label class="blt-checkbox"><input type="checkbox" @bind="_cfg.ShowBox" /> 开启常驻固定底衬视窗</label>
                            </div>
                        </div>
                    </div>

                    @* 画布底框尺寸预设与滑块 *@
                    <div style="padding-top:10px;border-top:1px dashed var(--line)">
                        <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:8px">
                            <span style="font-size:12px;font-weight:600;color:var(--ink-2)">OBS 视窗尺寸预设</span>
                            <div style="display:flex;gap:4px">
                                <button class="blt-btn subtle" style="padding:1px 6px;font-size:11px" @onclick="() => SetBoxPreset(380, 500)">经典 380×500</button>
                                <button class="blt-btn subtle" style="padding:1px 6px;font-size:11px" @onclick="() => SetBoxPreset(450, 650)">宽屏 450×650</button>
                                <button class="blt-btn subtle" style="padding:1px 6px;font-size:11px" @onclick="() => SetBoxPreset(320, 450)">紧凑 320×450</button>
                                <button class="blt-btn subtle" style="padding:1px 6px;font-size:11px" @onclick="() => SetBoxPreset(300, 700)">细长 300×700</button>
                            </div>
                        </div>
                        <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px">
                            <div>
                                <label class="blt-label">宽度: @_cfg.BoxWidth px</label>
                                <input type="range" class="blt-range" min="240" max="800" step="10" @bind="_cfg.BoxWidth" @bind:event="oninput" />
                            </div>
                            <div>
                                <label class="blt-label">高度: @_cfg.BoxHeight px</label>
                                <input type="range" class="blt-range" min="300" max="1080" step="10" @bind="_cfg.BoxHeight" @bind:event="oninput" />
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
        else if (_activeTab == "basic")
        {
            @* ── Tab 2: 基础控制 (排版位置 + 元素显隐 + 事件过滤 + 阈值) ── *@

            @* 1. 元素显示位置与排版布局专区 *@
            <div class="blt-panel" style="margin-bottom:12px">
                <div class="blt-panel-head">
                    <span class="t"><BltIcon Emoji="📐" /> 元素显示位置与排版布局</span>
                    <span class="en">POSITION & LAYOUT</span>
                </div>
                <div class="blt-panel-body">
                    <p style="font-size:12px;color:var(--ink-3);margin-top:0;margin-bottom:12px">
                        自由决定头像、用户 ID 与身份勋章的呈现位置。右侧 1:1 画布与 OBS 浮层实时同步联动：
                    </p>
                    <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:12px">
                        <div>
                            <label class="blt-label" style="font-weight:700">👤 用户头像显示位置</label>
                            <select class="blt-input" @bind="_cfg.AvatarPosition" @bind:after="OnAvatarPositionAfter">
                                <option value="left">👈 左侧横向排列（头像在左，右侧为 ID 与弹幕，经典排版）</option>
                                <option value="top-left">↖️ 左上方紧凑排列（顶部左侧显示头像+ID，弹幕换行在下方）</option>
                                <option value="top-center">⬆️ 上方居中对称排列（头像在顶部居中，ID在中间，弹幕在下方居中）</option>
                                <option value="hidden">🚫 隐藏头像（纯文字/气泡流）</option>
                            </select>
                            <div style="display:flex;gap:5px;margin-top:6px;flex-wrap:wrap">
                                <button class="blt-btn @(_cfg.AvatarPosition == "left" ? "blue" : "subtle")" style="font-size:11px;padding:2px 8px" @onclick='() => SetAvatarPos("left")'>👈 左侧横向</button>
                                <button class="blt-btn @(_cfg.AvatarPosition == "top-left" ? "blue" : "subtle")" style="font-size:11px;padding:2px 8px" @onclick='() => SetAvatarPos("top-left")'>↖️ 左上角紧凑</button>
                                <button class="blt-btn @(_cfg.AvatarPosition == "top-center" ? "blue" : "subtle")" style="font-size:11px;padding:2px 8px" @onclick='() => SetAvatarPos("top-center")'>⬆️ 顶部居中</button>
                                <button class="blt-btn @(_cfg.AvatarPosition == "hidden" ? "blue" : "subtle")" style="font-size:11px;padding:2px 8px" @onclick='() => SetAvatarPos("hidden")'>🚫 隐藏头像</button>
                            </div>
                        </div>
                        <div>
                            <label class="blt-label" style="font-weight:700">🏷️ 勋章与身份徽章相对位置</label>
                            <select class="blt-input" @bind="_cfg.BadgePosition" @bind:after="OnBadgePositionAfter">
                                <option value="before-name">位于 ID 前面（[荣耀] [勋章] [舰长] 用户名）</option>
                                <option value="after-name">位于 ID 后面（用户名 [荣耀] [勋章] [舰长]）</option>
                            </select>
                            <div style="display:flex;gap:5px;margin-top:6px;flex-wrap:wrap">
                                <button class="blt-btn @(_cfg.BadgePosition == "before-name" ? "blue" : "subtle")" style="font-size:11px;padding:2px 8px" @onclick='() => SetBadgePos("before-name")'>位于 ID 前面</button>
                                <button class="blt-btn @(_cfg.BadgePosition == "after-name" ? "blue" : "subtle")" style="font-size:11px;padding:2px 8px" @onclick='() => SetBadgePos("after-name")'>位于 ID 后面</button>
                            </div>
                        </div>
                    </div>

                    @* 细颗粒度元素显隐开关 *@
                    <div style="padding-top:10px;border-top:1px dashed var(--line)">
                        <label class="blt-label" style="margin-bottom:8px">元素显隐开关（修改后秒级实时同步 OBS 与预览）</label>
                        <div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:8px">
                            <label class="blt-checkbox"><input type="checkbox" @bind="_cfg.ShowAvatar" @bind:after="AutoSyncConfig" /> 显示用户头像</label>
                            <label class="blt-checkbox"><input type="checkbox" @bind="_cfg.ShowUsername" @bind:after="AutoSyncConfig" /> 显示用户名 ID</label>
                            <label class="blt-checkbox"><input type="checkbox" @bind="_cfg.ShowWealthMedal" @bind:after="AutoSyncConfig" /> 显示荣耀勋章 (荣誉等级 UL)</label>
                            <label class="blt-checkbox"><input type="checkbox" @bind="_cfg.ShowMedal" @bind:after="AutoSyncConfig" /> 显示粉丝勋章</label>
                            <label class="blt-checkbox"><input type="checkbox" @bind="_cfg.ShowMedalLightenedOnly" @bind:after="AutoSyncConfig" /> 只显已点亮粉丝勋章</label>
                            <label class="blt-checkbox"><input type="checkbox" @bind="_cfg.ShowGuardBadge" @bind:after="AutoSyncConfig" /> 显示大航海舰队徽章</label>
                            <label class="blt-checkbox"><input type="checkbox" @bind="_cfg.ShowModBadge" @bind:after="AutoSyncConfig" /> 显示房管身份徽章</label>
                            <label class="blt-checkbox"><input type="checkbox" @bind="_cfg.ShowGiftIcon" @bind:after="AutoSyncConfig" /> 显示礼物专属图标</label>
                        </div>
                    </div>
                </div>
            </div>

            @* 2. 细颗粒度事件过滤开关 *@
            <div class="blt-panel" style="margin-bottom:12px">
                <div class="blt-panel-head">
                    <span class="t"><BltIcon Emoji="🎯" /> 事件类型过滤开关</span>
                    <span class="en">EVENT FILTERS</span>
                </div>
                <div class="blt-panel-body">
                    <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px">
                        <label class="blt-checkbox"><input type="checkbox" @bind="_cfg.ShowDanmaku" /> 接收普通弹幕</label>
                        <label class="blt-checkbox"><input type="checkbox" @bind="_cfg.ShowGift" /> 接收送礼通知</label>
                        <label class="blt-checkbox"><input type="checkbox" @bind="_cfg.ShowSuperChat" /> 接收醒目留言 (SC)</label>
                        <label class="blt-checkbox"><input type="checkbox" @bind="_cfg.ShowGuardBuy" /> 接收开通大航海通知</label>
                        <label class="blt-checkbox"><input type="checkbox" @bind="_cfg.ShowEnterRoom" /> 接收观众进房播报</label>
                        <label class="blt-checkbox"><input type="checkbox" @bind="_cfg.FilterFreeGift" /> 过滤免费/银瓜子小礼物</label>
                    </div>
                </div>
            </div>

            @* 3. 礼物阈值与停留时间 *@
            <div class="blt-panel" style="margin-bottom:12px">
                <div class="blt-panel-head">
                    <span class="t"><BltIcon Emoji="⏱️" /> 阈值过滤与排版时间</span>
                    <span class="en">THRESHOLDS & TIMING</span>
                </div>
                <div class="blt-panel-body">
                    <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px">
                        <div>
                            <label class="blt-label">最低送礼显示金额 (元): @_cfg.GiftPriceAbove</label>
                            <input type="range" class="blt-range" min="0" max="100" step="1" @bind="_cfg.GiftPriceAbove" @bind:event="oninput" />
                            <div style="font-size:11px;color:var(--ink-3);margin-top:2px">低于此金额的送礼将静默忽略，不占用弹幕区域</div>
                        </div>
                        <div>
                            <label class="blt-label">弹幕停留时长: @_cfg.StayDuration 秒 (0 为不淡出)</label>
                            <input type="range" class="blt-range" min="0" max="60" step="1" @bind="_cfg.StayDuration" @bind:event="oninput" />
                        </div>
                        <div>
                            <label class="blt-label">最大同屏弹幕数: @_cfg.MaxCount 条</label>
                            <input type="range" class="blt-range" min="5" max="50" step="1" @bind="_cfg.MaxCount" @bind:event="oninput" />
                        </div>
                        <div>
                            <label class="blt-label">基础字号大小: @_cfg.BaseFontSize px</label>
                            <input type="range" class="blt-range" min="12" max="32" step="1" @bind="_cfg.BaseFontSize" @bind:event="oninput" />
                        </div>
                    </div>
                </div>
            </div>
        }
        else if (_activeTab == "advanced")
        {
            @* ── Tab 3: 进阶与特效 ── *@

            @* 1. 自定义 CSS 代码注入 *@
            <div class="blt-panel" style="margin-bottom:12px">
                <div class="blt-panel-head">
                    <span class="t"><BltIcon Emoji="💻" /> 自定义 CSS 源码注入 (支持高级魔改)</span>
                    <span class="en">CUSTOM CSS INJECTION</span>
                </div>
                <div class="blt-panel-body">
                    <p style="font-size:12px;color:var(--ink-3);margin-top:0;margin-bottom:8px">
                        支持实时向 OBS 浮层注入自定义 CSS 规则。可点击一键载入当前选定模版的完整 CSS 源码进行二次魔改：
                    </p>
                    <div style="display:flex;gap:8px;margin-bottom:8px">
