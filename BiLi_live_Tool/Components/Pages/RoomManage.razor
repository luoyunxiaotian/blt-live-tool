    protected override void OnInitialized()
    {
        _roomId = Config.RoomId;
        _autoConnectBool = Config.AutoConnect;
        _autoConnectClass = _autoConnectBool ? "on" : "";
        var skin = (Config.GetNode("skin") as JsonValue)?.GetValue<string>() ?? "";
        if (skin.Length == 0 || skin == "default") skin = "console";
        if (Themes.Contains(skin)) _skin = skin;
        LoadIdleCloseConfig();
        _idleSeenAt = MainPage.Current?.BiliIdleClosedAt ?? 0;   // only new auto-closes raise the note
        Hub.OnEvent += OnEvent;
        Hub.StatusChanged += OnStatus;
        _likeTimer = new System.Threading.Timer(_ => _ = PollLikeStatus(), null,
            TimeSpan.FromSeconds(1), TimeSpan.FromSeconds(1));
        _flushTimer = new System.Threading.Timer(_ => FlushTick(), null,
            TimeSpan.FromMilliseconds(300), TimeSpan.FromMilliseconds(300));
        _ = PollLikeStatus();   // first paint gets the current counters without waiting 1 s
        _ = LoadFoldersAsync();
        _ = LoadUpdateStatusAsync();
    }

    /// <summary>
    /// Hub events are frequent (弹幕 bursts): append the row on the renderer thread and
    /// only mark the dirty counter — FlushTick coalesces the repaint into one 300 ms beat.
    /// </summary>
    private void OnEvent(LiveEvent ev)
    {
        _ = InvokeAsync(() =>
        {
            _view.Insert(0, ev);
            if (_view.Count > 200) _view.RemoveAt(_view.Count - 1);
            Interlocked.Exchange(ref _pendingEvents, 1);
        });
    }

    /// <summary>300 ms flush: repaint when events arrived, and pick up idle auto-close notices.</summary>
    private void FlushTick()
    {
        var noteChanged = CheckIdleCloseNotice();
        var dirty = Interlocked.Exchange(ref _pendingEvents, 0) != 0;
        if (!dirty && !noteChanged) return;
        try { _ = InvokeAsync(StateHasChanged); } catch { /* renderer already gone */ }
    }

    /// <summary>Raises the notice once per new idle auto-close reported by MainPage.</summary>
    private bool CheckIdleCloseNotice()
    {
        var page = MainPage.Current;
        if (page == null) return false;
        try
        {
            // Any page can reopen the browser — then the notice no longer applies.
            if (_idleNote.Length > 0 && page.IsBiliVisible)
            {
                _idleNote = "";
                return true;
            }
            var at = page.BiliIdleClosedAt;
            if (at <= _idleSeenAt) return false;
            _idleSeenAt = at;
            _idleNote = page.BiliIdleCloseNote();
            return _idleNote.Length > 0;
        }
        catch { return false; }
    }

