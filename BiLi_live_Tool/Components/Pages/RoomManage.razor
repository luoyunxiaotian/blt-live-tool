        => PostJsonAsync("/api/maui/shell/open-path", new JsonObject { ["path"] = row.Path });

    private async Task PostJsonAsync(string path, JsonObject body)
    {
        try
        {
            using var resp = await Http.PostAsync(Base + path,
                new StringContent(body.ToJsonString(), Encoding.UTF8, "application/json"));
        }
        catch
        {
            // panel API down → the click is a no-op
        }
    }

    /// <summary>
    /// The /api/maui/* bridge is POST-only, but read endpoints may also be mapped as GET;
    /// POST first, fall back to GET, so either wiring works.
    /// </summary>
    private async Task<JsonObject?> MauiReadAsync(string path, JsonObject? body = null)
    {
        var o = await PostJsonReadAsync(path, body ?? new JsonObject());
        if (o != null) return o;
        try { return await GetJsonAsync(path); } catch { return null; }
    }

    // ---- 开机自启（HKCU Run；桥接端点 /api/maui/autolaunch/get|set）----

    private bool _autoLaunchOn;
    private bool _autoLaunchBusy;

    private async Task LoadAutoLaunchAsync()
    {
        var on = await FetchAutoLaunchAsync();
        if (!on.HasValue) return;   // bridge down → leave the switch off
        try { await InvokeAsync(() => { _autoLaunchOn = on.Value; StateHasChanged(); }); } catch { }
    }

    /// <summary>Registered Run value; null when the bridge is unreachable.</summary>
    private async Task<bool?> FetchAutoLaunchAsync()
    {
        var o = await MauiReadAsync("/api/maui/autolaunch/get");
        return o == null ? null : GetBool(o, "enabled", false);
    }

    /// <summary>Flips the switch, then reads the registered state back and toasts the result.</summary>
    private async Task ToggleAutoLaunch()
    {
        if (_autoLaunchBusy) return;
        _autoLaunchBusy = true;
        var want = !_autoLaunchOn;
        try
        {
            var r = await PostJsonReadAsync("/api/maui/autolaunch/set", new JsonObject { ["enabled"] = want });
            if (r == null)
            {
                await UI.ToastAsync("设置开机自启失败：面板服务未响应", false);
                return;
            }
            var read = await FetchAutoLaunchAsync();
            _autoLaunchOn = read ?? want;
            var ok = _autoLaunchOn == want;
            await UI.ToastAsync(ok ? (want ? "已开启开机自启" : "已关闭开机自启") : "设置开机自启失败", ok);
        }
        catch (Exception ex)
        {
            await UI.ToastAsync("设置开机自启失败：" + ex.Message, false);
        }
        finally
        {
            _autoLaunchBusy = false;
            StateHasChanged();
        }
    }

    // ---- 服务日志（GET /api/maui/server/log；3 s 轮询，只保留最近 200 行）----

    private sealed class ServerLogLine
    {
        public string Time = "";
        public string Level = "info";
        public string Src = "";
        public string Msg = "";
    }

    private const int MaxServerLines = 200;
    private System.Threading.Timer? _logTimer;
    private List<ServerLogLine> _serverLines = new();
    private int _logCount;
    private bool _logLoaded;
    private string _logSig = "";   // count + tail fingerprint: skips repaint when nothing changed

    private async Task PollServerLogAsync()
    {
        var o = await MauiReadAsync("/api/maui/server/log");
        if (o == null) return;   // bridge down → keep the last rendered lines

        var lines = new List<ServerLogLine>();
        if (o["lines"] is JsonArray arr)
        {
            foreach (var row in arr)
            {
                if (row is not JsonObject l) continue;
                lines.Add(new ServerLogLine
                {
                    Time = GetStr(l, "time", ""),
                    Level = GetStr(l, "level", "info").ToLowerInvariant(),
                    Src = GetStr(l, "src", ""),
                    Msg = GetStr(l, "msg", ""),
                });
            }
        }
        if (lines.Count > MaxServerLines) lines.RemoveRange(0, lines.Count - MaxServerLines);   // tail only
        var count = (int)GetNum(o, "count", lines.Count);
        var last = lines.Count > 0 ? lines[^1] : null;
        var sig = count + "|" + lines.Count + "|" + (last == null ? "" : last.Time + last.Msg);
        if (sig == _logSig) return;   // nothing new → no repaint, no JS scroll
        _logSig = sig;

        try
        {
            // The timer fires on a pool thread → hand state + JS scroll to the renderer.
            await InvokeAsync(async () =>
            {
                _serverLines = lines;
                _logCount = count;
                _logLoaded = true;
                StateHasChanged();
                await ScrollServerLogAsync();
            });
        }
        catch
        {
            // component disposed while the poll was in flight
        }
    }

    /// <summary>Pins the log viewport to the newest row (the container has a fixed max-height).</summary>
    private async Task ScrollServerLogAsync()
    {
        try { await JS.InvokeVoidAsync("eval", "var e=document.getElementById('blt-server-log');if(e){e.scrollTop=e.scrollHeight;}"); }
        catch { }
    }

    private Task RefreshServerLog() => PollServerLogAsync();

    private async Task ClearServerLog()
    {
        await PostJsonAsync("/api/maui/server/log/clear", new JsonObject());
        _serverLines = new List<ServerLogLine>();
        _logCount = 0;
        _logSig = "";
        _logLoaded = true;
        StateHasChanged();
        await UI.ToastAsync("已清空服务日志", true);
    }

    private async Task CopyServerLog()
    {
        if (_serverLines.Count == 0)
        {
            await UI.ToastAsync("暂无日志可复制", false);
            return;
        }
        var text = string.Join("\n",
            _serverLines.Select(l => $"{l.Time} [{l.Level.ToUpperInvariant()}] {l.Src} {l.Msg}".Trim()));
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", text);
            await UI.ToastAsync($"已复制 {_serverLines.Count} 行日志", true);
        }
        catch
        {
            // clipboard API blocked → textarea + execCommand fallback (same as KeyView page)
            try
            {
                var literal = System.Text.Json.JsonSerializer.Serialize(text);
                await JS.InvokeVoidAsync("eval",
                    "(function(){var t=document.createElement('textarea');t.value=" + literal +
                    ";t.style.position='fixed';t.style.opacity='0';document.body.appendChild(t);t.focus();t.select();" +
                    "document.execCommand('copy');document.body.removeChild(t);})()");
                await UI.ToastAsync($"已复制 {_serverLines.Count} 行日志", true);
            }
            catch { await UI.ToastAsync("复制失败", false); }
        }
    }

