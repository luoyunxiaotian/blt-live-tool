    /// <summary>POSTs the whole document; falls back to a direct in-process write when the API is down.</summary>
    private async Task SaveAsync(string label)
    {
        if (_busy) return;
        _busy = true;
        try
        {
            var json = _doc!.ToJsonString();
            try
            {
                using var resp = await Http.PostAsync(Base + "/api/config",
                    new StringContent(json, Encoding.UTF8, "application/json"));
                var body = await resp.Content.ReadAsStringAsync();
                if (resp.IsSuccessStatusCode)
                {
                    _status = label + " · " + Stamp();
                    return;
                }
                WriteLocal(label + " · HTTP " + (int)resp.StatusCode + ErrText(body));
            }
            catch (Exception ex)
            {
                WriteLocal(label + " · " + Short(ex.Message));
            }
        }
        finally
        {
            _busy = false;
        }
    }

    private void WriteLocal(string why)
    {
        try
        {
            Config.UpdateFrom(_doc!);   // top-level merge + persist, same semantics as POST /api/config
            Pipeline.ApplyConfig();
            ApplyFromDoc();
            _status = why + " → 已直写本地配置 · " + Stamp();
        }
        catch (Exception ex)
        {
            _status = "保存失败：" + Short(ex.Message);
        }
    }

    // ---- engine status / lifecycle ----

    private void RefreshEngineLocal()
    {
        try
        {
            var e = TtsEngine.EdgeStatus();
            _edgeRunning = PropBool(e, "running");
            var ep = PropStr(e, "execPath");
            if (ep.Length > 0) _edgePath = ep;
            var m = TtsEngine.MossStatus();
            _mossRunning = PropBool(m, "running");
            var md = PropStr(m, "modelDir");
            if (md.Length > 0) _mossModelDir = md;
        }
        catch { /* status probe must never break rendering */ }
    }

    private async Task FetchMossStatusAsync()
    {
        try
        {
            using var resp = await Http.PostAsync(Base + "/api/maui/tts/moss/status",
                new StringContent("{}", Encoding.UTF8, "application/json"));
            var text = await resp.Content.ReadAsStringAsync();
            if (resp.IsSuccessStatusCode && JsonNode.Parse(text) is JsonObject o)
            {
                _mossRunning = Flag(o, "running", _mossRunning);
                var md = Str(o, "modelDir");
                if (md.Length > 0) _mossModelDir = md;
                return;
            }
        }
        catch { /* fall back to the in-process probe below */ }
        RefreshEngineLocal();
    }

    private async Task FetchEdgeVoicesAsync()
    {
        try
        {
            using var resp = await Http.GetAsync(Base + "/api/tts/edge/voices");
            var text = await resp.Content.ReadAsStringAsync();
            if (!resp.IsSuccessStatusCode)
            {
                if (_engine == "edge") _status = "edge 音色清单 HTTP " + (int)resp.StatusCode + ErrText(text);
                _edgeRunning = false;
                return;
            }
            if (JsonNode.Parse(text) is not JsonArray arr)
            {
                _status = "edge 音色清单格式异常";
                return;
            }
            _voices.Clear();
            foreach (var node in arr)
            {
                if (node is not JsonObject o) continue;
                var name = Str(o, "ShortName");
                if (name.Length == 0) name = Str(o, "shortName");
                if (name.Length == 0) name = Str(o, "Name");
                if (name.Length == 0) continue;
                var friendly = Str(o, "FriendlyName");
                var gender = Str(o, "Gender");
                var zh = name.StartsWith("zh", StringComparison.OrdinalIgnoreCase);
                _voices.Add(new VoiceItem(name, VoiceLabel(name, friendly, gender), zh));
            }
            // Chinese voices first so the 50-entry window is actually useful; order stays stable otherwise.
            var sorted = _voices.OrderByDescending(v => v.Zh).ToList();
            _voices.Clear();
            _voices.AddRange(sorted);
            if (_engine == "edge") _edgeRunning = true;
        }
        catch (Exception ex)
        {
            _edgeRunning = false;
            if (_engine == "edge") _status = "edge 音色清单读取失败：" + Short(ex.Message);
        }
    }

    private async Task MossActionAsync(string action)
    {
        if (_busy) return;
        _busy = true;
        _status = "MOSS " + action + " 请求中…";
        try
        {
            try
            {
                using var resp = await Http.PostAsync(Base + "/api/maui/tts/moss/" + action,
                    new StringContent("{}", Encoding.UTF8, "application/json"));
                var text = await resp.Content.ReadAsStringAsync();
                if (resp.IsSuccessStatusCode)
                {
                    if (JsonNode.Parse(text) is JsonObject o) _mossRunning = Flag(o, "running", _mossRunning);
                    _status = "MOSS " + action + " → " + RunText(_mossRunning) + " · " + Stamp();
                    return;
                }
                _status = "MOSS " + action + " HTTP " + (int)resp.StatusCode + ErrText(text);
            }
            catch
            {
                // server unreachable: drive the host directly
                object r = action switch
                {
                    "stop" => TtsEngine.StopMoss(),
                    "restart" => await TtsEngine.RestartMossAsync(),
                    _ => TtsEngine.EnsureMoss(),
                };
                _mossRunning = PropBool(r, "running");
                _status = "MOSS " + action + "（本地直调）→ " + RunText(_mossRunning) + " · " + Stamp();
            }
        }
        finally
        {
            _busy = false;
            RefreshEngineLocal();
        }
    }

    private async Task StartMoss() => await MossActionAsync("ensure");

    private async Task StopMoss() => await MossActionAsync("stop");

    private async Task RestartMoss() => await MossActionAsync("restart");

    // ---- preview ----

    private async Task Preview()
    {
        if (_busy) return;
        _busy = true;
        _previewMsg = "合成中…";
        _previewUrl = "";
        try
        {
            var body = new JsonObject { ["text"] = "这是一条试听", ["voice"] = _voice };
            using var resp = await Http.PostAsync(Base + "/api/tts/edge/",
                new StringContent(body.ToJsonString(), Encoding.UTF8, "application/json"));
            if (!resp.IsSuccessStatusCode)
            {
                var err = await resp.Content.ReadAsStringAsync();
                _previewMsg = "合成失败 · HTTP " + (int)resp.StatusCode + ErrText(err);
                return;
            }
            var bytes = await resp.Content.ReadAsByteArrayAsync();
            var mime = resp.Content.Headers.ContentType?.MediaType ?? "audio/mpeg";
            if (bytes.Length < 100)
            {
                _previewMsg = "合成失败 · 仅返回 " + bytes.Length + " 字节";
                return;
            }
            _previewMsg = "已合成 " + bytes.Length + " 字节（" + mime + "）";
            // Inline data URL keeps the preview playable without extra JS assets.
            if (bytes.Length <= 2 * 1024 * 1024)
                _previewUrl = "data:" + mime + ";base64," + Convert.ToBase64String(bytes);
            else
                _previewMsg += " · 超过 2MB，未内联播放";
        }
        catch (Exception ex)
        {
            _previewMsg = "合成失败：" + Short(ex.Message);
        }
        finally
        {
            _busy = false;
        }
    }

