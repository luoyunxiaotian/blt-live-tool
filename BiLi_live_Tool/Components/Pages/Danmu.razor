    private void LoadSelectedTemplateCss()
    {
        try
        {
            string themeId = _cfg.ThemeType == "laplace" ? (_cfg.LaplaceTemplate ?? "laplace-nailv") : _cfg.Theme;
            string dir = Path.Combine(AppDomain.CurrentDomain.BaseDirectory, "wwwroot", "legacy", "danmu", _cfg.ThemeType == "laplace" ? "templates" : "themes");
            string cssFile = Path.Combine(dir, $"{themeId}.css");
            if (!File.Exists(cssFile))
            {
                var fallbackDir = Path.Combine(AppContext.BaseDirectory, "..", "..", "..", "wwwroot", "legacy", "danmu", _cfg.ThemeType == "laplace" ? "templates" : "themes");
                if (Directory.Exists(fallbackDir))
                {
                    cssFile = Path.Combine(fallbackDir, $"{themeId}.css");
                }
            }
            if (File.Exists(cssFile))
            {
                _cfg.CustomCss = File.ReadAllText(cssFile);
                Notify($"已载入模版 {themeId} 的全部 CSS 源码", true);
            }
            else
            {
                Notify($"未找到模版 CSS 文件: {cssFile}", false);
            }
        }
        catch (Exception ex)
        {
            Notify($"载入失败: {ex.Message}", false);
        }
    }

    private void ClearCustomCss()
    {
        _cfg.CustomCss = "";
        Notify("自定义 CSS 已清空", true);
    }

    private string ExportConfigJson()
    {
        try
        {
            return JsonSerializer.Serialize(_cfg, new JsonSerializerOptions { WriteIndented = true });
        }
        catch { return "{}"; }
    }

    private async Task CopyConfigJson()
    {
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", ExportConfigJson());
            Notify("配置 JSON 已成功复制到剪贴板！", true);
        }
        catch (Exception ex)
        {
            Notify($"复制失败: {ex.Message}", false);
        }
    }

    private void ImportConfigFromJson()
    {
        if (string.IsNullOrWhiteSpace(_importJsonInput))
        {
            Notify("请先粘贴配置 JSON", false);
            return;
        }
        try
        {
            var parsed = JsonSerializer.Deserialize<DanmuConfig>(_importJsonInput, new JsonSerializerOptions { PropertyNameCaseInsensitive = true });
            if (parsed != null)
            {
                _cfg = parsed;
                Notify("配置已成功导入并应用！", true);
            }
        }
        catch (Exception ex)
        {
            Notify($"导入失败，JSON 格式有误: {ex.Message}", false);
        }
    }

    private void LoadConfigFromStorage()
    {
        var node = Config.GetNode("danmuOverlay");
        if (node is JsonObject jo)
        {
            try
            {
                _cfg = JsonSerializer.Deserialize<DanmuConfig>(jo.ToJsonString(), new JsonSerializerOptions { PropertyNameCaseInsensitive = true }) ?? new DanmuConfig();
            }
            catch { _cfg = new DanmuConfig(); }
        }
        else
        {
            _cfg = new DanmuConfig();
        }
    }

    private void SaveConfig() => SaveConfig(true);

    private void SaveConfig(bool notify)
    {
        try
        {
            var jsonStr = JsonSerializer.Serialize(_cfg);
            if (JsonNode.Parse(jsonStr) is JsonObject obj)
            {
                var doc = Config.Snapshot();
                doc["danmuOverlay"] = obj;
                Config.ReplaceFrom(doc);
                Hub.PublishOutbound("danmu_config_update", obj);
                if (notify)
                {
                    Notify("弹幕浮层配置已保存，OBS 浮层已实时同步更新！", true);
                }
            }
        }
        catch (Exception ex)
        {
            if (notify)
            {
                Notify("保存失败: " + ex.Message, false);
            }
        }
    }

