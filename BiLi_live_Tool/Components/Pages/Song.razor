    // ---------- http plumbing ----------

    private async Task<JsonNode?> GetJson(string path)
    {
        var resp = await Http.GetAsync(path);
        var text = await resp.Content.ReadAsStringAsync();
        if (!resp.IsSuccessStatusCode) throw new Exception("HTTP " + (int)resp.StatusCode + " " + Trim(text));
        return string.IsNullOrWhiteSpace(text) ? null : JsonNode.Parse(text);
    }

    private async Task<JsonNode?> PostJson(string path, JsonObject body)
    {
        using var content = new StringContent(body.ToJsonString(), Encoding.UTF8, "application/json");
        var resp = await Http.PostAsync(path, content);
        var text = await resp.Content.ReadAsStringAsync();
        if (!resp.IsSuccessStatusCode) throw new Exception("HTTP " + (int)resp.StatusCode + " " + Trim(text));
        return string.IsNullOrWhiteSpace(text) ? null : JsonNode.Parse(text);
    }

    private async Task Guard(Func<Task> body, string failPrefix)
    {
        _busy = true;
        try { await body(); }
        catch (Exception ex) { SetMsg(failPrefix + "：" + ex.Message, "red"); }
        finally
        {
            _busy = false;
            StateHasChanged();
        }
    }

    private void SetMsg(string text, string cls)
    {
        _feedback = text;
        _feedbackCls = cls;
    }

    // ---------- helpers ----------

    private static string Trim(string s) => s.Length > 160 ? s[..160] : s;

    private static string Js(JsonObject? o, string key)
        => o?[key] is JsonValue v && v.TryGetValue<string>(out var s) ? s ?? "" : "";

    private static long Jl(JsonObject? o, string key, long def = 0)
        => o?[key] is JsonValue v && v.TryGetValue<long>(out var l) ? l : def;

    private static bool Jb(JsonObject? o, string key, bool def = false)
        => o?[key] is JsonValue v && v.TryGetValue<bool>(out var b) ? b : def;

    private static bool Vb(JsonNode? n)
    {
        if (n is not JsonValue v) return false;
        if (v.TryGetValue<bool>(out var b)) return b;
        if (v.TryGetValue<long>(out var l)) return l != 0;
        return false;
    }

    private static long ParseLong(string s, long def = 0)
        => long.TryParse((s ?? "").Trim(), out var v) ? (v < 0 ? 0 : v) : def;

    private static string FmtTime(long ms)
        => ms <= 0 ? "—" : DateTimeOffset.FromUnixTimeMilliseconds(ms).LocalDateTime.ToString("MM-dd HH:mm:ss");

    private static string StatusText(string s) => s switch
    {
        "success" => "成功",
        "error" or "fail" or "failed" => "失败",
        "blacklist" => "黑名单",
        "cooldown" or "user_cooldown" => "冷却中",
        "not_found" => "未找到",
        "guard_only" => "仅舰长",
        "medal" => "勋章不足",
        "honor" => "等级不足",
        "daily_limit" => "超每日上限",
        "dedup" => "重复点歌",
        "" => "未知",
        _ => s,
    };

    private static string PlatName(string p) => p switch
    {
        "qq" => "QQ音乐",
        "netease" => "网易云",
        "kugou" => "酷狗",
        "bilibili" => "B站",
        _ => p.Length > 0 ? p : "—",
    };

    private static string PlatCls(string p) => p switch
    {
        "qq" => "blue",
        "netease" => "red",
        "kugou" => "amber",
        "bilibili" => "green",
        _ => "off",
    };

    private static string OnOff(bool b) => b ? "on" : "";
    private static string OnOffText(bool b) => b ? "ON" : "OFF";

