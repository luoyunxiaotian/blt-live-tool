    /// <summary>原版 voiceGroup()：在线音色按 locale 分组，作为下拉的 optgroup 标题。</summary>
    private static string EdgeGroup(string locale)
    {
        var lc = locale ?? "";
        if (lc.StartsWith("zh-CN", StringComparison.OrdinalIgnoreCase)) return "普通话(Edge)";
        if (lc.StartsWith("zh-HK", StringComparison.OrdinalIgnoreCase)
            || lc.StartsWith("zh-Hant-HK", StringComparison.OrdinalIgnoreCase)) return "粤语(Edge)";
        if (lc.StartsWith("zh-TW", StringComparison.OrdinalIgnoreCase)) return "台湾国语(Edge)";
        if (lc.StartsWith("en-", StringComparison.OrdinalIgnoreCase)) return "英语(Edge)";
        if (lc.StartsWith("ja-", StringComparison.OrdinalIgnoreCase)) return "日语(Edge)";
        if (lc.StartsWith("ko-", StringComparison.OrdinalIgnoreCase)) return "韩语(Edge)";
        return lc.Length > 0 ? "其它语言(Edge)" : "在线音色(Edge)";
    }

    /// <summary>分组显示顺序（原版 order 数组 + 系统音色 + 本地音色）。</summary>
    private static readonly string[] GroupOrder =
    {
        "普通话(Edge)", "粤语(Edge)", "台湾国语(Edge)", "英语(Edge)", "日语(Edge)", "韩语(Edge)",
        "其它语言(Edge)", "在线音色(Edge)", "系统音色", "内置音色（本地）", "自定义音色（克隆）",
    };

    /// <summary>
    /// 下拉分组：收藏置顶 → 按当前引擎给清单（原版 buildVoiceOptions / buildMossVoiceOptions）。
    /// </summary>
    private List<(string Label, List<VoiceItem> Items)> VoiceGroups()
    {
        var filter = _voiceFilter.Trim();
        bool Match(VoiceItem v) => filter.Length == 0
            || v.Name.Contains(filter, StringComparison.OrdinalIgnoreCase)
            || v.Label.Contains(filter, StringComparison.OrdinalIgnoreCase);

        IEnumerable<VoiceItem> src = _engine == "moss"
            ? _mossBuiltin.Concat(_cloneVoices.Select(c => new VoiceItem(c.Id, c.Name + "（克隆）", "自定义音色（克隆）")))
            : _voices.Concat(_sysVoices);

        var hit = src.Where(Match).ToList();
        var groups = new List<(string Label, List<VoiceItem> Items)>();

        var fav = hit.Where(v => _favorites.Contains(v.Name)).ToList();
        if (fav.Count > 0) groups.Add(("⭐ 常用音色", fav));

        foreach (var g in GroupOrder)
        {
            var items = hit.Where(v => v.Group == g).ToList();
            if (items.Count > 0) groups.Add((g, items));
        }

        // 当前值不在清单里（引擎刚切换、本地服务还没起来）→ 补一条，别让下拉空白。
        var cur = VoiceSel;
        if (cur.Length > 0 && !groups.Any(g => g.Items.Any(v => v.Name == cur)))
        {
            var label = _engine == "moss" ? "当前配置（本地引擎未列出）" : "当前配置";
            groups.Insert(0, (label, new List<VoiceItem> { new(cur, cur + "（当前）", label) }));
        }
        return groups;
    }

