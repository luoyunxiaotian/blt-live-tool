@page "/tts"
@using System.Globalization
@using System.Text
@using System.Text.Json
@using System.Text.Json.Nodes
@inject AppConfig Config
@inject TtsHost TtsEngine
@inject LivePipeline Pipeline
@inject TtsSpeaker Speaker
@inject BiLi_live_Tool.Services.AudioService Audio
@inject BiLi_live_Tool.Services.DebouncedSaver Saver
@inject BiLi_live_Tool.Services.UiKit UI
@implements IDisposable
@* TTS page: engine panel, master switch, per-type switches, tone presets and voice preview.
   Config is read from GET /api/config and written back as the whole document via POST /api/config
   (server merges top-level keys and persists); a direct in-process write is the offline fallback. *@

<div class="blt-pagehead">
    <h1>语音念弹幕</h1><span class="en">TTS</span>
    <span style="margin-left:auto;display:flex;align-items:center;gap:12px">
        <span class="blt-hint" style="margin:0;font-family:var(--mono);color:var(--amber-ink)">@_status</span>
        @* Auto-save status line: replaced the 保存全部 button. *@
        <span class="blt-hint" style="margin:0">@AutoSaveText()</span>
    </span>
</div>

<div class="blt-topstrip">
    <span class="seg">config <b class="@ConfigClass()">@ConfigText()</b></span>
    <span class="seg">api <b>127.0.0.1:@Config.Port</b></span>
    <span class="seg" style="display:flex;align-items:center;gap:6px">engine
        <select class="blt-input bar-engine" style="width:146px;padding:1px 6px;font-size:11px"
                @bind="_engine" @bind:after="SaveEngineSoon" data-tip="引擎影响念弹幕 / 试听 / 播报队列等多项功能">
            <option value="edge">edge · 在线</option>
            <option value="sys">sys · 系统语音</option>
            <option value="moss">moss · 本地离线</option>
        </select>
    </span>
    <span class="seg">引擎状态 <b class="@EngineClass()">@EngineText()</b></span>
    <span class="seg">edge 音色 <b>@_voices.Count</b></span>
    <span class="seg">总开关 <b class="@OnOff(_enabled)">@OnOffText(_enabled)</b></span>
</div>

@* Master switch (tts.enabled): promoted from the corner panel to a page-level control bar. *@
<div class="blt-master @MasterCls()">
    <span class="st">启用语音念弹幕</span>
    <span class="sub">观众弹幕/礼物/SC/进房 → 语音播报（引擎 @_engine）</span>
    <span class="right">
        <span class="@BigSwitchClass(_enabled)" @onclick="ToggleEnabled"><span class="track"></span>@OnOffText(_enabled)</span>
    </span>
</div>

<div class="blt-grid blt-cols-2">
    @* ── 左列：语音引擎（含音色）/ 总开关与语音 ── *@
    <div>
        <div class="blt-panel">
            <div class="blt-panel-head"><span class="t"><BltIcon Emoji="🔈" /> 语音引擎</span><span class="en">ENGINE</span>
                <span class="right"><span>tts.engine</span><b class="amber">@_engine</b></span>
            </div>
            <div class="blt-panel-body">
                <label class="blt-label">engine · 引擎选择</label>
                <div style="display:flex;gap:10px">
                    <select class="blt-input" style="flex:1;cursor:pointer" @bind="_engine" @bind:after="SaveEngineSoon">
                        <option value="edge">edge · 在线语音（edge-tts，322 音色）</option>
                        <option value="moss">moss · 本地离线引擎（端口 8021）</option>
                        <option value="sys">sys · 系统语音兜底</option>
                    </select>
                    <button class="blt-btn" @onclick="RefreshAll">刷新状态</button>
                </div>

                <div style="margin-top:12px">
                    @if (_engine == "edge")
                    {
                        <div class="blt-kv"><span class="k">edge 服务 :8020</span><span class="v @OnOff(_edgeRunning)">@RunText(_edgeRunning)</span></div>
                        <div class="blt-kv"><span class="k">在线音色清单</span><span class="v @OnOff(_voices.Count > 0)">@VoiceStateText()</span></div>
                        <div class="blt-kv"><span class="k">引擎程序</span><span class="v" style="word-break:break-all">@PathText(_edgePath)</span></div>
                    }
                    else if (_engine == "moss")
                    {
                        <div class="blt-kv"><span class="k">moss 服务 :8021</span><span class="v @OnOff(_mossRunning)">@RunText(_mossRunning)</span></div>
                        <div class="blt-kv"><span class="k">引擎本体（moss_tts_server.exe）</span><span class="v @OnOff(_mossInstalled)">@MossInstalledText()</span></div>
                        <div class="blt-kv"><span class="k">引擎程序</span><span class="v" style="word-break:break-all">@PathText(_mossPath)</span></div>
                        <div class="blt-kv"><span class="k">模型目录</span><span class="v" style="word-break:break-all">@PathText(_mossModelDir)</span></div>
                        <div class="blt-kv"><span class="k">本地音色（mossVoice）</span><span class="v amber">@_mossVoice</span></div>
                    }
                    else
                    {
                        <div class="blt-kv"><span class="k">系统语音</span><span class="v amber">免服务 · 本机语音合成</span></div>
                        <div class="blt-kv"><span class="k">系统音色</span><span class="v @OnOff(_sysVoices.Count > 0)">@SysVoiceStateText()</span></div>
                        <div class="blt-kv"><span class="k">回退顺序</span><span class="v">edge → moss → sys</span></div>
                    }
                </div>

                @if (_engine == "moss")
                {
                    <div style="display:flex;gap:8px;margin-top:12px;flex-wrap:wrap">
                        <button class="blt-btn" @onclick="StartMoss" disabled="@_busy">启动</button>
                        <button class="blt-btn" @onclick="StopMoss" disabled="@_busy">停止</button>
                        <button class="blt-btn" @onclick="RestartMoss" disabled="@_busy">重启</button>
                    </div>

                    @* MOSS engine ships with the package (44.5MB is not worth an
                       on-demand download); this hint covers a broken install. *@
                    @if (!_mossInstalled)
                    {
                        <div class="blt-hint" style="color:var(--amber-ink)">
                            未找到 moss_tts_server.exe：请重新安装本程序，或把它放到 @_mossPath 同级目录
                        </div>
                    }
                    else
                    {
                        <div class="blt-hint">引擎已安装 · 模型（约 728 MB）首次启动时按需下载</div>
                    }
                }
                <div class="blt-hint">引擎改动即时生效并自动保存 · @AutoSaveText()</div>
                @if (_engine == "sys")
                {
                    <div class="blt-hint">sys 引擎不依赖本地服务；edge 未运行时自动回退到系统语音</div>
                }

                @* Voice picker stays inside the engine card (legacy 「🔈 语音引擎」 groups engine + voice). *@
                <div class="blt-kv" style="margin-top:14px;border-top:1px solid var(--line)">
                    <span class="k">voice · 音色与试听</span>
                    <span class="v amber">@VoiceSel</span>
                </div>
                <label class="blt-label">搜索音色（音色名 / 中文名 / 语种）</label>
                <input class="blt-input mono" placeholder="如 zh-CN / xiaoxiao / 女声" @bind="_voiceFilter" @bind:event="oninput" />

                <div style="margin-top:10px">
                    <label class="blt-label">@VoiceListLabel()</label>
                    <select class="blt-input mono" style="cursor:pointer" @bind="VoiceSel" @bind:after="SaveVoiceSoon">
                        @foreach (var g in VoiceGroups())
                        {
                            <optgroup label="@g.Label">
                                @foreach (var v in g.Items)
                                {
                                    <option value="@v.Name">@v.Label</option>
                                }
                            </optgroup>
                        }
                    </select>
                </div>

                <div style="display:flex;gap:8px;align-items:center;margin-top:10px;flex-wrap:wrap">
                    <button class="blt-btn" @onclick="ToggleFavorite" disabled="@_busy">@FavoriteBtnText()</button>
                    <button class="blt-btn" @onclick="Preview" disabled="@_busy">试听</button>
                    <span class="blt-hint" style="margin:0">@_previewMsg</span>
                </div>
                @if (_previewUrl.Length > 0)
                {
                    <audio controls src="@_previewUrl" style="width:100%;margin-top:10px"></audio>
                }
                <div class="blt-hint">音色选中即时生效并自动保存 · @AutoSaveText()</div>
                <div class="blt-hint">@PreviewHint()</div>
            </div>
        </div>

        @* ── MOSS 自定义（克隆）音色：走 Kestrel 反代 /api/tts/moss/* → 127.0.0.1:8021，
              路径与原版 legacy/tts.js 完全一致（GET /voices · POST /voices/add · /voices/remove）。 ── *@
        @if (_engine == "moss")
        {
            var cloneReady = _mossInstalled && _mossRunning;
            <div class="blt-panel">
                <div class="blt-panel-head"><span class="t"><BltIcon Emoji="🎙" /> 自定义克隆音色</span><span class="en">CLONE VOICES</span>
                    <span class="right"><span>GET /api/tts/moss/voices · POST .../voices/add | remove</span></span>
                </div>
                <div class="blt-panel-body">
                    @if (!_mossInstalled)
                    {
                        <div class="blt-empty">引擎未安装 · 无法管理克隆音色（请重新安装本程序，或把 moss_tts_server.exe 放到 @_mossPath 同级目录）</div>
                    }
                    else if (!_mossRunning)
                    {
                        <div class="blt-empty">引擎未运行 · 点上方「启动」后再管理克隆音色</div>
                    }

                    <label class="blt-label">名称（留空则取参考音频文件名，最长 20 字）</label>
                    <div style="display:flex;gap:8px;flex-wrap:wrap">
                        <input class="blt-input" style="flex:1;min-width:130px" placeholder="如：主播本音"
                               @bind="_cloneName" @bind:event="oninput" disabled="@(_busy || !cloneReady)"
                               data-tip="3–10 秒清晰人声；克隆在本地 MOSS 服务完成，参考音频不上传" />
                        <button class="blt-btn" style="flex:none" @onclick="PickCloneAudio" disabled="@(_busy || !cloneReady)">选择参考音频</button>
                        <button class="blt-btn primary" style="flex:none" @onclick="AddCloneVoice"
                                disabled="@(_busy || !cloneReady || _clonePath.Length == 0)">添加</button>
                    </div>
                    <div class="blt-hint" style="font-family:var(--mono);word-break:break-all">
                        参考音频：@(_clonePath.Length > 0 ? _clonePath : "未选择（wav / mp3 / flac / m4a / ogg）")
                    </div>

                    <div class="blt-kv" style="margin-top:12px;border-top:1px solid var(--line)">
                        <span class="k">已有克隆音色</span>
                        <span class="v amber">@_cloneVoices.Count 个</span>
                    </div>
                    @if (_cloneLoading)
                    {
                        <div class="blt-empty">音色清单加载中…</div>
                    }
                    else if (_cloneVoices.Count == 0)
                    {
                        <div class="blt-empty">暂无克隆音色 · 选一段参考音频后点「添加」</div>
                    }
                    else
                    {
                        <div style="margin-top:6px">
                            @foreach (var v in _cloneVoices)
                            {
                                <div style="display:flex;align-items:center;gap:8px;padding:5px 0;border-bottom:1px dashed var(--line)">
                                    <span style="flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">
                                        @v.Name <span class="blt-hint" style="margin:0;font-family:var(--mono)">@v.Id</span>
                                    </span>
                                    <button class="blt-btn" style="padding:3px 10px;flex:none" @onclick="() => PreviewClone(v)"
                                            disabled="@(_busy || !cloneReady)">试听</button>
                                    <button class="blt-btn" style="padding:3px 10px;flex:none" @onclick="() => DeleteClone(v)"
                                            disabled="@(_busy || !cloneReady)">删除</button>
                                </div>
                            }
                        </div>
                    }

                    <div style="display:flex;gap:8px;align-items:center;margin-top:10px;flex-wrap:wrap">
                        <button class="blt-btn" @onclick="RefreshCloneVoices" disabled="@(_busy || !cloneReady)">刷新音色清单</button>
                        <span class="blt-hint" style="margin:0">@_cloneMsg</span>
                    </div>
                    @if (_clonePreviewMsg.Length > 0)
                    {
                        <div class="blt-hint">@_clonePreviewMsg</div>
                    }
                    @if (_clonePreviewUrl.Length > 0)
                    {
                        <audio controls src="@_clonePreviewUrl" style="width:100%;margin-top:8px"></audio>
                    }
                    <div class="blt-hint">
                        克隆在本地 MOSS 服务完成（POST /api/tts/moss/voices/add · name + 参考音频路径），删除需二次确认；试听走 POST /api/tts/moss/（voiceId）。
                        播报音色仍由 tts.mossVoice 决定（当前 @_mossVoice），本卡片只负责管理克隆音色清单。
                    </div>
                </div>
            </div>
        }

        <div class="blt-panel">
            <div class="blt-panel-head"><span class="t">总开关 &amp; 语音</span><span class="en">MASTER</span>
                <span class="right"><span>enabled / rate / volume</span></span>
            </div>
            <div class="blt-panel-body">
                @* The master toggle itself sits in the page-level bar above (kept prominent on purpose). *@
                <div class="blt-kv">
                    <span class="k">启用语音念弹幕（页面顶部主控条）</span>
                    <span class="v @OnOff(_enabled)">@OnOffText(_enabled)</span>
                </div>
                <div style="display:flex;gap:14px;flex-wrap:wrap;margin-top:12px">
                    <div style="flex:1;min-width:110px">
                        <label class="blt-label">rate · 语速</label>
                        <input class="blt-input mono" type="number" step="0.05" min="0.5" max="2.5"
                               @bind="_rateText" @bind:after="SaveMasterSoon" />
                    </div>
                    <div style="flex:1;min-width:110px">
                        <label class="blt-label">volume · 音量</label>
                        <input class="blt-input mono" type="number" step="0.05" min="0" max="1"
                               @bind="_volumeText" @bind:after="SaveMasterSoon" />
                    </div>
                </div>
                <div class="blt-hint">rate 0.5–2.5（1 = 原速）· volume 0–1 · 总开关在页面顶部主控条</div>
                <div class="blt-hint">改动即时生效并自动保存 · @AutoSaveText()</div>
            </div>
        </div>
    </div>

    @* ── 右列：语气 / 念哪些事件 / 队列与过滤 / 只读参数 ── *@
    <div>
        <div class="blt-panel">
            <div class="blt-panel-head"><span class="t"><BltIcon Emoji="🎭" /> 语气</span><span class="en">TONE</span>
                <span class="right"><span>tone.global / byType</span><b class="amber">@_toneGlobal</b></span>
            </div>
            <div class="blt-panel-body">
                <label class="blt-label">全局语气（tone.global）</label>
                <select class="blt-input" style="cursor:pointer" @bind="_toneGlobal" @bind:after="SaveToneSoon">
                    <option value="">— 默认（normal）—</option>
                    @foreach (var t in _tonePresets)
                    {
                        <option value="@t.Key">@t.Label</option>
                    }
                </select>
                <div class="blt-hint">语气改动即时生效并自动保存 · @AutoSaveText()</div>

                <div style="margin-top:12px">
                    @if (_tonePresets.Count == 0)
                    {
                        <div class="blt-empty">配置中未找到 tonePresets</div>
                    }
                    else
                    {
                        @foreach (var t in _tonePresets)
                        {
                            <div class="blt-kv">
                                <span class="k">@t.Label <span class="blt-hint" style="margin:0;font-family:var(--mono)">@t.Key</span></span>
                                <span class="v">@t.Desc</span>
                            </div>
                        }
                    }
                </div>

                @* Per-event tone binding lives in the same card (legacy 「🎭 语气」 covers global + byType). *@
                <label class="blt-label" style="margin-top:14px;border-top:1px solid var(--line);padding-top:10px">各事件类型专属语气（「跟随全局」= 空值）</label>
                @if (_tonePresets.Count == 0)
                {
                    <div class="blt-empty">配置中未找到 tonePresets · 仅能跟随全局</div>
                }
                @foreach (var row in _toneByType)
                {
                    <div style="display:flex;align-items:center;gap:10px;padding:5px 0;flex-wrap:wrap">
                        <span class="blt-hint" style="width:88px;flex:none;margin:0">@row.Label</span>
                        <select class="blt-input" style="flex:1;min-width:140px;cursor:pointer"
                                @bind="row.Selected" @bind:after="SaveToneByTypeSoon">
                            <option value="">跟随全局</option>
                            @foreach (var t in _tonePresets)
                            {
                                <option value="@t.Key">@t.Label</option>
                            }
                        </select>
                    </div>
                }
                <div class="blt-hint">tone.byType · 下次播报即生效 · @AutoSaveText()</div>
            </div>
        </div>
        <div class="blt-panel">
            <div class="blt-panel-head"><span class="t">念哪些事件</span><span class="en">EVENTS</span>
                <span class="right"><span>enabled + sayUid + volume</span></span>
            </div>
            <div class="blt-panel-body">
                @foreach (var row in _cats)
                {
                    <div style="display:flex;align-items:center;gap:12px;padding:8px 0;border-bottom:1px dashed var(--line);flex-wrap:wrap">
                        <span class="@SwitchClass(row.Enabled)" @onclick="() => ToggleCat(row)"><span class="track"></span>@row.Label</span>
                        <span class="blt-hint" style="margin:0;font-family:var(--mono)">tts.@row.Key</span>
                        @* sayUid = 「念昵称」：real checkbox, never the UID itself. *@
                        <label class="blt-label" style="display:inline-flex;align-items:center;gap:6px;margin:0;letter-spacing:0"
                               title="朗读时先念用户昵称再念内容，UID 永远不会被念出">
                            <input type="checkbox" style="width:auto;margin:0;accent-color:var(--amber)"
                                   @bind="row.SayUid" @bind:after="SaveCatsSoon" />念昵称
                        </label>
                        <span style="margin-left:auto;display:flex;align-items:center;gap:6px">
                            <span class="blt-hint" style="margin:0">音量</span>
                            <input class="blt-input mono" style="width:84px" type="number" step="0.05" min="0" max="1"
                                   @bind="row.Volume" @bind:after="SaveCatsSoon" />
                        </span>
                    </div>
                }
                @if (_cats.Count == 0)
                {
                    <div class="blt-empty">配置读取失败，分类开关不可用</div>
                }
                <div class="blt-hint">开关 / 念昵称 / 音量改动即时生效并自动保存 · @AutoSaveText()</div>
            </div>
        </div>

        <div class="blt-panel">
            <div class="blt-panel-head"><span class="t">队列 / 过滤</span><span class="en">QUEUE</span>
                <span class="right"><span>待念 @Speaker.QueueCount · 上限 @_queueMax</span></span>
            </div>
            <div class="blt-panel-body">
                @* 1) queue cap + guard priority *@
                <div style="display:flex;gap:8px;align-items:flex-end;flex-wrap:wrap">
                    <div style="width:94px">
                        <label class="blt-label">队列上限</label>
                        <input class="blt-input mono" type="number" min="1" max="50" value="@_queueMax"
                               @onchange="OnQueueMaxChanged" />
                    </div>
                    <span class="@SwitchClass(_guardPriority)" style="margin-left:auto" @onclick="ToggleGuardPriority">
                        <span class="track"></span>舰长弹幕优先
                    </span>
                </div>

                @* 2) pending count + current state *@
                <div class="blt-kv" style="margin-top:10px">
                    <span class="k">待念条数</span>
                    <span class="v @(Speaker.QueueCount > 0 ? "amber" : "")">@Speaker.QueueCount 条</span>
                </div>
                <div class="blt-kv">
                    <span class="k">当前状态</span>
                    <span class="v @(Speaker.Speaking ? "green" : "")">@SpeakerStateText()</span>
                </div>

                @* 3) live queue list *@
                @{ var q = Speaker.QueueSnapshot(); }
                @if (q.Count == 0)
                {
                    <div class="blt-empty" style="padding:14px 6px">队列为空 · 命中事件后在这里排队</div>
                }
                else
                {
                    <div class="blt-log" style="max-height:186px;margin-top:10px">
                        @foreach (var row in q)
                        {
                            <div class="blt-logrow">
                                <span class="tag @QueueTagClass(row)">@QueueTagText(row)</span>
                                <span class="txt">@(row.Guard ? "★ " : "")@row.Text</span>
                            </div>
                        }
                    </div>
                }

                @* 4) skip / clear *@
                <div style="display:flex;gap:8px;align-items:center;margin-top:12px;flex-wrap:wrap">
                    <button class="blt-btn" @onclick="SkipSpeech" disabled="@(!Speaker.Speaking)">⏭ 跳过本条</button>
                    <button class="blt-btn" @onclick="ClearSpeechQueue" disabled="@(Speaker.QueueCount == 0)"><BltIcon Emoji="🗑" />清空队列</button>
                </div>
                <div class="blt-hint">
                    「跳过本条」立刻停掉正在念的这条、接着念下一条；「清空队列」只丢弃排队中的，正在念的不受影响。上限 1~50，达到上限后新事件被忽略（舰长优先开启时舰长弹幕插队到第 2 位之后）。
                </div>

                @* 5) filters: blacklist UID + banned words (legacy 队列 / 过滤 panel) *@
                <label class="blt-label" style="margin-top:12px">黑名单 UID（blacklistUids）</label>
                <textarea class="blt-input mono" rows="2" placeholder="123456,789012"
                          title="这些 UID 的用户发的内容不朗读，逗号分隔（填数字 UID，不是昵称）"
                          @bind="_blacklistUids" @bind:event="oninput" @bind:after="SaveFiltersSoon"></textarea>
                <div class="blt-hint">逗号分隔，命中即不念</div>

                <label class="blt-label" style="margin-top:12px">屏蔽词（bannedWords）</label>
                <textarea class="blt-input mono" rows="2" placeholder="广告,主播名字"
                          title="包含这些关键词的弹幕不朗读，逗号分隔。可屏蔽广告、敏感词"
                          @bind="_bannedWords" @bind:event="oninput" @bind:after="SaveFiltersSoon"></textarea>
                <div class="blt-hint">弹幕含任一词则不念，逗号分隔</div>

                <div class="blt-hint">已配置 @_blacklistCount 个 UID · @_bannedCount 个屏蔽词 · @AutoSaveText()</div>
            </div>
        </div>

        <div class="blt-panel">
            <div class="blt-panel-head"><span class="t"><BltIcon Emoji="⚙" />其他参数</span><span class="en">READ ONLY</span>
                <span class="right"><span>由原版面板维护</span></span>
            </div>
            <div class="blt-panel-body">
                <div class="blt-kv"><span class="k">pitch · 音调基准</span><span class="v">@_pitch</span></div>
                <div class="blt-kv"><span class="k">gain · 增益</span><span class="v">@_gain</span></div>
                <div class="blt-kv"><span class="k">gap · 队列间隔 ms</span><span class="v">@_gap</span></div>
                <div class="blt-kv"><span class="k">favoriteVoices · 收藏音色</span><span class="v">@_favoriteCount 个</span></div>
                <div class="blt-kv"><span class="k">blacklistUids / bannedWords</span><span class="v">@_blacklistCount / @_bannedCount</span></div>
            </div>
        </div>
    </div>
</div>

@code {
    // ---- shared HTTP client (localhost config API) ----
    private static readonly HttpClient Http = new() { Timeout = TimeSpan.FromSeconds(30) };
    // MOSS synthesis needs longer than 30 s (first run loads the model); legacy used 90 s.
    private static readonly HttpClient MossHttp = new() { Timeout = TimeSpan.FromSeconds(90) };
    private string Base => "http://127.0.0.1:" + Config.Port;

    private JsonObject? _doc;
    private bool _busy;
    private readonly SemaphoreSlim _saveGate = new(1, 1);   // serializes POSTs (manual + auto-save)
    private string _status = "载入中…";

    // engine
    private string _engine = "edge";
    private bool _edgeRunning, _mossRunning, _guardPriority;
    private string _edgePath = "", _mossPath = "", _mossModelDir = "", _mossVoice = "Junhao";

    // moss engine installer (on-demand 44.5 MB exe; model stays lazy)
    private bool _mossInstalled;              // engineInstalled from MossStatus: exe present on disk

    // moss custom (cloned) voices — same list the legacy panel shows
    // (GET /api/tts/moss/voices · POST /api/tts/moss/voices/add · /voices/remove).
    private readonly List<CloneVoice> _cloneVoices = new();
    private bool _cloneLoading;               // GET /voices in flight
    private string _cloneName = "";           // new voice name (empty → reference file name, max 20 chars)
    private string _clonePath = "";           // reference audio full path, read by the local MOSS server
    private string _cloneMsg = "";            // card status line (list fetch errors)
    private string _clonePreviewId = "", _clonePreviewMsg = "", _clonePreviewUrl = "";

    // master
    private bool _enabled;
    private string _rateText = "1", _volumeText = "1";
    private string _pitch = "1", _gain = "0", _gap = "0", _queueMax = "8";
    private int _favoriteCount, _blacklistCount, _bannedCount;

    // filters (tts.blacklistUids / tts.bannedWords, comma separated)
    private string _blacklistUids = "", _bannedWords = "";

    // auto-save status line
    private DateTime? _savedAt;
    private string _saveMsg = "";

    // per-type switches
    private List<CatRow> _cats = new();

    // voices
    //   在线音色（edge）/ 系统音色（sys，本进程 WinRT 合成器）/ 本地音色（moss 内置 + 克隆）。
    //   下拉按当前引擎取清单，与原版 rebuildVoiceSelect / buildVoiceOptions / buildMossVoiceOptions 一致。
    private readonly List<VoiceItem> _voices = new();
    private readonly List<VoiceItem> _sysVoices = new();
    private readonly List<VoiceItem> _mossBuiltin = new();
    private readonly List<string> _favorites = new();   // tts.favoriteVoices (max 20, oldest dropped)
    private string _voice = "zh-CN-XiaoxiaoNeural";
    private string _voiceFilter = "";
    private string _previewMsg = "", _previewUrl = "";

    // tone
    private string _toneGlobal = "normal";
    private readonly List<TonePreset> _tonePresets = new();
    private readonly List<ToneRow> _toneByType = new();

    private System.Threading.Timer? _tick;

    private sealed class CatRow
    {
        public string Key = "";
        public string Label = "";
        public bool Enabled;
        public bool SayUid;          // tts.<type>.sayUid → 「念昵称」(never speaks the UID itself)
        public string Volume = "1";
    }

    private sealed record VoiceItem(string Name, string Label, string Group);

    /// <summary>One MOSS custom (cloned) voice from GET /api/tts/moss/voices → custom[].</summary>
    private sealed class CloneVoice
    {
        public string Id = "";
        public string Name = "";
    }

    private sealed record TonePreset(string Key, string Label, string Desc);

    /// <summary>Editable row of tts.tone.byType; Selected == "" means 「跟随全局」.</summary>
    private sealed class ToneRow
    {
        public string Key = "";
        public string Label = "";
        public string Selected = "";
    }

    // ---- Chinese display names for the common zh voices (same map as the legacy panel) ----
    private static readonly Dictionary<string, string> ZhVoices = new()
    {
        ["zh-CN-XiaoxiaoNeural"] = "小晓(女·普通话)",
        ["zh-CN-XiaoyiNeural"] = "晓伊(女·普通话)",
        ["zh-CN-YunxiNeural"] = "云希(男·普通话)",
        ["zh-CN-YunyangNeural"] = "云扬(男·普通话)",
        ["zh-CN-YunjianNeural"] = "云健(男·普通话)",
        ["zh-CN-YunxiaNeural"] = "云夏(男·普通话)",
        ["zh-CN-liaoning-XiaobeiNeural"] = "小北(女·辽宁)",
        ["zh-CN-shaanxi-XiaoniNeural"] = "小妮(女·陕西)",
        ["zh-HK-HiuGaaiNeural"] = "曉佳(女·粤语)",
        ["zh-HK-HiuMaanNeural"] = "曉曼(女·粤语)",
        ["zh-HK-WanLungNeural"] = "雲龍(男·粤语)",
        ["zh-TW-HsiaoChenNeural"] = "曉臻(女·台湾)",
        ["zh-TW-HsiaoYuNeural"] = "曉雨(女·台湾)",
        ["zh-TW-YunJheNeural"] = "雲哲(男·台湾)",
    };

    // ---- lifecycle ----

    protected override async Task OnInitializedAsync()
    {
        Speaker.Changed += OnSpeakerChanged;
        await LoadConfigAsync();
        await RefreshAll();
        // Keep the engine lamps fresh without hammering the API; a running→stopped (or back)
        // flip also refreshes the clone-voice list, which is only valid while the engine runs.
        _tick = new System.Threading.Timer(_ => _ = InvokeAsync(async () =>
        {
            var wasRunning = _mossRunning;
            RefreshEngineLocal();
            if (_engine == "moss" && _mossRunning != wasRunning) await FetchMossVoicesAsync();
            StateHasChanged();
        }), null, 10000, 10000);
    }

    private async Task RefreshAll()
    {
        RefreshEngineLocal();
        await FetchMossStatusAsync();
        await FetchMossVoicesAsync();
        await FetchEdgeVoicesAsync();
        await FetchSysVoicesAsync();
    }

    /// <summary>Queue changes come from the pipeline thread → marshal to the renderer.</summary>
    private void OnSpeakerChanged() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Speaker.Changed -= OnSpeakerChanged;
        _tick?.Dispose();
    }

    /// <summary>Download progress arrives from a background thread → marshal to the renderer.</summary>

    // ---- config load / save ----

    private async Task LoadConfigAsync()
    {
        string? json = null;
        try
        {
            using var resp = await Http.GetAsync(Base + "/api/config");
            if (resp.IsSuccessStatusCode) json = await resp.Content.ReadAsStringAsync();
            else _status = "配置接口 HTTP " + (int)resp.StatusCode + "，改用本地快照";
        }
        catch (Exception ex)
        {
            _status = "配置接口不可用（" + Short(ex.Message) + "），改用本地快照";
        }

        if (json == null)
        {
            try { json = Config.SnapshotJson(); } catch { /* keep the page alive */ }
        }

        try
        {
            _doc = json != null ? JsonNode.Parse(json) as JsonObject : null;
        }
        catch (Exception ex)
        {
            _doc = null;
            _status = "配置解析失败：" + Short(ex.Message);
        }
        ApplyFromDoc();
        if (_doc != null && _status.StartsWith("载入中")) _status = "配置已载入 · " + Stamp();
    }

    private void ApplyFromDoc()
    {
        var tts = _doc?["tts"] as JsonObject;
        _engine = NormalizeEngine(Str(tts, "engine", "edge"));
        _voice = Str(tts, "voice", "zh-CN-XiaoxiaoNeural");
        _mossVoice = Str(tts, "mossVoice", "Junhao");
        _enabled = Flag(tts, "enabled", false);
        _rateText = NumText(tts, "rate", 1);
        _volumeText = NumText(tts, "volume", 1);
        _pitch = NumText(tts, "pitch", 1);
        _gain = NumText(tts, "gain", 0);
        _gap = NumText(tts, "gap", 0);
        _queueMax = NumText(tts, "queueMax", 8);
        _guardPriority = Flag(tts, "guardPriority", false);
        _favorites.Clear();
        if (tts?["favoriteVoices"] is JsonArray favs)
            foreach (var n in favs)
                if (n is JsonValue fv && fv.TryGetValue<string>(out var fs)
                    && !string.IsNullOrEmpty(fs) && !_favorites.Contains(fs))
                    _favorites.Add(fs);
        _favoriteCount = _favorites.Count;
        _blacklistUids = Str(tts, "blacklistUids");
        _bannedWords = Str(tts, "bannedWords");
        _blacklistCount = SplitList(_blacklistUids).Count;
        _bannedCount = SplitList(_bannedWords).Count;

        _cats = BuildCats(tts);

        _toneGlobal = Str(tts?["tone"] as JsonObject, "global", "normal");
        if (_toneGlobal.Length == 0) _toneGlobal = "normal";
        LoadTonePresets(tts);
        LoadToneByType(tts?["tone"] as JsonObject);
    }

    private static List<CatRow> BuildCats(JsonObject? tts)
    {
        var defs = new (string Key, string Label)[]
        {
            ("danmu", "弹幕"),
            ("gift", "礼物"),
            ("superchat", "醒目留言"),
            ("welcome", "欢迎进房"),
        };
        var list = new List<CatRow>();
        foreach (var (key, label) in defs)
        {
            var sec = tts?[key] as JsonObject;
            list.Add(new CatRow
            {
                Key = key,
                Label = label,
                Enabled = Flag(sec, "enabled", false),
                SayUid = Flag(sec, "sayUid", false),
                Volume = NumText(sec, "volume", 1),
            });
        }
        return list;
    }

    private void LoadTonePresets(JsonObject? tts)
    {
        _tonePresets.Clear();
        if (tts?["tonePresets"] is not JsonObject presets) return;
        foreach (var (key, node) in presets)
        {
            var p = node as JsonObject;
            var label = Str(p, "label");
            _tonePresets.Add(new TonePreset(key, label.Length > 0 ? label : key, ToneDesc(p)));
        }
    }

    private void LoadToneByType(JsonObject? tone)
    {
        _toneByType.Clear();
        var byType = tone?["byType"] as JsonObject;
        foreach (var (key, label) in new[] { ("danmu", "弹幕"), ("gift", "礼物"), ("superchat", "醒目留言"), ("welcome", "欢迎进房") })
        {
            _toneByType.Add(new ToneRow { Key = key, Label = label, Selected = Str(byType, key) });
        }
    }

    /// <summary>Writes every UI field back into the in-memory document (unknown keys stay untouched).</summary>
    private void ApplyToDoc()
    {
        _doc ??= new JsonObject();
        if (_doc["tts"] is not JsonObject tts)
        {
            tts = new JsonObject();
            _doc["tts"] = tts;
        }
        tts["enabled"] = _enabled;
        tts["engine"] = _engine;
        tts["voice"] = _voice;
        tts["mossVoice"] = _mossVoice;   // 本地引擎音色：下拉选它时必须写回，否则一直是默认值
        tts["rate"] = ParseD(_rateText, 1);
        tts["volume"] = ParseD(_volumeText, 1);
        tts["blacklistUids"] = _blacklistUids;
        tts["bannedWords"] = _bannedWords;
        tts["queueMax"] = (long)ParseD(_queueMax, 8);
        tts["guardPriority"] = _guardPriority;
        _blacklistCount = SplitList(_blacklistUids).Count;
        _bannedCount = SplitList(_bannedWords).Count;

        var favArr = new JsonArray();
        foreach (var f in _favorites) favArr.Add(f);
        tts["favoriteVoices"] = favArr;

        foreach (var row in _cats)
        {
            if (tts[row.Key] is not JsonObject sec)
            {
                sec = new JsonObject();
                tts[row.Key] = sec;
            }
            sec["enabled"] = row.Enabled;
            sec["sayUid"] = row.SayUid;
            sec["volume"] = ParseD(row.Volume, 1);
        }

        if (tts["tone"] is not JsonObject tone)
        {
            tone = new JsonObject();
            tts["tone"] = tone;
        }
        tone["global"] = _toneGlobal;
        var byType = tone["byType"] as JsonObject ?? new JsonObject();
        foreach (var row in _toneByType) byType[row.Key] = row.Selected;   // "" = follow global
        tone["byType"] = byType;
    }

    /// <summary>Kept as the manual whole-document path (auto-save covers the page; no button calls it any more).</summary>
    private async Task SaveAll()
    {
        ApplyToDoc();
        await SaveAsync("语音配置已保存");
    }

    private async Task SaveEngine()
    {
        ApplyToDoc();
        await SaveAsync("引擎已保存（" + _engine + "）");
        // 下拉清单跟着引擎走：切到谁就把谁的清单拉一遍（原版 rebuildVoiceSelect 的语义）。
        if (_engine == "moss")
        {
            if (!_mossRunning) await MossActionAsync("ensure");
            await FetchMossVoicesAsync();
        }
        else if (_engine == "sys")
        {
            await FetchSysVoicesAsync();
        }
        else
        {
            await FetchEdgeVoicesAsync();
        }
    }

    private async Task SaveVoice()
    {
        ApplyToDoc();
        await SaveAsync("音色已保存（" + _voice + "）");
    }

    private async Task SaveMaster()
    {
        ApplyToDoc();
        await SaveAsync("总开关已保存（" + OnOffText(_enabled) + "）");
    }

    private async Task SaveCats()
    {
        ApplyToDoc();
        await SaveAsync("分类开关已保存");
    }

    private async Task SaveTone()
    {
        ApplyToDoc();
        await SaveAsync("语气已保存（" + _toneGlobal + "）");
    }

    private async Task SaveToneByType()
    {
        ApplyToDoc();
        await SaveAsync("按事件语气已保存");
    }

    private async Task SaveFilters()
    {
        ApplyToDoc();
        await SaveAsync("黑名单已保存（" + _blacklistCount + " UID / " + _bannedCount + " 词）");
    }

    // ---- auto-save (debounced) ----
    // Every control writes through the same document; the debounce only decides how
    // often POST /api/config is hit. Instant controls (select/switch/checkbox) get
    // 200 ms, text fields the 450 ms default.

    /// <summary>Debounced save; the delegate runs off the renderer thread, so marshal back and repaint.</summary>
    private void SaveSoon(string key, Func<Task> save, int delayMs = 450)
        => Saver.Run(key, () => InvokeAsync(async () => { await save(); StateHasChanged(); }), delayMs);

    private void SaveEngineSoon() => SaveSoon("tts-engine", SaveEngine, 200);

    private void SaveVoiceSoon() => SaveSoon("tts-voice", SaveVoice, 200);

    private void SaveMasterSoon() => SaveSoon("tts-master", SaveMaster);

    private void SaveCatsSoon() => SaveSoon("tts-cats", SaveCats, 200);

    private void SaveToneSoon() => SaveSoon("tts-tone", SaveTone, 200);

    private void SaveToneByTypeSoon() => SaveSoon("tts-tone-type", SaveToneByType, 200);

    private void SaveFiltersSoon() => SaveSoon("tts-filters", SaveFilters);

    // ---- favorite voices (tts.favoriteVoices, max 20) ----

    private async Task ToggleFavorite()
    {
        var name = VoiceSel;
        if (name.Length == 0) return;   // SaveAsync serializes with any in-flight auto-save
        if (_favorites.Contains(name))
        {
            _favorites.Remove(name);
        }
        else
        {
            _favorites.Add(name);
            while (_favorites.Count > 20) _favorites.RemoveAt(0);   // cap 20 → drop the oldest
        }
        ApplyToDoc();
        _favoriteCount = _favorites.Count;
        await SaveAsync("常用音色已更新（" + _favorites.Count + " / 20）");
    }

    private string FavoriteBtnText() => _favorites.Contains(VoiceSel) ? "★ 已收藏" : "☆ 收藏";

    /// <summary>收藏项可能来自任一引擎的清单（edge ShortName / moss 音色 id / 系统音色名）。</summary>
    private string FavoriteLabel(string name)
    {
        var hit = _voices.Concat(_sysVoices).Concat(_mossBuiltin).FirstOrDefault(v => v.Name == name);
        var label = hit != null && hit.Label.Length > 0 ? hit.Label : name;
        return name == VoiceSel ? label + "（当前）" : label;
    }

    // ---- speak queue ----

    private string SpeakerStateText() => Speaker.Speaking ? "正在念：" + Speaker.CurrentText : "空闲";

    // ---- queue controls (skip / clear / cap / guard priority) ----

    private void SkipSpeech() => Speaker.SkipCurrent();

    private void ClearSpeechQueue() => Speaker.ClearQueue();

    private void OnQueueMaxChanged(ChangeEventArgs e)
    {
        var raw = e.Value?.ToString() ?? "";
        if (!int.TryParse(raw, out var n)) n = 8;
        n = Math.Clamp(n, 1, 50);
        _queueMax = n.ToString();
        SaveSoon("tts-queue", SaveMaster);
    }

    private void ToggleGuardPriority()
    {
        _guardPriority = !_guardPriority;
        SaveSoon("tts-queue", SaveMaster);
    }

    private static string QueueTagText(TtsSpeaker.QueueItem r) => r.Type switch
    {
        "danmu" => "弹幕",
        "gift" => "礼物",
        "superchat" => "SC",
        "welcome" => "进房",
        _ => r.Type,
    };

    private static string QueueTagClass(TtsSpeaker.QueueItem r) => r.Type switch
    {
        "danmu" => "tag danmu",
        "gift" => "tag gifts",
        "superchat" => "tag superchat",
        "welcome" => "tag interact",
        _ => "tag info",
    };

    /// <summary>POSTs the whole document; falls back to a direct in-process write when the API is down.</summary>
    private async Task SaveAsync(string label)
    {
        // Auto-save can fire from several debounce keys at once → serialize instead of
        // dropping the write (a dropped write would silently lose the newest edit).
        await _saveGate.WaitAsync();
        _busy = true;
        try
        {
            var json = _doc!.ToJsonString();
            try
            {
                using var resp = await Http.PostAsync(Base + "/api/config",
                    new StringContent(json, Encoding.UTF8, "application/json"));
                var body = await resp.Content.ReadAsStringAsync();
                if (resp.IsSuccessStatusCode)
                {
                    _saveMsg = "";
                    _savedAt = DateTime.Now;
                    _status = label + " · " + Stamp();
                    return;
                }
                WriteLocal(label + " · HTTP " + (int)resp.StatusCode + ErrText(body));
            }
            catch (Exception ex)
            {
                WriteLocal(label + " · " + Short(ex.Message));
            }
        }
        finally
        {
            _busy = false;
            _saveGate.Release();
        }
    }

    private void WriteLocal(string why)
    {
        try
        {
            Config.UpdateFrom(_doc!);   // top-level merge + persist, same semantics as POST /api/config
            Pipeline.ApplyConfig();
            ApplyFromDoc();
            _saveMsg = "";
            _savedAt = DateTime.Now;
            _status = why + " → 已直写本地配置 · " + Stamp();
        }
        catch (Exception ex)
        {
            _saveMsg = Short(ex.Message);
            _status = "保存失败：" + Short(ex.Message);
        }
    }

    // ---- engine status / lifecycle ----

    private void RefreshEngineLocal()
    {
        try
        {
            var e = TtsEngine.EdgeStatus();
            _edgeRunning = PropBool(e, "running");
            var ep = PropStr(e, "execPath");
            if (ep.Length > 0) _edgePath = ep;
            var m = TtsEngine.MossStatus();
            _mossRunning = PropBool(m, "running");
            _mossInstalled = PropBool(m, "engineInstalled");
            var mp = PropStr(m, "execPath");
            if (mp.Length > 0) _mossPath = mp;
            var md = PropStr(m, "modelDir");
            if (md.Length > 0) _mossModelDir = md;
        }
        catch { /* status probe must never break rendering */ }
    }

    private async Task FetchMossStatusAsync()
    {
        try
        {
            using var resp = await Http.PostAsync(Base + "/api/maui/tts/moss/status",
                new StringContent("{}", Encoding.UTF8, "application/json"));
            var text = await resp.Content.ReadAsStringAsync();
            if (resp.IsSuccessStatusCode && JsonNode.Parse(text) is JsonObject o)
            {
                _mossRunning = Flag(o, "running", _mossRunning);
                _mossInstalled = Flag(o, "engineInstalled", _mossInstalled);
                var md = Str(o, "modelDir");
                if (md.Length > 0) _mossModelDir = md;
                return;
            }
        }
        catch { /* fall back to the in-process probe below */ }
        RefreshEngineLocal();
    }

    private async Task FetchEdgeVoicesAsync()
    {
        try
        {
            using var resp = await Http.GetAsync(Base + "/api/tts/edge/voices");
            var text = await resp.Content.ReadAsStringAsync();
            if (!resp.IsSuccessStatusCode)
            {
                if (_engine == "edge") _status = "edge 音色清单 HTTP " + (int)resp.StatusCode + ErrText(text);
                _edgeRunning = false;
                return;
            }
            if (JsonNode.Parse(text) is not JsonArray arr)
            {
                _status = "edge 音色清单格式异常";
                return;
            }
            _voices.Clear();
            foreach (var node in arr)
            {
                if (node is not JsonObject o) continue;
                var name = Str(o, "ShortName");
                if (name.Length == 0) name = Str(o, "shortName");
                if (name.Length == 0) name = Str(o, "Name");
                if (name.Length == 0) continue;
                var friendly = Str(o, "FriendlyName");
                var gender = Str(o, "Gender");
                var locale = Str(o, "Locale");
                if (locale.Length == 0) locale = Str(o, "locale");
                _voices.Add(new VoiceItem(name, VoiceLabel(name, friendly, gender), EdgeGroup(locale)));
            }
            // 语种分组由 GroupOrder 决定顺序（原版 order 数组），这里不再重排。
            if (_engine == "edge") _edgeRunning = true;
        }
        catch (Exception ex)
        {
            _edgeRunning = false;
            if (_engine == "edge") _status = "edge 音色清单读取失败：" + Short(ex.Message);
        }
    }

    private async Task MossActionAsync(string action)
    {
        await _saveGate.WaitAsync();
        _busy = true;
        _status = "MOSS " + action + " 请求中…";
        try
        {
            try
            {
                using var resp = await Http.PostAsync(Base + "/api/maui/tts/moss/" + action,
                    new StringContent("{}", Encoding.UTF8, "application/json"));
                var text = await resp.Content.ReadAsStringAsync();
                if (resp.IsSuccessStatusCode)
                {
                    if (JsonNode.Parse(text) is JsonObject o) _mossRunning = Flag(o, "running", _mossRunning);
                    _status = "MOSS " + action + " → " + RunText(_mossRunning) + " · " + Stamp();
                    return;
                }
                _status = "MOSS " + action + " HTTP " + (int)resp.StatusCode + ErrText(text);
            }
            catch
            {
                // server unreachable: drive the host directly
                object r = action switch
                {
                    "stop" => TtsEngine.StopMoss(),
                    "restart" => await TtsEngine.RestartMossAsync(),
                    _ => TtsEngine.EnsureMoss(),
                };
                _mossRunning = PropBool(r, "running");
                _status = "MOSS " + action + "（本地直调）→ " + RunText(_mossRunning) + " · " + Stamp();
            }
        }
        finally
        {
            _busy = false;
            _saveGate.Release();
            RefreshEngineLocal();
            await FetchMossVoicesAsync();   // list is valid while running, cleared when stopped
        }
    }

