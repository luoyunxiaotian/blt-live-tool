    /// <summary>Test-play one clone: POST /api/tts/moss/ with voiceId (same payload as legacy playMoss).</summary>
    private async Task PreviewClone(CloneVoice v)
    {
        _busy = true;
        _clonePreviewId = v.Id;
        _clonePreviewMsg = "合成中…";
        _clonePreviewUrl = "";
        StateHasChanged();
        try
        {
            var body = new JsonObject
            {
                ["text"] = "你好，这是当前音色的试听效果。",
                ["speed"] = 1,
                ["voiceId"] = v.Id,
            };
            using var resp = await MossHttp.PostAsync(Base + "/api/tts/moss/",
                new StringContent(body.ToJsonString(), Encoding.UTF8, "application/json"));
            if (!resp.IsSuccessStatusCode)
            {
                var err = await resp.Content.ReadAsStringAsync();
                _clonePreviewMsg = "合成失败 · HTTP " + (int)resp.StatusCode + ErrText(err);
                await UI.ToastAsync("试听失败：" + _clonePreviewMsg, false);
                return;
            }
            var bytes = await resp.Content.ReadAsByteArrayAsync();
            var mime = resp.Content.Headers.ContentType?.MediaType ?? "audio/wav";
            if (bytes.Length < 100)
            {
                _clonePreviewMsg = "合成失败 · 仅返回 " + bytes.Length + " 字节";
                return;
            }
            _clonePreviewMsg = "已合成 " + bytes.Length + " 字节（" + mime + "）";
            // Inline data URL keeps the preview playable without extra JS assets (same as edge preview).
            if (bytes.Length <= 2 * 1024 * 1024)
                _clonePreviewUrl = "data:" + mime + ";base64," + Convert.ToBase64String(bytes);
            else
                _clonePreviewMsg += " · 超过 2MB，未内联播放";
        }
        catch (Exception ex)
        {
            _clonePreviewMsg = "试听失败：" + Short(ex.Message);
            await UI.ToastAsync("试听失败：" + Short(ex.Message), false);
        }
        finally
        {
            _busy = false;
            StateHasChanged();
        }
    }

    /// <summary>Parses a JSON body that may be empty or non-JSON (null on failure).</summary>
    private static JsonObject? TryObject(string json)
    {
        try { return JsonNode.Parse(json) as JsonObject; }
        catch { return null; }
    }

    // ---- preview ----

    private async Task Preview()
    {
        var voice = VoiceSel;

        // 系统语音没有 bytes 端点：直接让本进程的系统语音读一句（走 NativeAudio）。
        if (_engine == "sys")
        {
            await _saveGate.WaitAsync();
            _busy = true;
            _previewMsg = "朗读中…";
            _previewUrl = "";
            try
            {
                var ok = await Audio.SpeakSystemAsync("这是一条试听", 1, 1, 1, voice);
                _previewMsg = ok
                    ? "已用系统语音朗读（音色：" + (voice.Length > 0 ? voice : "默认中文音色") + "）"
                    : "系统语音朗读失败：本机可能没有可用的语音包";
            }
            catch (Exception ex) { _previewMsg = "朗读失败：" + Short(ex.Message); }
            finally
            {
                _busy = false;
                _saveGate.Release();
            }
            return;
        }

        await _saveGate.WaitAsync();
        _busy = true;
        _previewMsg = "合成中…";
        _previewUrl = "";
        try
        {
            var engine = _engine == "moss" ? "moss" : "edge";
            var body = engine == "moss"
                ? new JsonObject { ["text"] = "这是一条试听", ["speed"] = 1, ["voice"] = voice }
                : new JsonObject { ["text"] = "这是一条试听", ["voice"] = voice };
            using var resp = await Http.PostAsync(Base + "/api/tts/" + engine + "/",
                new StringContent(body.ToJsonString(), Encoding.UTF8, "application/json"));
            if (!resp.IsSuccessStatusCode)
            {
                var err = await resp.Content.ReadAsStringAsync();
                _previewMsg = "合成失败 · HTTP " + (int)resp.StatusCode + ErrText(err);
                return;
            }
            var bytes = await resp.Content.ReadAsByteArrayAsync();
            var mime = resp.Content.Headers.ContentType?.MediaType ?? (engine == "moss" ? "audio/wav" : "audio/mpeg");
            if (bytes.Length < 100)
            {
                _previewMsg = "合成失败 · 仅返回 " + bytes.Length + " 字节";
                return;
            }
            _previewMsg = "已合成 " + bytes.Length + " 字节（" + mime + "）";
            // Inline data URL keeps the preview playable without extra JS assets.
            if (bytes.Length <= 2 * 1024 * 1024)
                _previewUrl = "data:" + mime + ";base64," + Convert.ToBase64String(bytes);
            else
                _previewMsg += " · 超过 2MB，未内联播放";
        }
        catch (Exception ex)
        {
            _previewMsg = "合成失败：" + Short(ex.Message);
        }
        finally
        {
            _busy = false;
            _saveGate.Release();
        }
    }

