    private string ItemCardStyle(int guardLevel = 0)
    {
        if (_cfg.DisplayMode == "flat")
        {
            return "display:flex;align-items:baseline;gap:8px;padding:3px 6px;word-break:break-all;";
        }
        var bg = HexToRgba(_cfg.BgColor, _cfg.BgOpacity);
        var bWidth = _cfg.ShowBorder ? _cfg.BorderWidth : 0;
        var bColor = HexToRgba(_cfg.BorderColor, _cfg.BorderOpacity);
        var pad = _cfg.CardPadding;

        if (_cfg.CustomGuardStyle && guardLevel > 0)
        {
            if (guardLevel == 1) // 总督
            {
                bg = HexToRgba(_cfg.GovernorBgColor, _cfg.GovernorBgOpacity);
                bColor = HexToRgba(_cfg.GovernorBorderColor, _cfg.GovernorBorderOpacity);
            }
            else if (guardLevel == 2) // 提督
            {
                bg = HexToRgba(_cfg.AdmiralBgColor, _cfg.AdmiralBgOpacity);
                bColor = HexToRgba(_cfg.AdmiralBorderColor, _cfg.AdmiralBorderOpacity);
