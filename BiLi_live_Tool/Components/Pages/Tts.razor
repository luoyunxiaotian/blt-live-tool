@page "/tts"
@using System.Globalization
@using System.Text
@using System.Text.Json
@using System.Text.Json.Nodes
@inject AppConfig Config
@inject TtsHost TtsEngine
@inject LivePipeline Pipeline
@inject TtsSpeaker Speaker
@implements IDisposable
@* TTS page: engine panel, master switch, per-type switches, tone presets and voice preview.
   Config is read from GET /api/config and written back as the whole document via POST /api/config
   (server merges top-level keys and persists); a direct in-process write is the offline fallback. *@

<div class="blt-pagehead">
    <h1>语音念弹幕</h1><span class="en">TTS</span>
    <span style="margin-left:auto;display:flex;align-items:center;gap:12px">
        <span style="font-family:var(--mono);font-size:11px;color:var(--amber)">@_status</span>
        <button class="blt-btn primary" @onclick="SaveAll" disabled="@_busy">保存全部</button>
    </span>
</div>

<div class="blt-topstrip">
    <span class="seg">config <b class="@ConfigClass()">@ConfigText()</b></span>
    <span class="seg">api <b>127.0.0.1:@Config.Port</b></span>
    <span class="seg">engine <b class="amber">@_engine</b></span>
    <span class="seg">引擎状态 <b class="@EngineClass()">@EngineText()</b></span>
    <span class="seg">edge 音色 <b>@_voices.Count</b></span>
    <span class="seg">总开关 <b class="@OnOff(_enabled)">@OnOffText(_enabled)</b></span>
</div>

<div class="blt-grid blt-cols-2">
    @* ── 左列：引擎 / 音色 / 语气 ── *@
    <div>
        <div class="blt-panel">
            <div class="blt-panel-head"><span class="t">🎛 语音引擎</span><span class="en">ENGINE</span>
                <span class="right"><span>tts.engine</span><b class="amber">@_engine</b></span>
            </div>
            <div class="blt-panel-body">
                <label class="blt-label">engine · 引擎选择</label>
                <div style="display:flex;gap:10px">
                    <select class="blt-input" style="flex:1;cursor:pointer" @bind="_engine">
                        <option value="edge">edge · 在线语音（edge-tts，322 音色）</option>
                        <option value="moss">moss · 本地离线引擎（端口 8021）</option>
                        <option value="sys">sys · 系统语音兜底</option>
                    </select>
                    <button class="blt-btn" @onclick="RefreshAll">刷新状态</button>
                </div>

                <div style="margin-top:12px">
                    @if (_engine == "edge")
                    {
                        <div class="blt-kv"><span class="k">edge 服务 :8020</span><span class="v @OnOff(_edgeRunning)">@RunText(_edgeRunning)</span></div>
                        <div class="blt-kv"><span class="k">在线音色清单</span><span class="v @OnOff(_voices.Count > 0)">@VoiceStateText()</span></div>
                        <div class="blt-kv"><span class="k">引擎程序</span><span class="v" style="font-size:11px;word-break:break-all">@PathText(_edgePath)</span></div>
                    }
                    else if (_engine == "moss")
                    {
                        <div class="blt-kv"><span class="k">moss 服务 :8021</span><span class="v @OnOff(_mossRunning)">@RunText(_mossRunning)</span></div>
                        <div class="blt-kv"><span class="k">模型目录</span><span class="v" style="font-size:11px;word-break:break-all">@PathText(_mossModelDir)</span></div>
                        <div class="blt-kv"><span class="k">本地音色（mossVoice）</span><span class="v amber">@_mossVoice</span></div>
                    }
                    else
                    {
                        <div class="blt-kv"><span class="k">系统语音</span><span class="v amber">免服务 · 本机语音合成</span></div>
                        <div class="blt-kv"><span class="k">回退顺序</span><span class="v" style="font-size:11px">edge → moss → sys</span></div>
                    }
                </div>

                <div style="display:flex;gap:8px;margin-top:12px;flex-wrap:wrap">
                    @if (_engine == "moss")
                    {
                        <button class="blt-btn" @onclick="StartMoss" disabled="@_busy">启动</button>
                        <button class="blt-btn" @onclick="StopMoss" disabled="@_busy">停止</button>
                        <button class="blt-btn" @onclick="RestartMoss" disabled="@_busy">重启</button>
                    }
                    <button class="blt-btn primary" @onclick="SaveEngine" disabled="@_busy">保存引擎</button>
                </div>
                @if (_engine == "sys")
                {
                    <div style="font-family:var(--mono);font-size:10.5px;color:var(--ink-3);margin-top:8px">
                        sys 引擎不依赖本地服务；edge 未运行时自动回退到系统语音
                    </div>
                }
            </div>
        </div>

        <div class="blt-panel">
            <div class="blt-panel-head"><span class="t">🗣 音色与试听</span><span class="en">VOICE</span>
                <span class="right"><span>tts.voice</span><b class="amber">@_voice</b></span>
            </div>
            <div class="blt-panel-body">
                @if (_engine != "edge")
                {
                    <div style="font-family:var(--mono);font-size:10.5px;color:var(--amber);margin-bottom:8px">
                        当前引擎为 @_engine：下方列表来自 edge 引擎，保存后写入 tts.voice（moss 另用 mossVoice）
                    </div>
                }
                <label class="blt-label">搜索音色（ShortName / 名称）</label>
                <input class="blt-input mono" placeholder="如 zh-CN / xiaoxiao / 女声" @bind="_voiceFilter" @bind:event="oninput" />

                <div style="margin-top:10px">
                    <label class="blt-label">edge 音色（前 50 条 / 共 @_voices.Count 条 · 常用 @_favorites.Count / 20）</label>
                    <select class="blt-input mono" style="cursor:pointer" @bind="_voice">
                        @if (_favorites.Count > 0)
                        {
                            <optgroup label="⭐ 常用音色">
                                @foreach (var f in _favorites)
                                {
                                    <option value="@f">@FavoriteLabel(f)</option>
                                }
                            </optgroup>
                        }
                        @foreach (var v in ShownVoices())
                        {
                            <option value="@v.Name">@v.Label</option>
                        }
                    </select>
                </div>

                <div style="display:flex;gap:8px;align-items:center;margin-top:10px;flex-wrap:wrap">
                    <button class="blt-btn" @onclick="ToggleFavorite" disabled="@_busy">@FavoriteBtnText()</button>
                    <button class="blt-btn" @onclick="Preview" disabled="@_busy">试听</button>
                    <button class="blt-btn primary" @onclick="SaveVoice" disabled="@_busy">保存音色</button>
                    <span style="font-family:var(--mono);font-size:11px;color:var(--ink-2)">@_previewMsg</span>
                </div>
                @if (_previewUrl.Length > 0)
                {
                    <audio controls src="@_previewUrl" style="width:100%;margin-top:10px"></audio>
                }
                <div style="font-family:var(--mono);font-size:10.5px;color:var(--ink-3);margin-top:8px">
                    试听走 POST /api/tts/edge/（text + voice）· 返回 audio/mpeg 字节
                </div>
            </div>
        </div>

        <div class="blt-panel">
            <div class="blt-panel-head"><span class="t">🎚 语气预设</span><span class="en">TONE</span>
                <span class="right"><span>tone.global</span><b class="amber">@_toneGlobal</b></span>
            </div>
            <div class="blt-panel-body">
                <label class="blt-label">全局语气（tone.global）</label>
                <div style="display:flex;gap:10px">
                    <select class="blt-input" style="flex:1;cursor:pointer" @bind="_toneGlobal">
                        <option value="">— 默认（normal）—</option>
                        @foreach (var t in _tonePresets)
                        {
                            <option value="@t.Key">@t.Label</option>
                        }
                    </select>
                    <button class="blt-btn primary" @onclick="SaveTone" disabled="@_busy">保存语气</button>
                </div>

                <div style="margin-top:12px">
                    @if (_tonePresets.Count == 0)
                    {
                        <div class="blt-empty">配置中未找到 tonePresets</div>
                    }
                    else
                    {
                        @foreach (var t in _tonePresets)
                        {
                            <div class="blt-kv">
                                <span class="k">@t.Label <span style="font-family:var(--mono);color:var(--ink-3);font-size:10px">@t.Key</span></span>
                                <span class="v" style="font-size:11px">@t.Desc</span>
                            </div>
                        }
                    }
                </div>

            </div>
        </div>

        <div class="blt-panel">
            <div class="blt-panel-head"><span class="t">🎭 按事件语气</span><span class="en">TONE BY TYPE</span>
                <span class="right"><span>tone.byType</span></span>
            </div>
            <div class="blt-panel-body">
                <label class="blt-label">各事件类型专属语气 · 「跟随全局」= 空值</label>
                @if (_tonePresets.Count == 0)
                {
                    <div class="blt-empty">配置中未找到 tonePresets · 仅能跟随全局</div>
                }
                @foreach (var row in _toneByType)
                {
                    <div style="display:flex;align-items:center;gap:10px;padding:5px 0">
                        <span style="width:88px;flex:none;color:var(--ink-2)">@row.Label</span>
                        <select class="blt-input" style="flex:1;cursor:pointer" @bind="row.Selected">
                            <option value="">跟随全局</option>
                            @foreach (var t in _tonePresets)
                            {
                                <option value="@t.Key">@t.Label</option>
                            }
                        </select>
                    </div>
                }
                <div style="display:flex;gap:8px;margin-top:12px">
                    <button class="blt-btn primary" @onclick="SaveToneByType" disabled="@_busy">保存分类语气</button>
                    <span style="font-family:var(--mono);font-size:10.5px;color:var(--ink-3);align-self:center">下次播报即生效</span>
                </div>
            </div>
        </div>
    </div>

    @* ── 右列：播报队列 / 总开关 / 分类开关 / 只读参数 ── *@
    <div>
        <div class="blt-panel">
            <div class="blt-panel-head"><span class="t">📢 播报队列</span><span class="en">SPEAK QUEUE</span>
                <span class="right"><span>待念 @Speaker.QueueCount · 上限 @_queueMax</span></span>
            </div>
            <div class="blt-panel-body">
                <div class="blt-kv">
                    <span class="k">待念条数</span>
                    <span class="v @(Speaker.QueueCount > 0 ? "amber" : "")">@Speaker.QueueCount 条</span>
                </div>
                <div class="blt-kv">
                    <span class="k">当前状态</span>
                    <span class="v @(Speaker.Speaking ? "green" : "")">@SpeakerStateText()</span>
                </div>
                <div style="font-family:var(--mono);font-size:10.5px;color:var(--ink-3);margin-top:8px">
                    播报链路已在新版内建，无需打开旧面板：命中的事件直接进入队列，按「队列上限 / 舰长优先 / 队列间隔」依次念出。
                </div>
            </div>
        </div>

        <div class="blt-panel">
            <div class="blt-panel-head"><span class="t">🔊 总开关与语速</span><span class="en">MASTER</span>
                <span class="right"><span>enabled / rate / volume</span></span>
            </div>
            <div class="blt-panel-body">
                <span class="@SwitchClass(_enabled)" @onclick="ToggleEnabled"><span class="track"></span>语音念弹幕 <span style="color:var(--ink-3)">总开关（tts.enabled）</span></span>

                <div style="display:flex;gap:14px;margin-top:16px;flex-wrap:wrap">
                    <div style="flex:1;min-width:110px">
                        <label class="blt-label">rate · 语速</label>
                        <input class="blt-input mono" type="number" step="0.05" min="0.5" max="2.5" @bind="_rateText" />
                    </div>
                    <div style="flex:1;min-width:110px">
                        <label class="blt-label">volume · 音量</label>
                        <input class="blt-input mono" type="number" step="0.05" min="0" max="1" @bind="_volumeText" />
                    </div>
                </div>
                <div style="font-family:var(--mono);font-size:10.5px;color:var(--ink-3);margin-top:8px">
                    rate 0.5–2.5（1 = 原速）· volume 0–1
                </div>

                <div style="display:flex;gap:8px;margin-top:14px">
                    <button class="blt-btn primary" @onclick="SaveMaster" disabled="@_busy">保存总开关</button>
                </div>
            </div>
        </div>

        <div class="blt-panel">
            <div class="blt-panel-head"><span class="t">🧩 分类开关</span><span class="en">BY TYPE</span>
                <span class="right"><span>enabled + volume</span></span>
            </div>
            <div class="blt-panel-body">
                @foreach (var row in _cats)
                {
                    <div style="display:flex;align-items:center;gap:12px;padding:8px 0;border-bottom:1px dashed var(--line)">
                        <span class="@SwitchClass(row.Enabled)" @onclick="() => ToggleCat(row)"><span class="track"></span>@row.Label</span>
                        <span style="font-family:var(--mono);font-size:10px;color:var(--ink-3)">tts.@row.Key</span>
                        <span style="margin-left:auto;display:flex;align-items:center;gap:6px">
                            <span style="font-size:10.5px;color:var(--ink-3)">音量</span>
                            <input class="blt-input mono" style="width:84px" type="number" step="0.05" min="0" max="1" @bind="row.Volume" />
                        </span>
                    </div>
                }
                @if (_cats.Count == 0)
                {
                    <div class="blt-empty">配置读取失败，分类开关不可用</div>
                }
                <div style="display:flex;gap:8px;margin-top:14px">
                    <button class="blt-btn primary" @onclick="SaveCats" disabled="@_busy">保存分类设置</button>
                </div>
            </div>
        </div>

        <div class="blt-panel">
            <div class="blt-panel-head"><span class="t">⚙ 其他参数</span><span class="en">READ ONLY</span>
                <span class="right"><span>由原版面板维护</span></span>
            </div>
            <div class="blt-panel-body">
                <div class="blt-kv"><span class="k">pitch · 音调基准</span><span class="v">@_pitch</span></div>
                <div class="blt-kv"><span class="k">gain · 增益</span><span class="v">@_gain</span></div>
                <div class="blt-kv"><span class="k">gap · 队列间隔 ms</span><span class="v">@_gap</span></div>
                <div class="blt-kv"><span class="k">queueMax · 队列上限</span><span class="v">@_queueMax</span></div>
                <div class="blt-kv"><span class="k">guardPriority · 舰长优先</span><span class="v @OnOff(_guardPriority)">@OnOffText(_guardPriority)</span></div>
                <div class="blt-kv"><span class="k">favoriteVoices · 收藏音色</span><span class="v">@_favoriteCount 个</span></div>
                <div class="blt-kv"><span class="k">blacklistUids / bannedWords</span><span class="v">@_blacklistCount / @_bannedCount</span></div>
            </div>
        </div>
    </div>
</div>

@code {
    // ---- shared HTTP client (localhost config API) ----
    private static readonly HttpClient Http = new() { Timeout = TimeSpan.FromSeconds(30) };
    private string Base => "http://127.0.0.1:" + Config.Port;

    private JsonObject? _doc;
    private bool _busy;
    private string _status = "载入中…";

    // engine
    private string _engine = "edge";
    private bool _edgeRunning, _mossRunning, _guardPriority;
    private string _edgePath = "", _mossModelDir = "", _mossVoice = "Junhao";

    // master
    private bool _enabled;
    private string _rateText = "1", _volumeText = "1";
    private string _pitch = "1", _gain = "0", _gap = "0", _queueMax = "8";
    private int _favoriteCount, _blacklistCount, _bannedCount;

    // per-type switches
    private List<CatRow> _cats = new();

    // voices
    private readonly List<VoiceItem> _voices = new();
    private readonly List<string> _favorites = new();   // tts.favoriteVoices (max 20, oldest dropped)
    private string _voice = "zh-CN-XiaoxiaoNeural";
    private string _voiceFilter = "";
    private string _previewMsg = "", _previewUrl = "";

    // tone
    private string _toneGlobal = "normal";
    private readonly List<TonePreset> _tonePresets = new();
    private readonly List<ToneRow> _toneByType = new();

    private System.Threading.Timer? _tick;

    private sealed class CatRow
    {
        public string Key = "";
        public string Label = "";
        public bool Enabled;
        public string Volume = "1";
    }

    private sealed record VoiceItem(string Name, string Label, bool Zh);

    private sealed record TonePreset(string Key, string Label, string Desc);

    /// <summary>Editable row of tts.tone.byType; Selected == "" means 「跟随全局」.</summary>
    private sealed class ToneRow
    {
        public string Key = "";
        public string Label = "";
        public string Selected = "";
    }

    // ---- Chinese display names for the common zh voices (same map as the legacy panel) ----
    private static readonly Dictionary<string, string> ZhVoices = new()
    {
        ["zh-CN-XiaoxiaoNeural"] = "小晓(女·普通话)",
        ["zh-CN-XiaoyiNeural"] = "晓伊(女·普通话)",
        ["zh-CN-YunxiNeural"] = "云希(男·普通话)",
        ["zh-CN-YunyangNeural"] = "云扬(男·普通话)",
        ["zh-CN-YunjianNeural"] = "云健(男·普通话)",
        ["zh-CN-YunxiaNeural"] = "云夏(男·普通话)",
        ["zh-CN-liaoning-XiaobeiNeural"] = "小北(女·辽宁)",
        ["zh-CN-shaanxi-XiaoniNeural"] = "小妮(女·陕西)",
        ["zh-HK-HiuGaaiNeural"] = "曉佳(女·粤语)",
        ["zh-HK-HiuMaanNeural"] = "曉曼(女·粤语)",
        ["zh-HK-WanLungNeural"] = "雲龍(男·粤语)",
        ["zh-TW-HsiaoChenNeural"] = "曉臻(女·台湾)",
        ["zh-TW-HsiaoYuNeural"] = "曉雨(女·台湾)",
        ["zh-TW-YunJheNeural"] = "雲哲(男·台湾)",
    };

    // ---- lifecycle ----

    protected override async Task OnInitializedAsync()
    {
        Speaker.Changed += OnSpeakerChanged;
        await LoadConfigAsync();
        await RefreshAll();
        // Keep the engine lamps fresh without hammering the API.
        _tick = new System.Threading.Timer(_ => _ = InvokeAsync(() => { RefreshEngineLocal(); StateHasChanged(); }), null, 10000, 10000);
    }

    private async Task RefreshAll()
    {
        RefreshEngineLocal();
        await FetchMossStatusAsync();
        await FetchEdgeVoicesAsync();
    }

    /// <summary>Queue changes come from the pipeline thread → marshal to the renderer.</summary>
    private void OnSpeakerChanged() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Speaker.Changed -= OnSpeakerChanged;
        _tick?.Dispose();
    }

    // ---- config load / save ----

    private async Task LoadConfigAsync()
    {
        string? json = null;
        try
        {
            using var resp = await Http.GetAsync(Base + "/api/config");
            if (resp.IsSuccessStatusCode) json = await resp.Content.ReadAsStringAsync();
            else _status = "配置接口 HTTP " + (int)resp.StatusCode + "，改用本地快照";
        }
        catch (Exception ex)
        {
            _status = "配置接口不可用（" + Short(ex.Message) + "），改用本地快照";
        }

        if (json == null)
        {
            try { json = Config.SnapshotJson(); } catch { /* keep the page alive */ }
        }

        try
        {
            _doc = json != null ? JsonNode.Parse(json) as JsonObject : null;
        }
        catch (Exception ex)
        {
            _doc = null;
            _status = "配置解析失败：" + Short(ex.Message);
        }
        ApplyFromDoc();
        if (_doc != null && _status.StartsWith("载入中")) _status = "配置已载入 · " + Stamp();
    }

    private void ApplyFromDoc()
    {
        var tts = _doc?["tts"] as JsonObject;
        _engine = NormalizeEngine(Str(tts, "engine", "edge"));
        _voice = Str(tts, "voice", "zh-CN-XiaoxiaoNeural");
        _mossVoice = Str(tts, "mossVoice", "Junhao");
        _enabled = Flag(tts, "enabled", false);
        _rateText = NumText(tts, "rate", 1);
        _volumeText = NumText(tts, "volume", 1);
        _pitch = NumText(tts, "pitch", 1);
        _gain = NumText(tts, "gain", 0);
        _gap = NumText(tts, "gap", 0);
        _queueMax = NumText(tts, "queueMax", 8);
        _guardPriority = Flag(tts, "guardPriority", false);
        _favorites.Clear();
        if (tts?["favoriteVoices"] is JsonArray favs)
            foreach (var n in favs)
                if (n is JsonValue fv && fv.TryGetValue<string>(out var fs)
                    && !string.IsNullOrEmpty(fs) && !_favorites.Contains(fs))
                    _favorites.Add(fs);
        _favoriteCount = _favorites.Count;
        _blacklistCount = SplitList(Str(tts, "blacklistUids")).Count;
        _bannedCount = SplitList(Str(tts, "bannedWords")).Count;

        _cats = BuildCats(tts);

        _toneGlobal = Str(tts?["tone"] as JsonObject, "global", "normal");
        if (_toneGlobal.Length == 0) _toneGlobal = "normal";
        LoadTonePresets(tts);
        LoadToneByType(tts?["tone"] as JsonObject);
    }

    private static List<CatRow> BuildCats(JsonObject? tts)
    {
        var defs = new (string Key, string Label)[]
        {
            ("danmu", "弹幕"),
            ("gift", "礼物"),
            ("superchat", "醒目留言"),
            ("welcome", "欢迎进房"),
        };
        var list = new List<CatRow>();
        foreach (var (key, label) in defs)
        {
            var sec = tts?[key] as JsonObject;
            list.Add(new CatRow
            {
                Key = key,
                Label = label,
                Enabled = Flag(sec, "enabled", false),
                Volume = NumText(sec, "volume", 1),
            });
        }
        return list;
    }

    private void LoadTonePresets(JsonObject? tts)
    {
        _tonePresets.Clear();
        if (tts?["tonePresets"] is not JsonObject presets) return;
        foreach (var (key, node) in presets)
        {
            var p = node as JsonObject;
            var label = Str(p, "label");
            _tonePresets.Add(new TonePreset(key, label.Length > 0 ? label : key, ToneDesc(p)));
        }
    }

    private void LoadToneByType(JsonObject? tone)
    {
        _toneByType.Clear();
        var byType = tone?["byType"] as JsonObject;
        foreach (var (key, label) in new[] { ("danmu", "弹幕"), ("gift", "礼物"), ("superchat", "醒目留言"), ("welcome", "欢迎进房") })
        {
            _toneByType.Add(new ToneRow { Key = key, Label = label, Selected = Str(byType, key) });
        }
    }

    /// <summary>Writes every UI field back into the in-memory document (unknown keys stay untouched).</summary>
    private void ApplyToDoc()
    {
        _doc ??= new JsonObject();
        if (_doc["tts"] is not JsonObject tts)
        {
            tts = new JsonObject();
            _doc["tts"] = tts;
        }
        tts["enabled"] = _enabled;
        tts["engine"] = _engine;
        tts["voice"] = _voice;
        tts["rate"] = ParseD(_rateText, 1);
        tts["volume"] = ParseD(_volumeText, 1);

        var favArr = new JsonArray();
        foreach (var f in _favorites) favArr.Add(f);
        tts["favoriteVoices"] = favArr;

        foreach (var row in _cats)
        {
            if (tts[row.Key] is not JsonObject sec)
            {
                sec = new JsonObject();
                tts[row.Key] = sec;
            }
            sec["enabled"] = row.Enabled;
            sec["volume"] = ParseD(row.Volume, 1);
        }

        if (tts["tone"] is not JsonObject tone)
        {
            tone = new JsonObject();
            tts["tone"] = tone;
        }
        tone["global"] = _toneGlobal;
        var byType = tone["byType"] as JsonObject ?? new JsonObject();
        foreach (var row in _toneByType) byType[row.Key] = row.Selected;   // "" = follow global
        tone["byType"] = byType;
    }

