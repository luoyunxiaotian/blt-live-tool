    private string DanmuTextStyle(int guardLevel = 0)
    {
        var fs = _cfg.BaseFontSize > 0 ? _cfg.BaseFontSize : _cfg.DanmuSize;

        // 1. 若为 Laplace 模版：真实呈现各个模板的气泡与文字样式
        if (_cfg.ThemeType == "laplace")
        {
            var t = _cfg.LaplaceTemplate ?? "laplace-nailv";
            if (t == "laplace-nailv" || t == "laplace-nailv-next")
            {
                var bg = guardLevel switch { 1 => "rgb(253, 213, 186)", 2 => "rgb(233, 204, 240)", 3 => "rgb(200, 221, 252)", _ => "#f1fbf5" };
                var fg = guardLevel switch { 1 => "rgb(61, 24, 23)", 2 => "rgb(74, 29, 95)", 3 => "rgb(26, 24, 85)", _ => "#213d2b" };
                return $"background-color:{bg};color:{fg};padding:6px 14px;border-radius:18px;font-size:{fs}px;font-weight:bold;width:fit-content;display:inline-block;box-shadow:0 0 1px {fg};line-height:1.4;";
            }
            if (t == "rhea-purple")
            {
                var bg = guardLevel == 3 ? "rgb(200, 221, 252)" : "rgb(244, 222, 232)";
                var fg = guardLevel == 3 ? "rgb(26, 24, 85)" : "rgb(110, 62, 87)";
                return $"background-color:{bg};color:{fg};padding:6px 14px;border-radius:18px;font-size:{fs}px;font-weight:bold;width:fit-content;display:inline-block;line-height:1.4;";
            }
            if (t == "sui-outline")
            {
                return $"background:transparent;color:#ffffff;font-size:{fs}px;font-weight:800;text-shadow:-2px -2px 0 #000, 2px -2px 0 #000, -2px 2px 0 #000, 2px 2px 0 #000, 0 1px 2px #000;display:inline-block;line-height:1.4;";
            }
            if (t == "nana7mi-simple")
            {
                return $"background-color:#e1f5fe;color:#0277bd;padding:6px 14px;border-radius:16px;font-size:{fs}px;font-weight:600;width:fit-content;display:inline-block;line-height:1.4;";
            }
            if (t == "miki-modern")
            {
                return $"background-color:#212121;color:#ffffff;padding:6px 12px;border-radius:8px;border-left:4px solid #ff4081;font-size:{fs}px;font-weight:600;width:fit-content;display:inline-block;line-height:1.4;";
            }
            if (t == "collab-dialog")
            {
                return $"background-color:#e8f5e9;color:#2e7d32;padding:6px 14px;border-radius:16px;font-size:{fs}px;font-weight:600;width:fit-content;display:inline-block;line-height:1.4;";
            }
            if (t == "orange-bubble")
            {
                return $"background-color:#fff3e0;color:#e65100;padding:6px 14px;border-radius:18px;font-size:{fs}px;font-weight:700;width:fit-content;display:inline-block;box-shadow:0 2px 8px rgba(255,152,0,0.25);line-height:1.4;";
            }
            if (t == "shed-bubble")
            {
                return $"background-color:#f3e5f5;color:#4a148c;padding:6px 14px;border-radius:18px;font-size:{fs}px;font-weight:700;width:fit-content;display:inline-block;line-height:1.4;";
            }
            if (t == "shed-wave")
            {
                return $"background:rgba(255,255,255,0.18);color:#80d8ff;padding:6px 14px;border-radius:14px;backdrop-filter:blur(8px);border:1px solid rgba(128,216,255,0.4);font-size:{fs}px;font-weight:600;width:fit-content;display:inline-block;line-height:1.4;";
            }
            if (t == "orange-block")
            {
                return $"color:#ffffff;font-size:{fs}px;font-weight:700;line-height:1.4;";
            }
            if (t == "zelda-fantasy")
            {
                return $"color:#ffeb3b;font-size:{fs}px;font-weight:600;line-height:1.4;";
            }
            if (t == "reversed-fun")
            {
                return $"background-color:#f1fbf5;color:#213d2b;padding:6px 14px;border-radius:18px;font-size:{fs}px;font-weight:bold;width:fit-content;display:inline-block;transform:rotate(180deg);line-height:1.4;";
            }
            return $"background-color:#f1fbf5;color:#213d2b;padding:6px 14px;border-radius:18px;font-size:{fs}px;font-weight:bold;width:fit-content;display:inline-block;line-height:1.4;";
        }

        // 2. 自研经典 28 款皮肤的文字渲染
        var font = _cfg.DanmuFont == "system-ui" ? "system-ui, -apple-system, sans-serif" : _cfg.DanmuFont;
        var color = HexToRgba(_cfg.DanmuColor, _cfg.DanmuOpacity);
        var shadow = StrokeToShadow(_cfg.DanmuStroke);
        var weight = IsGamingSlateTheme ? "700" : "normal";
        return $"font-family:{font};color:{color};font-size:{_cfg.DanmuSize}px;font-weight:{weight};line-height:{_cfg.DanmuLineHeight};text-shadow:{shadow};word-break:break-all;";
    }
    private static string StrokeToShadow(string stroke) => stroke switch
    {
        "shadow" => "0 1px 3px rgba(0,0,0,0.85)",
        "heavy-shadow" => "0 2px 8px rgba(0,0,0,0.95), 0 0 2px rgba(0,0,0,0.8)",
        "outline" => "-1px -1px 0 #000, 1px -1px 0 #000, -1px 1px 0 #000, 1px 1px 0 #000",
        _ => "none"
    };

    private static string HexToRgba(string? hex, int opacityPercent)
    {
        if (string.IsNullOrEmpty(hex)) return "rgba(0,0,0,1)";
        var h = hex.TrimStart('#');
        if (h.Length == 3) h = $"{h[0]}{h[0]}{h[1]}{h[1]}{h[2]}{h[2]}";
        if (h.Length != 6) return hex;
        try
        {
            var r = Convert.ToInt32(h[..2], 16);
            var g = Convert.ToInt32(h.Substring(2, 2), 16);
            var b = Convert.ToInt32(h.Substring(4, 2), 16);
            var a = Math.Clamp(opacityPercent / 100.0, 0.0, 1.0);
            return $"rgba({r},{g},{b},{a:0.##})";
        }
        catch { return hex; }
    }

