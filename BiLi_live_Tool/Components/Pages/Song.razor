    private List<SearchRowVm> _searchRows = new();
    private List<RecentRowVm> _recentRows = new();

    private int _currentIndex = -1;

    // ---------- settings form (seconds/minutes for display, ms in config) ----------
    private bool _enabled;
    private string _platform = "qq";
    private string _keyword = "点歌";
    private string _cooldownSec = "10";
    private string _userCooldownSec = "60";
    private string _fanMedalMin = "0";
    private string _honorLevelMin = "0";
    private bool _guardOnly;
    private string _maxDaily = "0";
    private bool _dedupEnabled = true;
    private string _dedupMin = "5";

    // ---------- 平台登录（应用内登录 → 自动抓 Cookie） ----------
    private string _musicLoginMsg = "";
    private bool _musicLoginBusy;

    /// <summary>OBS 歌词浮层地址（原版 lyrics/overlay.html 的等价路径）。</summary>
    /// <summary>OBS 歌词浮层地址：必须带真实端口（Nav.BaseUri 在 Blazor Hybrid 下是 http://localhost/，没有端口）。</summary>
    private string OverlayUrl => "http://127.0.0.1:" + Api.Port + "/lyrics/overlay.html";

    /// <summary>应用内登录：打开平台登录窗 → 轮询捕获结果 → 成功后回填并保存 Cookie。</summary>
    private async Task LoginPlatform(string platform)
    {
        _musicLoginBusy = true;
        _musicLoginMsg = "正在打开 " + PlatName(platform) + " 登录窗口…";
        StateHasChanged();
        try
        {
            await PostJson("/api/maui/music/login", new JsonObject { ["platform"] = platform });
            _musicLoginMsg = "已打开登录窗口：请在其中扫码/登录，" + PlatName(platform) + " 的 Cookie 会自动回填（最多等 2 分钟）";
            StateHasChanged();
            for (var i = 0; i < 60; i++)
            {
                await Task.Delay(2000);
                var st = await PostJson("/api/maui/music/capture", new JsonObject { ["platform"] = platform }) as JsonObject;
                var has = st?["hasCookie"] is JsonValue v && v.TryGetValue<bool>(out var b) && b;
                if (!has) continue;
                await LoadCookiesAsync();
                _musicLoginMsg = "已捕获 " + PlatName(platform) + " 登录态并写入配置";
                SetMsg(_musicLoginMsg, "green");
                _musicLoginBusy = false;
                StateHasChanged();
                return;
            }
            _musicLoginMsg = "未在 2 分钟内捕获到登录态：可再点一次「应用内登录」，或手动粘贴 Cookie";
            SetMsg(_musicLoginMsg, "amber");
        }
        catch (Exception ex)
        {
            _musicLoginMsg = "应用内登录失败：" + ex.Message;
            SetMsg(_musicLoginMsg, "red");
        }
        finally
        {
            _musicLoginBusy = false;
            StateHasChanged();
        }
    }

    private Task LoginQq() => LoginPlatform("qq");
    private Task LoginNetease() => LoginPlatform("netease");
    private Task LoginKugou() => LoginPlatform("kugou");
    private Task CheckQq() => CheckPlatform("qq");
    private Task CheckNetease() => CheckPlatform("netease");
    private Task CheckKugou() => CheckPlatform("kugou");
    private Task ClearQq() => ClearPlatform("qq");
    private Task ClearNetease() => ClearPlatform("netease");
    private Task ClearKugou() => ClearPlatform("kugou");

    /// <summary>查询该平台是否已有登录态。</summary>
    private async Task CheckPlatform(string platform)
    {
        try
        {
            var st = await PostJson("/api/maui/music/has", new JsonObject { ["platform"] = platform }) as JsonObject;
            var has = st?["has"] is JsonValue v && v.TryGetValue<bool>(out var b) && b;
            _musicLoginMsg = PlatName(platform) + (has ? "：已捕获登录态" : "：尚未捕获（可用「应用内登录」或手动粘贴）");
            SetMsg(_musicLoginMsg, has ? "green" : "amber");
        }
        catch (Exception ex) { SetMsg("检测失败：" + ex.Message, "red"); }
        StateHasChanged();
    }

    /// <summary>清除该平台已保存的 Cookie。</summary>
    private async Task ClearPlatform(string platform)
    {
        if (!await UI.ConfirmAsync("确定清除 " + PlatName(platform) + " 已保存的 Cookie？")) return;
        try
        {
            await PostJson("/api/maui/music/clear", new JsonObject { ["platform"] = platform });
            await LoadCookiesAsync();
            _musicLoginMsg = "已清除 " + PlatName(platform) + " 的 Cookie";
            SetMsg(_musicLoginMsg, "green");
        }
        catch (Exception ex) { SetMsg("清除失败：" + ex.Message, "red"); }
        StateHasChanged();
