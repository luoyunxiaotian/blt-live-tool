    private async Task LoadUpdateStatusAsync()
    {
        try
        {
            var o = await PostJsonReadAsync("/api/maui/update/status", new JsonObject());
            if (o == null) { _updateMsg = "状态接口无响应"; _updateLoaded = true; return; }
            _updateTime = o["lastCheckAt"] is JsonValue tv && tv.TryGetValue<string>(out var ts) ? ts ?? "" : "";
            if (o["info"] is JsonObject info) ApplyUpdateInfo(info);
            if (o["updater"] is JsonObject u)
            {
                _updaterPhase = u["phase"] is JsonValue pv && pv.TryGetValue<string>(out var ps) ? ps ?? "" : "";
                _updaterPercent = u["percent"] is JsonValue pc && pc.TryGetValue<int>(out var pi) ? pi : 0;
                _updaterMsg = u["message"] is JsonValue mv && mv.TryGetValue<string>(out var ms) ? ms ?? "" : "";
            }
            _updateLoaded = true;
        }
        catch (Exception ex) { _updateMsg = "状态加载失败：" + ex.Message; _updateLoaded = true; }
    }

    private async Task CheckUpdateNow()
    {
        _updateBusy = true;
        _updateMsg = "正在检查…";
        StateHasChanged();
        try
        {
            var resp = await Http.PostAsync(Base + "/api/maui/update/check",
                new StringContent("{\"force\":true}", Encoding.UTF8, "application/json"));
            var txt = await resp.Content.ReadAsStringAsync();
            if (JsonNode.Parse(txt) is JsonObject o)
            {
                ApplyUpdateInfo(o);
                _updateTime = DateTime.Now.ToString("yyyy-MM-dd HH:mm:ss");
            }
        }
        catch (Exception ex)
        {
            _updateMsg = "检查失败：" + ex.Message;
        }
        finally
        {
            _updateBusy = false;
            StateHasChanged();
        }
    }

    private void ApplyUpdateInfo(JsonObject o)
    {
        _updateHasUpdate = o["hasUpdate"] is JsonValue hv && hv.TryGetValue<bool>(out var hb) && hb;
        _updateLatest = o["latest"] is JsonValue lv && lv.TryGetValue<string>(out var ls) ? ls ?? "" : "";
        _updateMsg = o["message"] is JsonValue mv && mv.TryGetValue<string>(out var ms) ? ms ?? "" : "";
        _updateNotes = o["notes"] is JsonValue nv && nv.TryGetValue<string>(out var ns) ? ns ?? "" : "";
        _updateAssetName = o["assetName"] is JsonValue av && av.TryGetValue<string>(out var ans) ? ans ?? "" : "";
        _updateHasAsset = _updateAssetName.Length > 0;
        _updateAssetSize = o["assetSize"] is JsonValue sv && sv.TryGetValue<long>(out var sz) ? sz : 0;
        _updateLoaded = true;
    }

