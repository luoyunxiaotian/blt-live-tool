    // ---- small helpers ----

    private static string JoinArray(JsonObject? o, string key)
    {
        if (o != null && o[key] is JsonArray arr)
            return string.Join("\n", arr.Select(ElemText).Where(s => s.Trim().Length > 0));
        return "";
    }

    private static string ElemText(JsonNode? n)
        => n is JsonValue v && v.TryGetValue<string>(out var s) && s != null ? s : "";

    private static JsonArray LinesToArray(string text)
    {
        var arr = new JsonArray();
        foreach (var raw in text.Replace("\r\n", "\n").Replace('\r', '\n').Split('\n'))
        {
            var line = raw.Trim();
            if (line.Length > 0) arr.Add(JsonValue.Create(line));
        }
        return arr;
    }

    private static int PoolCount(string text)
        => text.Replace("\r\n", "\n").Replace('\r', '\n').Split('\n').Count(x => x.Trim().Length > 0);

    private string ConfigClass() => _doc != null ? "green" : "red";

    private string ConfigText() => _doc != null ? "LOADED" : "FAIL";

    private static string OnOff(bool on) => on ? "green" : "red";

    private static string OnOffText(bool on) => on ? "ON" : "OFF";

    /// <summary>Returns the bare "on" marker for controls that already carry a base class.</summary>
    private static string OnCls(bool on) => on ? "on" : "";

    private static string Stamp() => DateTime.Now.ToString("HH:mm:ss");

    private static string Short(string s)
    {
        if (string.IsNullOrEmpty(s)) return "未知错误";
        return s.Length > 90 ? s[..90] + "…" : s;
    }

    private static string ErrText(string s)
    {
        try
        {
            if (JsonNode.Parse(s) is JsonObject o)
            {
                var e = Str(o, "error");
                if (e.Length > 0) return " · " + e;
            }
        }
        catch { /* not JSON */ }
        return "";
    }

    private static string Str(JsonObject? o, string key, string def = "")
    {
        if (o != null && o.TryGetPropertyValue(key, out var v) && v is JsonValue jv && jv.TryGetValue<string>(out var s) && s != null) return s;
        return def;
    }

    private static bool Flag(JsonObject? o, string key, bool def)
    {
        if (o != null && o.TryGetPropertyValue(key, out var v) && v is JsonValue jv && jv.TryGetValue<bool>(out var b)) return b;
        return def;
    }

    private static double Dbl(JsonObject? o, string key, double def)
    {
        if (o != null && o.TryGetPropertyValue(key, out var v) && v is JsonValue jv && jv.TryGetValue<double>(out var d)) return d;
        return def;
    }

    private static long Lng(JsonObject? o, string key, long def = 0)
    {
        if (o != null && o.TryGetPropertyValue(key, out var v) && v is JsonValue jv && jv.TryGetValue<long>(out var l)) return l;
        return def;
    }

    private static string NumText(JsonObject? o, string key, double def)
        => Dbl(o, key, def).ToString("0.###", System.Globalization.CultureInfo.InvariantCulture);

    private static double ParseD(string s, double def)
    {
        if (double.TryParse(s, System.Globalization.NumberStyles.Float, System.Globalization.CultureInfo.InvariantCulture, out var d)) return d;
        if (double.TryParse(s, out var d2)) return d2;
        return def;
    }

    private static long ParseL(string s, long def)
        => long.TryParse(s, out var v) ? v : def;
}
