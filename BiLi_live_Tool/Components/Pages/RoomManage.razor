@page "/"
@using System.Text
@using System.Text.Json.Nodes
@using BiLi_live_Tool.Services
@inject AppConfig Config
@inject LiveService Live
@inject EventHub Hub
@inject LivePipeline Pipeline
@inject KestrelHost Api
@inject TtsHost Tts
@inject DebouncedSaver Saver
@implements IDisposable

<div class="blt-pagehead"><h1>房间管理</h1><span class="en">ROOM MANAGE</span></div>

<div class="blt-topstrip">
    <span class="seg">status: <b class="@StateClass()">@StateText()</b></span>
    @if (Hub.LastStatus.ConnectedAt > 0)
    {
        <span class="seg">uptime <b>@Uptime()</b></span>
    }
</div>

<div class="blt-grid blt-cols-2">
    @* ── 左列：直播间连接 + 事件流 ── *@
    <div>
        <div class="blt-panel">
            <div class="blt-panel-head"><span class="t">🔗 直播间连接</span><span class="en">ROOM LINK</span>
                <span class="right"><span>status:</span><b class="@StateClass()">@StateText()</b></span>
            </div>
            <div class="blt-panel-body">
                <label class="blt-label">room_id</label>
                <div style="display:flex;gap:10px">
                    <input class="blt-input mono" @bind="_roomId" @bind:after="SaveRoomIdSoon" placeholder="直播间号（支持短号）" @onkeydown="OnRoomKey" />
                    <button class="blt-btn primary" @onclick="Connect" disabled="@Live.IsRunning">连接</button>
                    <button class="blt-btn" @onclick="Disconnect" disabled="@(!Live.IsRunning)">断开</button>
                </div>

                <div class="blt-steps">
                    <div class="blt-step @StepClass(0)">
                        <div class="s1"><span class="blt-dot @StepDot(0)"></span>解析房间</div>
                        <div class="s2">@StepText(0)</div>
                    </div>
                    <div class="blt-step @StepClass(1)">
                        <div class="s1"><span class="blt-dot @StepDot(1)"></span>检查开播</div>
                        <div class="s2">@StepText(1)</div>
                    </div>
                    <div class="blt-step @StepClass(2)">
                        <div class="s1"><span class="blt-dot @StepDot(2)"></span>连接服务器</div>
                        <div class="s2">@StepText(2)</div>
                    </div>
                    <div class="blt-step @StepClass(3)">
                        <div class="s1"><span class="blt-dot @StepDot(3)"></span>实时连接</div>
                        <div class="s2">@StepText(3)</div>
                    </div>
                </div>

                <div style="display:flex;gap:26px;margin-top:14px;flex-wrap:wrap">
                    <span class="blt-switch @_autoConnectClass" @onclick="ToggleAutoConnect">
                        <span class="track"></span>自动连接 <span class="blt-hint" style="margin:0">启动时连上次房间</span>
                    </span>
                    <span class="blt-switch on"><span class="track"></span>断线重连 <span class="blt-hint" style="margin:0">15s 间隔</span></span>
                </div>
                <div class="blt-hint">房间号与自动连接改动即时保存 · @AutoSaveText()</div>

                @* B站浏览器控制条 —— 固定三键，隐藏/关闭在最左（停靠时左栏 38% 可见区必可点） *@
                <div style="display:flex;gap:8px;margin-top:14px;padding-top:12px;border-top:1px dashed var(--line);align-items:center">
                    <button class="blt-btn" @onclick="HideBiliBrowser" data-tip="挪到屏幕外，内存保留">隐藏浏览器</button>
                    <button class="blt-btn" @onclick="CloseBiliBrowser" data-tip="销毁窗口释放内存，再打开自动重建">关闭浏览器</button>
                    <button class="blt-btn primary" @onclick="OpenBiliBrowser">打开B站浏览器</button>
                </div>
            </div>
        </div>

        <div class="blt-panel">
            <div class="blt-panel-head"><span class="t">📜 事件流</span><span class="en">EVENT LOG</span>
                <span class="right"><span>tail -f · 缓存 @Hub.GetRecent("danmu").Count + 最近</span>
                <button class="blt-btn" style="padding:2px 10px" @onclick="ClearView">清空显示</button></span>
            </div>
            <div class="blt-panel-body" style="padding:6px 0">
                @if (_view.Count == 0)
                {
                    <div class="blt-empty">等待事件… 连接后实时滚动显示 弹幕 / 礼物 / 舰长 / SC，也可用右侧快捷操作模拟</div>
                }
                else
                {
                    <div class="blt-log">
                        @foreach (var ev in _view)
                        {
                            <div class="blt-logrow">
                                <span class="t">@ev.Time</span>
                                <span class="tag @TagClass(ev.Type)">@TagText(ev.Type)</span>
                                <span class="txt"><span class="u">@(string.IsNullOrEmpty(ev.Uname) ? "—" : ev.Uname)</span> @EventText(ev)</span>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>

    @* ── 右列：B站账号 + 服务端 + 快捷操作 ── *@
    <div>
        <div class="blt-panel">
            <div class="blt-panel-head"><span class="t">🔑 B站账号</span><span class="en">AUTH</span>
                <span class="right"><span>cookie:</span><b class="@CookieCls()">@CookieText()</b></span>
            </div>
            <div class="blt-panel-body">
                <div class="blt-kv"><span class="k">登录状态</span><span class="v @CookieCls()">@LoginText()</span></div>
                <div class="blt-kv"><span class="k">UID</span><span class="v">@(string.IsNullOrEmpty(Config.Uid) ? "—" : Config.Uid)</span></div>
                <div class="blt-kv"><span class="k">Cookie</span><span class="v">@(HasCookie() ? "已捕获（SESSDATA/bili_jct）" : "未捕获")</span></div>
                <div style="display:flex;gap:8px;margin-top:10px;flex-wrap:wrap">
                    <button class="blt-btn primary" @onclick="OpenBiliBrowser">打开B站浏览器</button>
                    <button class="blt-btn" @onclick="ClearLogin">清除登录态</button>
                </div>
            </div>
        </div>

        <div class="blt-panel">
            <div class="blt-panel-head"><span class="t">🖥 服务端</span><span class="en">SERVER</span></div>
            <div class="blt-panel-body">
                <div class="blt-kv"><span class="k">面板服务</span><span class="v @ApiCls()">@ApiText()</span></div>
                <div class="blt-kv"><span class="k">监听地址</span><span class="v">127.0.0.1:@Api.Port</span></div>
                <div class="blt-kv"><span class="k">Edge TTS (8020)</span><span class="v">@(EdgeRunning ? "RUNNING" : "OFF")</span></div>
                <div class="blt-kv"><span class="k">MOSS 引擎 (8021)</span><span class="v">@(MossRunning ? "RUNNING" : "按需")</span></div>
            </div>
        </div>

        @* Auto like: POST /api/like/start|stop + GET /api/like/status (1 s poll). *@
        <div class="blt-panel">
            <div class="blt-panel-head"><span class="t">👍 自动点赞</span><span class="en">AUTO LIKE</span>
                <span class="right"><span class="blt-badge @LikeBadgeCls()">@LikeBadgeText()</span></span>
            </div>
            <div class="blt-panel-body">
                <div class="blt-master @LikeMasterCls()">
                    <span class="st">已点赞 <b>@_likeLiked</b> 次</span>
                    <span class="sub">@LikeSubText()</span>
                </div>
                <div style="display:flex;gap:8px;flex-wrap:wrap">
                    <button class="blt-btn primary" @onclick="StartLike" disabled="@(!LikeReady() || _likeRunning)">开始点赞</button>
                    <button class="blt-btn" @onclick="StopLike" disabled="@(!_likeRunning)">停止</button>
                </div>
                @if (_likeError.Length > 0)
                {
                    <div class="blt-hint" style="color:var(--red);margin:0">@_likeError</div>
                }
                <p class="blt-hint">
                    点赞为 B站「点赞」长按协议循环发送，用于提升直播间热度；仅在已连接且已配置 Cookie 时可用。
                </p>
            </div>
        </div>

        <div class="blt-panel">
            <div class="blt-panel-head"><span class="t">⚡ 快捷操作</span><span class="en">QUICK OPS</span>
                <span class="right"><span>dev · 走完整事件管线</span></span>
            </div>
            <div class="blt-panel-body">
                <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px">
                    <button class="blt-btn" @onclick="SimDanmu">模拟弹幕</button>
                    <button class="blt-btn" @onclick="SimGifts">模拟礼物</button>
                    <button class="blt-btn" @onclick="SimGuard">模拟舰长</button>
                    <button class="blt-btn" @onclick="SimSc">模拟 SC</button>
                    <button class="blt-btn" @onclick="SimFollow">模拟关注</button>
                    <button class="blt-btn" @onclick="SimWelcome">模拟进房</button>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private static readonly HttpClient Http = new() { Timeout = TimeSpan.FromSeconds(10) };

    private string _roomId = "";
    private string _autoConnectClass = "";
    private bool _autoConnectBool;
    private List<LiveEvent> _view = new();

    // Auto-save status for the room settings written through Config.ReplaceFrom.
    private DateTime? _savedAt;
    private string _saveMsg = "";

    // Auto like state, refreshed by the 1 s poll below.
    private System.Threading.Timer? _likeTimer;
    private bool _likeRunning;
    private int _likeLiked;
    private string _likeError = "";

    private bool EdgeRunning => GetProp(Tts.EdgeStatus(), "running");
    private bool MossRunning => GetProp(Tts.MossStatus(), "running");

    private string Base => "http://127.0.0.1:" + Api.Port;

    private static bool GetProp(object o, string name)
        => Convert.ToBoolean(o.GetType().GetProperty(name)?.GetValue(o));

    protected override void OnInitialized()
    {
        _roomId = Config.RoomId;
        _autoConnectBool = Config.AutoConnect;
        _autoConnectClass = _autoConnectBool ? "on" : "";
        Hub.OnEvent += OnEvent;
        Hub.StatusChanged += OnStatus;
        _likeTimer = new System.Threading.Timer(_ => _ = PollLikeStatus(), null,
            TimeSpan.FromSeconds(1), TimeSpan.FromSeconds(1));
        _ = PollLikeStatus();   // first paint gets the current counters without waiting 1 s
    }

    private void OnEvent(LiveEvent ev) => InvokeAsync(() =>
    {
        _view.Insert(0, ev);
        if (_view.Count > 200) _view.RemoveAt(_view.Count - 1);
        StateHasChanged();
    });

    private void OnStatus(LiveStatusInfo st) => InvokeAsync(StateHasChanged);

    private Task OnRoomKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") return Connect();
        return Task.CompletedTask;
    }

    private Task Connect()
    {
        var rid = _roomId.Trim();
        if (rid.Length == 0 || Live.IsRunning) return Task.CompletedTask;
        Config.SetRoomAndCookie(rid, "");
        Live.Start(rid, Config.Cookie);
        return Task.CompletedTask;
    }

    private void Disconnect() => Live.Stop();

    private void ToggleAutoConnect()
    {
        _autoConnectBool = !_autoConnectBool;
        _autoConnectClass = _autoConnectBool ? "on" : "";
        SaveRoomConfigSoon(200);
    }

    // ---- auto-save (debounced) ----
    // The room settings live in the local config store, so the debounce only decides
    // how often data/config.json is rewritten. The same "room-config" key is shared,
    // which makes a newer edit cancel the pending write of an older one.

    private void SaveRoomConfigSoon(int delayMs = 450)
        => Saver.Run("room-config", () => InvokeAsync(async () => { SaveRoomConfig(); StateHasChanged(); }), delayMs);

    private void SaveRoomIdSoon() => SaveRoomConfigSoon();

    private void SaveRoomConfig()
    {
        try
        {
            var doc = Config.Snapshot();
            doc["autoConnect"] = _autoConnectBool;
            var rid = _roomId.Trim();
            if (rid.Length > 0) doc["roomId"] = rid;   // never wipe a stored id from an empty box
            Config.ReplaceFrom(doc);
            _saveMsg = "";
            _savedAt = DateTime.Now;
        }
        catch (Exception ex)
        {
            _saveMsg = ex.Message;
        }
    }

    private string AutoSaveText()
    {
        if (_saveMsg.Length > 0) return "保存失败：" + _saveMsg;
        return _savedAt.HasValue ? "已自动保存 " + _savedAt.Value.ToString("HH:mm:ss") : "改动即时自动保存";
    }

    // ---- auto like (B站「点赞」长按协议) ----

    /// <summary>The like loop needs a room id (connected or configured) plus a captured cookie.</summary>
    private bool LikeReady() => HasCookie() && (Hub.LastStatus.State == "connected" || Config.RoomId.Length > 0);

    private string LikeMasterCls() => _likeRunning ? "on" : "";

    private string LikeBadgeCls() => _likeRunning ? "green" : _likeError.Length > 0 ? "red" : "off";

    private string LikeBadgeText() => _likeRunning ? "运行中" : "已停止";

    private string LikeSubText()
    {
        if (_likeRunning) return "循环点赞中 · 300 ms/次";
        if (!LikeReady()) return "需要已连接直播间且已配置 Cookie";
        return "已停止 · 点「开始点赞」启动循环";
    }

    private async Task StartLike()
    {
        _likeError = "";
        try
        {
            using var resp = await Http.PostAsync(Base + "/api/like/start",
                new StringContent("{}", Encoding.UTF8, "application/json"));
            var body = await resp.Content.ReadAsStringAsync();
            if (!resp.IsSuccessStatusCode)
            {
                _likeError = "HTTP " + (int)resp.StatusCode;
                return;
            }
            var err = ApiError(body);
            if (err.Length > 0)
            {
                _likeError = err;
                return;
            }
            await PollLikeStatus();   // reflect the new running state at once
        }
        catch (Exception ex)
        {
            _likeError = ex.Message;
        }
    }

    private async Task StopLike()
    {
        try
        {
            using var resp = await Http.PostAsync(Base + "/api/like/stop",
                new StringContent("{}", Encoding.UTF8, "application/json"));
            var body = await resp.Content.ReadAsStringAsync();
            if (!resp.IsSuccessStatusCode)
            {
                _likeError = "HTTP " + (int)resp.StatusCode;
                return;
            }
            var err = ApiError(body);
            if (err.Length > 0)
            {
                _likeError = err;
                return;
            }
            await PollLikeStatus();
        }
        catch (Exception ex)
        {
            _likeError = ex.Message;
        }
    }

    /// <summary>GET /api/like/status — called by the 1 s timer and after start/stop.</summary>
    private async Task PollLikeStatus()
    {
        JsonObject? o;
        try
        {
            o = await GetJsonAsync("/api/like/status");
        }
        catch
        {
            return;   // the panel API may be down; keep the last known counters
        }
        if (o == null) return;

        var running = GetBool(o, "running", false);
        var liked = (int)GetNum(o, "liked", 0);
        var error = GetStr(o, "error", "");
        if (running == _likeRunning && liked == _likeLiked && error == _likeError) return;

        try
        {
            // The timer fires on a pool thread → hand the state update to the renderer.
            await InvokeAsync(() =>
            {
                _likeRunning = running;
                _likeLiked = liked;
                _likeError = error;
                StateHasChanged();
            });
        }
        catch
        {
            // component disposed while the poll was in flight
        }
    }

    private async Task<JsonObject?> GetJsonAsync(string path)
    {
        using var resp = await Http.GetAsync(Base + path);
        var txt = await resp.Content.ReadAsStringAsync();
        if (!resp.IsSuccessStatusCode) return null;
        return JsonNode.Parse(txt) as JsonObject;
    }

    private static string ApiError(string body)
    {
        try
        {
            if (JsonNode.Parse(body) is JsonObject o && o["error"] is JsonValue v && v.TryGetValue<string>(out var e))
                return e ?? "";
        }
        catch { }
        return "";
    }

    private static bool GetBool(JsonObject o, string key, bool def)
        => o.TryGetPropertyValue(key, out var v) && v is JsonValue jv && jv.TryGetValue<bool>(out var b) ? b : def;

    private static string GetStr(JsonObject o, string key, string def)
        => o.TryGetPropertyValue(key, out var v) && v is JsonValue jv && jv.TryGetValue<string>(out var s) && !string.IsNullOrEmpty(s) ? s : def;

    private static double GetNum(JsonObject o, string key, double def)
        => o.TryGetPropertyValue(key, out var v) && v is JsonValue jv && jv.TryGetValue<double>(out var d) ? d : def;

    private void OpenBiliBrowser()
    {
        var rid = Live.IsRunning ? Hub.LastStatus.RealRoomId : _roomId.Trim();
        var url = long.TryParse(rid, out _) ? $"https://live.bilibili.com/{rid}" : "https://live.bilibili.com/";
        MainPage.Current?.ShowBiliBrowser(url);
    }

    private void HideBiliBrowser() => MainPage.Current?.HideBiliBrowser();
    private void CloseBiliBrowser() => MainPage.Current?.CloseBiliBrowser();

    private void ClearLogin()
    {
        Config.SetBiliCookie("", "");
        _view.Clear();
        Hub.PublishStatus(Hub.LastStatus); // refresh trigger
        StateHasChanged();
    }

    private void ClearView() => _view.Clear();

    private void SimDanmu() => Simulate("danmu");
    private void SimGifts() => Simulate("gifts");
    private void SimGuard() => Simulate("guard");
    private void SimSc() => Simulate("superchat");
    private void SimFollow() => Simulate("follow");
    private void SimWelcome() => SimulateWelcome();

    private void Simulate(string type)
    {
        var ev = type switch
        {
            "gifts" => new LiveEvent { Type = "gifts", Uname = "测试观众", GiftName = "小花花", Num = 5, Price = 100, TotalCoin = 500, CoinType = "gold", Value = 0.5 },
            "guard" => new LiveEvent { Type = "guard", Uname = "测试舰长", Level = 3, LevelName = "舰长", Num = 1, Price = 198000, Value = 198, IsGuard = true, GuardLevel = 3 },
            "superchat" => new LiveEvent { Type = "superchat", Uname = "测试SC", Msg = "主播加油！", Price = 30, StartTime = DateTimeOffset.Now.ToUnixTimeMilliseconds() },
            "follow" => new LiveEvent { Type = "interact", Uname = "测试粉丝", MsgType = 2 },
            _ => new LiveEvent { Type = "danmu", Uname = "测试观众", Msg = "这是一条测试弹幕" },
        };
        ev.Time = DateTime.Now.ToString("yyyy-MM-dd HH:mm:ss");
        ev.Ts = DateTimeOffset.Now.ToUnixTimeMilliseconds();
        Pipeline.ProcessDebugEvent(ev);
    }

    private void SimulateWelcome()
    {
        Pipeline.ProcessDebugEvent(new LiveEvent
        {
            Type = "interact",
            Time = DateTime.Now.ToString("yyyy-MM-dd HH:mm:ss"),
            Ts = DateTimeOffset.Now.ToUnixTimeMilliseconds(),
            Uid = "10001",
            Uname = "测试观众",
            MsgType = 1,
        });
    }

    private bool HasCookie() => Config.Cookie.Contains("SESSDATA") || Config.Cookie.Contains("bili_jct");

    private string CookieCls() => HasCookie() ? "green" : "red";

    private string CookieText() => HasCookie() ? "VALID" : "NONE";

    private string LoginText() => HasCookie() ? "已登录" : "未登录";

    private string ApiCls() => Api.IsRunning ? "green" : "red";

    private string ApiText() => Api.IsRunning ? "RUNNING" : "DOWN";

    private string StateClass() => Hub.LastStatus.State switch
    {
        "connected" => "green",
        "error" => "red",
        "idle" => "",
        _ => "amber",
    };

    private string StateText() => Hub.LastStatus.State switch
    {
        "idle" => "未连接",
        "resolving" => "解析中",
        "checking_live" => "检测开播",
        "not_live" => "未开播",
        "getting_danmu" => "获取弹幕服务器",
        "connected" => "CONNECTED",
        "reconnecting" => "重连中",
        "disconnected" => "已断开",
        "error" => "错误",
        _ => Hub.LastStatus.State,
    };

    private string Uptime()
    {
        var secs = (DateTimeOffset.Now.ToUnixTimeMilliseconds() - Hub.LastStatus.ConnectedAt) / 1000;
        return $"{secs / 3600:d2}:{secs % 3600 / 60:d2}:{secs % 60:d2}";
    }

    private (bool done, bool active) StepState(int step)
    {
        var s = Hub.LastStatus.State;
        return step switch
        {
            0 => s is "checking_live" or "getting_danmu" or "connected" or "not_live" or "reconnecting" or "disconnected"
                ? (true, false) : s == "resolving" ? (false, true) : (false, false),
            1 => s is "getting_danmu" or "connected" or "reconnecting" or "disconnected"
                ? (true, false) : s is "checking_live" or "not_live" ? (false, true) : (false, false),
            2 => s is "connected" or "reconnecting"
                ? (true, s != "connected") : s == "getting_danmu" ? (false, true) : (false, false),
            3 => s == "connected" ? (true, false) : (false, false),
            _ => (false, false),
        };
    }

    private string StepClass(int step)
    {
        var (done, active) = StepState(step);
        return done ? "done" : active ? "active" : "";
    }

    private string StepDot(int step)
    {
        var (done, active) = StepState(step);
        return done ? "green" : active ? "amber" : "gray";
    }

    private string StepText(int step)
    {
        var (done, active) = StepState(step);
        if (done) return "OK";
        if (!active) return "WAIT";
        return Hub.LastStatus.State switch
        {
            "resolving" => "解析…",
            "checking_live" => "查询中…",
            "not_live" => "未开播",
            "getting_danmu" => "获取节点…",
            "connected" => "ONLINE",
            "reconnecting" => "重连…",
            _ => "进行中…",
        };
    }

    private string TagClass(string type) => type switch
    {
        "danmu" => "danmu",
        "gifts" or "gifts_merged" => "gifts",
        "guard" => "guard",
        "superchat" => "superchat",
        "interact" => "interact",
        _ => "info",
    };

    private string TagText(string type) => type switch
    {
        "danmu" => "DANMU",
        "gifts" => "GIFT",
        "gifts_merged" => "GIFTΣ",
        "guard" => "GUARD",
        "superchat" => "SC",
        "interact" => "INTER",
        _ => type.ToUpperInvariant()[..Math.Min(6, type.Length)],
    };

    private string EventText(LiveEvent ev) => ev.Type switch
    {
        "danmu" => ev.Msg,
        "gifts" => $"送出 {ev.GiftName} ×{ev.Num}" + (ev.Value > 0 ? $"（≈¥{ev.Value}）" : ""),
        "guard" => $"开通 {ev.LevelName} ×{ev.Num}",
        "superchat" => $"SC：{ev.Msg}" + (ev.Price > 0 ? $"（¥{ev.Price}）" : ""),
        "interact" => ev.MsgType == 2 ? "关注了直播间" : "进入直播间",
        "gifts_merged" => $"聚合：{string.Join("、", (ev.Gifts ?? new()).Select(g => $"{g.GiftName}×{g.Num}"))}",
        _ => "",
    };

    public void Dispose()
    {
        Hub.OnEvent -= OnEvent;
        Hub.StatusChanged -= OnStatus;
        _likeTimer?.Dispose();
        _likeTimer = null;
    }
}
