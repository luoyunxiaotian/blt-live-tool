    /// <summary>Reads biliBrowser.idleCloseMin: absent → default 10 min (on), 0 → switch off.</summary>
    private void LoadIdleCloseConfig()
    {
        var mins = DefaultIdleMin;
        try
        {
            if (Config.GetNode("biliBrowser") is JsonObject bb
                && bb.TryGetPropertyValue("idleCloseMin", out var v)
                && v is JsonValue jv
                && jv.TryGetValue<double>(out var d))
                mins = (int)Math.Round(d);
        }
        catch { }
        _idleCloseOn = mins > 0;
        _idleMin = _idleCloseOn ? Math.Clamp(mins, 1, MaxIdleMin) : DefaultIdleMin;
    }

