    public record LogoOption(string Value, string Label);
    private List<LogoOption> _availableLogos = new();

    private void ReloadLogosList()
    {
        var list = new List<LogoOption>
        {
            new("logos/logo_1.png", "Logo 1 (默认)"),
            new("logos/logo_2.png", "Logo 2 (游戏)"),
            new("logos/logo_3.png", "Logo 3 (音乐)"),
            new("logos/logo_4.png", "Logo 4 (科技)"),
            new("logos/logo_5.png", "Logo 5 (社交)"),
            new("logos/logo_6.png", "Logo 6 (主播)")
        };

        var known = new HashSet<string>(list.Select(x => x.Value), StringComparer.OrdinalIgnoreCase);

        try
        {
            var dir = Path.Combine(AppConfig.LegacyRoot, "lower-thirds", "logos");
            if (Directory.Exists(dir))
            {
                var files = Directory.GetFiles(dir);
                foreach (var file in files)
                {
                    var ext = Path.GetExtension(file).ToLowerInvariant();
                    if (ext == ".png" || ext == ".jpg" || ext == ".jpeg" || ext == ".svg" || ext == ".webp" || ext == ".gif" || ext == ".ico")
                    {
                        var fn = Path.GetFileName(file);
                        var rel = $"logos/{fn}";
                        if (!known.Contains(rel))
                        {
                            list.Add(new LogoOption(rel, $"{fn} (自定义)"));
                            known.Add(rel);
                        }
                    }
                }
            }
        }
        catch { }

        var sel = GetSelectedChannel();
        if (sel != null && !string.IsNullOrWhiteSpace(sel.Logo) && !known.Contains(sel.Logo))
        {
            list.Add(new LogoOption(sel.Logo, $"{Path.GetFileName(sel.Logo)} (自定)"));
        }

        _availableLogos = list;
    }

    private string GetLogoDisplayUrl(string logoPath)
    {
        if (string.IsNullOrWhiteSpace(logoPath)) return "";
        if (logoPath.StartsWith("http://") || logoPath.StartsWith("https://") || logoPath.StartsWith("data:"))
            return logoPath;
        return $"http://127.0.0.1:{Api.Port}/lower-thirds/{logoPath.TrimStart('/')}";
    }

    private void OnLogoChanged(ChangeEventArgs e)
    {
        var sel = GetSelectedChannel();
        if (sel != null)
        {
            var logo = e.Value?.ToString() ?? "";
            sel.Logo = logo;
            sel.ShowLogo = !string.IsNullOrEmpty(logo);
            OnFormChanged();
        }
    }

    private async Task PickAndImportLogo()
    {
        try
        {
            var customFileType = new Microsoft.Maui.Storage.FilePickerFileType(new Dictionary<DevicePlatform, IEnumerable<string>>
            {
                { DevicePlatform.WinUI, new[] { ".png", ".jpg", ".jpeg", ".svg", ".webp", ".gif", ".ico" } },
            });

            var file = await Microsoft.Maui.Storage.FilePicker.Default.PickAsync(new Microsoft.Maui.Storage.PickOptions
            {
                PickerTitle = "请选择徽标图标图片（PNG/JPG/SVG/WEBP/GIF）",
                FileTypes = customFileType
            });

            if (file == null) return;

            var ext = Path.GetExtension(file.FileName ?? "").ToLowerInvariant();
            var validExts = new[] { ".png", ".jpg", ".jpeg", ".svg", ".webp", ".gif", ".ico" };
            if (string.IsNullOrEmpty(ext) || Array.IndexOf(validExts, ext) < 0)
            {
                await UI.ToastAsync("请选择有效的图片文件（PNG、JPG、SVG、WEBP、GIF）", false);
                return;
            }

            var logosDir = Path.Combine(AppConfig.LegacyRoot, "lower-thirds", "logos");
            Directory.CreateDirectory(logosDir);

            var rawName = Path.GetFileNameWithoutExtension(file.FileName) ?? "logo";
            var safeName = string.Concat(rawName.Split(Path.GetInvalidFileNameChars())).Trim();
            if (string.IsNullOrWhiteSpace(safeName)) safeName = "custom_logo_" + DateTime.Now.ToString("yyyyMMdd_HHmmss");

            var targetFileName = $"{safeName}{ext}";
            var targetPath = Path.Combine(logosDir, targetFileName);

            if (File.Exists(targetPath))
            {
                targetFileName = $"{safeName}_{DateTime.Now:HHmmss}{ext}";
                targetPath = Path.Combine(logosDir, targetFileName);
            }

            using (var inStream = await file.OpenReadAsync())
            using (var outStream = File.Create(targetPath))
            {
                await inStream.CopyToAsync(outStream);
            }

            ReloadLogosList();

            var sel = GetSelectedChannel();
            if (sel != null)
            {
                sel.Logo = $"logos/{targetFileName}";
                sel.ShowLogo = true;
                OnFormChanged();
            }

            _feedback = $"图标「{targetFileName}」导入成功并已应用";
            _feedbackOk = true;
            await UI.ToastAsync($"图标「{targetFileName}」导入成功并已应用！", true);
            StateHasChanged();
        }
        catch (Exception ex)
        {
            await UI.ToastAsync("导入图标失败：" + ex.Message, false);
        }
    }

