    // ---- auto-save (debounced) ----
    // The room settings live in the local config store, so the debounce only decides
    // how often data/config.json is rewritten. The same "room-config" key is shared,
    // which makes a newer edit cancel the pending write of an older one.

    private void SaveRoomConfigSoon(int delayMs = 450)
        => Saver.Run("room-config", () => InvokeAsync(async () => { SaveRoomConfig(); StateHasChanged(); }), delayMs);

    private void SaveRoomIdSoon() => SaveRoomConfigSoon();

    private void SaveRoomConfig()
    {
        try
        {
            var doc = Config.Snapshot();
            doc["autoConnect"] = _autoConnectBool;
            WriteIdleCloseConfig(doc);   // biliBrowser.idleCloseMin rides the same debounced write
            var rid = _roomId.Trim();
            if (rid.Length > 0) doc["roomId"] = rid;   // never wipe a stored id from an empty box
            Config.ReplaceFrom(doc);
            _saveMsg = "";
            _savedAt = DateTime.Now;
        }
        catch (Exception ex)
        {
            _saveMsg = ex.Message;
        }
    }

