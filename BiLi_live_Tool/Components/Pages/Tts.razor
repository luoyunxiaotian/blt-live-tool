    private string MossInstalledText() => _mossInstalled ? "已安装" : "未安装";

    // ---- MOSS custom (cloned) voices ----
    // Real paths (from legacy wwwroot/legacy/tts.js; the Kestrel proxy keeps the same names):
    //   GET  /api/tts/moss/voices        → { builtin:[{id,name,desc}], custom:[{id,name,desc}] }
    //   POST /api/tts/moss/voices/add    → { name, path }   (path = local reference-audio file)
    //   POST /api/tts/moss/voices/remove → { id }
    //   POST /api/tts/moss/              → { text, speed, voiceId } → WAV bytes (试听)
    // Kestrel proxies /api/tts/{engine}/{**rest} to 127.0.0.1:8021, so the page only calls the local API.

    /// <summary>GET /api/tts/moss/voices → custom[] (engine must be installed + running).</summary>
    private async Task FetchMossVoicesAsync()
    {
        if (!_mossInstalled || !_mossRunning)
        {
            _cloneVoices.Clear();
            _mossBuiltin.Clear();
            _cloneMsg = "";
            return;
        }
        _cloneLoading = true;
        try
        {
            using var resp = await Http.GetAsync(Base + "/api/tts/moss/voices");
            var text = await resp.Content.ReadAsStringAsync();
            if (!resp.IsSuccessStatusCode)
            {
                _cloneMsg = "音色清单 HTTP " + (int)resp.StatusCode + ErrText(text);
                return;
            }
            if (JsonNode.Parse(text) is not JsonObject o)
            {
                _cloneMsg = "音色清单格式异常";
                return;
            }
            _cloneVoices.Clear();
            _mossBuiltin.Clear();
            // builtin[] 是本地引擎自带音色（原版 legacy/tts.js 也是这个字段），
            // custom[] 是用户克隆出来的音色 —— 两者共同构成 moss 引擎的下拉清单。
            if (o["builtin"] is JsonArray bArr)
            {
                foreach (var n in bArr)
                {
                    if (n is not JsonObject v) continue;
                    var id = Str(v, "id");
                    if (id.Length == 0) continue;
                    var name = Str(v, "name");
                    var desc = Str(v, "desc");
                    _mossBuiltin.Add(new VoiceItem(id,
                        (name.Length > 0 ? name : id) + (desc.Length > 0 ? " · " + desc : ""),
                        "内置音色（本地）"));
                }
            }
            if (o["custom"] is JsonArray arr)
            {
                foreach (var n in arr)
                {
                    if (n is not JsonObject v) continue;
                    var id = Str(v, "id");
                    if (id.Length == 0) continue;
                    var name = Str(v, "name");
                    _cloneVoices.Add(new CloneVoice { Id = id, Name = name.Length > 0 ? name : id });
                }
            }
            _cloneMsg = "";
        }
        catch (Exception ex) { _cloneMsg = "音色清单读取失败：" + Short(ex.Message); }
        finally { _cloneLoading = false; }
    }

    private async Task RefreshCloneVoices()
    {
        _busy = true;
        try { await FetchMossVoicesAsync(); }
        finally
        {
            _busy = false;
            StateHasChanged();
        }
    }

    /// <summary>Picks the reference audio; the MOSS service clones from the file path (never uploaded).</summary>
    private async Task PickCloneAudio()
    {
        try
        {
            var file = await Microsoft.Maui.Storage.FilePicker.Default.PickAsync(
                new Microsoft.Maui.Storage.PickOptions { PickerTitle = "选择参考音频（3–10 秒清晰人声）" });
            if (file == null) return;   // cancelled
            var path = file.FullPath ?? "";
            var ext = System.IO.Path.GetExtension(file.FileName ?? "").ToLowerInvariant();
            if (path.Length == 0) { await UI.ToastAsync("无法读取文件路径，请重试", false); return; }
            if (ext.Length == 0 || Array.IndexOf(AudioExtensions, ext) < 0)
            {
                await UI.ToastAsync("请选择音频文件（wav / mp3 / flac / m4a / ogg）", false);
                return;
            }
            _clonePath = path;
            _cloneMsg = "";
            if (_cloneName.Trim().Length == 0)
            {
                var bare = System.IO.Path.GetFileNameWithoutExtension(file.FileName ?? "");
                if (bare.Length == 0) bare = "自定义音色";
                _cloneName = bare.Length > 20 ? bare[..20] : bare;   // legacy slices to 20 chars as well
            }
        }
        catch (Exception ex)
        {
            await UI.ToastAsync("选择参考音频失败：" + Short(ex.Message), false);
        }
        finally { StateHasChanged(); }
    }

    private static readonly string[] AudioExtensions = { ".wav", ".mp3", ".flac", ".m4a", ".ogg", ".aac", ".wma", ".opus" };

    /// <summary>POST /api/tts/moss/voices/add { name, path } — legacy response is { ok, error }.</summary>
    private async Task AddCloneVoice()
    {
        var path = _clonePath;
        if (path.Length == 0) { await UI.ToastAsync("请先选择参考音频", false); return; }
        var name = _cloneName.Trim();
        if (name.Length == 0) name = "自定义音色";
        _busy = true;
        try
        {
            var body = new JsonObject { ["name"] = name, ["path"] = path };
            using var resp = await Http.PostAsync(Base + "/api/tts/moss/voices/add",
                new StringContent(body.ToJsonString(), Encoding.UTF8, "application/json"));
            var text = await resp.Content.ReadAsStringAsync();
            var o = TryObject(text);
            if (resp.IsSuccessStatusCode && Flag(o, "ok", true))
            {
                await UI.ToastAsync("已添加自定义音色「" + name + "」", true);
                _cloneName = "";
                _clonePath = "";
                await FetchMossVoicesAsync();
            }
            else
            {
                var err = Str(o, "error");
                await UI.ToastAsync("添加失败：" + (err.Length > 0 ? err : "HTTP " + (int)resp.StatusCode + ErrText(text)), false);
            }
        }
        catch (Exception ex)
        {
            await UI.ToastAsync("添加失败：" + Short(ex.Message), false);
        }
        finally
        {
            _busy = false;
            StateHasChanged();
        }
    }

