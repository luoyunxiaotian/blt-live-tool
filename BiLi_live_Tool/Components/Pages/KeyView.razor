    private List<KeyOption> ThemeOptions()
        => _themes.Select(t => new KeyOption { Value = t.Id, Label = t.Name + "（" + t.Id + "）" }).ToList();

    /// <summary>The overlay.theme row (kept in _rows so the whole-group save preserves the key).</summary>
    private string ThemeRowText
    {
        get => _rows.FirstOrDefault(x => x.Key == "overlay.theme")?.Text ?? "";
        set
        {
            var r = _rows.FirstOrDefault(x => x.Key == "overlay.theme");
            if (r != null && r.Text != value) r.Text = value;
        }
    }

    private ThemeInfo? SelectedTheme
    {
        get
        {
            var id = ThemeRowText;
            return _themes.FirstOrDefault(t => t.Id == id);
        }
    }

    /// <summary>Theme list categorized by visual form/render mode (each theme appears exactly once).</summary>
    private List<ThemeGroup> ThemeGroups()
    {
        var groups = new List<ThemeGroup>();
        var seen = new HashSet<string>(StringComparer.OrdinalIgnoreCase);

        // 1. 全键盘+鼠标写实布局 (常驻显示完整键盘与鼠标)
        var layoutThemes = _themes.Where(t => t.Render == "layout" && !t.Id.StartsWith("pad-") && seen.Add(t.Id)).ToList();
        if (layoutThemes.Count > 0)
            groups.Add(new ThemeGroup { Label = "【写实键鼠全布局】常驻显示完整键鼠（推荐）", Items = layoutThemes });

        // 2. 动态单键流 / 浮出气泡 (敲击时逐个显示按键气泡)
        var streamThemes = _themes.Where(t => (t.Render is "" or "recent") && !t.Id.StartsWith("pad-") && t.Devices.Contains("kb") && seen.Add(t.Id)).ToList();
        if (streamThemes.Count > 0)
            groups.Add(new ThemeGroup { Label = "【动态流式单键】按键时逐个弹出气泡（无常驻底板）", Items = streamThemes });

        // 3. 独立游戏手柄
        var padThemes = _themes.Where(t => (t.Id.StartsWith("pad-") || (t.Devices.Count == 1 && t.Devices[0] == "gp")) && seen.Add(t.Id)).ToList();
        if (padThemes.Count > 0)
            groups.Add(new ThemeGroup { Label = "【独立游戏手柄】", Items = padThemes });

        // 4. 热力图与鼠标轨迹
        var fxThemes = _themes.Where(t => (t.Render is "heatmap" or "trail") && seen.Add(t.Id)).ToList();
        if (fxThemes.Count > 0)
            groups.Add(new ThemeGroup { Label = "【热力图与鼠标轨迹】", Items = fxThemes });

        // 5. 其它补充
        var other = _themes.Where(t => seen.Add(t.Id)).ToList();
        if (other.Count > 0)
            groups.Add(new ThemeGroup { Label = "【其它主题】", Items = other });

        return groups;
    }

    private static string DeviceText(ThemeInfo t)
    {
        var names = new List<string>();
        if (t.Devices.Contains("kb")) names.Add("键盘");
        if (t.Devices.Contains("ms")) names.Add("鼠标");
        if (t.Devices.Contains("gp")) names.Add("手柄");
        var dev = names.Count > 0 ? string.Join(" · ", names) : "通用";
        var mode = t.Render == "layout" ? "常驻完整全布局" : (t.Render == "heatmap" ? "热力图" : (t.Render == "trail" ? "鼠标轨迹" : "逐个按键弹出"));
        return $"{dev} · 模式：{mode}";
    }

    /// <summary>Keep overlay.theme and the selected theme's params out of the generic row list (they render in the theme block).</summary>
    private bool ShowInGenericList(KeyRow r)
    {
        if (r.Key == "overlay.theme") return false;
        var st = SelectedTheme;
        return st == null || !st.Params.Any(p => p.Key == r.Key);
    }

    /// <summary>Rows for the selected theme's params, paired with their manifest spec.</summary>
    private List<(KeyRow Row, ThemeParam Param)> SelectedParams()
    {
        var list = new List<(KeyRow, ThemeParam)>();
        var st = SelectedTheme;
        if (st == null) return list;
        foreach (var p in st.Params)
        {
            var row = _rows.FirstOrDefault(x => x.Key == p.Key);
            if (row != null) list.Add((row, p));
        }
        return list;
    }

    /// <summary>Add a number row for any of the selected theme's params missing from the config.</summary>
    private void EnsureParamRows(List<KeyRow> rows)
    {
        var id = rows.FirstOrDefault(x => x.Key == "overlay.theme")?.Text ?? "";
        var st = _themes.FirstOrDefault(t => t.Id == id);
        if (st == null) return;
        foreach (var p in st.Params)
        {
            if (p.Key.Length == 0 || p.Key == "overlay.theme") continue;
            if (rows.Any(x => x.Key == p.Key)) continue;
            rows.Add(new KeyRow
            {
                Key = p.Key,
                Label = (p.Label.Length > 0 ? p.Label : p.Key) + " " + p.Key,
                Kind = "number",
                Min = p.Min, Max = p.Max,
                Step = p.Step > 0 ? p.Step : 1,
                Unit = p.Unit,
                Num = p.Min,
            });
        }
    }

    private void OnThemeChanged()
    {
        EnsureParamRows(_rows);
        Notify("已切换主题：" + ThemeRowText + " · 自动保存中…", true);
        SaveRowSoon(200);
    }

    private async Task RefreshThemes()
    {
        _themeLoading = true;
        try
        {
            await LoadManifest();
            Notify(_themesFallback
                ? "主题清单拉取失败，已改用内置兜底清单"
                : $"已刷新主题清单 · {_themes.Count} 套", !_themesFallback);
        }
        finally
        {
            _themeLoading = false;
        }
    }

    private double ValueOf(string key)
    {
        foreach (var r in _rows)
            if (r.Key == key && r.Kind == "number") return r.Num;
        return 0;
    }

    // ---------------- http ----------------

    private async Task<JsonNode?> PostJsonAsync(string path, JsonNode body)
    {
        try
        {
            using var resp = await Http.PostAsync(Base + path, JsonBody(body));
            var txt = await resp.Content.ReadAsStringAsync();
            if (!resp.IsSuccessStatusCode)
            {
                _lastError = "HTTP " + (int)resp.StatusCode;
                return null;
            }
            var err = ApiError(txt);
            if (err.Length > 0)
            {
                _lastError = err;
                return null;
            }
            _lastError = "";
            return JsonNode.Parse(txt);
        }
        catch (Exception ex)
        {
            _lastError = ex.Message;
            return null;
        }
    }

    private static StringContent JsonBody(JsonNode node)
        => new(node.ToJsonString(), Encoding.UTF8, "application/json");

    private static string ApiError(string body)
    {
        try
        {
            if (JsonNode.Parse(body) is JsonObject o && o["error"] is JsonValue v && v.TryGetValue<string>(out var e))
                return e ?? "";
        }
        catch { }
        return "";
    }

    private string ErrSuffix()
        => _lastError.Length > 0
            ? "（" + _lastError + "）"
            : "（本机服务端 127.0.0.1:" + Api.Port + " 可能未启动）";

    // ---------------- clipboard / feedback ----------------

    private async Task CopyOverlayUrl() => await CopyText(OverlayUrl, "已复制浮层地址");

    private async Task CopyText(string text, string okMsg)
    {
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", text);
            Notify(okMsg, true);
        }
        catch
        {
            try
            {
                var literal = JsonSerializer.Serialize(text);
                await JS.InvokeVoidAsync("eval",
                    "(function(){var t=document.createElement('textarea');t.value=" + literal +
                    ";t.style.position='fixed';t.style.opacity='0';document.body.appendChild(t);t.focus();t.select();" +
                    "document.execCommand('copy');document.body.removeChild(t);})()");
                Notify(okMsg, true);
            }
            catch
            {
                Notify("复制失败，请手动复制输入框内容", false);
            }
        }
    }

    private void Notify(string msg, bool ok)
    {
        _note = msg;
        _noteOk = ok;
    }

    private static bool Flag(JsonObject o, string key, bool def)
        => o.TryGetPropertyValue(key, out var v) && v is JsonValue jv && jv.TryGetValue<bool>(out var b) ? b : def;

    private static double Num(JsonObject o, string key, double def)
        => o.TryGetPropertyValue(key, out var v) && v is JsonValue jv && jv.TryGetValue<double>(out var d) ? d : def;

    private static string Fmt(double v) => v.ToString(CultureInfo.InvariantCulture);

    public void Dispose()
    {
        _disposed = true;
        _timer?.Dispose();
    }
