    private async Task LoadUpListAsync()
    {
        try
        {
            var data = await GetJson("/api/song-request/bilibili-uplist") as JsonObject;
            _upList.Clear();
            if (data?["upList"] is JsonArray arr)
                foreach (var n in arr)
                {
                    var s = n is JsonValue v && v.TryGetValue<string>(out var uid) ? uid ?? "" : "";
                    if (s.Length > 0) _upList.Add(s);
                }
            BuildUpRows();
