    // ---------- cookie / uplist form ----------
    private bool _ckQq, _ckNetease, _ckKugou, _ckBili;
    private string _cookieQq = "";
    private string _cookieNetease = "";
    private string _cookieKugou = "";
    private string _newUid = "";

    // ---------- search / blacklist form ----------
    private string _searchType = "smart";
    private string _searchKeyword = "";
    private string _blType = "song";
    private string _blValue = "";

    // ---------- page state ----------
    private HttpClient? _http;
    private bool _busy;
    private bool _searching;
    private string _feedback = "";
    private string _feedbackCls = "off";

    // Live page instance behind the static [JSInvokable] ReorderPlaylist (JS drag callback);
    // refreshed on every render, nulled in Dispose.
    private static Song? _page;

    // ---------- auto-save state ----------
    private readonly SemaphoreSlim _saveGate = new(1, 1);   // serializes POSTs (auto-save can fire back to back)
    private DateTime? _savedAt;
    private string _saveMsg = "";

    // ---------- player / lyrics state ----------
    private string _lyricSongKey = "";
    private int _lyricShownActive = -2;   // 上次滚动到的歌词行（-2=未初始化）
    private string _lyricSource = "";
    private bool _lyricLoading;
    private List<(double Time, string Text)> _lyricLines = new();
    private static readonly Regex LrcTag = new(@"^\[(\d+):(\d+)(?:\.(\d+))?\]", RegexOptions.Compiled);

    private const string RowBaseStyle = "display:flex;align-items:center;gap:10px;padding:6px 12px;border-bottom:1px dashed var(--line)";

    // Local API base follows the config port (pinned to 7460 by AppConfig default).
    private HttpClient Http => _http ??= new HttpClient
    {
        BaseAddress = new Uri("http://127.0.0.1:" + Config.Port),
        Timeout = TimeSpan.FromSeconds(30),
    };

    protected override async Task OnInitializedAsync()
    {
        Player.Changed += OnSongChanged;
        await RefreshAll(false);
    }

    /// <summary>
    /// Mounts wwwroot/blt-drag.js. index.html belongs to the build/coordinator step, so the
    /// script is injected here on first render; the file is self-contained (document-level
    /// event delegation) and idempotent, so a later &lt;script src="blt-drag.js?v=014"&gt; in
    /// index.html is harmless and this injection can then be dropped.
    /// </summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // 歌词自动滚动：高亮行变化时把它滚到可视区中间
        var lyricActive = _lyricLines.Count > 0 ? ActiveLyricIndex() : -1;
        if (lyricActive != _lyricShownActive)
        {
            _lyricShownActive = lyricActive;
            try
            {
                await JS.InvokeVoidAsync("eval",
                    "(function(){var b=document.getElementById('blt-lyric-box');var a=b&&b.querySelector('.blt-lyric-on');" +
                    "if(!b||!a)return;var t=a.offsetTop-(b.clientHeight-a.clientHeight)/2;b.scrollTo({top:t<0?0:t,behavior:'smooth'});})()");
            }
            catch { }
        }
        _page = this;   // static slot read by the [JSInvokable] drag callback below
        if (!firstRender) return;
        try
        {
            await JS.InvokeVoidAsync("eval",
                "(function(){if(window.bltDrag||document.getElementById('blt-drag-js'))return;" +
                "var s=document.createElement('script');s.id='blt-drag-js';s.src='blt-drag.js?v=014';" +
                "s.defer=true;document.head.appendChild(s);})()");
        }
        catch { /* JS interop unavailable → the ↑ / ↓ buttons remain the fallback */ }
    }

    /// <summary>
    /// Drag &amp; drop callback from blt-drag.js (DotNet.invokeMethodAsync by assembly name).
    /// Static so JS needs no DotNetObjectReference; the live page instance comes from _page.
    /// </summary>
    [JSInvokable]
    public static Task ReorderPlaylist(int from, int to)
    {
        var page = _page;
        return page == null ? Task.CompletedTask : page.ApplyReorderAsync(from, to);
    }

    /// <summary>Moves one playlist entry (0-based destination) and persists it, same API as ↑ / ↓.</summary>
    private async Task ApplyReorderAsync(int from, int to)
    {
        if (from == to) return;
        // The JS callback thread is not the renderer thread → marshal before touching state.
        await InvokeAsync(async () =>
        {
            await Guard(async () =>
            {
                await PostJson("/api/song-request/playlist/reorder", new JsonObject { ["from"] = from, ["to"] = to });
                await LoadPlaylistAsync();
                SetMsg("已调整播放顺序", "green");
                await UI.ToastAsync("已调整播放顺序", true);
            }, "排序失败");
        });
    }

    public void Dispose()
    {
        if (ReferenceEquals(_page, this)) _page = null;   // a stale DOM must not reach a disposed page
        Player.Changed -= OnSongChanged;
        _http?.Dispose();
        _http = null;
    }

    // ---------- player / lyrics ----------

    /// <summary>Player.Changed also fires from the JS callback thread → marshal to the renderer.</summary>
    private void OnSongChanged()
    {
        _ = InvokeAsync(async () =>
        {
            var key = Player.CurrentName + "\n" + Player.CurrentArtist;
            if (key != _lyricSongKey)
            {
                _lyricSongKey = key;
                await LoadLyricsAsync();
            }
            StateHasChanged();
        });
    }

    private string RangeMax => (Player.Duration > 1 ? Player.Duration : 1).ToString("0.###", CultureInfo.InvariantCulture);
    private string RangeValue
    {
        get
        {
            var max = Player.Duration > 1 ? Player.Duration : 1;
            var cur = Player.Current < 0 ? 0 : Player.Current;
            return (cur > max ? max : cur).ToString("0.###", CultureInfo.InvariantCulture);
        }
    }

    private void OnSeekChanged(ChangeEventArgs e)
    {
        if (double.TryParse(e.Value?.ToString(), NumberStyles.Float, CultureInfo.InvariantCulture, out var t))
            Player.Seek(t < 0 ? 0 : t);
    }

    private Task PlayPrev() => PlayerAction(() => Player.PlayIndexAsync(Player.PlayingIndex - 1), true);
    private Task PlayNext() => PlayerAction(() => Player.PlayNextAsync(), true);
    private Task PlayAt(int index) => PlayerAction(() => Player.PlayIndexAsync(index), true);

    private Task PlayPause() => PlayerAction(() =>
    {
        if (Player.PlayingIndex < 0) return Task.CompletedTask;
        if (Player.IsPlaying) Player.Pause(); else Player.Resume();
        return Task.CompletedTask;
    });

    private Task PlayStop() => PlayerAction(() =>
    {
        Player.StopPlayback();
        return Task.CompletedTask;
    });

    private async Task PlayerAction(Func<Task> action, bool reloadPlaylist = false)
    {
        try
        {
            await action();
            if (reloadPlaylist) await LoadPlaylistAsync();
        }
        catch (Exception ex) { SetMsg("播放操作失败：" + ex.Message, "red"); }
        finally { await InvokeAsync(StateHasChanged); }
    }

    /// <summary>Opens playback for the playlist current index (manual refresh only; autoPlay must not be off).</summary>
    private async Task AutoStartIfIdleAsync()
    {
        if (Player.IsPlaying || Player.PlayingIndex >= 0) return;
        if (_currentIndex < 0 || _currentIndex >= _playlist.Count) return;
        if (!AutoPlayEnabled()) return;
        await Player.PlayIndexAsync(_currentIndex);
    }

    private bool AutoPlayEnabled()
    {
        var sr = Config.GetNode("songRequest") as JsonObject;
        if (sr == null) return true;   // absent key = legacy default (true)
        return sr["autoPlay"] is not JsonValue v || !v.TryGetValue<bool>(out var b) || b;
    }

    private async Task LoadLyricsAsync()
    {
        if (Player.CurrentName.Length == 0)
        {
            _lyricLines = new List<(double, string)>();
            _lyricSource = "";
            return;
        }
        _lyricLoading = true;
        StateHasChanged();
        try
        {
            var id = "";
            var platform = Player.CurrentPlatform;
            var idx = Player.PlayingIndex;
            if (idx >= 0 && idx < _playlist.Count)
            {
                var entry = _playlist[idx];
                id = Js(entry, "id");
                if (id.Length == 0) id = Js(entry, "mid");
                if (id.Length == 0) id = Js(entry, "hash");
                if (id.Length == 0) id = Js(entry, "bvid");
                if (platform.Length == 0) platform = Js(entry, "platform");
            }
            var url = "/api/lyrics?song=" + Uri.EscapeDataString(Player.CurrentName)
                    + "&artist=" + Uri.EscapeDataString(Player.CurrentArtist)
                    + "&platform=" + Uri.EscapeDataString(platform)
                    + "&id=" + Uri.EscapeDataString(id);
            var data = await GetJson(url) as JsonObject;
            _lyricSource = Js(data, "source");
            _lyricLines = ParseLrc(Js(data, "lrc"));
        }
        catch
        {
            _lyricLines = new List<(double, string)>();
            _lyricSource = "";   // network / API failure → empty state 「暂无歌词」
        }
        finally
        {
            _lyricLoading = false;
            StateHasChanged();
        }
    }

    /// <summary>LRC → (seconds, text); one line with several timestamps keeps the first one only.</summary>
    private static List<(double Time, string Text)> ParseLrc(string lrc)
    {
        var list = new List<(double Time, string Text)>();
        if (string.IsNullOrEmpty(lrc)) return list;
        foreach (var raw in lrc.Split('\n'))
        {
            var line = raw.Trim();
            var m = LrcTag.Match(line);
            if (!m.Success) continue;
            var mm = long.TryParse(m.Groups[1].Value, out var a) ? a : 0;
            var ss = long.TryParse(m.Groups[2].Value, out var b) ? b : 0;
            var frac = m.Groups[3].Success
                ? double.TryParse("0." + m.Groups[3].Value, NumberStyles.Float, CultureInfo.InvariantCulture, out var f) ? f : 0
                : 0;
            var text = line[m.Length..].Trim();
            if (text.Length == 0) continue;
            list.Add((mm * 60 + ss + frac, text));
        }
        list.Sort((x, y) => x.Time.CompareTo(y.Time));
        return list;
    }

    private int ActiveLyricIndex()
    {
        var t = Player.Current + 0.05;
        var idx = -1;
        for (var i = 0; i < _lyricLines.Count; i++)
            if (_lyricLines[i].Time <= t) idx = i;
        return idx;
    }

    private static string LyricLineStyle(int index, int active)
        => index == active
            ? "padding:4px 6px;font-weight:600;color:var(--ink)"
            : "padding:4px 6px;color:var(--ink-3)";

    private string LyricSourceText() => _lyricSource switch
    {
        "local" => "本地 .lrc",
        "netease" => "网易云",
        "qq" => "QQ音乐",
        "kugou" => "酷狗",
        "" => "—",
        _ => _lyricSource,
    };

    private string PlayerStateText()
        => Player.IsPlaying ? "PLAYING" : Player.PlayingIndex >= 0 ? "PAUSED" : "IDLE";

    private static string NoteCls(string note)
        => note.Contains("失败") || note.Contains("无法") || note.Contains("中断") || note.Contains("停止自动")
            ? "var(--red)"
            : "var(--green)";

    private static string MmSs(double seconds)
    {
        if (double.IsNaN(seconds) || seconds < 0) seconds = 0;
        var t = (int)Math.Floor(seconds);
        return (t / 60).ToString("00") + ":" + (t % 60).ToString("00");
    }

    // ---------- loading ----------

    private async Task RefreshClicked() => await RefreshAll(true);

    private async Task RefreshAll(bool allowAutoStart)
    {
        _busy = true;
        try
        {
            await LoadConfigAsync();
            await Task.WhenAll(LoadPlaylistAsync(), LoadBlacklistAsync(), LoadRecentAsync(), LoadCookiesAsync(), LoadUpListAsync());
            if (_feedbackCls != "red") SetMsg("已刷新", "green");
            if (allowAutoStart) await AutoStartIfIdleAsync();
        }
        catch (Exception ex)
        {
            SetMsg("加载失败：" + ex.Message, "red");
        }
        finally
        {
            _busy = false;
            StateHasChanged();
        }
    }

    private async Task LoadConfigAsync()
    {
        try
        {
            var doc = await GetJson("/api/config") as JsonObject;
            if (doc == null) { SetMsg("配置读取失败：响应为空", "red"); return; }
            ApplySettings(doc["songRequest"] as JsonObject);
        }
        catch (Exception ex) { SetMsg("配置读取失败：" + ex.Message, "red"); }
    }

    private async Task LoadPlaylistAsync()
    {
        try { ApplyPlaylist(await GetJson("/api/song-request/playlist")); }
        catch (Exception ex) { SetMsg("播放列表读取失败：" + ex.Message, "red"); }
    }

    private async Task LoadBlacklistAsync()
    {
        try
        {
            var data = await GetJson("/api/song-request/blacklist") as JsonObject;
            _blacklist.Clear();
            if (data?["blacklist"] is JsonArray arr)
                foreach (var n in arr) if (n is JsonObject o) _blacklist.Add(o);
            BuildBlacklistRows();
        }
        catch (Exception ex) { SetMsg("黑名单读取失败：" + ex.Message, "red"); }
    }

    private async Task LoadRecentAsync()
    {
        try
        {
            var data = await GetJson("/api/song-request/recent") as JsonObject;
            _recent.Clear();
            if (data?["recent"] is JsonArray arr)
                foreach (var n in arr) if (n is JsonObject o) _recent.Add(o);
            BuildRecentRows();
        }
        catch (Exception ex) { SetMsg("最近点歌读取失败：" + ex.Message, "red"); }
    }

    private async Task LoadCookiesAsync()
    {
        try
        {
            var data = await GetJson("/api/song-request/cookie-status") as JsonObject;
            _ckQq = Jb(data, "qq");
            _ckNetease = Jb(data, "netease");
            _ckKugou = Jb(data, "kugou");
            _ckBili = Jb(data, "bilibili");
