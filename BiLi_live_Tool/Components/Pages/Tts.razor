    /// <summary>系统音色（sys 引擎用）：由本进程的 WinRT 语音合成器提供，不是引擎进程。</summary>
    private async Task FetchSysVoicesAsync()
    {
        try
        {
            using var resp = await Http.GetAsync(Base + "/api/tts/sys/voices");
            var text = await resp.Content.ReadAsStringAsync();
            if (JsonNode.Parse(text) is not JsonArray arr) return;
            _sysVoices.Clear();
            foreach (var node in arr)
            {
                if (node is not JsonObject o) continue;
                var name = Str(o, "ShortName");
                if (name.Length == 0) name = Str(o, "Name");
                if (name.Length == 0) continue;
                var label = Str(o, "FriendlyName");
                _sysVoices.Add(new VoiceItem(name, label.Length > 0 ? label : name, "系统音色"));
            }
        }
        catch { /* 本机没有语音平台时留空，下拉仍有当前值一条 */ }
    }

