@page "/"
@using System.Text
@using System.Text.Json.Nodes
@using BiLi_live_Tool.Services
@inject AppConfig Config
@inject LiveService Live
@inject EventHub Hub
@inject LivePipeline Pipeline
@inject KestrelHost Api
@inject TtsHost Tts
@inject VerifyService Verify
@inject DebouncedSaver Saver
@inject IJSRuntime JS
@inject NavigationManager Nav
@implements IDisposable

<div class="blt-pagehead"><h1>房间管理</h1><span class="en">ROOM MANAGE</span></div>

<div class="blt-topstrip">
    <span class="seg">status: <b class="@StateClass()">@StateText()</b></span>
    @if (Hub.LastStatus.ConnectedAt > 0)
    {
        <span class="seg">uptime <b>@Uptime()</b></span>
    }
</div>

@* Card order mirrors the legacy Electron「房间管理（设置）」page: connection → login →
   manual cookie import → auto like → record folders → blindbox map → skin. The three
   MAUI-only diagnostics cards (server / event log / quick ops) stay at the end. *@
<div class="blt-grid">
    <div class="blt-panel">
        <div class="blt-panel-head"><span class="t">🔗 直播间连接</span><span class="en">ROOM LINK</span>
            <span class="right"><span>status:</span><b class="@StateClass()">@StateText()</b></span>
        </div>
        <div class="blt-panel-body">
            <label class="blt-label">room_id</label>
            <div style="display:flex;gap:10px">
                <input class="blt-input mono" @bind="_roomId" @bind:after="SaveRoomIdSoon" placeholder="直播间号（支持短号）" @onkeydown="OnRoomKey" />
                <button class="blt-btn primary" @onclick="Connect" disabled="@(Live.IsRunning || Verify.Locked)">连接</button>
                <button class="blt-btn" @onclick="Disconnect" disabled="@(!Live.IsRunning)">断开</button>
            </div>

            <div class="blt-steps">
                <div class="blt-step @StepClass(0)">
                    <div class="s1"><span class="blt-dot @StepDot(0)"></span>解析房间</div>
                    <div class="s2">@StepText(0)</div>
                </div>
                <div class="blt-step @StepClass(1)">
                    <div class="s1"><span class="blt-dot @StepDot(1)"></span>检查开播</div>
                    <div class="s2">@StepText(1)</div>
                </div>
                <div class="blt-step @StepClass(2)">
                    <div class="s1"><span class="blt-dot @StepDot(2)"></span>连接服务器</div>
                    <div class="s2">@StepText(2)</div>
                </div>
                <div class="blt-step @StepClass(3)">
                    <div class="s1"><span class="blt-dot @StepDot(3)"></span>实时连接</div>
                    <div class="s2">@StepText(3)</div>
                </div>
            </div>

            <div style="display:flex;gap:26px;margin-top:14px;flex-wrap:wrap">
                <span class="blt-switch @_autoConnectClass" @onclick="ToggleAutoConnect">
                    <span class="track"></span>自动连接 <span class="blt-hint" style="margin:0">启动时连上次房间</span>
                </span>
                <span class="blt-switch on"><span class="track"></span>断线重连 <span class="blt-hint" style="margin:0">15s 间隔</span></span>
            </div>
            <div class="blt-hint">房间号与自动连接改动即时保存 · @AutoSaveText()</div>

            @* B站浏览器控制条 —— 固定三键，隐藏/关闭在最左（停靠时左栏 38% 可见区必可点） *@
            <div style="display:flex;gap:8px;margin-top:14px;padding-top:12px;border-top:1px dashed var(--line);align-items:center">
                <button class="blt-btn" @onclick="HideBiliBrowser" data-tip="挪到屏幕外，内存保留">隐藏浏览器</button>
                <button class="blt-btn" @onclick="CloseBiliBrowser" data-tip="销毁窗口释放内存，再打开自动重建">关闭浏览器</button>
                <button class="blt-btn primary" @onclick="OpenBiliBrowser">打开B站浏览器</button>
            </div>

            @* 闲置自动关闭（biliBrowser.idleCloseMin）：开关与分钟数都走本页自动保存 *@
            <div style="display:flex;gap:10px;margin-top:10px;align-items:center;flex-wrap:wrap">
                <span class="blt-switch @IdleSwitchClass()" @onclick="ToggleIdleClose">
                    <span class="track"></span>闲置自动关闭 B站浏览器
                </span>
                <input class="blt-input mono" type="number" min="1" max="120" step="1" style="width:76px"
                       @bind="_idleMin" @bind:after="SaveIdleSoon" disabled="@(!_idleCloseOn)" />
                <span class="blt-hint" style="margin:0">分钟（1~120）</span>
            </div>
            @if (_idleNote.Length > 0)
            {
                <div class="blt-hint" style="color:var(--amber);margin:6px 0 0">@_idleNote</div>
            }
            <div class="blt-hint">
                窗口打开时约占 150MB~0.8GB 内存；闲置（无跳转、未播放视频）超过该时长会自动关闭释放内存，再点『打开B站浏览器』可重新打开。
            </div>
        </div>
    </div>

    <div class="blt-panel">
        <div class="blt-panel-head"><span class="t">🔐 B站登录</span><span class="en">AUTH</span>
            <span class="right"><span>cookie:</span><b class="@CookieCls()">@CookieText()</b></span>
        </div>
        <div class="blt-panel-body">
            <div class="blt-kv"><span class="k">登录状态</span><span class="v @CookieCls()">@LoginText()</span></div>
            <div class="blt-kv"><span class="k">UID</span><span class="v">@(string.IsNullOrEmpty(Config.Uid) ? "—" : Config.Uid)</span></div>
            <div class="blt-kv"><span class="k">Cookie</span><span class="v">@(HasCookie() ? "已捕获（SESSDATA/bili_jct）" : "未捕获")</span></div>
            <div style="display:flex;gap:8px;margin-top:10px;flex-wrap:wrap">
                <button class="blt-btn primary" @onclick="OpenBiliBrowser">打开B站浏览器</button>
                <button class="blt-btn" @onclick="ClearLogin">清除登录态</button>
            </div>
        </div>
    </div>

    @* 📋 手动导入 Cookie — fallback when QR login is unavailable: paste the whole
       cookie string, parse the key=value pairs and write config.cookie. *@
    <div class="blt-panel">
        <div class="blt-panel-head"><span class="t">📋 手动导入 Cookie</span><span class="en">COOKIE IMPORT</span>
            <span class="right"><span>备用方式 · 没有扫码条件时使用</span></span>
        </div>
        <div class="blt-panel-body">
            <p class="blt-hint" style="margin-top:0">
                推荐用上方「B站登录」扫码。无法扫码时：按 F12 → 网络(Network) → 筛选 Fetch/XHR →
                点一个 web-room 开头的请求 → 复制「请求标头」里的整段 Cookie，粘贴到下面，会自动解析并保存。
            </p>
            <textarea class="blt-input mono" rows="4" style="min-height:76px"
                      placeholder="粘贴整段 Cookie，例如：enable_web_push=DISABLE; ...; SESSDATA=xxx; bili_jct=xxx"
                      @bind="_cookieInput" @bind:event="oninput"></textarea>
            <div style="display:flex;gap:8px;margin-top:10px;flex-wrap:wrap">
                <button class="blt-btn primary" @onclick="ImportCookie">解析并保存</button>
            </div>
            @if (_cookieInfo.Length > 0)
            {
                <div class="blt-hint" style="color:var(--green);margin:8px 0 0">@_cookieInfo</div>
            }
            @if (_cookieWarn.Length > 0)
            {
                <div class="blt-hint" style="color:var(--amber);margin:8px 0 0">@_cookieWarn</div>
            }
            @if (_cookieError.Length > 0)
            {
                <div class="blt-hint" style="color:var(--red);margin:8px 0 0">@_cookieError</div>
            }
            <div class="blt-kv"><span class="k">当前 Cookie</span><span class="v @CookieCls()">@CookieText()</span></div>
        </div>
    </div>

    @* Auto like: POST /api/like/start|stop + GET /api/like/status (1 s poll). *@
    <div class="blt-panel">
        <div class="blt-panel-head"><span class="t">👍 自动点赞</span><span class="en">AUTO LIKE</span>
            <span class="right"><span class="blt-badge @LikeBadgeCls()">@LikeBadgeText()</span></span>
        </div>
        <div class="blt-panel-body">
            <div class="blt-master @LikeMasterCls()">
                <span class="st">已点赞 <b>@_likeLiked</b> 次</span>
                <span class="sub">@LikeSubText()</span>
            </div>
            <div style="display:flex;gap:8px;flex-wrap:wrap">
                <button class="blt-btn primary" @onclick="StartLike" disabled="@(!LikeReady() || _likeRunning)">开始点赞</button>
                <button class="blt-btn" @onclick="StopLike" disabled="@(!_likeRunning)">停止</button>
            </div>
            @if (_likeError.Length > 0)
            {
                <div class="blt-hint" style="color:var(--red);margin:0">@_likeError</div>
            }
            <p class="blt-hint">
                点赞为 B站「点赞」长按协议循环发送，用于提升直播间热度；仅在已连接且已配置 Cookie 时可用。
            </p>
        </div>
    </div>

    @* 📁 记录文件夹 — absolute paths served by GET /api/status → folders. *@
    <div class="blt-panel">
        <div class="blt-panel-head"><span class="t">📁 记录文件夹</span><span class="en">RECORD FOLDERS</span>
            <span class="right"><button class="blt-btn" style="padding:2px 10px" @onclick="OpenDataFolder">打开数据目录</button></span>
        </div>
        <div class="blt-panel-body">
            @if (_folders.Count == 0)
            {
                <div class="blt-hint" style="margin-top:0">未获取到记录目录（面板服务未运行，或尚未产生记录）。</div>
            }
            else
            {
                @foreach (var f in _folders)
                {
                    <div class="blt-kv">
                        <span class="k" style="min-width:66px">@f.Label</span>
                        <span class="v" style="flex:1;margin-left:8px;font-size:12px;word-break:break-all;text-align:left">@f.Path</span>
                        <button class="blt-btn" style="padding:1px 10px;margin-left:10px" @onclick="() => OpenRowFolder(f)">打开</button>
                    </div>
                }
            }
            <div class="blt-hint">弹幕/礼物等记录文件的保存位置，点「打开」在资源管理器中定位；目录来自 GET /api/status 的 folders 字段。</div>
        </div>
    </div>

    @* 🎁 盲盒收入映射 is maintained on the gifts page in the MAUI rewrite. *@
    <div class="blt-panel">
        <div class="blt-panel-head"><span class="t">🎁 盲盒收入映射</span><span class="en">BLINDBOX MAP</span></div>
        <div class="blt-panel-body">
            <div class="blt-hint" style="margin-top:0">
                盲盒收入映射（礼物名 → 单个盲盒开出收入）在「礼物截图生成」页维护，用于计算盲盒盈亏，不影响记录。
            </div>
            <div style="display:flex;gap:8px;margin-top:10px;flex-wrap:wrap">
                <button class="blt-btn primary" @onclick="GoGiftPage">前往「礼物截图生成」</button>
            </div>
        </div>
    </div>

    @* 🎨 界面皮肤 — same theme ids / names / order as the MainLayout top strip picker. *@
    <div class="blt-panel">
        <div class="blt-panel-head"><span class="t">🎨 界面皮肤</span><span class="en">THEME</span>
            <span class="right"><button class="blt-btn" style="padding:2px 10px" @onclick="ResetFoldMemory">重置卡片折叠记忆</button></span>
        </div>
        <div class="blt-panel-body">
            <label class="blt-label">skin</label>
            <select class="blt-input" value="@_skin" @onchange="OnSkinChanged">
                <option value="classic">★ 经典默认（旧版）</option>
                    <option value="console">C 专业控制台</option>
                <option value="neon">A 暗夜霓虹</option>
                <option value="workbench">B 清爽工作台</option>
                <option value="bili">D B站应援</option>
                <option value="vibrancy">E 灵动玻璃</option>
                <option value="brutal">F 新粗野主义</option>
                <option value="hud">G 电竞 HUD</option>
                <option value="editorial">H 杂志编辑风</option>
            </select>
            <div class="blt-hint">即时生效 · 全部页面换装 · 自动保存</div>
            @if (_foldMsg.Length > 0)
            {
                <div class="blt-hint" style="color:var(--green);margin:8px 0 0">@_foldMsg</div>
            }
        </div>
    </div>

    @if (Verify.Locked)
    {
        @* 对齐旧版 renderVerifyLockCard：「🔒 账号待授权」说明卡 + 三个操作 *@
        <div class="blt-panel" style="border-color:var(--red);background:var(--red-dim)">
            <div class="blt-panel-head" style="border-bottom-color:rgba(245,110,110,.35)">
                <span class="t" style="color:var(--red)">🔒 账号待授权</span>
                <span class="en">VERIFY</span>
                <span class="right"><span>@Verify.State.CheckedAt</span></span>
            </div>
            <div class="blt-panel-body">
                <div class="blt-hint" style="color:var(--ink-2);margin:0">
                    本工具为作者白名单授权制：你的 B站账号 UID <b>@Verify.State.Uid</b> 需要<b>加入作者的白名单</b>后才能使用全部功能。
                    在授权通过前，连接直播间被锁定（已保存的配置不会丢失，授权后自动恢复）。
                    <br />原因：@Verify.State.Message
                </div>
                <div class="blt-hint" style="color:var(--ink-2);margin-top:6px">
                    获取授权：联系作者 <b>B站UID <span style="font-family:var(--mono)">@VerifyService.AuthorUid</span></b>，说明你的来意即可申请。
                </div>
                <div style="display:flex;gap:8px;flex-wrap:wrap;margin-top:10px">
                    <button class="blt-btn primary" @onclick="CopyAuthorUid2">📋 复制作者B站ID</button>
                    <button class="blt-btn" @onclick="OpenAuthorSpace2">🔗 打开作者B站主页</button>
                    <button class="blt-btn" @onclick="RetryVerify2">↻ 重试验证</button>
                    <span class="blt-hint" style="align-self:center;margin:0">@_verifyNote2</span>
                </div>
            </div>
        </div>
    }

    @* 🆕 检查更新 — MAUI 通道：只比较以 -maui 结尾的 Release 标签。 *@
    <div class="blt-panel">
        <div class="blt-panel-head"><span class="t">🆕 检查更新</span><span class="en">UPDATE</span>
            <span class="right"><span>@UpdateChannelText()</span></span>
        </div>
        <div class="blt-panel-body">
            <div class="blt-kv"><span class="k">当前版本</span><span class="v">@KestrelHost.VersionText</span></div>
            <div class="blt-kv"><span class="k">最新版本</span><span class="v @UpdValueCls()">@UpdLatestText()</span></div>
            <div class="blt-kv"><span class="k">上次检查</span><span class="v">@(_updateTime.Length > 0 ? _updateTime : "尚未检查")</span></div>
            @if (_updateMsg.Length > 0)
            {
                <div class="blt-hint" style="color:@UpdNoteColor();margin:8px 0 0">@_updateMsg</div>
            }
            @if (_updateNotes.Length > 0)
            {
                <div class="blt-log" style="max-height:150px;margin-top:10px;white-space:pre-wrap">
                    <div class="blt-logrow"><span class="txt">@_updateNotes</span></div>
                </div>
            }
            <div style="display:flex;gap:8px;flex-wrap:wrap;margin-top:12px">
                <button class="blt-btn primary" @onclick="CheckUpdateNow" disabled="@_updateBusy">@(_updateBusy ? "检查中…" : "立即检查")</button>
                <button class="blt-btn" @onclick="OpenReleasePage">打开发布页</button>
                <button class="blt-btn primary" @onclick="StartUpdateDownload" disabled="@(!_updateHasAsset || _updaterBusy)">@DownloadBtnText()</button>
                @if (_updaterPhase == "Staged")
                {
                    <button class="blt-btn amber" @onclick="ApplyUpdateNow">🔄 更新并重启</button>
                    <button class="blt-btn" @onclick="CancelUpdate">稍后</button>
                }
            </div>
            @if (_updaterMsg.Length > 0 || _updaterPercent > 0)
            {
                <div style="margin-top:10px">
                    <div style="height:6px;border-radius:3px;background:var(--line);overflow:hidden">
                        <div style="height:100%;width:@(_updaterPercent)%;background:var(--amber);transition:width .2s"></div>
                    </div>
                    <div class="blt-hint" style="margin-top:6px;color:@UpdaterNoteColor()">@_updaterMsg</div>
                </div>
            }
            <div class="blt-hint">
                点「下载并安装」会自动下载、校验 SHA256、解压到暂存目录，然后退出应用完成替换并自动重启（<b>config.json 与 data/ 原样保留</b>，旧文件备份在 update_backup/）。
                检查结果缓存 6 小时，启动时会静默检查一次；版本比较只看 <b>-maui</b> 结尾的 Release 标签。
                @if (_updateHasAsset)
                {
                    <span> 已附带更新包：<b>@_updateAssetName</b>（@UpdateAssetSizeText()）。</span>
                }
            </div>
        </div>
    </div>

    <div class="blt-panel">
        <div class="blt-panel-head"><span class="t">🖥 服务端</span><span class="en">SERVER</span></div>
        <div class="blt-panel-body">
            <div class="blt-kv"><span class="k">面板服务</span><span class="v @ApiCls()">@ApiText()</span></div>
            <div class="blt-kv"><span class="k">监听地址</span><span class="v">127.0.0.1:@Api.Port</span></div>
            <div class="blt-kv"><span class="k">Edge TTS (8020)</span><span class="v">@(EdgeRunning ? "RUNNING" : "OFF")</span></div>
            <div class="blt-kv"><span class="k">MOSS 引擎 (8021)</span><span class="v">@(MossRunning ? "RUNNING" : "按需")</span></div>
        </div>
    </div>

    <div class="blt-panel">
        <div class="blt-panel-head"><span class="t">📜 事件日志</span><span class="en">EVENT LOG</span>
            <span class="right"><span>tail -f · 缓存 @Hub.GetRecent("danmu").Count + 最近</span>
            <button class="blt-btn" style="padding:2px 10px" @onclick="ClearView">清空显示</button></span>
        </div>
        <div class="blt-panel-body" style="padding:6px 0">
            @if (_view.Count == 0)
            {
                <div class="blt-empty">等待事件… 连接后实时滚动显示 弹幕 / 礼物 / 舰长 / SC，也可用下方快捷操作模拟</div>
            }
            else
            {
                <div class="blt-log">
                    @foreach (var ev in _view)
                    {
                        <div class="blt-logrow">
                            <span class="t">@ev.Time</span>
                            <span class="tag @TagClass(ev.Type)">@TagText(ev.Type)</span>
                            <span class="txt"><span class="u">@(string.IsNullOrEmpty(ev.Uname) ? "—" : ev.Uname)</span> @EventText(ev)</span>
                        </div>
                    }
                </div>
            }
        </div>
    </div>

    <div class="blt-panel">
        <div class="blt-panel-head"><span class="t">⚡ 快捷操作</span><span class="en">QUICK OPS</span>
            <span class="right"><span>dev · 走完整事件管线</span></span>
        </div>
        <div class="blt-panel-body">
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px">
                <button class="blt-btn" @onclick="SimDanmu">模拟弹幕</button>
                <button class="blt-btn" @onclick="SimGifts">模拟礼物</button>
                <button class="blt-btn" @onclick="SimGuard">模拟舰长</button>
                <button class="blt-btn" @onclick="SimSc">模拟 SC</button>
                <button class="blt-btn" @onclick="SimFollow">模拟关注</button>
                <button class="blt-btn" @onclick="SimWelcome">模拟进房</button>
            </div>
        </div>
    </div>
</div>

@code {
    private static readonly HttpClient Http = new() { Timeout = TimeSpan.FromSeconds(10) };

    private string _roomId = "";
    private string _autoConnectClass = "";
    private bool _autoConnectBool;
    private List<LiveEvent> _view = new();

    // Auto-save status for the room settings written through Config.ReplaceFrom.
    private DateTime? _savedAt;
    private string _saveMsg = "";

    // 闲置自动关闭 B站浏览器（biliBrowser.idleCloseMin；0 = 关闭该行为）。
    private const int DefaultIdleMin = 10;
    private const int MaxIdleMin = 120;
    private bool _idleCloseOn = true;
    private int _idleMin = DefaultIdleMin;
    private string _idleNote = "";
    private long _idleSeenAt;   // last observed MainPage.BiliIdleClosedAt (notice de-dup)

    // Repaint batching: OnEvent only marks a dirty counter; this 300 ms timer turns a
    // burst of hub events into a single StateHasChanged.
    private System.Threading.Timer? _flushTimer;
    private int _pendingEvents;

    // Auto like state, refreshed by the 1 s poll below.
    private System.Threading.Timer? _likeTimer;
    private bool _likeRunning;
    private int _likeLiked;
    private string _likeError = "";

    // Manual cookie import (📋 手动导入 Cookie).
    private string _cookieInput = "";
    private string _cookieInfo = "";
    private string _cookieWarn = "";
    private string _cookieError = "";

    // Record folder rows (📁 记录文件夹), loaded from GET /api/status → folders.
    private static readonly (string Key, string Label)[] FolderDefs =
    {
        ("danmu", "弹幕记录"),
        ("gifts", "礼物记录"),
        ("blindbox", "盲盒记录"),
        ("guard", "舰长记录"),
        ("superchat", "SC 记录"),
    };
    private readonly List<(string Label, string Path)> _folders = new();

    // Skin picker (🎨 界面皮肤): ids/order copied from the MainLayout top strip.
    private static readonly string[] Themes =
    {
        "classic", "console", "neon", "workbench", "bili", "vibrancy", "brutal", "hud", "editorial",
    };
    private string _skin = "console";
    private string _foldMsg = "";

    // ---- 检查更新（MAUI 通道）----
    private string _updateTime = "";
    private string _updateLatest = "";
    private string _updateMsg = "";
    private string _updateNotes = "";
