@page "/danmu"
@using System.Text.Json
@using System.Text.Json.Nodes
@inject KestrelHost Api
@inject AppConfig Config
@inject IJSRuntime JS
@inject EventHub Hub

<div class="blt-pagehead"><h1>弹幕显示浮层</h1><span class="en">DANMU OVERLAY</span></div>

<div class="blt-topstrip">
    <span class="seg">浮层状态 <b class="@(_cfg.Enabled ? "green" : "ink-3")">@(_cfg.Enabled ? "已启用" : "已停用")</b></span>
    <span class="seg">预设皮肤 <b class="amber">@ThemeDisplayName(_cfg.Theme)</b></span>
    <span class="seg">OBS 链接 <b class="mono" style="font-size:11px">@OverlayUrl()</b></span>
    <span class="seg" style="gap:6px">
        <button class="blt-btn" style="padding:2px 8px" @onclick="CopyOverlayUrl"><BltIcon Name="copy" /> 复制链接</button>
        <a class="blt-btn" style="padding:2px 8px;text-decoration:none" href="@OverlayUrl()" target="_blank" rel="noopener"><BltIcon Name="external" /> 浏览器打开</a>
    </span>
    <span class="seg" style="margin-left:auto;gap:6px">
        <button class="blt-btn" style="padding:2px 10px" @onclick="SendTestDanmu">测试普通弹幕</button>
        <button class="blt-btn" style="padding:2px 10px" @onclick="SendTestEmoteDanmu">测试表情弹幕</button>
        <button class="blt-btn amber" style="padding:2px 10px" @onclick="SendTestGuardDanmu">测试舰长弹幕</button>
        <button class="blt-btn" style="padding:2px 10px;background:rgba(255,77,109,0.2);color:#ff4d6d;border:1px solid rgba(255,77,109,0.4)" @onclick="SendTestGovernorDanmu">测试总督弹幕</button>
        <button class="blt-btn subtle" style="padding:2px 10px" @onclick="ResetCurrentThemeDefaults">恢复皮肤默认值</button>
        <button class="blt-btn blue" style="padding:2px 12px;font-weight:600" @onclick="SaveConfig">保存配置</button>
    </span>
</div>

@if (!string.IsNullOrEmpty(_note))
{
    <div style="margin-bottom:10px;padding:6px 12px;border-radius:var(--r);font-size:12px;background:@(_noteOk ? "rgba(46,204,113,0.15)" : "rgba(231,76,60,0.15)");border:1px solid @(_noteOk ? "rgba(46,204,113,0.4)" : "rgba(231,76,60,0.4)");color:@(_noteOk ? "#2ecc71" : "#e74c3c")">
        @_note
    </div>
}

<div class="blt-grid blt-cols-2" style="align-items:start">
    @* ── 左侧：配置参数控制台 ── *@
    <div>
        @* 皮肤与全局布局 *@
        <div class="blt-panel" style="margin-bottom:12px">
            <div class="blt-panel-head">
                <span class="t"><BltIcon Emoji="🎨" /> 皮肤预设与布局模式</span>
                <span class="en">THEME & LAYOUT</span>
            </div>
            <div class="blt-panel-body">
                <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px">
                    <div>
                        <label class="blt-label">预设皮肤</label>
                        <select class="blt-input" value="@_cfg.Theme" @onchange="OnThemeSelectChanged">
                            <option value="classic-glass">★ 现代半透明极简玻璃 (Classic Glass)</option>
                            <option value="frost-palace">❄️ 凛冬圣殿 · 冰凌结晶 (冰晶花环冰魄羽翼)</option>
                            <option value="violet-cyber">⚡ 幻紫电竞 · 赛博光环 (八边视窗脉冲翼)</option>
                            <option value="titan-tactical">🛡️ 战术重工 · 钛金雷达 (防爆装甲重装翼)</option>
                            <option value="monvhuajia">🌸 魔女花嫁 · 梦幻昼白 (精美蕾丝花架)</option>
                            <option value="monvhuajia-night">🌙 魔女花嫁 · 暗夜幽魅 (紫藤夜月)</option>
                            <option value="rose-throne">🌹 蔷薇王座 · 哥特绯红 (荆棘皇冠双翼)</option>
                            <option value="cyber-night">⚡ 赛博迷幻夜 · 霓虹幻境 (机甲光环浮空翼)</option>
                            <option value="neko-cute">🐾 萌系猫咪 · 糖粉猫爪 (萌猫耳肉球丝带翼)</option>
                            <option value="strawberry-bunny">🍓 草莓兔兔 · 甜莓奶霜 (萌耳草莓圈双翼)</option>
                            <option value="magic-card">🔮 魔法卡牌 · 库洛幻彩 (星芒塔罗阵羽翼)</option>
                            <option value="butterfly-wind">🦋 蝶月风铃 · 幽夜幻蝶 (幽蓝风铃月影蝶翼)</option>
                            <option value="jinx-graffiti">⚡ 街头涂鸦 · 狂潮电音 (朋克电音闪电翼)</option>
                            <option value="neon-station">📡 霓虹基站 · 矩阵脉冲 (轨道HUD电路翼)</option>
                            <option value="tulip-letter">🌷 郁金香信 · 晨曦花园 (复古花信火漆翼)</option>
                            <option value="star-moon-gold">👑 星海月球 · 坠夜黑金 (奢华星轨星云双翼)</option>
                            <option value="flower-hymn">⚜️ 花与诗颂 · 欧风古典 (欧式金叶洛可可花枝)</option>
                            <option value="ark-rhodes">🛡️ 方舟终端 · 罗德战备 (工业装甲雷达双翼)</option>
                            <option value="rainbow-sunny">🌈 彩虹星晴 · 甜彩梦境 (梦幻云朵七彩光辉翼)</option>
                            <option value="cat-cookies">🍪 小猫曲奇 · 甜蜜烘焙 (奶油猫耳可颂麦穗翼)</option>
                            <option value="memory-diary">📒 谁的日记 · 手账贴纸 (胶带相框撕边便签翼)</option>
                            <option value="eldritch-eye">👁️ 暗夜深渊 · 诡谲骨眼 (魔眼骨环恶魔翼)</option>
                            <option value="sakura-wafuu">🌸 樱华落雪 · 绯樱结 (水引绯樱花筏翼)</option>
                            <option value="bakery-shop">🍞 面包小店 · 暖心手账 (牛角包麦穗手账翼)</option>
                            <option value="candy-game">🍬 糖果游戏 · 炫彩电玩 (像素按键彩虹翼)</option>
                            <option value="win98-retro">💻 Win98 · 复古视窗 (经典视窗标题栏)</option>
                            <option value="openlivechat">💬 仿油管气泡 · 纯享风 (YouTube 纯享气泡)</option>
                        </select>
                    </div>
                    <div>
                        <label class="blt-label">显示排列模式</label>
                        <select class="blt-input" @bind="_cfg.DisplayMode">
                            <option value="card">气泡卡片模式 (Card)</option>
                            <option value="flat">紧凑通栏单行模式 (Flat)</option>
                        </select>
                    </div>
                </div>

                <div style="display:flex;gap:16px;margin-top:10px;align-items:center">
                    <label class="blt-check"><input type="checkbox" @bind="_cfg.Enabled" /> 启用弹幕浮层</label>
                    <label class="blt-check"><input type="checkbox" @bind="_cfg.ShowMedal" /> 显示粉丝勋章</label>
                </div>
            </div>
        </div>

        @* 常驻固定底框（看板）设置 *@
        <div class="blt-panel" style="margin-bottom:12px">
            <div class="blt-panel-head">
                <span class="t"><BltIcon Emoji="🔲" /> 弹幕常驻固定底框（看板容器）</span>
                <span class="en">PERMANENT CANVAS BOX</span>
            </div>
            <div class="blt-panel-body">
                <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:10px">
                    <label class="blt-check" style="font-weight:600">
                        <input type="checkbox" @bind="_cfg.ShowBox" /> 开启常驻固定底框（常驻显示弹幕区域，不会随弹幕消失）
                    </label>
                    <span style="font-size:12px;color:var(--ink-3)">适合在直播间标定弹幕机固定区域</span>
                </div>

                @if (_cfg.ShowBox)
                {
                    @* 快捷预设尺寸 *@
                    <div style="margin-bottom:12px;padding:8px 10px;background:var(--bg-2);border-radius:6px;border:1px solid var(--line)">
                        <div style="display:flex;align-items:center;gap:6px;flex-wrap:wrap">
                            <span style="font-size:11px;color:var(--ink-2);font-weight:600">快捷预设尺寸：</span>
                            <button class="blt-btn subtle" style="padding:2px 8px;font-size:11px" @onclick="() => SetBoxPreset(320, 450)">小巧精致 (320 × 450)</button>
                            <button class="blt-btn subtle" style="padding:2px 8px;font-size:11px" @onclick="() => SetBoxPreset(380, 520)">经典标准 (380 × 520)</button>
                            <button class="blt-btn subtle" style="padding:2px 8px;font-size:11px" @onclick="() => SetBoxPreset(450, 650)">宽屏大版 (450 × 650)</button>
                            <button class="blt-btn subtle" style="padding:2px 8px;font-size:11px" @onclick="() => SetBoxPreset(380, 780)">瘦长通顶 (380 × 780)</button>
                        </div>
                    </div>

                    @* 底框尺寸（宽与高） *@
                    <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:12px">
                        <div>
                            <div style="display:flex;justify-content:space-between">
                                <label class="blt-label">底框宽度 (@_cfg.BoxWidth px)</label>
                                <span style="font-size:11px;color:var(--ink-3)">推荐 320~480</span>
                            </div>
                            <input type="range" min="200" max="800" step="10" @bind="_cfg.BoxWidth" @bind:event="oninput" style="width:100%" />
                        </div>
                        <div>
                            <div style="display:flex;justify-content:space-between">
                                <label class="blt-label">底框高度 (@_cfg.BoxHeight px)</label>
                                <span style="font-size:11px;color:var(--ink-3)">推荐 400~800</span>
                            </div>
                            <input type="range" min="200" max="1000" step="10" @bind="_cfg.BoxHeight" @bind:event="oninput" style="width:100%" />
                        </div>
                    </div>

                    @* 底框色彩与透明度 *@
                    <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:12px">
                        <div>
                            <label class="blt-label">底框背景颜色</label>
                            <div style="display:flex;gap:6px;align-items:center">
                                <input type="color" @bind="_cfg.BoxBgColor" style="width:36px;height:28px;border:none;border-radius:4px;cursor:pointer;background:none;padding:0" />
                                <input class="blt-input mono" @bind="_cfg.BoxBgColor" style="flex:1;padding:2px 6px;font-size:11px" />
                            </div>
                        </div>
                        <div>
                            <label class="blt-label">底框背景透明度 (@_cfg.BoxBgOpacity%)</label>
                            <input type="range" min="0" max="100" step="5" @bind="_cfg.BoxBgOpacity" @bind:event="oninput" style="width:100%" />
                        </div>
                    </div>

                    @* 底框圆角与内边距 *@
                    <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px">
                        <div>
                            <label class="blt-label">底框圆角 (@_cfg.BoxRadius px)</label>
                            <input type="range" min="0" max="36" step="1" @bind="_cfg.BoxRadius" @bind:event="oninput" style="width:100%" />
                        </div>
                        <div>
                            <label class="blt-label">底框内边距 (@_cfg.BoxPadding px)</label>
                            <input type="range" min="4" max="32" step="2" @bind="_cfg.BoxPadding" @bind:event="oninput" style="width:100%" />
                        </div>
                    </div>

                    @* 底框边框设置 *@
                    <div style="margin-top:12px;padding-top:10px;border-top:1px dashed var(--line)">
                        <div style="display:flex;align-items:center;gap:12px;margin-bottom:8px">
                            <label class="blt-check"><input type="checkbox" @bind="_cfg.ShowBoxBorder" /> 开启底框外边框</label>
                        </div>
                        @if (_cfg.ShowBoxBorder)
                        {
                            <div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:10px">
                                <div>
                                    <label class="blt-label">边框颜色</label>
                                    <div style="display:flex;gap:6px;align-items:center">
                                        <input type="color" @bind="_cfg.BoxBorderColor" style="width:36px;height:28px;border:none;border-radius:4px;cursor:pointer;background:none;padding:0" />
                                        <input class="blt-input mono" @bind="_cfg.BoxBorderColor" style="flex:1;padding:2px 6px;font-size:11px" />
                                    </div>
                                </div>
                                <div>
                                    <label class="blt-label">边框透明度 (@_cfg.BoxBorderOpacity%)</label>
                                    <input type="range" min="0" max="100" step="5" @bind="_cfg.BoxBorderOpacity" @bind:event="oninput" style="width:100%" />
                                </div>
                                <div>
                                    <label class="blt-label">边框粗细 (@_cfg.BoxBorderWidth px)</label>
                                    <input type="range" min="1" max="8" step="1" @bind="_cfg.BoxBorderWidth" @bind:event="oninput" style="width:100%" />
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>

        @* 昵称设置 *@
        <div class="blt-panel" style="margin-bottom:12px">
            <div class="blt-panel-head">
                <span class="t"><BltIcon Emoji="👤" /> 昵称文字样式</span>
                <span class="en">NICKNAME</span>
            </div>
            <div class="blt-panel-body">
                <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px">
                    <div>
                        <label class="blt-label">昵称字体</label>
                        <select class="blt-input" @bind="_cfg.NicknameFont">
                            <option value="system-ui">系统默认无衬线字体</option>
                            <option value="Microsoft YaHei">微软雅黑</option>
                            <option value="SimHei">黑体</option>
                            <option value="KaiTi">楷体</option>
                            <option value="Consolas">等宽代码体 (Consolas)</option>
                        </select>
                    </div>
                    <div>
                        <label class="blt-label">昵称字号大小 (@_cfg.NicknameSize px)</label>
                        <input type="range" min="12" max="32" step="1" @bind="_cfg.NicknameSize" @bind:event="oninput" style="width:100%" />
                    </div>
                </div>

                <div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:10px;margin-top:10px;align-items:center">
                    <div>
                        <label class="blt-label">昵称颜色</label>
                        <div style="display:flex;gap:6px;align-items:center">
                            <input type="color" @bind="_cfg.NicknameColor" style="width:36px;height:28px;border:none;border-radius:4px;cursor:pointer;background:none;padding:0" />
                            <input class="blt-input mono" @bind="_cfg.NicknameColor" style="flex:1;padding:2px 6px;font-size:11px" />
                        </div>
                    </div>
                    <div>
                        <label class="blt-label">昵称透明度 (@_cfg.NicknameOpacity%)</label>
                        <input type="range" min="0" max="100" step="5" @bind="_cfg.NicknameOpacity" @bind:event="oninput" style="width:100%" />
                    </div>
                    <div style="padding-top:14px">
                        <label class="blt-check"><input type="checkbox" @bind="_cfg.NicknameBold" /> 昵称加粗显示</label>
                    </div>
                </div>
            </div>
        </div>

        @* 弹幕设置 *@
        <div class="blt-panel" style="margin-bottom:12px">
            <div class="blt-panel-head">
                <span class="t"><BltIcon Emoji="💬" /> 弹幕文字样式</span>
                <span class="en">DANMU CONTENT</span>
            </div>
            <div class="blt-panel-body">
                <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px">
                    <div>
                        <label class="blt-label">弹幕字体</label>
                        <select class="blt-input" @bind="_cfg.DanmuFont">
                            <option value="system-ui">系统默认无衬线字体</option>
                            <option value="Microsoft YaHei">微软雅黑</option>
                            <option value="SimHei">黑体</option>
                            <option value="KaiTi">楷体</option>
                            <option value="Consolas">等宽代码体 (Consolas)</option>
                        </select>
                    </div>
                    <div>
                        <label class="blt-label">弹幕字号大小 (@_cfg.DanmuSize px)</label>
                        <input type="range" min="12" max="36" step="1" @bind="_cfg.DanmuSize" @bind:event="oninput" style="width:100%" />
                    </div>
                </div>

                <div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:10px;margin-top:10px">
                    <div>
                        <label class="blt-label">弹幕颜色</label>
                        <div style="display:flex;gap:6px;align-items:center">
                            <input type="color" @bind="_cfg.DanmuColor" style="width:36px;height:28px;border:none;border-radius:4px;cursor:pointer;background:none;padding:0" />
                            <input class="blt-input mono" @bind="_cfg.DanmuColor" style="flex:1;padding:2px 6px;font-size:11px" />
                        </div>
                    </div>
                    <div>
                        <label class="blt-label">弹幕透明度 (@_cfg.DanmuOpacity%)</label>
                        <input type="range" min="0" max="100" step="5" @bind="_cfg.DanmuOpacity" @bind:event="oninput" style="width:100%" />
                    </div>
                    <div>
                        <label class="blt-label">描边与阴影</label>
                        <select class="blt-input" @bind="_cfg.DanmuStroke">
                            <option value="none">无阴影描边</option>
                            <option value="shadow">柔和抗疲劳阴影</option>
                            <option value="heavy-shadow">清晰重阴影</option>
                            <option value="outline">硬朗黑色描边</option>
                        </select>
                    </div>
                </div>
            </div>
        </div>

        @* 背景与边框设置 *@
        <div class="blt-panel" style="margin-bottom:12px">
            <div class="blt-panel-head">
                <span class="t"><BltIcon Emoji="🔲" /> 背景与边框</span>
                <span class="en">BACKGROUND & BORDER</span>
            </div>
            <div class="blt-panel-body">
                <div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:10px">
                    <div>
                        <label class="blt-label">背景底色</label>
                        <div style="display:flex;gap:6px;align-items:center">
                            <input type="color" @bind="_cfg.BgColor" style="width:36px;height:28px;border:none;border-radius:4px;cursor:pointer;background:none;padding:0" />
                            <input class="blt-input mono" @bind="_cfg.BgColor" style="flex:1;padding:2px 6px;font-size:11px" />
                        </div>
                    </div>
                    <div>
                        <label class="blt-label">背景透明度 (@_cfg.BgOpacity%)</label>
                        <input type="range" min="0" max="100" step="5" @bind="_cfg.BgOpacity" @bind:event="oninput" style="width:100%" />
                    </div>
                    <div>
                        <label class="blt-label">卡片圆角 (@_cfg.CardRadius px)</label>
                        <input type="range" min="0" max="28" step="1" @bind="_cfg.CardRadius" @bind:event="oninput" style="width:100%" />
                    </div>
                </div>

                <div style="margin-top:10px;padding-top:8px;border-top:1px dashed var(--line)">
                    <div style="display:flex;align-items:center;gap:12px;margin-bottom:6px">
                        <label class="blt-check"><input type="checkbox" @bind="_cfg.ShowBorder" /> 开启卡片外边框</label>
                    </div>
                    @if (_cfg.ShowBorder)
                    {
                        <div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:10px">
                            <div>
                                <label class="blt-label">边框颜色</label>
                                <div style="display:flex;gap:6px;align-items:center">
                                    <input type="color" @bind="_cfg.BorderColor" style="width:36px;height:28px;border:none;border-radius:4px;cursor:pointer;background:none;padding:0" />
                                    <input class="blt-input mono" @bind="_cfg.BorderColor" style="flex:1;padding:2px 6px;font-size:11px" />
                                </div>
                            </div>
                            <div>
                                <label class="blt-label">边框透明度 (@_cfg.BorderOpacity%)</label>
                                <input type="range" min="0" max="100" step="5" @bind="_cfg.BorderOpacity" @bind:event="oninput" style="width:100%" />
                            </div>
                            <div>
                                <label class="blt-label">边框粗细 (@_cfg.BorderWidth px)</label>
                                <input type="range" min="1" max="6" step="1" @bind="_cfg.BorderWidth" @bind:event="oninput" style="width:100%" />
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

        @* ── 大航海专属个性化样式（舰长 / 提督 / 总督）· 可折叠 ── *@
        <div class="blt-panel" style="margin-bottom:12px;border:1px solid @(_expandGuardSettings ? "var(--brand)" : "var(--line)")">
            <div class="blt-panel-head" style="user-select:none;display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:8px">
                <div style="display:flex;align-items:center;gap:8px">
                    <span class="t"><BltIcon Emoji="💎" /> 大航海专属个性化样式（舰长 / 提督 / 总督）</span>
                    <span class="en">GUARD STYLES</span>
                </div>
                
                <div style="display:flex;align-items:center;gap:10px">
                    @* 折叠状态下的常驻总开关（用户直接点击切换，打开时显示不同边框，关闭时显示全局统一边框） *@
                    <label class="blt-check" style="margin:0;font-weight:600;font-size:12px;cursor:pointer;display:flex;align-items:center;gap:6px" @onclick:stopPropagation="true">
                        <input type="checkbox" @bind="_cfg.CustomGuardStyle" /> 启用专属样式
                    </label>

                    @if (_cfg.CustomGuardStyle)
                    {
                        <span class="blt-pill" style="font-size:10px;background:rgba(186,136,235,0.25);color:#ba88eb;border:1px solid rgba(186,136,235,0.5)">
                            已启用专属边框与色彩
                        </span>
                    }
                    else
                    {
                        <span class="blt-pill" style="font-size:10px;background:rgba(255,255,255,0.06);color:var(--ink-3);border:1px solid var(--line)">
                            已关闭 · 全局统一边框
                        </span>
                    }

                    <button type="button" class="blt-btn subtle" style="padding:2px 8px;font-size:12px;color:var(--brand);font-weight:600" @onclick="() => _expandGuardSettings = !_expandGuardSettings">
                        @(_expandGuardSettings ? "收起配置 ▲" : "展开配置 ▼")
                    </button>
                </div>
            </div>

            @if (_expandGuardSettings)
            {
                <div class="blt-panel-body">
                    <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:12px;padding:8px 12px;background:@(_cfg.CustomGuardStyle ? "rgba(186,136,235,0.08)" : "rgba(255,255,255,0.03)");border:1px solid @(_cfg.CustomGuardStyle ? "rgba(186,136,235,0.3)" : "var(--line)");border-radius:6px">
                        <div style="font-size:12px">
                            @if (_cfg.CustomGuardStyle)
                            {
                                <span style="color:#ba88eb;font-weight:600">🟢 大航海专属样式已启用：</span>
                                <span style="color:var(--ink-2)">总督、提督、舰长弹幕将展示下方配置的专属独立边框色、背景色与昵称高亮色。</span>
                            }
                            else
                            {
                                <span style="color:var(--ink-3);font-weight:600">⚪ 大航海专属样式已关闭：</span>
                                <span style="color:var(--ink-2)">所有弹幕的边框与背景将与普通弹幕保持一致（统一边框）。您仍可在下方预先配置各项色彩，开启后即刻生效。</span>
                            }
                        </div>
                        <button type="button" class="blt-btn subtle" style="padding:3px 10px;font-size:11px;flex-shrink:0;margin-left:12px" @onclick="ResetGuardColors">恢复大航海默认配色</button>
                    </div>

                    @* 无论总开关开启还是关闭，下方 3 个大航海级别配置全部可见并可调节！绝不再出现空白！ *@
                    @* 1. 总督 (Guard Level 1) *@
                    <div style="background:rgba(255,255,255,0.02);border:1px solid rgba(255,77,109,0.35);border-radius:8px;padding:12px;margin-bottom:10px">
                        <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:8px">
                            <div style="display:flex;align-items:center;gap:8px">
                                <span style="font-size:11px;padding:2px 8px;border-radius:4px;font-weight:700;background:linear-gradient(135deg,#ff4d6d,#c9184a);color:#fff">👑 总督 (Governor)</span>
                                <span style="font-size:11px;color:var(--ink-3)">最高荣誉大航海身份 · 专属尊享配色</span>
                            </div>
                            @if (!_cfg.CustomGuardStyle)
                            {
                                <span style="font-size:11px;color:var(--ink-3)">（总开关关闭中，开启后生效）</span>
                            }
                        </div>
                        <div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:10px">
                            <div>
                                <label class="blt-label">卡片背景色</label>
                                <div style="display:flex;gap:6px;align-items:center">
                                    <input type="color" @bind="_cfg.GovernorBgColor" style="width:36px;height:28px;border:none;border-radius:4px;cursor:pointer;background:none;padding:0" />
                                    <input class="blt-input mono" @bind="_cfg.GovernorBgColor" style="flex:1;padding:2px 6px;font-size:11px" />
                                </div>
                            </div>
                            <div>
                                <label class="blt-label">背景透明度 (@_cfg.GovernorBgOpacity%)</label>
                                <input type="range" min="0" max="100" step="5" @bind="_cfg.GovernorBgOpacity" @bind:event="oninput" style="width:100%" />
                            </div>
                            <div>
                                <label class="blt-label">昵称/高亮强调色</label>
                                <div style="display:flex;gap:6px;align-items:center">
                                    <input type="color" @bind="_cfg.GovernorTextColor" style="width:36px;height:28px;border:none;border-radius:4px;cursor:pointer;background:none;padding:0" />
                                    <input class="blt-input mono" @bind="_cfg.GovernorTextColor" style="flex:1;padding:2px 6px;font-size:11px" />
                                </div>
                            </div>
                        </div>
                        <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:8px">
                            <div>
                                <label class="blt-label">边框颜色</label>
                                <div style="display:flex;gap:6px;align-items:center">
                                    <input type="color" @bind="_cfg.GovernorBorderColor" style="width:36px;height:28px;border:none;border-radius:4px;cursor:pointer;background:none;padding:0" />
                                    <input class="blt-input mono" @bind="_cfg.GovernorBorderColor" style="flex:1;padding:2px 6px;font-size:11px" />
                                </div>
                            </div>
                            <div>
                                <label class="blt-label">边框透明度 (@_cfg.GovernorBorderOpacity%)</label>
                                <input type="range" min="0" max="100" step="5" @bind="_cfg.GovernorBorderOpacity" @bind:event="oninput" style="width:100%" />
                            </div>
                        </div>
                    </div>

                    @* 2. 提督 (Guard Level 2) *@
                    <div style="background:rgba(255,255,255,0.02);border:1px solid rgba(199,125,255,0.35);border-radius:8px;padding:12px;margin-bottom:10px">
                        <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:8px">
                            <div style="display:flex;align-items:center;gap:8px">
                                <span style="font-size:11px;padding:2px 8px;border-radius:4px;font-weight:700;background:linear-gradient(135deg,#9d4edd,#7b2cbf);color:#fff">🔱 提督 (Admiral)</span>
                                <span style="font-size:11px;color:var(--ink-3)">高阶大航海荣誉身份 · 专属华丽配色</span>
                            </div>
                            @if (!_cfg.CustomGuardStyle)
                            {
                                <span style="font-size:11px;color:var(--ink-3)">（总开关关闭中，开启后生效）</span>
                            }
                        </div>
                        <div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:10px">
                            <div>
                                <label class="blt-label">卡片背景色</label>
                                <div style="display:flex;gap:6px;align-items:center">
                                    <input type="color" @bind="_cfg.AdmiralBgColor" style="width:36px;height:28px;border:none;border-radius:4px;cursor:pointer;background:none;padding:0" />
                                    <input class="blt-input mono" @bind="_cfg.AdmiralBgColor" style="flex:1;padding:2px 6px;font-size:11px" />
                                </div>
                            </div>
                            <div>
                                <label class="blt-label">背景透明度 (@_cfg.AdmiralBgOpacity%)</label>
                                <input type="range" min="0" max="100" step="5" @bind="_cfg.AdmiralBgOpacity" @bind:event="oninput" style="width:100%" />
                            </div>
                            <div>
                                <label class="blt-label">昵称/高亮强调色</label>
                                <div style="display:flex;gap:6px;align-items:center">
                                    <input type="color" @bind="_cfg.AdmiralTextColor" style="width:36px;height:28px;border:none;border-radius:4px;cursor:pointer;background:none;padding:0" />
                                    <input class="blt-input mono" @bind="_cfg.AdmiralTextColor" style="flex:1;padding:2px 6px;font-size:11px" />
                                </div>
                            </div>
                        </div>
                        <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:8px">
                            <div>
                                <label class="blt-label">边框颜色</label>
                                <div style="display:flex;gap:6px;align-items:center">
                                    <input type="color" @bind="_cfg.AdmiralBorderColor" style="width:36px;height:28px;border:none;border-radius:4px;cursor:pointer;background:none;padding:0" />
                                    <input class="blt-input mono" @bind="_cfg.AdmiralBorderColor" style="flex:1;padding:2px 6px;font-size:11px" />
                                </div>
                            </div>
                            <div>
                                <label class="blt-label">边框透明度 (@_cfg.AdmiralBorderOpacity%)</label>
                                <input type="range" min="0" max="100" step="5" @bind="_cfg.AdmiralBorderOpacity" @bind:event="oninput" style="width:100%" />
                            </div>
                        </div>
                    </div>

                    @* 3. 舰长 (Guard Level 3) *@
                    <div style="background:rgba(255,255,255,0.02);border:1px solid rgba(78,168,222,0.35);border-radius:8px;padding:12px">
                        <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:8px">
                            <div style="display:flex;align-items:center;gap:8px">
                                <span style="font-size:11px;padding:2px 8px;border-radius:4px;font-weight:700;background:linear-gradient(135deg,#0077b6,#023e8a);color:#fff">⚓ 舰长 (Captain)</span>
                                <span style="font-size:11px;color:var(--ink-3)">经典大航海中坚力量 · 专属深蓝配色</span>
                            </div>
                            @if (!_cfg.CustomGuardStyle)
                            {
                                <span style="font-size:11px;color:var(--ink-3)">（总开关关闭中，开启后生效）</span>
                            }
                        </div>
                        <div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:10px">
                            <div>
                                <label class="blt-label">卡片背景色</label>
                                <div style="display:flex;gap:6px;align-items:center">
                                    <input type="color" @bind="_cfg.CaptainBgColor" style="width:36px;height:28px;border:none;border-radius:4px;cursor:pointer;background:none;padding:0" />
                                    <input class="blt-input mono" @bind="_cfg.CaptainBgColor" style="flex:1;padding:2px 6px;font-size:11px" />
                                </div>
                            </div>
                            <div>
                                <label class="blt-label">背景透明度 (@_cfg.CaptainBgOpacity%)</label>
                                <input type="range" min="0" max="100" step="5" @bind="_cfg.CaptainBgOpacity" @bind:event="oninput" style="width:100%" />
                            </div>
                            <div>
                                <label class="blt-label">昵称/高亮强调色</label>
                                <div style="display:flex;gap:6px;align-items:center">
                                    <input type="color" @bind="_cfg.CaptainTextColor" style="width:36px;height:28px;border:none;border-radius:4px;cursor:pointer;background:none;padding:0" />
                                    <input class="blt-input mono" @bind="_cfg.CaptainTextColor" style="flex:1;padding:2px 6px;font-size:11px" />
                                </div>
                            </div>
                        </div>
                        <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:8px">
                            <div>
                                <label class="blt-label">边框颜色</label>
                                <div style="display:flex;gap:6px;align-items:center">
                                    <input type="color" @bind="_cfg.CaptainBorderColor" style="width:36px;height:28px;border:none;border-radius:4px;cursor:pointer;background:none;padding:0" />
                                    <input class="blt-input mono" @bind="_cfg.CaptainBorderColor" style="flex:1;padding:2px 6px;font-size:11px" />
                                </div>
                            </div>
                            <div>
                                <label class="blt-label">边框透明度 (@_cfg.CaptainBorderOpacity%)</label>
                                <input type="range" min="0" max="100" step="5" @bind="_cfg.CaptainBorderOpacity" @bind:event="oninput" style="width:100%" />
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        @* 头像设置 *@
        <div class="blt-panel" style="margin-bottom:12px">
            <div class="blt-panel-head">
                <span class="t"><BltIcon Emoji="🖼" /> 观众头像设置</span>
                <span class="en">AVATAR</span>
            </div>
            <div class="blt-panel-body">
                <div style="display:flex;align-items:center;gap:12px;margin-bottom:8px">
                    <label class="blt-check"><input type="checkbox" @bind="_cfg.ShowAvatar" /> 显示观众头像（取消勾选则一键隐藏头像，仅保留文字）</label>
                </div>
                @if (_cfg.ShowAvatar)
                {
                    <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px">
                        <div>
                            <label class="blt-label">头像外形</label>
                            <select class="blt-input" @bind="_cfg.AvatarShape">
                                <option value="circle">圆形 (Circle)</option>
                                <option value="rounded">圆角矩形 (Rounded)</option>
                                <option value="square">正方形 (Square)</option>
                            </select>
                        </div>
                        <div>
                            <label class="blt-label">头像大小 (@_cfg.AvatarSize px)</label>
                            <input type="range" min="20" max="60" step="2" @bind="_cfg.AvatarSize" @bind:event="oninput" style="width:100%" />
                        </div>
                    </div>

                    <div style="margin-top:10px;padding-top:8px;border-top:1px dashed var(--line)">
                        <div style="display:flex;align-items:center;gap:12px;margin-bottom:6px">
                            <label class="blt-check"><input type="checkbox" @bind="_cfg.ShowAvatarBorder" /> 开启头像外边框</label>
                        </div>
                        @if (_cfg.ShowAvatarBorder)
                        {
                            <div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:10px">
                                <div>
                                    <label class="blt-label">头像边框颜色</label>
                                    <div style="display:flex;gap:6px;align-items:center">
                                        <input type="color" @bind="_cfg.AvatarBorderColor" style="width:36px;height:28px;border:none;border-radius:4px;cursor:pointer;background:none;padding:0" />
                                        <input class="blt-input mono" @bind="_cfg.AvatarBorderColor" style="flex:1;padding:2px 6px;font-size:11px" />
                                    </div>
                                </div>
                                <div>
                                    <label class="blt-label">边框透明度 (@_cfg.AvatarBorderOpacity%)</label>
                                    <input type="range" min="0" max="100" step="5" @bind="_cfg.AvatarBorderOpacity" @bind:event="oninput" style="width:100%" />
                                </div>
                                <div>
                                    <label class="blt-label">边框粗细 (@_cfg.AvatarBorderWidth px)</label>
                                    <input type="range" min="1" max="5" step="1" @bind="_cfg.AvatarBorderWidth" @bind:event="oninput" style="width:100%" />
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>

        @* 动效与停留时间 *@
        <div class="blt-panel">
            <div class="blt-panel-head">
                <span class="t"><BltIcon Emoji="⏱" /> 动效与展示规则</span>
                <span class="en">ANIMATION & LIFETIME</span>
            </div>
            <div class="blt-panel-body">
                <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:12px">
                    <div>
                        <label class="blt-label">入场动画</label>
                        <select class="blt-input" @bind="_cfg.Animation">
                            <option value="slide">底部平滑滑入 (Slide Up)</option>
                            <option value="fade">原地平滑淡入 (Fade In)</option>
                            <option value="bounce">灵动弹跳入场 (Bounce In)</option>
                            <option value="none">秒出无动效 (Instant)</option>
                        </select>
                    </div>
                    <div>
                        <label class="blt-label">同屏最大弹幕条数 (@_cfg.MaxCount 条)</label>
                        <input type="range" min="3" max="30" step="1" @bind="_cfg.MaxCount" @bind:event="oninput" style="width:100%" />
                    </div>
                </div>

                @* 独立突出的持续时间控件 *@
                <div style="padding:10px;background:rgba(255,255,255,0.03);border:1px solid var(--line);border-radius:8px">
                    <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:6px">
                        <label class="blt-label" style="margin:0;font-weight:600">
                            ⏱ 弹幕显示持续时间（每条弹幕停留多久）
                        </label>
                        <span class="blt-badge" style="font-size:11px;font-weight:600;color:var(--brand)">
                            @(_cfg.StayDuration == 0 ? "常驻不消失" : $"{_cfg.StayDuration} 秒")
                        </span>
                    </div>
                    <div style="display:flex;align-items:center;gap:12px;margin-bottom:8px">
                        <input type="range" min="0" max="60" step="1" @bind="_cfg.StayDuration" @bind:event="oninput" style="flex:1" />
                        <div style="display:flex;align-items:center;gap:4px;width:90px">
                            <input type="number" min="0" max="120" class="blt-input mono" @bind="_cfg.StayDuration" style="text-align:center;padding:2px 4px" />
                            <span style="font-size:11px;color:var(--ink-3)">秒</span>
                        </div>
                    </div>
                    <div style="display:flex;gap:6px;flex-wrap:wrap;align-items:center">
                        <span style="font-size:11px;color:var(--ink-3)">快捷预设：</span>
                        <button class="blt-btn subtle" style="padding:1px 6px;font-size:11px" @onclick="() => _cfg.StayDuration = 5">5秒</button>
                        <button class="blt-btn subtle" style="padding:1px 6px;font-size:11px" @onclick="() => _cfg.StayDuration = 10">10秒</button>
                        <button class="blt-btn subtle" style="padding:1px 6px;font-size:11px" @onclick="() => _cfg.StayDuration = 15">15秒 (推荐)</button>
                        <button class="blt-btn subtle" style="padding:1px 6px;font-size:11px" @onclick="() => _cfg.StayDuration = 30">30秒</button>
                        <button class="blt-btn subtle" style="padding:1px 6px;font-size:11px" @onclick="() => _cfg.StayDuration = 0">常驻不消失 (0秒)</button>
                    </div>
                    <div style="font-size:11px;color:var(--ink-3);margin-top:6px">
                        💡 提示：设置为 0 秒时弹幕将常驻显示，不自动淡出移除，直到超出同屏最大条数被新弹幕顶替。
                    </div>
                </div>
            </div>
        </div>
    </div>

    @* ── 右侧：1:1 动态实时交互预览画布 ── *@
    <div>
        <div class="blt-panel" style="position:sticky;top:10px">
            <div class="blt-panel-head">
                <span class="t"><BltIcon Emoji="👁" /> 1:1 动态实时预览画布</span>
                <span class="en">LIVE PREVIEW</span>
                <span class="right">
                    <span style="font-size:11px;color:var(--ink-3)">底衬模拟：</span>
                    <select class="blt-input" style="width:120px;padding:1px 6px;font-size:11px" @bind="_previewBg">
                        <option value="dark">极夜深黑</option>
                        <option value="checker">透明棋盘格</option>
                        <option value="game">模拟游戏画面</option>
                    </select>
                </span>
            </div>
            <div class="blt-panel-body" style="padding:0;overflow:hidden">
                <div style="@PreviewContainerStyle()">
                    <div style="@PreviewStageBoxStyle()">
                        @if (_cfg.ShowBox)
                        {
                            <div style="font-size:10px;font-family:monospace;color:rgba(255,255,255,0.45);text-align:right;margin-bottom:6px;user-select:none">
                                📌 常驻固定底框 · @_cfg.BoxWidth × @_cfg.BoxHeight px
                            </div>
                        }
                        <div style="@PreviewStageStyle()">
                            @* 模拟弹幕 1：普通粉丝 *@
                            <div style="@ItemCardStyle(0)">
                                @if (IsWin98Theme)
                                {
                                    <div style="display:flex;align-items:center;justify-content:space-between;width:100%;height:18px;background:@Win98TitleBg(0);padding:0 4px;margin-bottom:4px;box-sizing:border-box">
                                        <div style="display:flex;align-items:center;gap:4px">
                                            <img src="legacy/danmu/themes/win98-retro/win98-pc.svg" style="width:12px;height:12px" alt="icon" />
                                            <span style="font-size:10px;font-family:'SimSun',monospace;font-weight:700;color:#ffffff">@Win98TitleText(0)</span>
                                        </div>
                                        <img src="legacy/danmu/themes/win98-retro/win98-btns.svg" style="height:12px;object-fit:contain" alt="btns" />
                                    </div>
                                }
                                @if (HasThemeOrnaments)
                                {
                                    <div style="position:absolute;right:4px;top:0;bottom:0;width:140px;background:url('@ThemePatternUrl(0)') no-repeat right center;background-size:contain;pointer-events:none;opacity:0.85;z-index:0"></div>
                                }
                                <div style="display:flex;align-items:flex-start;gap:8px;width:100%">
                                    @if (_cfg.ShowAvatar)
                                    {
                                        <div style="flex-shrink:0;width:@(_cfg.AvatarSize)px;height:@(_cfg.AvatarSize)px;position:relative;z-index:2">
                                            <img src="@TestFanAvatar" style="@AvatarImageStyle()" referrerpolicy="no-referrer" alt="avatar" />
                                            @if (HasThemeOrnaments)
                                            {
                                                <img src="@ThemeAvatarFrameUrl(0)" style="position:absolute;width:165%;height:165%;left:-32%;top:-33%;pointer-events:none;z-index:3" alt="frame" />
                                            }
                                        </div>
                                    }
                                    @if (HasThemeOrnaments)
                                    {
                                        <div style="width:4px;align-self:stretch;background:url('@ThemeDotUrl()') repeat-y center;background-size:contain;opacity:0.75;margin:0 2px;flex-shrink:0;z-index:2"></div>
                                    }
                                    <div style="flex:1;min-width:0;display:flex;flex-direction:column;justify-content:center;position:relative;z-index:2">
                                        <div style="display:flex;align-items:center;gap:6px;flex-wrap:wrap;margin-bottom:2px">
