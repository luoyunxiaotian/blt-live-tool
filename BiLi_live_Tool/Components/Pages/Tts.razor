    private List<VoiceItem> ShownVoices()
    {
        var filter = _voiceFilter.Trim();
        IEnumerable<VoiceItem> src = _voices;
        if (filter.Length > 0)
            src = src.Where(v => v.Name.Contains(filter, StringComparison.OrdinalIgnoreCase)
                              || v.Label.Contains(filter, StringComparison.OrdinalIgnoreCase));
        // Favorites are rendered in their own optgroup → keep them out of the main list.
        var list = src.Where(v => !_favorites.Contains(v.Name)).Take(50).ToList();
        if (_voice.Length > 0 && !_favorites.Contains(_voice) && !list.Any(v => v.Name == _voice))
            list.Insert(0, new VoiceItem(_voice, _voice + "（当前配置）", false));
        return list;
    }

    private static string VoiceLabel(string name, string friendly, string gender)
    {
        if (ZhVoices.TryGetValue(name, out var zh)) return zh + " · " + name;
        if (friendly.Length > 0)
        {
            var f = friendly.Replace("Microsoft ", "").Replace(" Online (Natural)", "").Replace(" - ", " · ");
            return f + " · " + name;
        }
        var g = gender == "Female" ? "女" : gender == "Male" ? "男" : gender;
        return g.Length > 0 ? name + "（" + g + "）" : name;
    }

    private static string NormalizeEngine(string e)
        => e == "moss" || e == "sys" ? e : "edge";

    private static string ToneDesc(JsonObject? p)
    {
        if (p == null) return "";
        var parts = new List<string>();
        var rate = Dbl(p, "rate", 1);
        if (Math.Abs(rate - 1) > 0.001) parts.Add("语速 ×" + rate.ToString("0.##", CultureInfo.InvariantCulture));
        var pitch = Dbl(p, "pitch", 0);
        if (Math.Abs(pitch) > 0.001) parts.Add("音调 " + (pitch > 0 ? "+" : "") + pitch.ToString("0.##", CultureInfo.InvariantCulture) + "Hz");
        var voice = Str(p, "voice");
        if (voice.Length > 0) parts.Add("音色 " + voice);
        var prefix = Str(p, "prefix");
        if (prefix.Length > 0) parts.Add("前缀 「" + prefix + "」");
        if (parts.Count == 0) parts.Add("原声（无调整）");
        return string.Join(" · ", parts);
    }

