@page "/song"
@using System.Globalization
@using System.Text
@using System.Text.Json.Nodes
@using System.Text.RegularExpressions
@inject AppConfig Config
@inject SongPlayer Player
@inject BiLi_live_Tool.Services.DebouncedSaver Saver
@inject IJSRuntime JS
@inject BiLi_live_Tool.Services.UiKit UI
@inject BiLi_live_Tool.Services.KestrelHost Api
@implements IDisposable

<div class="blt-pagehead"><h1>点歌功能</h1><span class="en">SONG REQUEST</span></div>

<div class="blt-topstrip">
    <span class="seg">播放列表 <b>@_playlist.Count</b> 首@(CurSeg())</span>
    <span class="seg">cookie
        <span class="blt-badge @CkCls(_ckQq)">QQ</span>
        <span class="blt-badge @CkCls(_ckNetease)">网易云</span>
        <span class="blt-badge @CkCls(_ckKugou)">酷狗</span>
        <span class="blt-badge @CkCls(_ckBili)">B站</span>
    </span>
    <span class="seg" style="margin-left:auto">
        @if (_feedback.Length > 0)
        {
            <span class="blt-badge @_feedbackCls">@_feedback</span>
        }
    </span>
    <span class="seg">
        <button class="blt-btn" style="padding:3px 12px" @onclick="RefreshClicked" disabled="@_busy">刷新</button>
    </span>
</div>

<div class="blt-platform-bar">
    <span class="lbl"><BltIcon Emoji="🎵" /> 点歌平台</span>
    <span class="opts">
        <button class="blt-btn @(_platform == "qq" ? "on" : "")" @onclick="PickQq">QQ音乐</button>
        <button class="blt-btn @(_platform == "netease" ? "on" : "")" @onclick="PickNetease">网易云音乐</button>
        <button class="blt-btn @(_platform == "kugou" ? "on" : "")" @onclick="PickKugou">酷狗音乐</button>
        <button class="blt-btn @(_platform == "bilibili" ? "on" : "")" @onclick="PickBilibili">B站</button>
    </span>
    <span class="right" style="margin-left:auto;display:flex;align-items:center;gap:8px">
        <span class="blt-switch lg @BigSwitchClass()" @onclick="ToggleEnabled"><span class="track"></span>@(_enabled ? "ON" : "OFF")</span>
        <span class="lbl">启用弹幕点歌</span>
    </span>
    <span class="tip">这个平台同时用于「弹幕点歌」和「手动搜索」；观众发送「@KeywordText() + 歌名」即点歌。当前：<b>@PlatName(_platform)</b>@( _enabled ? "" : " · 已停用")</span>
</div>

<div class="blt-grid blt-cols-2">
    @* ── 左列：设置 / 搜索 / 黑名单 ── *@
    <div>
        <div class="blt-panel">
            <div class="blt-panel-head">
                <span class="t"><BltIcon Emoji="⚙" />点歌设置</span><span class="en">SETTINGS</span>
                <span class="right"><span>songRequest · POST /api/config</span></span>
            </div>
            <div class="blt-panel-body">
                @* Master switch (songRequest.enabled): promoted from the page header to the top of this card. *@
                <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px 14px">
                    <div>
                        <label class="blt-label">触发关键词</label>
                        <input class="blt-input" @bind="_keyword" @bind:after="SaveSettingsTextSoon" placeholder="点歌" />
                    </div>
                    <div>
                        <label class="blt-label">每日上限（0=不限）</label>
                        <input class="blt-input" type="number" min="0" @bind="_maxDaily" @bind:after="SaveSettingsTextSoon" />
                    </div>
                    <div>
                        <label class="blt-label">全局冷却（秒）</label>
                        <input class="blt-input" type="number" min="0" @bind="_cooldownSec" @bind:after="SaveSettingsTextSoon" />
                    </div>
                    <div>
                        <label class="blt-label">每用户冷却（秒）</label>
                        <input class="blt-input" type="number" min="0" @bind="_userCooldownSec" @bind:after="SaveSettingsTextSoon" />
                    </div>
                    <div>
                        <label class="blt-label">最低粉丝勋章</label>
                        <input class="blt-input" type="number" min="0" @bind="_fanMedalMin" @bind:after="SaveSettingsTextSoon" />
                    </div>
                    <div>
                        <label class="blt-label">最低荣誉等级</label>
                        <input class="blt-input" type="number" min="0" @bind="_honorLevelMin" @bind:after="SaveSettingsTextSoon" />
                    </div>
                    <div>
                        <label class="blt-label">仅舰长可点</label>
                        <span class="blt-switch @OnOff(_guardOnly)" @onclick="ToggleGuardOnly">
                            <span class="track"></span>@OnOffText(_guardOnly)
                        </span>
                    </div>
                    <div>
                        <label class="blt-label">去重（分钟内不重复）</label>
                        <div style="display:flex;gap:8px;align-items:center">
                            <span class="blt-switch @OnOff(_dedupEnabled)" @onclick="ToggleDedup">
                                <span class="track"></span>@OnOffText(_dedupEnabled)
                            </span>
                            <input class="blt-input" type="number" min="0" style="width:72px" @bind="_dedupMin" @bind:after="SaveSettingsTextSoon" disabled="@(!_dedupEnabled)" />
                        </div>
                    </div>
                </div>
                @* 保存设置 button replaced by the auto-save status line (every edit writes through immediately). *@
                <div style="display:flex;gap:14px;align-items:center;flex-wrap:wrap;margin-top:14px;padding-top:10px;border-top:1px dashed var(--line)">
                    <span class="blt-hint" style="margin:0">@AutoSaveText()</span>
                    <span class="blt-hint" style="margin:0">改动即时生效 · 回写整份配置，黑名单 / Cookie / UP 名单等未展示字段原样保留</span>
                </div>
            </div>
        </div>

        <div class="blt-panel">
            <div class="blt-panel-head">
                <span class="t"><BltIcon Emoji="🔍" /> 手动搜索</span><span class="en">SEARCH</span>
                <span class="right"><span>POST /api/song-request/search</span></span>
            </div>
            <div class="blt-panel-body">
                <div style="display:flex;gap:8px">
                    <select class="blt-input" style="width:112px;flex:none" @bind="_searchType">
                        <option value="smart">智能搜索</option>
                        <option value="song">按歌名</option>
                        <option value="artist">按歌手</option>
                        <option value="lyric">按歌词</option>
                    </select>
                    <input class="blt-input" @bind="_searchKeyword" @bind:event="oninput" @onkeydown="OnSearchKey"
                           placeholder="歌曲名 / 歌手 / 歌词片段" />
                    <button class="blt-btn primary" style="flex:none" @onclick="DoSearch" disabled="@_busy">搜索</button>
                </div>
                @if (_searching)
                {
                    <div class="blt-empty">搜索中…（走当前平台，可能需要数秒）</div>
                }
                else if (_results.Count == 0)
                {
                    <div class="blt-empty">暂无搜索结果 · 命中后点「添加」进入播放列表</div>
                }
                else
                {
                    <div style="margin-top:10px">
                        @foreach (var r in _searchRows)
                        {
                            <div style="display:flex;align-items:center;gap:8px;padding:5px 0;border-bottom:1px dashed var(--line)">
                                <span style="flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">@r.Title</span>
                                <span class="blt-badge @r.PlatformBadgeCls">@r.PlatformBadgeName</span>
                                <span class="blt-badge @r.VipBadgeCls">@r.VipBadgeText</span>
                                <button class="blt-btn" style="padding:3px 10px;flex:none" @onclick="r.Add" disabled="@_busy">添加</button>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>

        <div class="blt-panel">
            <div class="blt-panel-head">
                <span class="t"><BltIcon Emoji="🚫" /> 黑名单</span><span class="en">BLACKLIST</span>
                <span class="right"><span>共 @_blacklist.Count 条 · 包含匹配</span></span>
            </div>
            <div class="blt-panel-body">
                <div style="display:flex;gap:8px">
                    <select class="blt-input" style="width:96px;flex:none" @bind="_blType">
                        <option value="song">歌曲</option>
                        <option value="artist">歌手</option>
                    </select>
                    <input class="blt-input" @bind="_blValue" @bind:event="oninput" @onkeydown="OnBlacklistKey"
                           placeholder="歌曲名或歌手名" />
                    <button class="blt-btn" style="flex:none" @onclick="AddBlacklist" disabled="@_busy">添加</button>
                </div>
                @if (_blacklist.Count == 0)
                {
                    <div class="blt-empty">黑名单为空</div>
                }
                else
                {
                    <div style="margin-top:8px">
                        @foreach (var b in _blacklistRows)
                        {
                            <div style="display:flex;align-items:center;gap:10px;padding:5px 0;border-bottom:1px dashed var(--line)">
                                <span class="blt-badge @b.TypeCls" style="flex:none">@b.TypeText</span>
                                <span style="flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">@b.Value</span>
                                <button class="blt-btn" style="padding:3px 10px" @onclick="b.Remove" disabled="@_busy">删除</button>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>

    @* ── 右列：播放列表 / Cookie / 最近点歌 ── *@
    <div>
        <div class="blt-panel">
            <div class="blt-panel-head">
                <span class="t"><BltIcon Emoji="🎵" /> 播放列表</span><span class="en">PLAYLIST</span>
                <span class="right">
                    <span>@_playlist.Count 首 · idx @(_currentIndex)</span>
                    <button class="blt-btn" style="padding:2px 10px" @onclick="SkipCurrent" disabled="@_busy">跳过当前</button>
                    <button class="blt-btn" style="padding:2px 10px" @onclick="ClearPlaylist" disabled="@_busy">清空</button>
                </span>
            </div>
            <div class="blt-panel-body" style="padding:4px 0">
                @if (_playlist.Count == 0)
                {
                    <div class="blt-empty">播放列表为空 · 弹幕「@KeywordText() + 歌名」或在此手动搜索添加</div>
                }
                else
                {
                    @foreach (var row in _playlistRows)
                    {
                        @* draggable + data-index are the contract of wwwroot/blt-drag.js; the
                           ↑ / ↓ buttons stay as the accessible / no-JS fallback. *@
                        <div style="@row.RowStyle" draggable="true" data-index="@row.Index" data-blt-drag="playlist"
                             title="拖动调整播放顺序（也可用 ↑ / ↓ 按钮）">
                            <span style="@row.NoStyle">@row.NoText</span>
                            <span style="flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">
                                @row.Title<span style="color:var(--ink-3)"> - @row.Artist</span>
                                <span class="blt-badge @row.PlatformBadgeCls">@row.PlatformBadgeName</span>
                                <span class="blt-badge @row.VipBadgeCls">@row.VipBadgeText</span>
                                @if (row.IsCurrent)
                                {
                                    <span class="blt-badge amber">当前</span>
                                }
                                @if (row.Index == Player.PlayingIndex)
                                {
                                    <span class="blt-badge @(Player.IsPlaying ? "green" : "off")">@(Player.IsPlaying ? "播放中" : "已暂停")</span>
                                }
                            </span>
                            <span style="width:104px;flex:none;color:var(--ink-2);font-size:11.5px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">@row.Requester</span>
                            <span style="flex:none;display:flex;gap:6px">
                                <button class="blt-btn" style="padding:3px 8px" @onclick="row.Play">▶</button>
                                <button class="blt-btn" style="padding:3px 8px" @onclick="row.MoveUp" disabled="@(!row.CanUp || _busy)">↑</button>
                                <button class="blt-btn" style="padding:3px 8px" @onclick="row.MoveDown" disabled="@(!row.CanDown || _busy)">↓</button>
                                <button class="blt-btn" style="padding:3px 8px" @onclick="row.Remove" disabled="@_busy">删除</button>
                            </span>
                        </div>
                    }
                    <div class="blt-hint" style="padding:6px 12px 0;margin:0">拖动行可直接调整播放顺序 · 也可用 ↑ / ↓ 按钮逐行移动</div>
                }
            </div>
        </div>

        @* ── 播放器 ── *@
        <div class="blt-panel">
            <div class="blt-panel-head">
                <span class="t">▶ 播放器</span><span class="en">PLAYER</span>
                <span class="right">
                    <span>@PlayerStateText()</span>
                    <span class="blt-badge @PlatCls(Player.CurrentPlatform)">@(Player.CurrentPlatform.Length > 0 ? PlatName(Player.CurrentPlatform) : "—")</span>
                </span>
            </div>
            <div class="blt-panel-body">
                <div style="display:flex;align-items:center;gap:8px;min-height:22px">
                    @if (Player.CurrentName.Length > 0)
                    {
                        <span style="flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">
                            <b>@Player.CurrentName</b>
                            @if (Player.CurrentArtist.Length > 0)
                            {
                                <span style="color:var(--ink-3)"> - @Player.CurrentArtist</span>
                            }
                            @if (Player.CurrentRequester.Length > 0)
                            {
                                <span class="blt-badge blue">+ @Player.CurrentRequester</span>
                            }
                        </span>
                    }
                    else
                    {
                        <span class="blt-hint" style="flex:1;margin:0">未在播放 · 弹幕点歌或点列表「▶」开播</span>
                    }
                </div>
                @if (Player.LastNote.Length > 0)
                {
                    <div class="blt-hint" style="font-family:var(--mono);margin:6px 0 0;color:@NoteCls(Player.LastNote)">@Player.LastNote</div>
                }
                <div style="display:flex;gap:6px;align-items:center;margin-top:10px;flex-wrap:wrap">
                    <button class="blt-btn" style="padding:3px 10px" @onclick="PlayPrev" disabled="@(Player.PlayingIndex < 1)">⏮ 上一首</button>
                    <button class="blt-btn primary" style="padding:3px 12px" @onclick="PlayPause" disabled="@(Player.PlayingIndex < 0)">@(Player.IsPlaying ? "⏸ 暂停" : "▶ 播放")</button>
                    <button class="blt-btn" style="padding:3px 10px" @onclick="PlayNext" disabled="@(_playlist.Count == 0)">⏭ 跳过</button>
                    <button class="blt-btn" style="padding:3px 10px" @onclick="PlayStop" disabled="@(Player.PlayingIndex < 0)">⏹ 停止</button>
                </div>
                <div style="display:flex;align-items:center;gap:10px;margin-top:10px">
                    <input type="range" min="0" max="@RangeMax" step="0.5" value="@RangeValue"
                           style="flex:1;accent-color:var(--amber)" @onchange="OnSeekChanged" />
                    <span class="blt-hint" style="font-family:var(--mono);color:var(--ink-2);flex:none;margin:0">@MmSs(Player.Current) / @MmSs(Player.Duration)</span>
                </div>
                <p class="blt-hint">
                    播放走新版内建音频链路（/api/song-request/song-url + blt-audio.js），进度同时上报 OBS 歌词浮层。
                </p>
            </div>
        </div>

        @* ── OBS 歌词浮层（原版 lyrics/overlay.html，OBS 里加浏览器源指向该地址） ── *@
        <div class="blt-panel">
            <div class="blt-panel-head">
                <span class="t"><BltIcon Emoji="📜" /> OBS 歌词浮层</span><span class="en">OBS OVERLAY</span>
                <span class="right"><span>OBS 浏览器源</span></span>
            </div>
            <div class="blt-panel-body">
                <div class="blt-kv">
                    <span class="k">浮层地址</span>
                    <span class="v"><span class="mono" style="font-size:11.5px">@OverlayUrl</span></span>
                </div>
                <div style="display:flex;gap:8px;margin-top:8px;flex-wrap:wrap">
                    <button class="blt-btn" @onclick="CopyOverlayUrl">复制地址</button>
                    <button class="blt-btn" @onclick="OpenOverlay">在浏览器里预览</button>
                </div>
                <div class="blt-hint" style="margin-top:8px">
                    OBS：来源 → 浏览器 → 粘贴上面的地址，建议竖屏比例（如 420×760）。歌词随播放进度滚动；
                    播放时进度会通过 WebSocket 的 song_progress 帧推送（未播放时浮层显示等待状态）。
                </div>
            </div>
        </div>

        @* ── 歌词 ── *@
        <div class="blt-panel">
            <div class="blt-panel-head">
                <span class="t"><BltIcon Emoji="📜" /> 歌词</span><span class="en">LYRICS</span>
                <span class="right"><span>GET /api/lyrics · @LyricSourceText()</span></span>
            </div>
            <div class="blt-panel-body" style="padding:8px">
                @if (_lyricLoading)
                {
                    <div class="blt-empty">歌词加载中…</div>
                }
                else if (_lyricLines.Count == 0)
                {
                    <div class="blt-empty">@LyricEmptyReason()</div>
                    <div style="display:flex;justify-content:center;gap:8px;margin-top:8px">
                        <button class="blt-btn" @onclick="LoadLyricsAsync" disabled="@_lyricLoading">重试</button>
                        <button class="blt-btn" @onclick="CopyOverlayUrl" title="复制 OBS 歌词浮层地址">复制浮层地址</button>
                    </div>
                }
                else
                {
                    var active = ActiveLyricIndex();
                    <div id="blt-lyric-box" style="height:300px;overflow-y:auto;padding:2px 4px;scroll-behavior:smooth">
                        @for (var i = 0; i < _lyricLines.Count; i++)
                        {
                            <div class="@(i == active ? "blt-lyric-on" : "")" style="@LyricLineStyle(i, active)">@_lyricLines[i].Text</div>
                        }
                    </div>
                }
            </div>
        </div>

        <div class="blt-panel">
            <div class="blt-panel-head">
                <span class="t"><BltIcon Emoji="🍪" />平台 Cookie</span><span class="en">COOKIE</span>
                <span class="right"><span>VIP 歌曲需要登录态</span></span>
            </div>
            <div class="blt-panel-body">
                <div class="blt-kv">
                    <span class="k">QQ音乐</span>
                    <span class="v"><span class="blt-badge @CkCls(_ckQq)">@CkText(_ckQq)</span></span>
                </div>
                <div style="display:flex;gap:8px;margin:6px 0 12px">
                    <BltSecretInput @bind-Value="_cookieQq" Placeholder="粘贴 QQ音乐 Cookie（留空保存 = 清除）" />
                    <button class="blt-btn" style="flex:none" @onclick="SaveQqCookie" disabled="@_busy">保存</button>
                    <button class="blt-btn" style="flex:none" title="在内置浏览器打开登录页，扫码/登录后自动抓取 Cookie 并保存"
                            @onclick="LoginQq"><BltIcon Emoji="🌐" /> 应用内登录</button>
                    <button class="blt-btn" style="flex:none" title="查询是否已捕获到该平台的登录态"
                            @onclick="CheckQq">检测</button>
                    <button class="blt-btn" style="flex:none" title="清除该平台已保存的 Cookie"
                            @onclick="ClearQq">清除</button>
                </div>

                <div class="blt-kv">
                    <span class="k">网易云音乐</span>
                    <span class="v"><span class="blt-badge @CkCls(_ckNetease)">@CkText(_ckNetease)</span></span>
                </div>
                <div style="display:flex;gap:8px;margin:6px 0 12px">
                    <BltSecretInput @bind-Value="_cookieNetease" Placeholder="粘贴 网易云 Cookie（MUSIC_U=...）" />
                    <button class="blt-btn" style="flex:none" @onclick="SaveNeteaseCookie" disabled="@_busy">保存</button>
                    <button class="blt-btn" style="flex:none" title="在内置浏览器打开登录页，扫码/登录后自动抓取 Cookie 并保存"
                            @onclick="LoginNetease"><BltIcon Emoji="🌐" /> 应用内登录</button>
                    <button class="blt-btn" style="flex:none" title="查询是否已捕获到该平台的登录态"
                            @onclick="CheckNetease">检测</button>
                    <button class="blt-btn" style="flex:none" title="清除该平台已保存的 Cookie"
                            @onclick="ClearNetease">清除</button>
                </div>

                <div class="blt-kv">
                    <span class="k">酷狗音乐</span>
                    <span class="v"><span class="blt-badge @CkCls(_ckKugou)">@CkText(_ckKugou)</span></span>
                </div>
                <div style="display:flex;gap:8px;margin:6px 0 12px">
                    <BltSecretInput @bind-Value="_cookieKugou" Placeholder="粘贴 酷狗 Cookie（留空保存 = 清除）" />
                    <button class="blt-btn" style="flex:none" @onclick="SaveKugouCookie" disabled="@_busy">保存</button>
                    <button class="blt-btn" style="flex:none" title="在内置浏览器打开登录页，扫码/登录后自动抓取 Cookie 并保存"
                            @onclick="LoginKugou"><BltIcon Emoji="🌐" /> 应用内登录</button>
                    <button class="blt-btn" style="flex:none" title="查询是否已捕获到该平台的登录态"
                            @onclick="CheckKugou">检测</button>
                    <button class="blt-btn" style="flex:none" title="清除该平台已保存的 Cookie"
                            @onclick="ClearKugou">清除</button>
                </div>

                @if (_musicLoginMsg.Length > 0)
                {
                    <div class="blt-hint" style="margin:0 0 8px;color:var(--amber-ink)">@_musicLoginMsg</div>
                }
                <div class="blt-kv">
                    <span class="k">B站</span>
                    <span class="v"><span class="blt-badge @CkCls(_ckBili)">@CkText(_ckBili)</span></span>
                </div>
                <div style="display:flex;gap:8px;margin-top:8px;align-items:center">
                    <button class="blt-btn" @onclick="OpenBiliBrowser">打开B站浏览器</button>
                    <span class="blt-hint" style="margin:0">登录后自动捕获并同步 B站 Cookie（SESSDATA / bili_jct）</span>
                </div>

                <div style="margin-top:14px;padding-top:10px;border-top:1px dashed var(--line)">
                    <label class="blt-label">B站 UP 主名单 · 仅搜索名单内 UP 主的视频</label>
                    <div style="display:flex;gap:8px">
                        <input class="blt-input mono" @bind="_newUid" @bind:event="oninput" @onkeydown="OnUidKey" placeholder="输入 UP 主 UID（纯数字）" />
                        <button class="blt-btn" style="flex:none" @onclick="AddUid" disabled="@_busy">添加</button>
                    </div>
                    @if (_upList.Count == 0)
                    {
                        <div class="blt-empty">名单为空 · B站平台将搜索不到任何结果</div>
                    }
                    else
                    {
                        <div style="margin-top:8px;max-height:220px;overflow-y:auto">
                            @foreach (var u in _upRows)
                            {
                                <div style="display:flex;align-items:center;gap:10px;padding:4px 0;border-bottom:1px dashed var(--line)">
                                    <span style="flex:1;font-family:var(--mono);font-size:12px">@u.Uid</span>
                                    <button class="blt-btn" style="padding:3px 10px" @onclick="u.Remove" disabled="@_busy">删除</button>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="blt-panel">
            <div class="blt-panel-head">
                <span class="t"><BltIcon Emoji="🕒" /> 最近点歌</span><span class="en">RECENT</span>
                <span class="right"><span>最近 @(_recentRows.Count) 条 · GET /api/song-request/recent</span></span>
            </div>
            <div class="blt-panel-body" style="padding:6px 0">
                @if (_recentRows.Count == 0)
                {
                    <div class="blt-empty">暂无点歌记录</div>
                }
                else
                {
                    <div class="blt-log" style="max-height:260px">
                        @foreach (var r in _recentRows)
                        {
                            <div class="blt-logrow">
                                <span class="t">@r.Time</span>
                                <span class="tag @r.StatusCls">@r.StatusText</span>
                                <span class="txt"><span class="u">@r.Uname</span> @r.Song</span>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@code {
    // ---------- remote data ----------
    private readonly List<JsonObject> _playlist = new();
    private readonly List<JsonObject> _blacklist = new();
    private readonly List<JsonObject> _recent = new();
    private readonly List<string> _upList = new();
    private readonly List<JsonObject> _results = new();

