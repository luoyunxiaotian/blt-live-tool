    private string AvatarImageStyle()
    {
        var radius = _cfg.AvatarShape == "circle" ? "50%" : (_cfg.AvatarShape == "rounded" ? "8px" : "0px");
        var b = _cfg.ShowAvatarBorder && _cfg.AvatarBorderWidth > 0
            ? $"{_cfg.AvatarBorderWidth}px solid {HexToRgba(_cfg.AvatarBorderColor, _cfg.AvatarBorderOpacity)}"
            : "none";
        return $"width:100%;height:100%;border-radius:{radius};border:{b};object-fit:cover;display:block;";
    }

