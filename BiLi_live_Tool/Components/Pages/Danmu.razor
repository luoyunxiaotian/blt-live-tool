    private void SaveConfig()
    {
        try
        {
            var jsonStr = JsonSerializer.Serialize(_cfg);
            if (JsonNode.Parse(jsonStr) is JsonObject obj)
            {
                var doc = Config.Snapshot();
                doc["danmuOverlay"] = obj;
                Config.ReplaceFrom(doc);
                Hub.PublishOutbound("danmu_config_update", obj);
                Notify("弹幕浮层配置已保存，OBS 浮层已实时同步更新！", true);
            }
        }
        catch (Exception ex)
        {
            Notify("保存失败: " + ex.Message, false);
        }
    }

