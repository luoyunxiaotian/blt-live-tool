    private void ApplyPlaylist(JsonNode? data)
    {
        _playlist.Clear();
        if (data?["playlist"] is JsonArray arr)
            foreach (var n in arr) if (n is JsonObject o) _playlist.Add(o);
        _currentIndex = (int)Jl(data as JsonObject, "currentIndex", -1);
        BuildPlaylistRows();
    }

    private void ApplySettings(JsonObject? sr)
    {
        if (sr == null) return;
        _enabled = Jb(sr, "enabled");
        _platform = Js(sr, "platform");
        if (_platform.Length == 0) _platform = "qq";
        var kw = Js(sr, "keyword");
        _keyword = kw.Length > 0 ? kw : "点歌";
        _cooldownSec = (Jl(sr, "cooldownMs", 10000) / 1000).ToString();
        _userCooldownSec = (Jl(sr, "userCooldownMs", 60000) / 1000).ToString();
        _fanMedalMin = Jl(sr, "fanMedalMin").ToString();
        _honorLevelMin = Jl(sr, "honorLevelMin").ToString();
        _guardOnly = Jb(sr, "guardOnly");
        _maxDaily = Jl(sr, "maxDaily").ToString();
        _dedupEnabled = Jb(sr, "dedupEnabled", true);
        _dedupMin = Math.Max(0, (long)Math.Round(Jl(sr, "dedupMs", 300000) / 60000.0)).ToString();
    }

    // ---------- view model builders (closures live in code, not in markup) ----------

    private void BuildPlaylistRows()
    {
        var rows = new List<PlaylistRowVm>(_playlist.Count);
        for (var i = 0; i < _playlist.Count; i++)
        {
            var idx = i;
            var song = _playlist[i];
            var platform = Js(song, "platform");
            var vip = Vb(song["vip"]);
            var isCurrent = i == _currentIndex;
            rows.Add(new PlaylistRowVm
            {
                Index = i,
                NoText = isCurrent ? "▶ " + (i + 1) : (i + 1).ToString(),
                NoStyle = "width:46px;flex:none;font-family:var(--mono);font-size:11px;color:" + (isCurrent ? "var(--amber)" : "var(--ink-3)"),
                RowStyle = RowBaseStyle + (isCurrent ? ";background:var(--amber-dim)" : ""),
                Title = Js(song, "name"),
                Artist = Js(song, "artist"),
                Requester = Js(song, "requester"),
                PlatformBadgeName = PlatName(platform),
                PlatformBadgeCls = PlatCls(platform),
                VipBadgeText = vip ? "VIP" : "免费",
                VipBadgeCls = vip ? "red" : "off",
                IsCurrent = isCurrent,
                CanUp = i > 0,
                CanDown = i < _playlist.Count - 1,
                Play = () => PlayAt(idx),
                Remove = () => RemoveAt(idx),
                MoveUp = () => MoveTo(idx, idx - 1),
                MoveDown = () => MoveTo(idx, idx + 1),
            });
        }
        _playlistRows = rows;
    }

    private void BuildBlacklistRows()
    {
        var rows = new List<BlacklistRowVm>(_blacklist.Count);
        for (var i = 0; i < _blacklist.Count; i++)
        {
            var idx = i;
            var b = _blacklist[i];
            var type = Js(b, "type");
            rows.Add(new BlacklistRowVm
            {
                TypeText = type == "artist" ? "歌手" : "歌曲",
                TypeCls = type == "artist" ? "blue" : "amber",
                Value = Js(b, "value"),
                Remove = () => DeleteBlacklistAt(idx),
            });
        }
        _blacklistRows = rows;
    }

    private void BuildUpRows()
    {
        var rows = new List<UidRowVm>(_upList.Count);
        foreach (var uid in _upList)
        {
            var id = uid;
            rows.Add(new UidRowVm { Uid = id, Remove = () => DeleteUid(id) });
        }
        _upRows = rows;
    }

    private void BuildSearchRows()
    {
        var rows = new List<SearchRowVm>(_results.Count);
        foreach (var song in _results)
        {
            var s = song;
            var platform = Js(s, "platform");
            var vip = Vb(s["vip"]);
            var artist = Js(s, "artist");
            rows.Add(new SearchRowVm
            {
                Title = Js(s, "name") + (artist.Length > 0 ? " - " + artist : ""),
                PlatformBadgeName = PlatName(platform),
                PlatformBadgeCls = PlatCls(platform),
                VipBadgeText = vip ? "VIP" : "免费",
                VipBadgeCls = vip ? "red" : "off",
                Add = () => AddSong(s),
            });
        }
        _searchRows = rows;
    }

    private void BuildRecentRows()
    {
        var rows = new List<RecentRowVm>();
        foreach (var r in _recent.Take(20))
        {
            var artist = Js(r, "artist");
            var status = Js(r, "status");
            rows.Add(new RecentRowVm
            {
                Time = FmtTime(Jl(r, "time")),
                Song = Js(r, "songName") + (artist.Length > 0 ? " - " + artist : ""),
                Uname = Js(r, "uname"),
                StatusText = StatusText(status),
                StatusCls = status == "success" ? "interact" : "info",
            });
        }
        _recentRows = rows;
    }

    // ---------- playlist ops ----------

    private async Task RemoveAt(int index) => await Guard(async () =>
    {
        // 删掉的正是正在播放的那首 → 立即停止并跳下一首（否则播放器会继续播已删除的歌）
        var wasPlaying = index == Player.PlayingIndex;
        await PostJson("/api/song-request/playlist/remove", new JsonObject { ["index"] = index });
        await LoadPlaylistAsync();
        if (!wasPlaying)
        {
            SetMsg("已移除第 " + (index + 1) + " 首", "green");
            return;
        }
        if (_playlist.Count == 0)
        {
            Player.StopPlayback();
            SetMsg("已移除正在播放的歌曲：播放列表已空 → 已停止播放", "amber");
            return;
        }
        var next = index < _playlist.Count ? index : 0;
        await Player.PlayIndexAsync(next);
        SetMsg("正在播放的歌曲被移除 → 自动跳到第 " + (next + 1) + " 首", "amber");
    }, "移除失败");

    private async Task MoveTo(int from, int to) => await Guard(async () =>
    {
        await PostJson("/api/song-request/playlist/reorder", new JsonObject { ["from"] = from, ["to"] = to });
        await LoadPlaylistAsync();
        SetMsg(to < from ? "已上移" : "已下移", "green");
    }, "排序失败");

    private async Task ClearPlaylist() => await Guard(async () =>
    {
        await PostJson("/api/song-request/playlist/clear", new JsonObject());
        await LoadPlaylistAsync();
        SetMsg("播放列表已清空", "green");
    }, "清空失败");

    private async Task SkipCurrent() => await Guard(async () =>
    {
        await PostJson("/api/song-request/skip", new JsonObject());
        await LoadPlaylistAsync();
        SetMsg("已跳过当前歌曲", "green");
    }, "跳过失败");

    // ---------- search ----------

    private async Task DoSearch()
    {
        var kw = _searchKeyword.Trim();
        if (kw.Length == 0) { SetMsg("请输入搜索关键词", "amber"); StateHasChanged(); return; }
        _busy = true;
        _searching = true;
        try
        {
            var resp = await PostJson("/api/song-request/search", new JsonObject { ["keyword"] = kw, ["type"] = _searchType });
            _results.Clear();
            if (resp?["results"] is JsonArray arr)
                foreach (var n in arr) if (n is JsonObject o) _results.Add(o);
            BuildSearchRows();
            SetMsg(_results.Count == 0 ? "未找到与「" + kw + "」匹配的歌曲" : "搜索到 " + _results.Count + " 条结果",
                _results.Count == 0 ? "amber" : "green");
        }
        catch (Exception ex) { SetMsg("搜索失败：" + ex.Message, "red"); }
        finally
        {
            _busy = false;
            _searching = false;
            StateHasChanged();
        }
    }

    private async Task AddSong(JsonObject song) => await Guard(async () =>
    {
        var body = new JsonObject { ["song"] = song.DeepClone(), ["requester"] = "手动添加" };
        var wasIdle = !Player.IsPlaying;                    // 当前没有歌在播
        await PostJson("/api/song-request/playlist/add", body);
        await LoadPlaylistAsync();
        // 空闲时加歌 → 直接开播（与弹幕点歌的自动播放行为一致）
        if (wasIdle && AutoPlayEnabled() && _playlist.Count > 0)
        {
            await Player.PlayIndexAsync(_playlist.Count - 1);
            SetMsg("已添加并开始播放《" + Js(song, "name") + "》", "green");
        }
        else SetMsg("已添加《" + Js(song, "name") + "》到播放列表", "green");
    }, "添加失败");

