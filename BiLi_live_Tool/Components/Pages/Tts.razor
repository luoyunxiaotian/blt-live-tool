@page "/tts"
@using System.Globalization
@using System.Text
@using System.Text.Json
@using System.Text.Json.Nodes
@inject AppConfig Config
@inject TtsHost TtsEngine
@inject LivePipeline Pipeline
@inject TtsSpeaker Speaker
@inject BiLi_live_Tool.Services.DebouncedSaver Saver
@implements IDisposable
@* TTS page: engine panel, master switch, per-type switches, tone presets and voice preview.
   Config is read from GET /api/config and written back as the whole document via POST /api/config
   (server merges top-level keys and persists); a direct in-process write is the offline fallback. *@

<div class="blt-pagehead">
    <h1>语音念弹幕</h1><span class="en">TTS</span>
    <span style="margin-left:auto;display:flex;align-items:center;gap:12px">
        <span class="blt-hint" style="margin:0;font-family:var(--mono);color:var(--amber)">@_status</span>
        @* Auto-save status line: replaced the 保存全部 button. *@
        <span class="blt-hint" style="margin:0">@AutoSaveText()</span>
    </span>
</div>

<div class="blt-topstrip">
    <span class="seg">config <b class="@ConfigClass()">@ConfigText()</b></span>
    <span class="seg">api <b>127.0.0.1:@Config.Port</b></span>
    <span class="seg">engine <b class="amber">@_engine</b></span>
    <span class="seg">引擎状态 <b class="@EngineClass()">@EngineText()</b></span>
    <span class="seg">edge 音色 <b>@_voices.Count</b></span>
    <span class="seg">总开关 <b class="@OnOff(_enabled)">@OnOffText(_enabled)</b></span>
</div>

@* Master switch (tts.enabled): promoted from the corner panel to a page-level control bar. *@
<div class="blt-master @MasterCls()">
    <span class="st">启用语音念弹幕</span>
    <span class="sub">观众弹幕/礼物/SC/进房 → 语音播报（引擎 @_engine）</span>
    <span class="right">
        <span class="@BigSwitchClass(_enabled)" @onclick="ToggleEnabled"><span class="track"></span>@OnOffText(_enabled)</span>
    </span>
</div>

<div class="blt-grid blt-cols-2">
    @* ── 左列：语音引擎（含音色）/ 总开关与语音 ── *@
    <div>
        <div class="blt-panel">
            <div class="blt-panel-head"><span class="t"><BltIcon Emoji="🔈" /> 语音引擎</span><span class="en">ENGINE</span>
                <span class="right"><span>tts.engine</span><b class="amber">@_engine</b></span>
            </div>
            <div class="blt-panel-body">
                <label class="blt-label">engine · 引擎选择</label>
                <div style="display:flex;gap:10px">
                    <select class="blt-input" style="flex:1;cursor:pointer" @bind="_engine" @bind:after="SaveEngineSoon">
                        <option value="edge">edge · 在线语音（edge-tts，322 音色）</option>
                        <option value="moss">moss · 本地离线引擎（端口 8021）</option>
                        <option value="sys">sys · 系统语音兜底</option>
                    </select>
                    <button class="blt-btn" @onclick="RefreshAll">刷新状态</button>
                </div>

                <div style="margin-top:12px">
                    @if (_engine == "edge")
                    {
                        <div class="blt-kv"><span class="k">edge 服务 :8020</span><span class="v @OnOff(_edgeRunning)">@RunText(_edgeRunning)</span></div>
                        <div class="blt-kv"><span class="k">在线音色清单</span><span class="v @OnOff(_voices.Count > 0)">@VoiceStateText()</span></div>
                        <div class="blt-kv"><span class="k">引擎程序</span><span class="v" style="word-break:break-all">@PathText(_edgePath)</span></div>
                    }
                    else if (_engine == "moss")
                    {
                        <div class="blt-kv"><span class="k">moss 服务 :8021</span><span class="v @OnOff(_mossRunning)">@RunText(_mossRunning)</span></div>
                        <div class="blt-kv"><span class="k">引擎本体（moss_tts_server.exe）</span><span class="v @OnOff(_mossInstalled)">@MossInstalledText()</span></div>
                        <div class="blt-kv"><span class="k">引擎程序</span><span class="v" style="word-break:break-all">@PathText(_mossPath)</span></div>
                        <div class="blt-kv"><span class="k">模型目录</span><span class="v" style="word-break:break-all">@PathText(_mossModelDir)</span></div>
                        <div class="blt-kv"><span class="k">本地音色（mossVoice）</span><span class="v amber">@_mossVoice</span></div>
                    }
                    else
                    {
                        <div class="blt-kv"><span class="k">系统语音</span><span class="v amber">免服务 · 本机语音合成</span></div>
                        <div class="blt-kv"><span class="k">回退顺序</span><span class="v">edge → moss → sys</span></div>
                    }
                </div>

                @if (_engine == "moss")
                {
                    <div style="display:flex;gap:8px;margin-top:12px;flex-wrap:wrap">
                        <button class="blt-btn" @onclick="StartMoss" disabled="@_busy">启动</button>
                        <button class="blt-btn" @onclick="StopMoss" disabled="@_busy">停止</button>
                        <button class="blt-btn" @onclick="RestartMoss" disabled="@_busy">重启</button>
                    </div>

                    @* MOSS engine ships with the package (44.5MB is not worth an
                       on-demand download); this hint covers a broken install. *@
                    @if (!_mossInstalled)
                    {
                        <div class="blt-hint" style="color:var(--amber)">
                            未找到 moss_tts_server.exe：请重新安装本程序，或把它放到 @_mossPath 同级目录
                        </div>
                    }
                    else
                    {
                        <div class="blt-hint">引擎已安装 · 模型（约 728 MB）首次启动时按需下载</div>
                    }
                }
                <div class="blt-hint">引擎改动即时生效并自动保存 · @AutoSaveText()</div>
                @if (_engine == "sys")
                {
                    <div class="blt-hint">sys 引擎不依赖本地服务；edge 未运行时自动回退到系统语音</div>
                }

                @* Voice picker stays inside the engine card (legacy 「🔈 语音引擎」 groups engine + voice). *@
                <div class="blt-kv" style="margin-top:14px;border-top:1px solid var(--line)">
                    <span class="k">voice · 音色与试听</span>
                    <span class="v amber">@_voice</span>
                </div>
                @if (_engine != "edge")
                {
                    <div class="blt-hint" style="color:var(--amber);margin:0 0 8px">
                        当前引擎为 @_engine：下方列表来自 edge 引擎，选中后写入 tts.voice（moss 另用 mossVoice）
                    </div>
                }
                <label class="blt-label">搜索音色（ShortName / 名称）</label>
                <input class="blt-input mono" placeholder="如 zh-CN / xiaoxiao / 女声" @bind="_voiceFilter" @bind:event="oninput" />

                <div style="margin-top:10px">
                    <label class="blt-label">edge 音色（前 50 条 / 共 @_voices.Count 条 · 常用 @_favorites.Count / 20）</label>
                    <select class="blt-input mono" style="cursor:pointer" @bind="_voice" @bind:after="SaveVoiceSoon">
                        @if (_favorites.Count > 0)
                        {
                            <optgroup label="⭐ 常用音色">
                                @foreach (var f in _favorites)
                                {
                                    <option value="@f">@FavoriteLabel(f)</option>
                                }
                            </optgroup>
                        }
                        @foreach (var v in ShownVoices())
                        {
                            <option value="@v.Name">@v.Label</option>
                        }
                    </select>
                </div>

                <div style="display:flex;gap:8px;align-items:center;margin-top:10px;flex-wrap:wrap">
                    <button class="blt-btn" @onclick="ToggleFavorite" disabled="@_busy">@FavoriteBtnText()</button>
                    <button class="blt-btn" @onclick="Preview" disabled="@_busy">试听</button>
                    <span class="blt-hint" style="margin:0">@_previewMsg</span>
                </div>
                @if (_previewUrl.Length > 0)
                {
                    <audio controls src="@_previewUrl" style="width:100%;margin-top:10px"></audio>
                }
                <div class="blt-hint">音色选中即时生效并自动保存 · @AutoSaveText()</div>
                <div class="blt-hint">试听走 POST /api/tts/edge/（text + voice）· 返回 audio/mpeg 字节</div>
            </div>
        </div>

        <div class="blt-panel">
            <div class="blt-panel-head"><span class="t">总开关 &amp; 语音</span><span class="en">MASTER</span>
                <span class="right"><span>enabled / rate / volume</span></span>
            </div>
            <div class="blt-panel-body">
                @* The master toggle itself sits in the page-level bar above (kept prominent on purpose). *@
                <div class="blt-kv">
                    <span class="k">启用语音念弹幕（页面顶部主控条）</span>
                    <span class="v @OnOff(_enabled)">@OnOffText(_enabled)</span>
                </div>
                <div style="display:flex;gap:14px;flex-wrap:wrap;margin-top:12px">
                    <div style="flex:1;min-width:110px">
                        <label class="blt-label">rate · 语速</label>
                        <input class="blt-input mono" type="number" step="0.05" min="0.5" max="2.5"
                               @bind="_rateText" @bind:after="SaveMasterSoon" />
                    </div>
                    <div style="flex:1;min-width:110px">
                        <label class="blt-label">volume · 音量</label>
                        <input class="blt-input mono" type="number" step="0.05" min="0" max="1"
                               @bind="_volumeText" @bind:after="SaveMasterSoon" />
                    </div>
                </div>
                <div class="blt-hint">rate 0.5–2.5（1 = 原速）· volume 0–1 · 总开关在页面顶部主控条</div>
                <div class="blt-hint">改动即时生效并自动保存 · @AutoSaveText()</div>
            </div>
        </div>
    </div>

    @* ── 右列：语气 / 念哪些事件 / 队列与过滤 / 只读参数 ── *@
    <div>
        <div class="blt-panel">
            <div class="blt-panel-head"><span class="t"><BltIcon Emoji="🎭" /> 语气</span><span class="en">TONE</span>
                <span class="right"><span>tone.global / byType</span><b class="amber">@_toneGlobal</b></span>
            </div>
            <div class="blt-panel-body">
                <label class="blt-label">全局语气（tone.global）</label>
                <select class="blt-input" style="cursor:pointer" @bind="_toneGlobal" @bind:after="SaveToneSoon">
                    <option value="">— 默认（normal）—</option>
                    @foreach (var t in _tonePresets)
                    {
                        <option value="@t.Key">@t.Label</option>
                    }
                </select>
                <div class="blt-hint">语气改动即时生效并自动保存 · @AutoSaveText()</div>

                <div style="margin-top:12px">
                    @if (_tonePresets.Count == 0)
                    {
                        <div class="blt-empty">配置中未找到 tonePresets</div>
                    }
                    else
                    {
                        @foreach (var t in _tonePresets)
                        {
                            <div class="blt-kv">
                                <span class="k">@t.Label <span class="blt-hint" style="margin:0;font-family:var(--mono)">@t.Key</span></span>
                                <span class="v">@t.Desc</span>
                            </div>
                        }
                    }
                </div>

                @* Per-event tone binding lives in the same card (legacy 「🎭 语气」 covers global + byType). *@
                <label class="blt-label" style="margin-top:14px;border-top:1px solid var(--line);padding-top:10px">各事件类型专属语气（「跟随全局」= 空值）</label>
                @if (_tonePresets.Count == 0)
                {
                    <div class="blt-empty">配置中未找到 tonePresets · 仅能跟随全局</div>
                }
                @foreach (var row in _toneByType)
                {
                    <div style="display:flex;align-items:center;gap:10px;padding:5px 0;flex-wrap:wrap">
                        <span class="blt-hint" style="width:88px;flex:none;margin:0">@row.Label</span>
                        <select class="blt-input" style="flex:1;min-width:140px;cursor:pointer"
                                @bind="row.Selected" @bind:after="SaveToneByTypeSoon">
                            <option value="">跟随全局</option>
                            @foreach (var t in _tonePresets)
                            {
                                <option value="@t.Key">@t.Label</option>
                            }
                        </select>
                    </div>
                }
                <div class="blt-hint">tone.byType · 下次播报即生效 · @AutoSaveText()</div>
            </div>
        </div>
        <div class="blt-panel">
            <div class="blt-panel-head"><span class="t">念哪些事件</span><span class="en">EVENTS</span>
                <span class="right"><span>enabled + sayUid + volume</span></span>
            </div>
            <div class="blt-panel-body">
                @foreach (var row in _cats)
                {
                    <div style="display:flex;align-items:center;gap:12px;padding:8px 0;border-bottom:1px dashed var(--line);flex-wrap:wrap">
                        <span class="@SwitchClass(row.Enabled)" @onclick="() => ToggleCat(row)"><span class="track"></span>@row.Label</span>
                        <span class="blt-hint" style="margin:0;font-family:var(--mono)">tts.@row.Key</span>
                        @* sayUid = 「念昵称」：real checkbox, never the UID itself. *@
                        <label class="blt-label" style="display:inline-flex;align-items:center;gap:6px;margin:0;letter-spacing:0"
                               title="朗读时先念用户昵称再念内容，UID 永远不会被念出">
                            <input type="checkbox" style="width:auto;margin:0;accent-color:var(--amber)"
                                   @bind="row.SayUid" @bind:after="SaveCatsSoon" />念昵称
                        </label>
                        <span style="margin-left:auto;display:flex;align-items:center;gap:6px">
                            <span class="blt-hint" style="margin:0">音量</span>
                            <input class="blt-input mono" style="width:84px" type="number" step="0.05" min="0" max="1"
                                   @bind="row.Volume" @bind:after="SaveCatsSoon" />
                        </span>
                    </div>
                }
                @if (_cats.Count == 0)
                {
                    <div class="blt-empty">配置读取失败，分类开关不可用</div>
                }
                <div class="blt-hint">开关 / 念昵称 / 音量改动即时生效并自动保存 · @AutoSaveText()</div>
            </div>
        </div>

        <div class="blt-panel">
            <div class="blt-panel-head"><span class="t">队列 / 过滤</span><span class="en">QUEUE</span>
                <span class="right"><span>待念 @Speaker.QueueCount · 上限 @_queueMax</span></span>
            </div>
            <div class="blt-panel-body">
                @* 1) queue cap + guard priority *@
                <div style="display:flex;gap:8px;align-items:flex-end;flex-wrap:wrap">
                    <div style="width:94px">
                        <label class="blt-label">队列上限</label>
                        <input class="blt-input mono" type="number" min="1" max="50" value="@_queueMax"
                               @onchange="OnQueueMaxChanged" />
                    </div>
                    <span class="@SwitchClass(_guardPriority)" style="margin-left:auto" @onclick="ToggleGuardPriority">
                        <span class="track"></span>舰长弹幕优先
                    </span>
                </div>

                @* 2) pending count + current state *@
                <div class="blt-kv" style="margin-top:10px">
                    <span class="k">待念条数</span>
                    <span class="v @(Speaker.QueueCount > 0 ? "amber" : "")">@Speaker.QueueCount 条</span>
                </div>
                <div class="blt-kv">
                    <span class="k">当前状态</span>
                    <span class="v @(Speaker.Speaking ? "green" : "")">@SpeakerStateText()</span>
                </div>

                @* 3) live queue list *@
                @{ var q = Speaker.QueueSnapshot(); }
                @if (q.Count == 0)
                {
                    <div class="blt-empty" style="padding:14px 6px">队列为空 · 命中事件后在这里排队</div>
                }
                else
                {
                    <div class="blt-log" style="max-height:186px;margin-top:10px">
                        @foreach (var row in q)
                        {
                            <div class="blt-logrow">
                                <span class="tag @QueueTagClass(row)">@QueueTagText(row)</span>
                                <span class="txt">@(row.Guard ? "⭐ " : "")@row.Text</span>
                            </div>
                        }
                    </div>
                }

                @* 4) skip / clear *@
                <div style="display:flex;gap:8px;align-items:center;margin-top:12px;flex-wrap:wrap">
                    <button class="blt-btn" @onclick="SkipSpeech" disabled="@(!Speaker.Speaking)">⏭ 跳过本条</button>
                    <button class="blt-btn" @onclick="ClearSpeechQueue" disabled="@(Speaker.QueueCount == 0)">🗑 清空队列</button>
                </div>
                <div class="blt-hint">
                    「跳过本条」立刻停掉正在念的这条、接着念下一条；「清空队列」只丢弃排队中的，正在念的不受影响。上限 1~50，达到上限后新事件被忽略（舰长优先开启时舰长弹幕插队到第 2 位之后）。
                </div>

                @* 5) filters: blacklist UID + banned words (legacy 队列 / 过滤 panel) *@
                <label class="blt-label" style="margin-top:12px">黑名单 UID（blacklistUids）</label>
                <textarea class="blt-input mono" rows="2" placeholder="123456,789012"
                          title="这些 UID 的用户发的内容不朗读，逗号分隔（填数字 UID，不是昵称）"
                          @bind="_blacklistUids" @bind:event="oninput" @bind:after="SaveFiltersSoon"></textarea>
                <div class="blt-hint">逗号分隔，命中即不念</div>

                <label class="blt-label" style="margin-top:12px">屏蔽词（bannedWords）</label>
                <textarea class="blt-input mono" rows="2" placeholder="广告,主播名字"
                          title="包含这些关键词的弹幕不朗读，逗号分隔。可屏蔽广告、敏感词"
                          @bind="_bannedWords" @bind:event="oninput" @bind:after="SaveFiltersSoon"></textarea>
                <div class="blt-hint">弹幕含任一词则不念，逗号分隔</div>

                <div class="blt-hint">已配置 @_blacklistCount 个 UID · @_bannedCount 个屏蔽词 · @AutoSaveText()</div>
            </div>
        </div>

        <div class="blt-panel">
            <div class="blt-panel-head"><span class="t">⚙ 其他参数</span><span class="en">READ ONLY</span>
                <span class="right"><span>由原版面板维护</span></span>
            </div>
            <div class="blt-panel-body">
                <div class="blt-kv"><span class="k">pitch · 音调基准</span><span class="v">@_pitch</span></div>
                <div class="blt-kv"><span class="k">gain · 增益</span><span class="v">@_gain</span></div>
                <div class="blt-kv"><span class="k">gap · 队列间隔 ms</span><span class="v">@_gap</span></div>
                <div class="blt-kv"><span class="k">favoriteVoices · 收藏音色</span><span class="v">@_favoriteCount 个</span></div>
                <div class="blt-kv"><span class="k">blacklistUids / bannedWords</span><span class="v">@_blacklistCount / @_bannedCount</span></div>
            </div>
        </div>
    </div>
</div>

@code {
    // ---- shared HTTP client (localhost config API) ----
    private static readonly HttpClient Http = new() { Timeout = TimeSpan.FromSeconds(30) };
    private string Base => "http://127.0.0.1:" + Config.Port;

    private JsonObject? _doc;
    private bool _busy;
    private readonly SemaphoreSlim _saveGate = new(1, 1);   // serializes POSTs (manual + auto-save)
    private string _status = "载入中…";

    // engine
    private string _engine = "edge";
    private bool _edgeRunning, _mossRunning, _guardPriority;
    private string _edgePath = "", _mossPath = "", _mossModelDir = "", _mossVoice = "Junhao";

    // moss engine installer (on-demand 44.5 MB exe; model stays lazy)
    private bool _mossInstalled;              // engineInstalled from MossStatus: exe present on disk

    // master
    private bool _enabled;
    private string _rateText = "1", _volumeText = "1";
    private string _pitch = "1", _gain = "0", _gap = "0", _queueMax = "8";
    private int _favoriteCount, _blacklistCount, _bannedCount;

    // filters (tts.blacklistUids / tts.bannedWords, comma separated)
    private string _blacklistUids = "", _bannedWords = "";

    // auto-save status line
    private DateTime? _savedAt;
    private string _saveMsg = "";

    // per-type switches
    private List<CatRow> _cats = new();

    // voices
    private readonly List<VoiceItem> _voices = new();
    private readonly List<string> _favorites = new();   // tts.favoriteVoices (max 20, oldest dropped)
    private string _voice = "zh-CN-XiaoxiaoNeural";
    private string _voiceFilter = "";
    private string _previewMsg = "", _previewUrl = "";

    // tone
    private string _toneGlobal = "normal";
    private readonly List<TonePreset> _tonePresets = new();
    private readonly List<ToneRow> _toneByType = new();

    private System.Threading.Timer? _tick;

    private sealed class CatRow
    {
        public string Key = "";
        public string Label = "";
        public bool Enabled;
        public bool SayUid;          // tts.<type>.sayUid → 「念昵称」(never speaks the UID itself)
        public string Volume = "1";
    }

    private sealed record VoiceItem(string Name, string Label, bool Zh);

    private sealed record TonePreset(string Key, string Label, string Desc);

    /// <summary>Editable row of tts.tone.byType; Selected == "" means 「跟随全局」.</summary>
    private sealed class ToneRow
    {
        public string Key = "";
        public string Label = "";
        public string Selected = "";
    }

    // ---- Chinese display names for the common zh voices (same map as the legacy panel) ----
    private static readonly Dictionary<string, string> ZhVoices = new()
    {
        ["zh-CN-XiaoxiaoNeural"] = "小晓(女·普通话)",
        ["zh-CN-XiaoyiNeural"] = "晓伊(女·普通话)",
        ["zh-CN-YunxiNeural"] = "云希(男·普通话)",
        ["zh-CN-YunyangNeural"] = "云扬(男·普通话)",
        ["zh-CN-YunjianNeural"] = "云健(男·普通话)",
        ["zh-CN-YunxiaNeural"] = "云夏(男·普通话)",
        ["zh-CN-liaoning-XiaobeiNeural"] = "小北(女·辽宁)",
        ["zh-CN-shaanxi-XiaoniNeural"] = "小妮(女·陕西)",
        ["zh-HK-HiuGaaiNeural"] = "曉佳(女·粤语)",
        ["zh-HK-HiuMaanNeural"] = "曉曼(女·粤语)",
        ["zh-HK-WanLungNeural"] = "雲龍(男·粤语)",
        ["zh-TW-HsiaoChenNeural"] = "曉臻(女·台湾)",
        ["zh-TW-HsiaoYuNeural"] = "曉雨(女·台湾)",
        ["zh-TW-YunJheNeural"] = "雲哲(男·台湾)",
    };

    // ---- lifecycle ----

    protected override async Task OnInitializedAsync()
    {
        Speaker.Changed += OnSpeakerChanged;
        await LoadConfigAsync();
        await RefreshAll();
        // Keep the engine lamps fresh without hammering the API.
        _tick = new System.Threading.Timer(_ => _ = InvokeAsync(() => { RefreshEngineLocal(); StateHasChanged(); }), null, 10000, 10000);
    }

