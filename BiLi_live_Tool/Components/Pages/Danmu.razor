    private string PreviewContainerStyle()
    {
        var bg = _previewBg switch
        {
            "checker" => "background-image: linear-gradient(45deg, #222 25%, transparent 25%), linear-gradient(-45deg, #222 25%, transparent 25%), linear-gradient(45deg, transparent 75%, #222 75%), linear-gradient(-45deg, transparent 75%, #222 75%); background-size: 20px 20px; background-position: 0 0, 0 10px, 10px -10px, -10px 0px; background-color: #161616;",
            "game" => "background: radial-gradient(circle at 50% 50%, #1f2a44 0%, #0d111a 100%);",
            _ => "background: #0e1117;"
        };
        return $"{bg};min-height:480px;height:520px;display:flex;align-items:flex-end;justify-content:flex-start;padding:16px;box-sizing:border-box;overflow:auto;position:relative;";
    }

    private string PreviewStageBoxStyle()
    {
        if (!_cfg.ShowBox) return "width:100%;max-width:440px;pointer-events:none;";
        var bg = HexToRgba(_cfg.BoxBgColor, _cfg.BoxBgOpacity);
        var bWidth = _cfg.ShowBoxBorder ? _cfg.BoxBorderWidth : 0;
        var bColor = HexToRgba(_cfg.BoxBorderColor, _cfg.BoxBorderOpacity);
        var pad = _cfg.BoxPadding;
        var w = Math.Clamp(_cfg.BoxWidth, 240, 480);
        var h = Math.Clamp(_cfg.BoxHeight, 260, 480);
        return $"width:{w}px;height:{h}px;background-color:{bg};border-radius:{_cfg.BoxRadius}px;border:{bWidth}px solid {bColor};padding:{pad}px;box-sizing:border-box;box-shadow:0 8px 32px rgba(0,0,0,0.35);pointer-events:none;display:flex;flex-direction:column;justify-content:flex-end;flex-shrink:0;";
    }

    private string PreviewStageStyle()
    {
        var mask = "";
        var dist = _cfg.EdgeFadeDistance > 0 ? _cfg.EdgeFadeDistance : 80;
        if (_cfg.EdgeFadeMode == "top")
        {
            mask = $"-webkit-mask-image: linear-gradient(to bottom, transparent 0, #000 {dist}px, #000 100%); mask-image: linear-gradient(to bottom, transparent 0, #000 {dist}px, #000 100%);";
        }
        else if (_cfg.EdgeFadeMode == "bottom")
        {
            mask = $"-webkit-mask-image: linear-gradient(to top, transparent 0, #000 {dist}px, #000 100%); mask-image: linear-gradient(to top, transparent 0, #000 {dist}px, #000 100%);";
        }
        else if (_cfg.EdgeFadeMode == "both")
        {
            mask = $"-webkit-mask-image: linear-gradient(to bottom, transparent 0, #000 {dist}px, #000 calc(100% - {dist}px), transparent 100%); mask-image: linear-gradient(to bottom, transparent 0, #000 {dist}px, #000 calc(100% - {dist}px), transparent 100%);";
        }
        return $"display:flex;flex-direction:column;gap:{_cfg.CardGap}px;width:100%;pointer-events:none;padding-bottom:14px;{mask}";
    }

