<Project Sdk="Microsoft.NET.Sdk.Razor">

    <PropertyGroup>
        <TargetFrameworks>net10.0-android</TargetFrameworks>
        <TargetFrameworks Condition="!$([MSBuild]::IsOSPlatform('linux'))">$(TargetFrameworks);net10.0-ios;net10.0-maccatalyst</TargetFrameworks>
        <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net10.0-windows10.0.19041.0</TargetFrameworks>

        <!-- Note for MacCatalyst:
            The default runtime is maccatalyst-x64, except in Release config, in which case the default is maccatalyst-x64;maccatalyst-arm64.
            When specifying both architectures, use the plural <RuntimeIdentifiers> instead of the singular <RuntimeIdentifier>.
            The Mac App Store will NOT accept apps with ONLY maccatalyst-arm64 indicated;
            either BOTH runtimes must be indicated or ONLY macatalyst-x64. -->
        <!-- For example: <RuntimeIdentifiers>maccatalyst-x64;maccatalyst-arm64</RuntimeIdentifiers> -->

        <OutputType>Exe</OutputType>
        <RootNamespace>BiLi_live_Tool</RootNamespace>
        <UseMaui>true</UseMaui>
        <SingleProject>true</SingleProject>
        <ImplicitUsings>enable</ImplicitUsings>
        <EnableDefaultCssItems>false</EnableDefaultCssItems>
        <Nullable>enable</Nullable>

        <!-- Enable XAML source generation for faster build times and improved performance.
             This generates C# code from XAML at compile time instead of runtime inflation.
             To disable, remove this line.
             For individual files, you can override by setting Inflator metadata:
               <MauiXaml Update="MyPage.xaml" Inflator="Default" /> (reverts to defaults: Runtime for Debug, XamlC for Release)
               <MauiXaml Update="MyPage.xaml" Inflator="Runtime" /> (force runtime inflation) -->
        <MauiXamlInflator>SourceGen</MauiXamlInflator>

        <!-- Display name -->
        <ApplicationTitle>BiLi_live_Tool</ApplicationTitle>

        <!-- App Identifier -->
        <ApplicationId>com.companyname.bili_live_tool</ApplicationId>

        <!-- Versions -->
        <ApplicationDisplayVersion>0.1.7</ApplicationDisplayVersion>
        <ApplicationVersion>4</ApplicationVersion>

        <!-- To develop, package, and publish an app to the Microsoft Store, see: https://aka.ms/MauiTemplateUnpackaged -->
        <WindowsPackageType>None</WindowsPackageType>

        <!-- 体积优化（实测依据：开发文档/体积与内存优化方案.md）
             1) 卫星资源只保留中英：当前发布里有 88 个语言目录、约 170 个零碎文件，
                裁剪后同时降低 patch 增量的文件数；
             2) Release 不生成调试符号（*.pdb + DiaSymReader 约 3~6MB）。 -->
        <SatelliteResourceLanguages>zh-CN;en-US</SatelliteResourceLanguages>
        <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
        <DebugSymbols Condition="'$(Configuration)' == 'Release'">false</DebugSymbols>

        <!-- Raw build assets are copied by the CopyBltAssets target; keep them out of
             default item sets (Content/None double-inclusion in MAUI multi-targeting). -->
        <DefaultItemExcludes>$(DefaultItemExcludes);Assets\**</DefaultItemExcludes>

        <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
        <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">15.0</SupportedOSPlatformVersion>
        <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">24.0</SupportedOSPlatformVersion>
        <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
        <TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
    </PropertyGroup>

    <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">
        <!-- Embedded ASP.NET Core (Kestrel) hosts the local API/WS server for OBS overlays -->
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
    </ItemGroup>

    <ItemGroup>
        <!-- Original defaults generated from Bin/lib/config.js (field-for-field fidelity) -->
        <None Include="Services\default-config.json" Link="default-config.json" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

    <!-- Copy raw assets to the output root (avoid Content/None duplicate-item pitfalls). -->
    <Target Name="CopyBltAssets" AfterTargets="Build">
        <Copy SourceFiles="Assets\blindbox-default.json" DestinationFiles="$(OutputPath)\blindbox-default.json" SkipUnchangedFiles="true" />
        <Copy SourceFiles="Assets\viewer-template.html" DestinationFiles="$(OutputPath)\viewer-template.html" SkipUnchangedFiles="true" />
        <Copy SourceFiles="Assets\maui-bridge.js" DestinationFiles="$(OutputPath)\wwwroot\legacy\maui-bridge.js" SkipUnchangedFiles="true" Condition="Exists('$(OutputPath)\wwwroot\legacy')" />
        <Copy SourceFiles="Assets\keyview-default.json" DestinationFiles="$(OutputPath)\keyview-default.json" SkipUnchangedFiles="true" />
        <!-- Brand icon for the tray + window chrome (Assets/tray.ico). -->
        <Copy SourceFiles="Assets\tray.ico" DestinationFiles="$(OutputPath)\tray.ico" SkipUnchangedFiles="true" />
        <!-- Whitelist HMAC key: not in the repo; copied only when present locally. -->
        <Copy SourceFiles="verify-key.txt" DestinationFiles="$(OutputPath)\verify-key.txt" SkipUnchangedFiles="true" Condition="Exists('verify-key.txt')" />
        <Copy SourceFiles="Assets\update-now.ps1" DestinationFiles="$(OutputPath)\update-now.ps1" SkipUnchangedFiles="true" />
        <Copy SourceFiles="Assets\update-now.cmd" DestinationFiles="$(OutputPath)\update-now.cmd" SkipUnchangedFiles="true" />
    </Target>

    <ItemGroup>
        <!-- App Icon -->
        <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#512BD4" />

        <!-- Splash Screen -->
        <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#512BD4" BaseSize="128,128" />

        <!-- Images -->
        <MauiImage Include="Resources\Images\*" />
        <MauiImage Update="Resources\Images\dotnet_bot.svg" BaseSize="168,208" />

        <!-- Custom Fonts -->
        <MauiFont Include="Resources\Fonts\*" />

        <!-- Raw Assets (also remove the "Resources\Raw" prefix) -->
        <MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
        <PackageReference Include="Microsoft.AspNetCore.Components.WebView.Maui" Version="$(MauiVersion)" />
        <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" />
    </ItemGroup>


  <!-- The Build-time copy above lands in bin; publish would otherwise ship without
       tray.ico / blindbox defaults / viewer template / KeyView defaults / the legacy
       bridge patch. Mirror the same copies into the publish folder. -->
  <Target Name="CopyBltAssetsOnPublish" AfterTargets="Publish">
    <ItemGroup>
      <_BltPublishAsset Include="Assets\blindbox-default.json" />
      <_BltPublishAsset Include="Assets\viewer-template.html" />
      <_BltPublishAsset Include="Assets\keyview-default.json" />
      <_BltPublishAsset Include="Assets\tray.ico" />
    </ItemGroup>
    <Copy SourceFiles="@(_BltPublishAsset)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="verify-key.txt" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" Condition="Exists('verify-key.txt')" />
    <Copy SourceFiles="Assets\update-now.ps1" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="Assets\update-now.cmd" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="Assets\maui-bridge.js" DestinationFiles="$(PublishDir)wwwroot\legacy\maui-bridge.js"
          SkipUnchangedFiles="true" Condition="Exists('$(PublishDir)wwwroot\legacy')" />
  </Target>

</Project>
