    private string PreviewStageBoxStyle()
    {
        if (!_cfg.ShowBox) return "width:100%;max-width:440px;pointer-events:none;";
        var bg = HexToRgba(_cfg.BoxBgColor, _cfg.BoxBgOpacity);
        var bWidth = _cfg.ShowBoxBorder ? _cfg.BoxBorderWidth : 0;
        var bColor = HexToRgba(_cfg.BoxBorderColor, _cfg.BoxBorderOpacity);
        var pad = _cfg.BoxPadding;
        var w = Math.Clamp(_cfg.BoxWidth, 240, 480);
        var h = Math.Clamp(_cfg.BoxHeight, 260, 480);
        return $"width:{w}px;height:{h}px;background-color:{bg};border-radius:{_cfg.BoxRadius}px;border:{bWidth}px solid {bColor};padding:{pad}px;box-sizing:border-box;box-shadow:0 8px 32px rgba(0,0,0,0.35);pointer-events:none;display:flex;flex-direction:column;justify-content:flex-end;flex-shrink:0;";
