@page "/diagnostics"
@using System.Text
@using System.Text.Json.Nodes
@using BiLi_live_Tool.Services
@inject KestrelHost Api
@inject IJSRuntime JS
@inject BiLi_live_Tool.Services.UiKit UI

<div class="blt-pagehead"><h1>网络诊断</h1><span class="en">DIAGNOSTICS</span></div>

<div class="blt-panel">
    <div class="blt-panel-head"><span class="t"><BltIcon Emoji="🩺" /> 连通性探测</span><span class="en">CONNECTIVITY PROBES</span>
        <span class="right">
            <span>@GeneratedText()</span>
            <button class="blt-btn primary" style="padding:3px 14px" @onclick="RunAsync" disabled="@_running">@(_running ? "诊断中…" : "开始诊断")</button>
            <button class="blt-btn" style="padding:3px 12px" @onclick="CopyResult" disabled="@(_results.Count == 0)">复制结果</button>
        </span>
    </div>
    <div class="blt-panel-body">
        @if (_running)
        {
            <div class="blt-empty">正在依次探测 8 项服务，通常需要数秒（单项超时 6s）…</div>
        }
        @if (_error.Length > 0)
        {
            <div style="color:var(--red-ink);font-size:12px;padding:2px 0 8px">@_error</div>
        }
        @if (_copyHint.Length > 0)
        {
            <div style="color:var(--ink-2);font-size:12px;padding:2px 0 8px">@_copyHint</div>
        }
        @if (_results.Count == 0 && !_running && _error.Length == 0)
        {
            <div class="blt-empty">点击右上角「开始诊断」，探测 B站接口 / 更新源 / 音乐源 / 本机 TTS 服务 / 本机服务端 共 8 项。</div>
        }
        @if (_results.Count > 0)
        {
            <div style="overflow-x:auto">
                <table style="width:100%;border-collapse:collapse;font-size:12.5px">
                    <thead>
                        <tr>
                            <th style="text-align:left;padding:6px 8px;font-family:var(--mono);font-size:10px;color:var(--ink-3);letter-spacing:1px;border-bottom:1px solid var(--line)">状态</th>
                            <th style="text-align:left;padding:6px 8px;font-family:var(--mono);font-size:10px;color:var(--ink-3);letter-spacing:1px;border-bottom:1px solid var(--line)">探测项</th>
                            <th style="text-align:right;padding:6px 8px;font-family:var(--mono);font-size:10px;color:var(--ink-3);letter-spacing:1px;border-bottom:1px solid var(--line)">延迟</th>
                            <th style="text-align:left;padding:6px 8px;font-family:var(--mono);font-size:10px;color:var(--ink-3);letter-spacing:1px;border-bottom:1px solid var(--line)">详情</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var r in _results)
                        {
                            <tr>
                                <td style="padding:6px 8px;border-bottom:1px dashed var(--line);white-space:nowrap"><span class="blt-badge @Badge(r.State)">@StateText(r.State)</span></td>
                                <td style="padding:6px 8px;border-bottom:1px dashed var(--line)">@r.Name</td>
                                <td style="padding:6px 8px;border-bottom:1px dashed var(--line);text-align:right;font-family:var(--mono);color:var(--ink-2)">@r.Latency ms</td>
                                <td style="padding:6px 8px;border-bottom:1px dashed var(--line);color:var(--ink-2)">@r.Detail</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div style="display:flex;gap:14px;flex-wrap:wrap;padding:10px 2px 0;font-family:var(--mono);font-size:11px;color:var(--ink-2)">
                <span>合计 <b style="color:var(--ink)">@_results.Count</b> 项</span>
                <span>OK <b style="color:var(--green-ink)">@CountState("ok")</b></span>
                <span>WARN <b style="color:var(--amber-ink)">@CountState("warn")</b></span>
                <span>FAIL <b style="color:var(--red-ink)">@CountState("fail")</b></span>
                <span style="margin-left:auto">BUILD @KestrelHost.VersionText · 端口 @Api.Port</span>
            </div>
        }
        @if (_showText)
        {
            <label class="blt-label" style="margin-top:12px">诊断文本 · 可手动复制</label>
            <textarea readonly class="blt-input mono" style="height:190px;white-space:pre;resize:vertical" spellcheck="false">@PlainText()</textarea>
        }
    </div>
</div>

<div class="blt-panel">
    <div class="blt-panel-head"><span class="t"><BltIcon Emoji="📊" /> 事件统计</span><span class="en">EVENT STATS</span>
        <span class="right">
            <span class="blt-badge @StatsBadge()">@StatsStateText()</span>
            <span>@StatsRoomText()</span>
            <button class="blt-btn" style="padding:3px 12px" @onclick="RefreshStatsAsync" disabled="@_statsBusy">@(_statsBusy ? "刷新中…" : "刷新")</button>
        </span>
    </div>
    <div class="blt-panel-body">
        @if (_statsError.Length > 0)
        {
            <div style="color:var(--red-ink);font-size:12px;padding:2px 0 8px">@_statsError</div>
        }
        @if (_stats.Count == 0 && _statsError.Length == 0)
        {
            <div class="blt-empty" style="padding:16px 10px">@StatsEmptyText()</div>
        }
        else
        {
            <div style="overflow-x:auto">
                <table style="width:100%;border-collapse:collapse;font-size:12.5px">
                    <thead>
                        <tr>
                            <th style="@StatsThStyle()">事件类型</th>
                            <th style="@StatsThStyleRight()">次数</th>
                            <th style="@StatsThStyle()">最近时间</th>
                            <th style="@StatsThStyle()">最近样本</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var s in _stats)
                        {
                            <tr>
                                <td style="padding:6px 8px;border-bottom:1px dashed var(--line);white-space:nowrap">
                                    <b>@TypeText(s.Type)</b>
                                    <span style="font-family:var(--mono);font-size:10.5px;color:var(--ink-3);margin-left:6px">@s.Type</span>
                                </td>
                                <td style="padding:6px 8px;border-bottom:1px dashed var(--line);text-align:right;font-family:var(--mono);color:var(--ink)">@s.Count</td>
                                <td style="padding:6px 8px;border-bottom:1px dashed var(--line);font-family:var(--mono);font-size:11.5px;color:var(--ink-2);white-space:nowrap">@Dash(s.Last)</td>
                                <td style="padding:6px 8px;border-bottom:1px dashed var(--line);color:var(--ink-2)">@Dash(s.Sample)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div style="font-family:var(--mono);font-size:10.5px;color:var(--ink-3);padding-top:8px">
                来源 GET /api/debug/stats · 统计本次运行期间进入管线的事件（含下方模拟事件）
            </div>
        }
    </div>
</div>

<div class="blt-panel">
    <div class="blt-panel-head"><span class="t"><BltIcon Emoji="🚀" /> 模拟事件</span><span class="en">DEBUG INJECTION</span>
        <span class="right"><span>POST /api/debug/event</span></span>
    </div>
    <div class="blt-panel-body">
        <label class="blt-label">固定 UID 进房 · FIXED UID ENTER</label>
        <div style="display:flex;gap:10px;align-items:flex-end;flex-wrap:wrap">
            <div style="width:150px">
                <label class="blt-label">UID</label>
                <input class="blt-input mono" @bind="_simUid" placeholder="例如 10001" />
            </div>
            <div style="width:180px">
                <label class="blt-label">昵称</label>
                <input class="blt-input mono" @bind="_simUname" placeholder="例如 测试观众" />
            </div>
            <button class="blt-btn primary" style="margin-bottom:1px" @onclick="SendEnterAsync" disabled="@_simBusy">发送进房事件</button>
            <span class="blt-hint" style="margin:0 0 9px 0">type=interact（进房），带输入的 uid / uname</span>
        </div>

        <label class="blt-label" style="margin-top:14px">礼物数量快捷 · GIFT QUANTITY</label>
        <div style="display:flex;gap:8px;align-items:center;flex-wrap:wrap">
            <button class="blt-btn" @onclick="() => SendGiftAsync(1)" disabled="@_simBusy">×1</button>
            <button class="blt-btn" @onclick="() => SendGiftAsync(10)" disabled="@_simBusy">×10</button>
            <button class="blt-btn" @onclick="() => SendGiftAsync(100)" disabled="@_simBusy">×100</button>
            <button class="blt-btn" @onclick="() => SendGiftAsync(111)" disabled="@_simBusy">×111</button>
            <span class="blt-hint" style="margin:0">小花花 · 固定 uid=10001 / uname=测试观众，用于验证礼物聚合与感谢链路</span>
        </div>
    </div>
</div>

<div class="blt-panel">
    <div class="blt-panel-head"><span class="t">ℹ 说明</span><span class="en">NOTES</span></div>
    <div class="blt-panel-body">
        <div class="blt-empty" style="padding:0;text-align:left">
            诊断共 8 项：B站房间接口（观众数/房间信息）、B站弹幕服务器握手接口、授权验证服务器、GitHub 更新源、网易云音乐源（点歌）、
            Edge TTS 语音服务（本机 8020）、本地语音引擎 MOSS（本机 8021）、本机服务端。
            状态含义：OK 正常 / WARN 网络可达但接口异常 / FAIL 不可达。单项超时 6 秒。
        </div>
    </div>
</div>

@code {
    // Sequential probes can take up to ~8 x 6s; allow a generous timeout.
    private static readonly HttpClient Http = new() { Timeout = TimeSpan.FromSeconds(120) };

    private List<DiagItem> _results = new();
    private bool _running;
    private string _error = "";
    private string _generatedAt = "";
    private string _copyHint = "";
    private bool _showText;

    // ---- debug: event stats (GET /api/debug/stats) ----
    private sealed record StatRow(string Type, long Count, string Last, string Sample);

    private List<StatRow> _stats = new();
    private bool _statsBusy;
    private bool _statsLoaded;
    private string _statsError = "";
    private bool _statsConnected;
    private string _statsRoomId = "";

    // ---- debug: simulated events (POST /api/debug/event) ----
    private string _simUid = "10001";
    private string _simUname = "测试观众";
    private bool _simBusy;

    private sealed record DiagItem(string Name, string State, long Latency, string Detail);

    private string BaseUrl => "http://127.0.0.1:" + Api.Port;

    protected override Task OnInitializedAsync() => RefreshStatsAsync();

    // ----- debug: event stats -----

    private async Task RefreshStatsAsync()
    {
        if (_statsBusy) return;
        _statsBusy = true;
        _statsError = "";
        try
        {
            var txt = await Http.GetStringAsync(BaseUrl + "/api/debug/stats");
            var j = JsonNode.Parse(txt) as JsonObject;
            var err = GetStr(j?["error"]);
            if (err.Length > 0)
            {
                _statsError = "统计读取失败：" + err;
                return;
            }
            var rows = new List<StatRow>();
            if (j?["stats"] is JsonArray arr)
            {
                foreach (var n in arr)
                {
                    if (n is not JsonObject o) continue;
                    rows.Add(new StatRow(GetStr(o["type"]), GetLong(o["count"]), GetStr(o["last"]), GetStr(o["sample"])));
                }
            }
            _stats = rows;
            _statsConnected = j?["connected"] is JsonValue cv && cv.TryGetValue<bool>(out var cb) && cb;
            _statsRoomId = GetStr(j?["roomId"]);
            _statsLoaded = true;
        }
        catch (Exception e)
        {
            _statsError = "统计读取失败：" + e.Message;
        }
        finally
        {
            _statsBusy = false;
        }
    }

    // ----- debug: simulated events -----

    /// <summary>Fixed-UID enter event (BuildMockEvent maps interact/enter → MsgType 1).</summary>
    private async Task SendEnterAsync()
    {
        var uid = _simUid.Trim();
        var uname = _simUname.Trim();
        if (uid.Length == 0)
        {
            await UI.ToastAsync("请先填写 UID", false);
            return;
        }
        if (uname.Length == 0) uname = "观众" + uid;
        var body = new JsonObject { ["type"] = "interact", ["uid"] = uid, ["uname"] = uname };
        await SendDebugEventAsync(body, "已发送进房事件 · " + uname + "（UID " + uid + "）");
    }

    /// <summary>Gift quick buttons: same mock endpoint, fixed tester identity (aggregation check).</summary>
    private async Task SendGiftAsync(int num)
    {
        var body = new JsonObject
        {
            ["type"] = "gifts",
            ["giftName"] = "小花花",
            ["num"] = num,
            ["uid"] = "10001",
            ["uname"] = "测试观众",
        };
        await SendDebugEventAsync(body, "已发送礼物事件 · 小花花 ×" + num);
    }

    private async Task SendDebugEventAsync(JsonObject body, string okText)
    {
        if (_simBusy) return;
        _simBusy = true;
        try
        {
            var content = new StringContent(body.ToJsonString(), Encoding.UTF8, "application/json");
            using var resp = await Http.PostAsync(BaseUrl + "/api/debug/event", content);
            var txt = await resp.Content.ReadAsStringAsync();
            JsonObject? j = null;
            try { j = JsonNode.Parse(txt) as JsonObject; } catch { }
            var err = GetStr(j?["error"]);
            if (err.Length > 0)
            {
                await UI.ToastAsync("发送失败：" + err, false);
                return;
            }
            if (!resp.IsSuccessStatusCode)
            {
                await UI.ToastAsync("发送失败：HTTP " + (int)resp.StatusCode, false);
                return;
            }
            await UI.ToastAsync(okText, true);
            await RefreshStatsAsync();
        }
        catch (Exception e)
        {
            await UI.ToastAsync("发送失败：" + e.Message, false);
        }
        finally
        {
            _simBusy = false;
        }
    }

    private async Task RunAsync()
    {
        if (_running) return;
        _running = true;
        _error = "";
        _copyHint = "";
        _showText = false;
        try
        {
            var content = new StringContent("{}", Encoding.UTF8, "application/json");
            var resp = await Http.PostAsync(BaseUrl + "/api/diagnostics", content);
            var txt = await resp.Content.ReadAsStringAsync();
            var j = JsonNode.Parse(txt);
            var err = GetStr(j?["error"]);
            if (err.Length > 0)
            {
                _error = "诊断失败：" + err;
                return;
            }
            var list = new List<DiagItem>();
            if (j?["results"] is JsonArray arr)
            {
                foreach (var n in arr)
                {
                    if (n is not JsonObject o) continue;
                    var state = GetStr(o["state"]);
                    if (state != "ok" && state != "warn" && state != "fail") state = "warn";
                    list.Add(new DiagItem(GetStr(o["name"]), state, GetLong(o["latency"]), GetStr(o["detail"])));
                }
            }
            _results = list;
            var gen = GetLong(j?["generatedAt"]);
            _generatedAt = gen > 0
                ? DateTimeOffset.FromUnixTimeMilliseconds(gen).LocalDateTime.ToString("yyyy-MM-dd HH:mm:ss")
                : DateTime.Now.ToString("yyyy-MM-dd HH:mm:ss");
        }
        catch (Exception e)
        {
            _error = "诊断失败：" + e.Message;
        }
        finally
        {
            _running = false;
        }
    }

    private async Task CopyResult()
    {
        _showText = true;
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", PlainText());
            _copyHint = "已写入剪贴板；若系统未授权，可在下方文本框手动复制。";
        }
        catch
        {
            _copyHint = "写入剪贴板失败（浏览器不支持或未授权），请在下方文本框手动复制。";
        }
    }

    private string PlainText()
    {
        var sb = new StringBuilder();
        sb.AppendLine("BLT 网络诊断报告");
        sb.AppendLine("生成时间: " + (_generatedAt.Length > 0 ? _generatedAt : DateTime.Now.ToString("yyyy-MM-dd HH:mm:ss")));
        sb.AppendLine("BUILD " + KestrelHost.VersionText + " · 端口 " + Api.Port);
        sb.AppendLine(new string('-', 52));
        foreach (var r in _results)
            sb.AppendLine("[" + r.State.ToUpperInvariant().PadRight(4) + "] " + r.Name + " · " + r.Latency + "ms · " + r.Detail);
        sb.AppendLine(new string('-', 52));
        sb.AppendLine("合计 " + _results.Count + " 项 · OK " + CountState("ok") + " · WARN " + CountState("warn") + " · FAIL " + CountState("fail"));
        return sb.ToString();
    }

    private int CountState(string state)
    {
        var n = 0;
        foreach (var r in _results)
            if (r.State == state) n++;
        return n;
    }

    private string GeneratedText() => _generatedAt.Length > 0 ? "生成于 " + _generatedAt : "未运行";

    // ----- debug: stats helpers -----

    private string StatsBadge() => !_statsLoaded ? "off" : (_statsConnected ? "green" : "off");

    private string StatsStateText() => !_statsLoaded ? "读取中…" : (_statsConnected ? "已连接" : "未连接");

    private string StatsRoomText() => _statsRoomId.Length > 0 ? "房间 " + _statsRoomId : "房间 —";

    private string StatsEmptyText() => _statsBusy
        ? "读取统计…"
        : "暂无事件统计 —— 连接直播间或发送下方模拟事件后点「刷新」";

    private static string StatsThStyle() => StatsThStyle(false);

    private static string StatsThStyleRight() => StatsThStyle(true);

    private static string StatsThStyle(bool right)
        => "text-align:" + (right ? "right" : "left")
        + ";padding:6px 8px;font-family:var(--mono);font-size:10px;color:var(--ink-3);letter-spacing:1px;border-bottom:1px solid var(--line)";

    private static string TypeText(string type) => type switch
    {
        "danmu" => "弹幕",
        "gifts" => "礼物",
        "gifts_merged" => "礼物聚合",
        "blindbox" => "盲盒",
        "guard" => "舰长",
        "superchat" => "SC",
        "interact" => "互动/进房",
        "pk" => "PK",
        _ => type,
    };

    private static string Dash(string s) => s.Length > 0 ? s : "—";

    private static string StateText(string state) => state switch
    {
        "ok" => "OK",
        "warn" => "WARN",
        "fail" => "FAIL",
        _ => state.ToUpperInvariant(),
    };

    private static string Badge(string state) => state switch
    {
        "ok" => "green",
        "warn" => "amber",
        "fail" => "red",
        _ => "off",
    };

    private static long GetLong(JsonNode? n)
    {
        if (n == null) return 0;
        try { return n.GetValue<long>(); } catch { }
        try { return (long)n.GetValue<double>(); } catch { }
        try { return long.TryParse(n.ToString(), out var v) ? v : 0; } catch { return 0; }
    }

    private static string GetStr(JsonNode? n)
    {
        try { return n?.GetValue<string>() ?? ""; } catch { return ""; }
    }
}
