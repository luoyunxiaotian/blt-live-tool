    private static string OnOff(bool on) => on ? "green" : "red";

    private static string OnOffText(bool on) => on ? "ON" : "OFF";

    private static string SwitchClass(bool on) => on ? "blt-switch on" : "blt-switch";

    private static string PathText(string p) => p.Length > 0 ? p : "—";

    private static string Stamp() => DateTime.Now.ToString("HH:mm:ss");

    private static string Short(string s)
    {
        if (string.IsNullOrEmpty(s)) return "未知错误";
        return s.Length > 90 ? s[..90] + "…" : s;
    }

    private static string ErrText(string s)
    {
        try
        {
            if (JsonNode.Parse(s) is JsonObject o)
            {
                var e = Str(o, "error");
                if (e.Length > 0) return " · " + e;
            }
        }
        catch { /* not JSON */ }
        return "";
    }

    private static bool PropBool(object o, string name)
    {
        var v = o.GetType().GetProperty(name)?.GetValue(o);
        return v is bool b && b;
    }

    private static string PropStr(object o, string name)
        => o.GetType().GetProperty(name)?.GetValue(o) as string ?? "";

    private static string Str(JsonObject? o, string key, string def = "")
    {
        if (o != null && o.TryGetPropertyValue(key, out var v) && v is JsonValue jv && jv.TryGetValue<string>(out var s) && s != null) return s;
        return def;
    }

    private static bool Flag(JsonObject? o, string key, bool def)
    {
        if (o != null && o.TryGetPropertyValue(key, out var v) && v is JsonValue jv && jv.TryGetValue<bool>(out var b)) return b;
        return def;
    }

    private static double Dbl(JsonObject? o, string key, double def)
    {
        if (o != null && o.TryGetPropertyValue(key, out var v) && v is JsonValue jv && jv.TryGetValue<double>(out var d)) return d;
        return def;
    }

    private static string NumText(JsonObject? o, string key, double def)
        => Dbl(o, key, def).ToString("0.###", CultureInfo.InvariantCulture);

    private static double ParseD(string s, double def)
    {
        if (double.TryParse(s, NumberStyles.Float, CultureInfo.InvariantCulture, out var d)) return d;
        if (double.TryParse(s, out var d2)) return d2;
        return def;
    }

    private static List<string> SplitList(string s)
        => s.Split(new[] { ',', '，', '\n', ' ', ';', '；' }, StringSplitOptions.RemoveEmptyEntries)
            .Select(x => x.Trim()).Where(x => x.Length > 0).ToList();
}
