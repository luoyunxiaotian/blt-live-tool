    // ---- 应用内更新（下载 → 校验 → 暂存 → 重启安装）----

    private string _updaterPhase = "";
    private int _updaterPercent;
    private string _updaterMsg = "";
    private bool _updaterBusy;

    private string UpdaterNoteColor()
        => _updaterPhase == "Failed" ? "var(--red)" : _updaterPhase == "Staged" ? "var(--green)" : "var(--ink-3)";

    private async Task StartUpdateDownload()
    {
        _updaterBusy = true;
        _updaterPercent = 0;
        _updaterMsg = "正在准备下载…";
        StateHasChanged();
        try
        {
            await PostJsonAsync("/api/maui/update/download", new JsonObject());
            // 轮询进度（下载 156MB 视网络需要数十秒到数分钟）
            for (var i = 0; i < 600; i++)
            {
                await Task.Delay(1000);
                var o = await PostJsonReadAsync("/api/maui/update/status", new JsonObject());
                if (o?["updater"] is not JsonObject u) continue;
                _updaterPhase = u["phase"] is JsonValue pv && pv.TryGetValue<string>(out var ps) ? ps ?? "" : "";
                _updaterPercent = u["percent"] is JsonValue pct && pct.TryGetValue<int>(out var pi) ? pi : 0;
                _updaterMsg = u["message"] is JsonValue mv && mv.TryGetValue<string>(out var ms) ? ms ?? "" : "";
                StateHasChanged();
                if (_updaterPhase is "Staged" or "Failed" or "Idle") break;
            }
        }
        catch (Exception ex)
        {
            _updaterPhase = "Failed";
            _updaterMsg = "更新失败：" + ex.Message;
        }
        finally
        {
            _updaterBusy = false;
            StateHasChanged();
        }
    }

