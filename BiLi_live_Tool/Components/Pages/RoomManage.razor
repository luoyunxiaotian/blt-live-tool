    // ---- manual cookie import (📋 手动导入 Cookie) ----

    /// <summary>
    /// Parses "k=v; k2=v2" (also one pair per line, plus a pasted "Cookie: k=v" header)
    /// into an ordered dictionary; key/value order follows the paste.
    /// </summary>
    private static Dictionary<string, string> ParseCookiePairs(string raw)
    {
        var pairs = new Dictionary<string, string>(StringComparer.Ordinal);
        var text = (raw ?? "").Replace("\r", "\n");
        foreach (var chunk in text.Split(new[] { ';', '\n' }, StringSplitOptions.RemoveEmptyEntries))
        {
            var item = chunk.Trim();
            var eq = item.IndexOf('=');
            if (eq <= 0) continue;
            var key = item[..eq].Trim();
            var colon = key.LastIndexOf(':');           // tolerate a pasted "Cookie: SESSDATA" header
            if (colon >= 0) key = key[(colon + 1)..].Trim();
            var val = item[(eq + 1)..].Trim();
            if (key.Length == 0 || val.Length == 0) continue;
            if (val is "undefined" or "null" or "NaN") continue;
            pairs[key] = val;   // later duplicates win
        }
        return pairs;
    }

    /// <summary>Parses the pasted cookie and writes it through the same config path as SaveRoomConfig.</summary>
    private void ImportCookie()
    {
        _cookieInfo = "";
        _cookieWarn = "";
        _cookieError = "";

        var pairs = ParseCookiePairs(_cookieInput);
        if (pairs.Count == 0)
        {
            _cookieError = "未识别到有效 Cookie";
            return;
        }

        var hasSession = pairs.ContainsKey("SESSDATA");
        var hasJct = pairs.ContainsKey("bili_jct");
        var cookie = string.Join("; ", pairs.Select(kv => kv.Key + "=" + kv.Value));

        try
        {
            // Snapshot → mutate config.cookie → replace, exactly like SaveRoomConfig.
            var doc = Config.Snapshot();
            doc["cookie"] = cookie;
            if (pairs.TryGetValue("DedeUserID", out var uid) && uid.Length > 0) doc["uid"] = uid;
            Config.ReplaceFrom(doc);
        }
        catch (Exception ex)
        {
            _cookieError = "保存失败：" + ex.Message;
            return;
        }

        _cookieInfo = hasSession
            ? $"✅ 已识别 SESSDATA（共 {pairs.Count} 项，已保存）"
            : $"已保存 {pairs.Count} 项 Cookie";
        var warns = new List<string>();
        if (!hasSession) warns.Add("缺少 SESSDATA：登录态可能无效");
        if (!hasJct) warns.Add("缺少 bili_jct：发言/点赞等写操作会失败");
        _cookieWarn = warns.Count > 0 ? "⚠ " + string.Join("；", warns) : "";

        Hub.PublishStatus(Hub.LastStatus);   // refresh the login rows above
        StateHasChanged();
    }

    // ---- record folders (📁 记录文件夹) ----

    /// <summary>GET /api/status → folders, retried while the panel API finishes booting.</summary>
    private async Task LoadFoldersAsync()
    {
        for (var attempt = 0; attempt < 5; attempt++)
        {
            var rows = await FetchFoldersAsync();
            if (rows.Count > 0)
            {
                try
                {
                    await InvokeAsync(() =>
                    {
                        _folders.Clear();
                        _folders.AddRange(rows);
                        StateHasChanged();
                    });
                }
                catch
                {
                    // component disposed while the request was in flight
                }
                return;
            }
            await Task.Delay(700 * (attempt + 1));
        }
    }

    /// <summary>One row per record type (absolute paths); empty when the API is unreachable.</summary>
    private async Task<List<(string Label, string Path)>> FetchFoldersAsync()
    {
        var rows = new List<(string Label, string Path)>();
        try
        {
            var o = await GetJsonAsync("/api/status");
            var folders = o?["folders"] as JsonObject;
            if (folders == null) return rows;
            foreach (var (key, label) in FolderDefs)
                if (folders[key] is JsonValue v && v.TryGetValue<string>(out var p) && !string.IsNullOrEmpty(p))
                    rows.Add((label, p));
        }
        catch
        {
            // the panel API may still be starting up
        }
        return rows;
    }

