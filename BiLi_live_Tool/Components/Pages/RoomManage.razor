    /// <summary>POST to the MAUI bridge and read the JSON reply (bridge is POST-only).</summary>
    private async Task<JsonObject?> PostJsonReadAsync(string path, JsonObject body)
    {
        try
        {
            using var resp = await Http.PostAsync(Base + path,
                new StringContent(body.ToJsonString(), Encoding.UTF8, "application/json"));
            var txt = await resp.Content.ReadAsStringAsync();
            if (!resp.IsSuccessStatusCode) return null;
            return JsonNode.Parse(txt) as JsonObject;
        }
        catch { return null; }
    }

    private async Task<JsonObject?> GetJsonAsync(string path)
    {
        using var resp = await Http.GetAsync(Base + path);
        var txt = await resp.Content.ReadAsStringAsync();
        if (!resp.IsSuccessStatusCode) return null;
        return JsonNode.Parse(txt) as JsonObject;
    }

    private static string ApiError(string body)
    {
        try
        {
            if (JsonNode.Parse(body) is JsonObject o && o["error"] is JsonValue v && v.TryGetValue<string>(out var e))
                return e ?? "";
        }
        catch { }
        return "";
    }

    private static bool GetBool(JsonObject o, string key, bool def)
        => o.TryGetPropertyValue(key, out var v) && v is JsonValue jv && jv.TryGetValue<bool>(out var b) ? b : def;

    private static string GetStr(JsonObject o, string key, string def)
        => o.TryGetPropertyValue(key, out var v) && v is JsonValue jv && jv.TryGetValue<string>(out var s) && !string.IsNullOrEmpty(s) ? s : def;

    private static double GetNum(JsonObject o, string key, double def)
        => o.TryGetPropertyValue(key, out var v) && v is JsonValue jv && jv.TryGetValue<double>(out var d) ? d : def;

