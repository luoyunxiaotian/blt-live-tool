@page "/autodanmu"
@using System.Text
@using System.Text.Json
@using System.Text.Json.Nodes
@inject AppConfig Config
@inject LivePipeline Pipeline
@inject BiLi_live_Tool.Services.DebouncedSaver Saver
@implements IDisposable
@* Auto danmu page: welcome / gift thanks / follow thanks / timer pools, plus live pipeline test shots.
   Config is read from GET /api/config and written back as the whole document via POST /api/config
   (server merges top-level keys and persists); a direct in-process write is the offline fallback. *@

<div class="blt-pagehead">
    <h1>自动弹幕</h1><span class="en">AUTO DANMU</span>
    <span style="margin-left:auto;display:flex;align-items:center;gap:12px">
        <span class="blt-hint" style="margin:0;font-family:var(--mono);color:var(--amber)">@_status</span>
        @* 保存全部 button replaced by the auto-save status line (every edit writes through immediately). *@
        <span class="blt-hint" style="margin:0">@AutoSaveText()</span>
    </span>
</div>

<div class="blt-topstrip">
    <span class="seg">config <b class="@ConfigClass()">@ConfigText()</b></span>
    <span class="seg">api <b>127.0.0.1:@Config.Port</b></span>
    <span class="seg">欢迎 <b class="@OnOff(_welcomeEnabled)">@OnOffText(_welcomeEnabled)</b></span>
    <span class="seg">礼物感谢 <b class="@OnOff(_thankEnabled)">@OnOffText(_thankEnabled)</b></span>
    <span class="seg">关注感谢 <b class="@OnOff(_followEnabled)">@OnOffText(_followEnabled)</b></span>
    <span class="seg">定时 <b class="@OnOff(_timerEnabled)">@OnOffText(_timerEnabled)</b></span>
    <span class="seg">本场关注 <b class="green">@_followCount</b></span>
</div>

@* Page-level control bar: this page has no single master switch — it surfaces the
   four sub-function states and points at each card for the actual toggle. *@
<div class="blt-master @MasterCls()">
    <span class="st">自动弹幕</span>
    <span class="sub">无总开关 · 欢迎 / 礼物感谢 / 感谢关注 / 定时弹幕 四个子功能在各自卡片右上角独立开启</span>
    <span class="right">
        <span class="blt-badge @BadgeWelcome">欢迎 @OnOffText(_welcomeEnabled)</span>
        <span class="blt-badge @BadgeThank">感谢 @OnOffText(_thankEnabled)</span>
        <span class="blt-badge @BadgeFollow">关注 @OnOffText(_followEnabled)</span>
        <span class="blt-badge @BadgeTimer">定时 @OnOffText(_timerEnabled)</span>
    </span>
</div>

<div class="blt-grid blt-cols-2">
    @* ── 左列：欢迎 / 礼物感谢 ── *@
    <div>
        <div class="blt-panel">
            <div class="blt-panel-head"><span class="t">👋 欢迎进房</span><span class="en">WELCOME</span>
                @* Sub-function switch lives in the card head (was a corner control). *@
                <span class="right"><span class="blt-switch lg @OnCls(_welcomeEnabled)" @onclick="ToggleWelcome"><span class="track"></span>@OnOffText(_welcomeEnabled)</span></span>
            </div>
            <div class="blt-panel-body">
                <div class="blt-hint" style="margin:0">同一用户 60s 内只欢迎一次 · 改动即时生效并自动保存</div>

                <div style="display:flex;gap:14px;margin-top:16px;flex-wrap:wrap">
                    <div style="flex:1;min-width:110px">
                        <label class="blt-label">honorLevelMin · 荣誉下限</label>
                        <input class="blt-input mono" type="number" step="1" min="0" @bind="_honorMin" @bind:after="SaveWelcomeSoon" />
                    </div>
                    <div style="flex:1;min-width:110px">
                        <label class="blt-label">fanMedalMin · 灯牌下限</label>
                        <input class="blt-input mono" type="number" step="1" min="0" @bind="_medalMin" @bind:after="SaveWelcomeSoon" />
                    </div>
                    <div style="flex:1;min-width:110px">
                        <label class="blt-label">rate · 欢迎间隔秒</label>
                        <input class="blt-input mono" type="number" step="0.5" min="0" @bind="_welcomeRate" @bind:after="SaveWelcomeSoon" />
                    </div>
                </div>
                <div class="blt-hint">下限为 0 表示不过滤；大于 0 时，等级 ≤ 该值的用户不欢迎</div>

                <div style="margin-top:12px">
                    <label class="blt-label">texts · 欢迎语池（每行一条 · @PoolCount(_welcomeTexts) 条）</label>
                    <textarea class="blt-input" style="min-height:120px;line-height:1.7;resize:vertical" @bind="_welcomeTexts" @bind:after="SaveWelcomeSoon"></textarea>
                </div>
                <div style="margin-top:12px">
                    <label class="blt-label">guardTexts · 舰长专属语池（每行一条 · @PoolCount(_guardTexts) 条）</label>
                    <textarea class="blt-input" style="min-height:90px;line-height:1.7;resize:vertical" @bind="_guardTexts" @bind:after="SaveWelcomeSoon"></textarea>
                </div>
                <div class="blt-hint">可用占位符：{uname} {uid} {levelName} · 留空则用内置默认语</div>
                @* 保存欢迎设置 button replaced by the auto-save status line. *@
                <div class="blt-hint" style="margin-top:14px;padding-top:10px;border-top:1px dashed var(--line)">@AutoSaveText()</div>
            </div>
        </div>

        <div class="blt-panel">
            <div class="blt-panel-head"><span class="t">🎁 感谢礼物</span><span class="en">THANK</span>
                @* Sub-function switch lives in the card head (was a corner control). *@
                <span class="right"><span class="blt-switch lg @OnCls(_thankEnabled)" @onclick="ToggleThank"><span class="track"></span>@OnOffText(_thankEnabled)</span></span>
            </div>
            <div class="blt-panel-body">
                <div class="blt-hint" style="margin:0">聚合后播报 · 改动即时生效并自动保存</div>

                <div style="display:flex;gap:14px;margin-top:16px;flex-wrap:wrap">
                    <div style="flex:1;min-width:150px">
                        <label class="blt-label">waitMs · 聚合窗口（毫秒）</label>
                        <input class="blt-input mono" type="number" step="500" min="500" @bind="_waitMs" @bind:after="SaveThankSoon" />
                    </div>
                </div>
                <div class="blt-hint">同一用户在该窗口内的礼物合并为一条感谢（默认 3000ms）</div>

                <div style="margin-top:12px">
                    <label class="blt-label">texts · 感谢语池（每行一条 · @PoolCount(_thankTexts) 条）</label>
                    <textarea class="blt-input" style="min-height:150px;line-height:1.7;resize:vertical" @bind="_thankTexts" @bind:after="SaveThankSoon"></textarea>
                </div>
                <div class="blt-hint">可用占位符：{uname} {giftSummary} {giftName} {num}</div>
                @* 保存礼物感谢 button replaced by the auto-save status line. *@
                <div class="blt-hint" style="margin-top:14px;padding-top:10px;border-top:1px dashed var(--line)">@AutoSaveText()</div>
            </div>
        </div>
    </div>

    @* ── 右列：关注感谢 / 定时弹幕 / 模拟事件 ── *@
    <div>
        <div class="blt-panel">
            <div class="blt-panel-head"><span class="t">⭐ 感谢关注</span><span class="en">FOLLOW</span>
                @* Sub-function switch lives in the card head (was a corner control). *@
                <span class="right"><span class="blt-switch lg @OnCls(_followEnabled)" @onclick="ToggleFollow"><span class="track"></span>@OnOffText(_followEnabled)</span></span>
            </div>
            <div class="blt-panel-body">
                <div class="blt-hint" style="margin:0">同一 UID 本场只谢一次 · 改动即时生效并自动保存</div>

                <div style="display:flex;gap:14px;margin-top:16px;flex-wrap:wrap">
                    <div style="flex:1;min-width:150px">
                        <label class="blt-label">rate · 发送间隔秒</label>
                        <input class="blt-input mono" type="number" step="0.5" min="0" @bind="_followRate" @bind:after="SaveFollowSoon" />
                    </div>
                    <div style="flex:1;min-width:150px">
                        <label class="blt-label">本场统计刷新</label>
                        <button class="blt-btn" style="width:100%" @onclick="RefreshStats" disabled="@_busy">刷新统计</button>
                    </div>
                </div>

                <div style="margin-top:12px">
                    <div class="blt-kv"><span class="k">本场已感谢关注</span><span class="v green">@_followCount</span></div>
                    <div class="blt-kv"><span class="k">去重轨迹</span><span class="v">@_followTracked / @_followCap</span></div>
                    <div class="blt-kv"><span class="k">服务器侧 enabled</span><span class="v @OnOff(_statsEnabled)">@OnOffText(_statsEnabled)</span></div>
                    <div class="blt-kv"><span class="k">统计接口</span><span class="v @OnOff(_statsOk)">@StatsText()</span></div>
                </div>

                <div style="margin-top:12px">
                    <label class="blt-label">texts · 关注语池（每行一条 · @PoolCount(_followTexts) 条）</label>
                    <textarea class="blt-input" style="min-height:140px;line-height:1.7;resize:vertical" @bind="_followTexts" @bind:after="SaveFollowSoon"></textarea>
                </div>
                <div class="blt-hint">可用占位符：{uname} {uid}</div>
                @* 保存关注设置 button replaced by the auto-save status line. *@
                <div class="blt-hint" style="margin-top:14px;padding-top:10px;border-top:1px dashed var(--line)">@AutoSaveText()</div>
            </div>
        </div>

        <div class="blt-panel">
            <div class="blt-panel-head"><span class="t">⏱ 定时弹幕</span><span class="en">TIMER</span>
                @* Sub-function switch lives in the card head (was a corner control). *@
                <span class="right"><span class="blt-switch lg @OnCls(_timerEnabled)" @onclick="ToggleTimer"><span class="track"></span>@OnOffText(_timerEnabled)</span></span>
            </div>
            <div class="blt-panel-body">
                <div class="blt-hint" style="margin:0">断线时自动跳过 · 改动即时生效并自动保存</div>

                <div style="display:flex;gap:14px;margin-top:16px;flex-wrap:wrap">
                    <div style="flex:1;min-width:150px">
                        <label class="blt-label">intervalSec · 间隔秒</label>
                        <input class="blt-input mono" type="number" step="5" min="1" @bind="_timerInterval" @bind:after="SaveTimerSoon" />
                    </div>
                </div>

                <div style="margin-top:12px">
                    <label class="blt-label">texts · 定时语池（每行一条 · @PoolCount(_timerTexts) 条）</label>
                    <textarea class="blt-input" style="min-height:120px;line-height:1.7;resize:vertical" @bind="_timerTexts" @bind:after="SaveTimerSoon"></textarea>
                </div>
                @* 保存定时设置 button replaced by the auto-save status line. *@
                <div class="blt-hint" style="margin-top:14px;padding-top:10px;border-top:1px dashed var(--line)">@AutoSaveText()</div>
            </div>
        </div>

        <div class="blt-panel">
            <div class="blt-panel-head"><span class="t">⚡ 模拟事件</span><span class="en">SIMULATE</span>
                <span class="right"><span>dev · 走完整事件管线</span></span>
            </div>
            <div class="blt-panel-body">
                <div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:8px">
                    <button class="blt-btn" @onclick="SimFollow" disabled="@_busy">模拟关注</button>
                    <button class="blt-btn" @onclick="SimDanmu" disabled="@_busy">模拟弹幕</button>
                    <button class="blt-btn" @onclick="SimGifts" disabled="@_busy">模拟礼物</button>
                    <button class="blt-btn" @onclick="SimGuard" disabled="@_busy">模拟舰长</button>
                    <button class="blt-btn" @onclick="SimSuperchat" disabled="@_busy">模拟 SC</button>
                    <button class="blt-btn" @onclick="SimEnter" disabled="@_busy">模拟进房</button>
                </div>
                <div class="blt-hint" style="margin-top:10px">
                    POST /api/debug/event · 礼物感谢会在 waitMs 聚合窗口后发送；需已连接直播间才会真正发出
                </div>
                <div class="blt-hint" style="margin-top:6px;color:var(--ink-2)">@_simMsg</div>
            </div>
        </div>
    </div>
</div>

@code {
    private static readonly HttpClient Http = new() { Timeout = TimeSpan.FromSeconds(20) };
    private string Base => "http://127.0.0.1:" + Config.Port;

    private JsonObject? _doc;
    private bool _busy;
    private string _status = "载入中…";
    private string _simMsg = "";

    // auto-save status (the per-card save buttons were removed)
    private DateTime? _savedAt;
    private string _saveMsg = "";
    private readonly SemaphoreSlim _saveGate = new(1, 1);   // serializes POSTs (auto-save can fire back to back)

    // welcome
    private bool _welcomeEnabled;
    private string _honorMin = "0", _medalMin = "0", _welcomeRate = "1";
    private string _welcomeTexts = "", _guardTexts = "";

    // thank
    private bool _thankEnabled;
    private string _waitMs = "3000", _thankTexts = "";

    // follow
    private bool _followEnabled;
    private string _followRate = "1", _followTexts = "";

    // timer
    private bool _timerEnabled;
    private string _timerInterval = "60", _timerTexts = "";

    // follow stats (GET /api/autodanmu/follow-stats)
    private bool _statsOk, _statsEnabled;
    private long _followCount, _followTracked, _followCap;

    private System.Threading.Timer? _tick;

    protected override async Task OnInitializedAsync()
    {
        await LoadConfigAsync();
        await RefreshStatsAsync(true);
        // Poll the follow counter so the page shows this session's progress.
        _tick = new System.Threading.Timer(_ => _ = Tick(), null, 5000, 5000);
    }

    private async Task Tick()
    {
        await RefreshStatsAsync(true);
        await InvokeAsync(StateHasChanged);
    }

    public void Dispose() => _tick?.Dispose();

    // ---- config load / save ----

    private async Task LoadConfigAsync()
    {
        string? json = null;
        try
        {
            using var resp = await Http.GetAsync(Base + "/api/config");
            if (resp.IsSuccessStatusCode) json = await resp.Content.ReadAsStringAsync();
            else _status = "配置接口 HTTP " + (int)resp.StatusCode + "，改用本地快照";
        }
        catch (Exception ex)
        {
            _status = "配置接口不可用（" + Short(ex.Message) + "），改用本地快照";
        }

        if (json == null)
        {
            try { json = Config.SnapshotJson(); } catch { /* keep the page alive */ }
        }

        try
        {
            _doc = json != null ? JsonNode.Parse(json) as JsonObject : null;
        }
        catch (Exception ex)
        {
            _doc = null;
            _status = "配置解析失败：" + Short(ex.Message);
        }
        ApplyFromDoc();
        if (_doc != null && _status.StartsWith("载入中")) _status = "配置已载入 · " + Stamp();
    }

    private void ApplyFromDoc()
    {
        var ad = _doc?["autoDanmu"] as JsonObject;
        var welcome = ad?["welcome"] as JsonObject;
        var thank = ad?["thank"] as JsonObject;
        var follow = ad?["follow"] as JsonObject;
        var timer = ad?["timer"] as JsonObject;

        _welcomeEnabled = Flag(welcome, "enabled", false);
        _honorMin = NumText(welcome, "honorLevelMin", 0);
        _medalMin = NumText(welcome, "fanMedalMin", 0);
        _welcomeRate = NumText(welcome, "rate", 1);
        _welcomeTexts = JoinArray(welcome, "texts");
        _guardTexts = JoinArray(welcome, "guardTexts");

        _thankEnabled = Flag(thank, "enabled", true);
        _waitMs = NumText(thank, "waitMs", 3000);
        _thankTexts = JoinArray(thank, "texts");

        _followEnabled = Flag(follow, "enabled", false);
        _followRate = NumText(follow, "rate", 1);
        _followTexts = JoinArray(follow, "texts");

        _timerEnabled = Flag(timer, "enabled", false);
        _timerInterval = NumText(timer, "intervalSec", 60);
        _timerTexts = JoinArray(timer, "texts");
    }

    /// <summary>Writes the four sections back into the in-memory document (unknown keys stay untouched).</summary>
    private void ApplyToDoc(string section)
    {
        _doc ??= new JsonObject();
        if (_doc["autoDanmu"] is not JsonObject ad)
        {
            ad = new JsonObject();
            _doc["autoDanmu"] = ad;
        }

        if (section == "welcome" || section == "all")
        {
            var welcome = Section(ad, "welcome");
            welcome["enabled"] = _welcomeEnabled;
            welcome["honorLevelMin"] = ParseL(_honorMin, 0);
            welcome["fanMedalMin"] = ParseL(_medalMin, 0);
            welcome["rate"] = ParseD(_welcomeRate, 1);
            welcome["texts"] = LinesToArray(_welcomeTexts);
            welcome["guardTexts"] = LinesToArray(_guardTexts);
        }
        if (section == "thank" || section == "all")
        {
            var thank = Section(ad, "thank");
            thank["enabled"] = _thankEnabled;
            thank["waitMs"] = ParseL(_waitMs, 3000);
            thank["texts"] = LinesToArray(_thankTexts);
        }
        if (section == "follow" || section == "all")
        {
            var follow = Section(ad, "follow");
            follow["enabled"] = _followEnabled;
            follow["rate"] = ParseD(_followRate, 1);
            follow["texts"] = LinesToArray(_followTexts);
        }
        if (section == "timer" || section == "all")
        {
            var timer = Section(ad, "timer");
            timer["enabled"] = _timerEnabled;
            timer["intervalSec"] = ParseL(_timerInterval, 60);
            timer["texts"] = LinesToArray(_timerTexts);
        }
    }

    private static JsonObject Section(JsonObject parent, string key)
    {
        if (parent[key] is JsonObject o) return o;
        var n = new JsonObject();
        parent[key] = n;
        return n;
    }

    private async Task SaveAll()
    {
        ApplyToDoc("all");
        await SaveAsync("自动弹幕配置已保存");
    }

    private async Task SaveWelcome()
    {
        ApplyToDoc("welcome");
        await SaveAsync("欢迎设置已保存");
    }

    private async Task SaveThank()
    {
        ApplyToDoc("thank");
        await SaveAsync("礼物感谢已保存");
    }

    private async Task SaveFollow()
    {
        ApplyToDoc("follow");
        await SaveAsync("关注感谢已保存");
    }

    private async Task SaveTimer()
    {
        ApplyToDoc("timer");
        await SaveAsync("定时弹幕已保存");
    }

    /// <summary>POSTs the whole document; falls back to a direct in-process write when the API is down.</summary>
    private async Task SaveAsync(string label)
    {
        // Auto-save can fire from several debounce keys at once → serialize instead of
        // dropping the write (a dropped write would silently lose the newest edit).
        // _busy is left to the simulate/test actions so an in-flight save cannot make
        // them drop a click.
        await _saveGate.WaitAsync();
        try
        {
            var json = _doc?.ToJsonString();
            if (json == null) { _saveMsg = "配置尚未载入，未提交"; return; }
            try
            {
                using var resp = await Http.PostAsync(Base + "/api/config",
                    new StringContent(json, Encoding.UTF8, "application/json"));
                var body = await resp.Content.ReadAsStringAsync();
                if (resp.IsSuccessStatusCode)
                {
                    _saveMsg = "";
                    _savedAt = DateTime.Now;
                    _status = label + " · " + Stamp();
                    return;
                }
                WriteLocal(label + " · HTTP " + (int)resp.StatusCode + ErrText(body));
            }
            catch (Exception ex)
            {
                WriteLocal(label + " · " + Short(ex.Message));
            }
        }
        finally
        {
            _saveGate.Release();
        }
    }

    private void WriteLocal(string why)
    {
        try
        {
            Config.UpdateFrom(_doc!);   // top-level merge + persist, same semantics as POST /api/config
            Pipeline.ApplyConfig();
            ApplyFromDoc();
            _saveMsg = "";
            _savedAt = DateTime.Now;
            _status = why + " → 已直写本地配置 · " + Stamp();
        }
        catch (Exception ex)
        {
            _saveMsg = Short(ex.Message);
            _status = "保存失败：" + Short(ex.Message);
        }
    }

    // ---- auto-save (debounced) ----
    // Every control writes through the same document; the debounce only decides how
    // often POST /api/config is hit. Instant controls (switch) get 200 ms, text and
    // number fields the 450 ms default.

    /// <summary>Debounced save; the delegate runs off the renderer thread, so marshal back and repaint.</summary>
    private void SaveSoon(string key, Func<Task> save, int delayMs = 450)
        => Saver.Run(key, () => InvokeAsync(async () => { await save(); StateHasChanged(); }), delayMs);

    private void SaveWelcomeSoon() => SaveSoon("autodanmu-welcome", SaveWelcome);
    private void SaveThankSoon() => SaveSoon("autodanmu-thank", SaveThank);
    private void SaveFollowSoon() => SaveSoon("autodanmu-follow", SaveFollow);
    private void SaveTimerSoon() => SaveSoon("autodanmu-timer", SaveTimer);
    private void SaveWelcomeSoonSwitch() => SaveSoon("autodanmu-welcome", SaveWelcome, 200);
    private void SaveThankSoonSwitch() => SaveSoon("autodanmu-thank", SaveThank, 200);
    private void SaveFollowSoonSwitch() => SaveSoon("autodanmu-follow", SaveFollow, 200);
    private void SaveTimerSoonSwitch() => SaveSoon("autodanmu-timer", SaveTimer, 200);

    private string AutoSaveText()
    {
        if (_saveMsg.Length > 0) return "保存失败：" + _saveMsg;
        return _savedAt.HasValue ? "已自动保存 " + _savedAt.Value.ToString("HH:mm:ss") : "改动即时自动保存";
    }

    // ---- follow stats ----

    private Task RefreshStats() => RefreshStatsAsync(false);

    private async Task RefreshStatsAsync(bool quiet)
    {
        try
        {
            using var resp = await Http.GetAsync(Base + "/api/autodanmu/follow-stats");
            var text = await resp.Content.ReadAsStringAsync();
            if (!resp.IsSuccessStatusCode)
            {
                _statsOk = false;
                if (!quiet) _status = "关注统计 HTTP " + (int)resp.StatusCode + ErrText(text);
                return;
            }
            if (JsonNode.Parse(text) is JsonObject o)
            {
                _followCount = Lng(o, "count");
                _followTracked = Lng(o, "tracked");
                _followCap = Lng(o, "cap");
                _statsEnabled = Flag(o, "enabled", false);
                _statsOk = true;
                if (!quiet) _status = "关注统计已刷新 · " + Stamp();
            }
        }
        catch (Exception ex)
        {
            _statsOk = false;
            if (!quiet) _status = "关注统计读取失败：" + Short(ex.Message);
        }
    }

    private string StatsText() => _statsOk ? "OK" : "FAIL";

    // ---- debug events (real pipeline) ----

    private Task SimFollow() => Sim("follow", "");
    private Task SimDanmu() => Sim("danmu", "测试");
    private Task SimGifts() => Sim("gifts", "");
    private Task SimGuard() => Sim("guard", "");
    private Task SimSuperchat() => Sim("superchat", "");
    private Task SimEnter() => Sim("enter", "");

    private async Task Sim(string type, string msg)
    {
        if (_busy) return;
        _busy = true;
        _simMsg = "投递 " + type + " 事件…";
        try
        {
            var body = new JsonObject { ["type"] = type };
            if (msg.Length > 0) body["msg"] = msg;
            try
            {
                using var resp = await Http.PostAsync(Base + "/api/debug/event",
                    new StringContent(body.ToJsonString(), Encoding.UTF8, "application/json"));
                var text = await resp.Content.ReadAsStringAsync();
                if (resp.IsSuccessStatusCode)
                {
                    _simMsg = "已投递 " + type + " 事件（" + Stamp() + "）· 感谢语按对应面板的语池发送";
                    if (type == "follow") await RefreshStatsAsync(true);
                    return;
                }
                _simMsg = type + " HTTP " + (int)resp.StatusCode + ErrText(text);
            }
            catch
            {
                // API down: drive the in-process pipeline directly
                Pipeline.ProcessDebugEvent(BuildLocal(type, msg));
                _simMsg = "已直投本地管线 " + type + "（" + Stamp() + "）";
                if (type == "follow") await RefreshStatsAsync(true);
            }
        }
        finally
        {
            _busy = false;
        }
    }

    private static LiveEvent BuildLocal(string type, string msg)
    {
        var now = DateTime.Now;
        var ev = new LiveEvent
        {
            Time = now.ToString("yyyy-MM-dd HH:mm:ss"),
            Ts = new DateTimeOffset(now, TimeZoneInfo.Local.GetUtcOffset(now)).ToUnixTimeMilliseconds(),
            Uid = "900001",
        };
        switch (type)
        {
            case "gifts":
                ev.Type = "gifts";
                ev.Uname = "测试观众";
                ev.GiftName = "小花花";
                ev.Num = 5;
                ev.Price = 100;
                ev.TotalCoin = 500;
                ev.CoinType = "gold";
                ev.Value = 0.5;
                break;
            case "guard":
                ev.Type = "guard";
                ev.Uname = "测试舰长";
                ev.Level = 3;
                ev.LevelName = "舰长";
                ev.Num = 1;
                ev.Price = 198000;
                ev.TotalCoin = 198000;
                ev.Value = 198;
                ev.IsGuard = true;
                ev.GuardLevel = 3;
                break;
            case "superchat":
                ev.Type = "superchat";
                ev.Uname = "测试SC";
                ev.Msg = "主播加油！";
                ev.Price = 30;
                ev.StartTime = ev.Ts;
                break;
            case "follow":
                ev.Type = "interact";
                ev.Uname = "测试粉丝";
                ev.MsgType = 2;
                break;
            case "enter":
                ev.Type = "interact";
                ev.Uname = "测试观众";
                ev.MsgType = 1;
                break;
            default:
                ev.Type = "danmu";
                ev.Uname = "测试观众";
                ev.Msg = msg.Length > 0 ? msg : "这是一条测试弹幕";
                break;
        }
        return ev;
    }

