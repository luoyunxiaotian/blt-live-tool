    /// <summary>歌词为空时给出可执行的原因提示。</summary>
    private string LyricEmptyReason()
    {
        if (Player.CurrentName.Length == 0) return "未播放：点歌单里的 ▶ 播放后会自动加载歌词";
        if (_lyricSource.Length == 0) return "歌词请求失败（网络或接口异常）：点「重试」，或在 OBS 里刷新浏览器源";
        if (_lyricSource == "none") return "该平台未取到歌词：可换平台搜索同一首歌；或把同名 .lrc 放进本地歌词目录；VIP 歌曲可先「应用内登录」后再重试";
        return "暂无歌词（来源：" + LyricSourceText() + "）";
    }

    /// <summary>复制 OBS 歌词浮层地址。</summary>
