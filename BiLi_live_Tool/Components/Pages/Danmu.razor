    private string OverlayUrl() => $"http://127.0.0.1:{Api.Port}/legacy/danmu/overlay.html";

    private string GetUnifiedThemeValue()
    {
        if (_cfg.ThemeType == "laplace")
        {
            return $"laplace:{_cfg.LaplaceTemplate ?? _cfg.Theme ?? "laplace-nailv"}";
        }
        return $"classic:{_cfg.Theme ?? "classic-glass"}";
    }

    private void OnUnifiedThemeSelected(ChangeEventArgs e)
    {
        var val = e.Value?.ToString();
        if (string.IsNullOrEmpty(val)) return;

        if (val.StartsWith("laplace:"))
        {
            var id = val.Substring("laplace:".Length);
            var tmpl = LaplaceThemes.FirstOrDefault(t => t.Id == id);
            _cfg.ThemeType = "laplace";
            _cfg.LaplaceTemplate = id;
            _cfg.Theme = id;
            _cfg.ShowBox = false; // Laplace 现代模版默认全透明浮层无底框
            SaveConfig(false);
            Notify($"已切换至 Laplace 模版：{tmpl?.Name ?? id}（已实时生效并同步 OBS）", true);
        }
        else if (val.StartsWith("classic:"))
        {
            var id = val.Substring("classic:".Length);
            _cfg.ThemeType = "classic";
            _cfg.Theme = id;
            ApplyThemeDefaults(id);
            SaveConfig(false);
            Notify($"已切换至自研经典皮肤：{ThemeDisplayName(id)}（已实时生效并同步 OBS）", true);
        }
    }

    private readonly List<LiveEvent> _previewEvents = new();

    private void PushPreviewEvent(LiveEvent ev)
    {
        _previewEvents.Add(ev);
        if (_previewEvents.Count > 6)
        {
            _previewEvents.RemoveAt(0);
        }
        StateHasChanged();
    }

    private void ClearPreviewEvents()
    {
