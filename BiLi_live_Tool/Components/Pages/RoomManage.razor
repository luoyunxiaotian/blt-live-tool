@code {
    private static readonly HttpClient Http = new() { Timeout = TimeSpan.FromSeconds(10) };
    /// <summary>The update check walks every mirror (and pulls the manifest for the
    /// incremental info), which on a slow line needs more than the page's 10 s default —
    /// that used to surface as "检查失败：…HttpClient.Timeout of 10 seconds…" and left the
    /// download button disabled, so the first click did nothing.</summary>
    private static readonly HttpClient UpdateHttp = new() { Timeout = TimeSpan.FromSeconds(75) };

    private string _roomId = "";
    private string _autoConnectClass = "";
    private bool _autoConnectBool;
    private List<LiveEvent> _view = new();

    // Auto-save status for the room settings written through Config.ReplaceFrom.
    private DateTime? _savedAt;
    private string _saveMsg = "";

    // 闲置自动关闭 B站浏览器（biliBrowser.idleCloseMin；0 = 关闭该行为）。
    private const int DefaultIdleMin = 10;
    private const int MaxIdleMin = 120;
    private bool _idleCloseOn = true;
    private int _idleMin = DefaultIdleMin;
    private string _idleNote = "";
    private long _idleSeenAt;   // last observed MainPage.BiliIdleClosedAt (notice de-dup)

    // Repaint batching: OnEvent only marks a dirty counter; this 300 ms timer turns a
    // burst of hub events into a single StateHasChanged.
    private System.Threading.Timer? _flushTimer;
    private int _pendingEvents;

    // Auto like state, refreshed by the 1 s poll below.
    private System.Threading.Timer? _likeTimer;
    private bool _likeRunning;
    private int _likeLiked;
    private string _likeError = "";

    // Manual cookie import (📋 手动导入 Cookie).
    private string _cookieInput = "";
    private string _cookieInfo = "";
    private string _cookieWarn = "";
    private string _cookieError = "";

    // 免责声明门禁（config: disclaimerAgreed）：未勾选前 Cookie 粘贴/导入/清除全部禁用。
    private bool _disclaimerAgreed;

    // 「打开B站浏览器」会收窄主面板 —— 每个会话只提示一次 toast。
    private bool _narrowTipShown;

    // Record folder rows (📁 记录文件夹), loaded from GET /api/status → folders.
    private static readonly (string Key, string Label)[] FolderDefs =
    {
        ("danmu", "弹幕记录"),
        ("gifts", "礼物记录"),
        ("blindbox", "盲盒记录"),
        ("guard", "舰长记录"),
        ("superchat", "SC 记录"),
    };
    private readonly List<(string Label, string Path)> _folders = new();

    // Skin picker (🎨 界面皮肤): ids/order copied from the MainLayout top strip.
    private static readonly string[] Themes =
    {
        "classic", "console", "neon", "workbench", "bili", "vibrancy", "brutal", "hud", "editorial",
        "heroui-dark", "heroui-violet", "heroui-emerald",
    };
    private string _skin = "console";
    private string _foldMsg = "";

    // ---- 检查更新（MAUI 通道）----
    private string _updateTime = "";
    private string _updateLatest = "";
    private string _updateMsg = "";
    private string _updateNotes = "";
    private string _updateAssetName = "";
    private long _updateAssetSize;
    // 增量包信息（由检查结果里的 manifest.patch 带出）：命中时按钮显示真实要下载的大小
    private long _updatePatchSize;
    private string _updatePatchFrom = "";
    private bool _updatePatchApplies;
    private bool _updateBusy;
    private bool _updateHasUpdate;
    private bool _updateHasAsset;
    private bool _updateLoaded;

    private bool EdgeRunning => GetProp(Tts.EdgeStatus(), "running");
    private bool MossRunning => GetProp(Tts.MossStatus(), "running");

    private string Base => "http://127.0.0.1:" + Api.Port;

    private static bool GetProp(object o, string name)
        => Convert.ToBoolean(o.GetType().GetProperty(name)?.GetValue(o));

    protected override void OnInitialized()
    {
        _roomId = Config.RoomId;
        _autoConnectBool = Config.AutoConnect;
        _autoConnectClass = _autoConnectBool ? "on" : "";
        var skin = (Config.GetNode("skin") as JsonValue)?.GetValue<string>() ?? "";
        if (skin.Length == 0 || skin == "default") skin = "console";
        if (Themes.Contains(skin)) _skin = skin;
        _disclaimerAgreed = Config.GetNode("disclaimerAgreed") is JsonValue dv && dv.TryGetValue<bool>(out var da) && da;
        LoadIdleCloseConfig();
        _idleSeenAt = MainPage.Current?.BiliIdleClosedAt ?? 0;   // only new auto-closes raise the note
        Hub.OnEvent += OnEvent;
        Hub.StatusChanged += OnStatus;
        _likeTimer = new System.Threading.Timer(_ => _ = PollLikeStatus(), null,
            TimeSpan.FromSeconds(1), TimeSpan.FromSeconds(1));
        _flushTimer = new System.Threading.Timer(_ => FlushTick(), null,
            TimeSpan.FromMilliseconds(300), TimeSpan.FromMilliseconds(300));
        _logTimer = new System.Threading.Timer(_ => _ = PollServerLogAsync(), null,
            TimeSpan.FromSeconds(3), TimeSpan.FromSeconds(3));
        _ = PollLikeStatus();   // first paint gets the current counters without waiting 1 s
        _ = LoadFoldersAsync();
        _ = LoadUpdateStatusAsync();
        _ = LoadCleanupStatusAsync();   // 更新残留的旧文件：有的话显示清理按钮
        _ = LoadAutoLaunchAsync();
        _ = PollServerLogAsync();   // 服务日志：首次立即拉取，之后走 3 s 定时器
    }

    /// <summary>
    /// Hub events are frequent (弹幕 bursts): append the row on the renderer thread and
    /// only mark the dirty counter — FlushTick coalesces the repaint into one 300 ms beat.
    /// </summary>
    private void OnEvent(LiveEvent ev)
    {
        _ = InvokeAsync(() =>
        {
            _view.Insert(0, ev);
            if (_view.Count > 200) _view.RemoveAt(_view.Count - 1);
            Interlocked.Exchange(ref _pendingEvents, 1);
        });
    }

    /// <summary>300 ms flush: repaint when events arrived, and pick up idle auto-close notices.</summary>
    private void FlushTick()
    {
        var noteChanged = CheckIdleCloseNotice();
        var dirty = Interlocked.Exchange(ref _pendingEvents, 0) != 0;
        if (!dirty && !noteChanged) return;
        try { _ = InvokeAsync(StateHasChanged); } catch { /* renderer already gone */ }
    }

    /// <summary>Raises the notice once per new idle auto-close reported by MainPage.</summary>
    private bool CheckIdleCloseNotice()
    {
        var page = MainPage.Current;
        if (page == null) return false;
        try
        {
            // Any page can reopen the browser — then the notice no longer applies.
            if (_idleNote.Length > 0 && page.IsBiliVisible)
            {
                _idleNote = "";
                return true;
            }
            var at = page.BiliIdleClosedAt;
            if (at <= _idleSeenAt) return false;
            _idleSeenAt = at;
            _idleNote = page.BiliIdleCloseNote();
            return _idleNote.Length > 0;
        }
        catch { return false; }
    }

    private void OnStatus(LiveStatusInfo st) => InvokeAsync(StateHasChanged);

    private Task OnRoomKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") return Connect();
        return Task.CompletedTask;
    }

    private string _verifyNote2 = "";

    private async Task CopyAuthorUid2()
    {
        var text = AppIdentity.AuthorContact;
        try { await JS.InvokeVoidAsync("navigator.clipboard.writeText", text); _verifyNote2 = "已复制作者B站ID"; }
        catch { _verifyNote2 = "复制失败，请手动记下 UID " + VerifyService.AuthorUid; }
        StateHasChanged();
    }

    private async Task OpenAuthorSpace2()
    {
        try { await JS.InvokeVoidAsync("bltOpenExternal", "https://space.bilibili.com/" + VerifyService.AuthorUid); _verifyNote2 = "已打开作者主页"; }
        catch { _verifyNote2 = "打开失败"; }
        StateHasChanged();
    }

    private System.Threading.Timer? _cooldownTimer2;
    private int _verifyCooldown2;
    private bool _isVerifying2;

    private void StartCooldown2(int seconds)
    {
        _verifyCooldown2 = seconds;
        _cooldownTimer2?.Dispose();
        _cooldownTimer2 = new System.Threading.Timer(_ =>
        {
            if (_verifyCooldown2 > 0)
            {
                _verifyCooldown2--;
                InvokeAsync(StateHasChanged);
            }
            else
            {
                _cooldownTimer2?.Dispose();
                _cooldownTimer2 = null;
                InvokeAsync(StateHasChanged);
            }
        }, null, 1000, 1000);
    }

    private async Task RetryVerify2()
    {
        if (_isVerifying2 || _verifyCooldown2 > 0) return;
        _isVerifying2 = true;
        _verifyNote2 = "正在重新验证…";
        StateHasChanged();
        try
        {
            var res = await Verify.RefreshDetailedAsync(force: true);
            _verifyCooldown2 = res.CooldownRemaining;
            if (res.RateLimited)
            {
                _verifyNote2 = $"请勿频繁重试，请等待 {res.CooldownRemaining} 秒";
                StartCooldown2(res.CooldownRemaining);
            }
            else if (res.Ok)
            {
                _verifyNote2 = "验证通过！已恢复全部功能";
                _verifyCooldown2 = 0;
            }
            else
            {
                _verifyNote2 = string.IsNullOrEmpty(res.Message) ? "验证仍未通过" : "仍未通过：" + res.Message;
                if (res.CooldownRemaining > 0)
                {
                    StartCooldown2(res.CooldownRemaining);
                }
            }
        }
        catch (Exception ex)
        {
            _verifyNote2 = "重试请求失败: " + ex.Message;
        }
        finally
        {
            _isVerifying2 = false;
            StateHasChanged();
        }
    }

    private Task Connect()
    {
        var rid = _roomId.Trim();
        if (rid.Length == 0 || Live.IsRunning) return Task.CompletedTask;
        Config.SetRoomAndCookie(rid, "");
        Live.Start(rid, Config.Cookie);
        return Task.CompletedTask;
    }

    private void Disconnect() => Live.Stop();

    private void ToggleAutoConnect()
    {
        _autoConnectBool = !_autoConnectBool;
        _autoConnectClass = _autoConnectBool ? "on" : "";
        SaveRoomConfigSoon(200);
    }

    // ---- auto-save (debounced) ----
    // The room settings live in the local config store, so the debounce only decides
    // how often data/config.json is rewritten. The same "room-config" key is shared,
    // which makes a newer edit cancel the pending write of an older one.

    private void SaveRoomConfigSoon(int delayMs = 450)
        => Saver.Run("room-config", () => InvokeAsync(async () => { SaveRoomConfig(); StateHasChanged(); }), delayMs);

    private void SaveRoomIdSoon() => SaveRoomConfigSoon();

    private void SaveRoomConfig()
    {
        try
        {
            var doc = Config.Snapshot();
            doc["autoConnect"] = _autoConnectBool;
            doc["disclaimerAgreed"] = _disclaimerAgreed;   // 风险声明勾选态跟随同一份配置保存
            WriteIdleCloseConfig(doc);   // biliBrowser.idleCloseMin rides the same debounced write
            var rid = _roomId.Trim();
            if (rid.Length > 0) doc["roomId"] = rid;   // never wipe a stored id from an empty box
            Config.ReplaceFrom(doc);
            _saveMsg = "";
            _savedAt = DateTime.Now;
        }
        catch (Exception ex)
        {
            _saveMsg = ex.Message;
        }
    }

    // ---- 闲置自动关闭 B站浏览器（biliBrowser.idleCloseMin；0 = 关掉该行为）----

    /// <summary>Reads biliBrowser.idleCloseMin: absent → default 10 min (on), 0 → switch off.</summary>
    private void LoadIdleCloseConfig()
    {
        var mins = DefaultIdleMin;
        try
        {
            if (Config.GetNode("biliBrowser") is JsonObject bb
                && bb.TryGetPropertyValue("idleCloseMin", out var v)
                && v is JsonValue jv
                && jv.TryGetValue<double>(out var d))
                mins = (int)Math.Round(d);
        }
        catch { }
        _idleCloseOn = mins > 0;
        _idleMin = _idleCloseOn ? Math.Clamp(mins, 1, MaxIdleMin) : DefaultIdleMin;
    }

    private string IdleSwitchClass() => _idleCloseOn ? "on" : "";

    private void ToggleIdleClose()
    {
        _idleCloseOn = !_idleCloseOn;
        SaveRoomConfigSoon();
    }

    private void SaveIdleSoon() => SaveRoomConfigSoon();

    /// <summary>风险声明勾选态：立即放开/收紧控件，持久化走同一份 debounced 配置写入。</summary>
    private void SaveDisclaimer()
    {
        SaveRoomConfigSoon(150);
        StateHasChanged();
    }

    /// <summary>Writes the switch + minutes into the snapshot (0 = the switch is off).</summary>
    private void WriteIdleCloseConfig(JsonObject doc)
    {
        var bb = doc["biliBrowser"] as JsonObject ?? new JsonObject();
        if (_idleCloseOn) _idleMin = Math.Clamp(_idleMin, 1, MaxIdleMin);
        bb["idleCloseMin"] = _idleCloseOn ? _idleMin : 0;
        doc["biliBrowser"] = bb;
    }

    private string AutoSaveText()
    {
        if (_saveMsg.Length > 0) return "保存失败：" + _saveMsg;
        return _savedAt.HasValue ? "已自动保存 " + _savedAt.Value.ToString("HH:mm:ss") : "改动即时自动保存";
    }

    // ---- manual cookie import (📋 手动导入 Cookie) ----

    /// <summary>
    /// Parses "k=v; k2=v2" (also one pair per line, plus a pasted "Cookie: k=v" header)
    /// into an ordered dictionary; key/value order follows the paste.
    /// </summary>
    private static Dictionary<string, string> ParseCookiePairs(string raw)
    {
        var pairs = new Dictionary<string, string>(StringComparer.Ordinal);
        var text = (raw ?? "").Replace("\r", "\n");
        foreach (var chunk in text.Split(new[] { ';', '\n' }, StringSplitOptions.RemoveEmptyEntries))
        {
            var item = chunk.Trim();
            var eq = item.IndexOf('=');
            if (eq <= 0) continue;
            var key = item[..eq].Trim();
            var colon = key.LastIndexOf(':');           // tolerate a pasted "Cookie: SESSDATA" header
            if (colon >= 0) key = key[(colon + 1)..].Trim();
            var val = item[(eq + 1)..].Trim();
            if (key.Length == 0 || val.Length == 0) continue;
            if (val is "undefined" or "null" or "NaN") continue;
            pairs[key] = val;   // later duplicates win
        }
        return pairs;
    }

    /// <summary>Parses the pasted cookie and writes it through the same config path as SaveRoomConfig.</summary>
    private async Task ImportCookie()
    {
        if (!_disclaimerAgreed) return;   // gate: the button is disabled anyway
        _cookieInfo = "";
        _cookieWarn = "";
        _cookieError = "";

        var pairs = ParseCookiePairs(_cookieInput);
        if (pairs.Count == 0)
        {
            _cookieError = "未识别到有效 Cookie";
            await UI.ToastAsync("未识别到有效 Cookie", false);
            return;
        }

        var hasSession = pairs.ContainsKey("SESSDATA");
        var hasJct = pairs.ContainsKey("bili_jct");
        var cookie = string.Join("; ", pairs.Select(kv => kv.Key + "=" + kv.Value));

        try
        {
            // Snapshot → mutate config.cookie → replace, exactly like SaveRoomConfig.
            var doc = Config.Snapshot();
            doc["cookie"] = cookie;
            if (pairs.TryGetValue("DedeUserID", out var uid) && uid.Length > 0) doc["uid"] = uid;
            Config.ReplaceFrom(doc);
        }
        catch (Exception ex)
        {
            _cookieError = "保存失败：" + ex.Message;
            await UI.ToastAsync("Cookie 保存失败：" + ex.Message, false);
            return;
        }

        _cookieInfo = hasSession
            ? $"已识别 SESSDATA（共 {pairs.Count} 项，已保存）"
            : $"已保存 {pairs.Count} 项 Cookie";
        var warns = new List<string>();
        if (!hasSession) warns.Add("缺少 SESSDATA：登录态可能无效");
        if (!hasJct) warns.Add("缺少 bili_jct：发言/点赞等写操作会失败");
        _cookieWarn = warns.Count > 0 ? string.Join("；", warns) : "";

        Hub.PublishStatus(Hub.LastStatus);   // refresh the login rows above
        StateHasChanged();
        await UI.ToastAsync(_cookieInfo, true);
    }

    // ---- record folders (📁 记录文件夹) ----

    /// <summary>GET /api/status → folders, retried while the panel API finishes booting.</summary>
    private async Task LoadFoldersAsync()
    {
        for (var attempt = 0; attempt < 5; attempt++)
        {
            var rows = await FetchFoldersAsync();
            if (rows.Count > 0)
            {
                try
                {
                    await InvokeAsync(() =>
                    {
                        _folders.Clear();
                        _folders.AddRange(rows);
                        StateHasChanged();
                    });
                }
                catch
                {
                    // component disposed while the request was in flight
                }
                return;
            }
            await Task.Delay(700 * (attempt + 1));
        }
    }

    /// <summary>One row per record type (absolute paths); empty when the API is unreachable.</summary>
    private async Task<List<(string Label, string Path)>> FetchFoldersAsync()
    {
        var rows = new List<(string Label, string Path)>();
        try
        {
            var o = await GetJsonAsync("/api/status");
            var folders = o?["folders"] as JsonObject;
            if (folders == null) return rows;
            foreach (var (key, label) in FolderDefs)
                if (folders[key] is JsonValue v && v.TryGetValue<string>(out var p) && !string.IsNullOrEmpty(p))
                    rows.Add((label, p));
        }
        catch
        {
            // the panel API may still be starting up
        }
        return rows;
    }

