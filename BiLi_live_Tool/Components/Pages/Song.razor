    // ---------- settings (every edit auto-saves; the 保存设置 button is gone) ----------

    /// <summary>Reads the whole config document, patches songRequest and POSTs it back.</summary>
    private async Task SaveSettings()
    {
        // Auto-save can fire from several debounce keys in a row → serialize instead of
        // dropping the write (a dropped write would silently lose the newest edit).
        await _saveGate.WaitAsync();
        try
        {
            var doc = await GetJson("/api/config") as JsonObject ?? new JsonObject();
            var sr = doc["songRequest"] as JsonObject;
            if (sr == null)
            {
                sr = new JsonObject();
                doc["songRequest"] = sr;
            }
            var keyword = _keyword.Trim();
            sr["enabled"] = JsonValue.Create(_enabled);
            sr["platform"] = JsonValue.Create(_platform);
            sr["keyword"] = JsonValue.Create(keyword.Length > 0 ? keyword : "点歌");
            sr["cooldownMs"] = JsonValue.Create(ParseLong(_cooldownSec, 10) * 1000L);
            sr["userCooldownMs"] = JsonValue.Create(ParseLong(_userCooldownSec, 60) * 1000L);
            sr["fanMedalMin"] = JsonValue.Create(ParseLong(_fanMedalMin));
            sr["honorLevelMin"] = JsonValue.Create(ParseLong(_honorLevelMin));
            sr["guardOnly"] = JsonValue.Create(_guardOnly);
            sr["maxDaily"] = JsonValue.Create(ParseLong(_maxDaily));
            sr["dedupEnabled"] = JsonValue.Create(_dedupEnabled);
            sr["dedupMs"] = JsonValue.Create(ParseLong(_dedupMin, 5) * 60000L);
            var resp = await PostJson("/api/config", doc);
            ApplySettings((resp as JsonObject)?["songRequest"] as JsonObject);
            _saveMsg = "";
            _savedAt = DateTime.Now;
        }
        catch (Exception ex)
        {
            _saveMsg = Trim(ex.Message);
        }
        finally
        {
            _saveGate.Release();
        }
    }

    /// <summary>Debounced auto-save: the delegate runs off the renderer thread, so marshal back and repaint.</summary>
    private void SaveSoon(string key, int delayMs)
        => Saver.Run(key, () => InvokeAsync(async () => { await SaveSettings(); StateHasChanged(); }), delayMs);

    private void SaveSettingsSoon() => SaveSoon("song-settings", 200);       // select / switch
    private void SaveSettingsTextSoon() => SaveSoon("song-settings", 450);   // text / number input

    /// <summary>Auto-save status line; replaces the old 保存设置 button.</summary>
    private string AutoSaveText()
    {
        if (_saveMsg.Length > 0) return "保存失败：" + _saveMsg;
        return _savedAt.HasValue ? "已自动保存 " + _savedAt.Value.ToString("HH:mm:ss") : "改动即时自动保存";
    }

