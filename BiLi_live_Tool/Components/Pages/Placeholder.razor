@page "/tts"
@page "/autodanmu"
@page "/pk"
@page "/song"
@page "/realtime"
@page "/gifts"
@page "/logs/danmu"
@page "/logs/gifts"
@page "/logs/blindbox"
@page "/logs/guard"
@page "/logs/superchat"
@page "/alert"
@page "/widgets"
@page "/keyview"
@page "/diagnostics"
@page "/help"
@using BiLi_live_Tool.Services
@inject NavigationManager Nav
@inject EventHub Hub

<div class="blt-pagehead"><h1>@PageName()</h1><span class="en">REBUILD IN PROGRESS</span></div>

<div class="blt-panel">
    <div class="blt-panel-head"><span class="t">🚧 页面重构中</span><span class="en">NEXT ITERATION</span></div>
    <div class="blt-panel-body">
        <div class="blt-empty">
            <p>该页面将按「C 专业控制台」风格补齐。功能层（C# 服务）已就绪：</p>
            <p style="font-family:var(--mono);color:var(--ink-2)">
                @Nav.Uri.Replace("http://", "") · 当前路由数据与后端服务均已接入 DI
            </p>
            <p style="margin-top:10px">
                过渡方案：打开浏览器访问 <b style="color:var(--amber)">http://127.0.0.1:7460/legacy/index.html</b>
                可使用原版面板的对应功能页（服务层完全共用）。
            </p>
        </div>
    </div>
</div>

<div class="blt-panel">
    <div class="blt-panel-head"><span class="t">📡 实时事件</span><span class="en">LIVE</span></div>
    <div class="blt-panel-body" style="padding:6px 0">
        @if (_recent.Count == 0)
        {
            <div class="blt-empty">暂无事件</div>
        }
        else
        {
            <div class="blt-log">
                @foreach (var ev in _recent)
                {
                    <div class="blt-logrow">
                        <span class="t">@ev.Time</span>
                        <span class="tag @Tag(ev.Type)">@TagText(ev.Type)</span>
                        <span class="txt"><span class="u">@ev.Uname</span> @Brief(ev)</span>
                    </div>
                }
            </div>
        }
    </div>
</div>

@code {
    private List<LiveEvent> _recent = new();

    protected override void OnInitialized()
    {
        Hub.OnEvent += OnEvent;
    }

    private void OnEvent(LiveEvent ev) => InvokeAsync(() =>
    {
        _recent.Insert(0, ev);
        if (_recent.Count > 30) _recent.RemoveAt(_recent.Count - 1);
        StateHasChanged();
    });

    private string PageName()
    {
        var path = new Uri(Nav.Uri).AbsolutePath.Trim('/');
        return path switch
        {
            "tts" => "语音念弹幕",
            "autodanmu" => "自动弹幕",
            "pk" => "PK 连线",
            "song" => "点歌功能",
            "realtime" => "实时展示",
            "gifts" => "礼物数据生成",
            "alert" => "提醒特效墙",
            "widgets" => "文字挂件",
            "keyview" => "键鼠手柄可视化",
            "diagnostics" => "网络诊断",
            "help" => "使用教程",
            var p when p.StartsWith("logs/") => p[5..] + " 记录",
            _ => path,
        };
    }

    private string Tag(string type) => type switch
    {
        "danmu" => "danmu", "gifts" => "gifts", "guard" => "guard",
        "superchat" => "superchat", "interact" => "interact", _ => "info",
    };

    private string TagText(string type) => type switch
    {
        "danmu" => "DANMU", "gifts" => "GIFT", "guard" => "GUARD",
        "superchat" => "SC", "interact" => "INTER", _ => "INFO",
    };

    private string Brief(LiveEvent ev) => ev.Type switch
    {
        "danmu" => ev.Msg,
        "gifts" => $"{ev.GiftName} ×{ev.Num}",
        "guard" => $"开通 {ev.LevelName}",
        "superchat" => $"SC：{ev.Msg}",
        "interact" => ev.MsgType == 2 ? "关注" : "进房",
        _ => "",
    };

    public void Dispose() => Hub.OnEvent -= OnEvent;
}
