    // ---- 应用内更新（下载 → 校验 → 暂存 → 重启安装）----

    private string _updaterPhase = "";
    private int _updaterPercent;
    private string _updaterMsg = "";
    private bool _updaterBusy;

    private string UpdaterNoteColor()
        => _updaterPhase == "Failed" ? "var(--red)" : _updaterPhase == "Staged" ? "var(--green)" : "var(--ink-3)";

    /// <summary>True while no bytes are arriving yet (mirror detection, manifest fetch, file
    /// comparison, extraction): the bar animates instead of sitting at 0 %, which used to look
    /// like the click had done nothing.</summary>
    private bool UpdaterIndeterminate()
        => _updaterPhase is "Verifying" or "Extracting" or "Applying"
           || (_updaterPhase == "Downloading" && _updaterPercent <= 0);

    private async Task StartUpdateDownload()
    {
        _updaterBusy = true;
        _updaterPercent = 0;
        _updaterPhase = "Verifying";
        _updaterMsg = "正在检测下载线路…";
        StateHasChanged();
        try
        {
            // 一次点击必须够用：面板还没拿到检查结果时（刚启动/缓存按版本失效）先补一次检查，
            // 再直接进入下载，避免"点一下没反应、要点第二下"。
            if (!_updateHasAsset)
            {
                await CheckUpdateNow();
                if (!_updateHasAsset)
                {
                    _updaterPhase = "Failed";
                    _updaterMsg = "没有可下载的更新：请先点「立即检查」，或该版本暂无更新资产";
                    return;
                }
            }
            await PostJsonAsync("/api/maui/update/download", new JsonObject());
            // 轮询进度（下载 156MB 视网络需要数十秒到数分钟）
            var sawActivity = false;
            for (var i = 0; i < 600; i++)
            {
                await Task.Delay(1000);
                var o = await PostJsonReadAsync("/api/maui/update/status", new JsonObject());
                if (o?["updater"] is not JsonObject u) continue;
                _updaterPhase = u["phase"] is JsonValue pv && pv.TryGetValue<string>(out var ps) ? ps ?? "" : "";
                _updaterPercent = u["percent"] is JsonValue pct && pct.TryGetValue<int>(out var pi) ? pi : 0;
                _updaterMsg = u["message"] is JsonValue mv && mv.TryGetValue<string>(out var ms) ? ms ?? "" : "";
                StateHasChanged();
                if (_updaterPhase is "Verifying" or "Downloading" or "Extracting" or "Applying") sawActivity = true;
                if (_updaterPhase is "Staged" or "Failed" or "UpToDate") break;
                // Idle 只在"已经看到任务跑起来"之后才算结束：否则点下载后的第一拍（任务还没开始，
                // 服务端仍是上一次的 Idle）就会把进度显示掐掉，看起来像点了没反应。
                if (_updaterPhase == "Idle" && sawActivity) break;
            }
        }
        catch (Exception ex)
        {
            _updaterPhase = "Failed";
            _updaterMsg = "更新失败：" + ex.Message;
        }
        finally
        {
            _updaterBusy = false;
            StateHasChanged();
        }
    }

    private async Task ApplyUpdateNow()
    {
        // 先确认：安装会退出应用并由脚本重启；期间手动启动会占用文件（首次失败就是这个原因）。
        var go = true;
        try
        {
            go = await JS.InvokeAsync<bool>("bltConfirm",
                "应用将自动退出并替换文件，随后自动重新启动（约十几秒）。\n\n替换期间请勿手动启动应用，否则文件被占用会导致安装失败。\n\n现在开始安装？",
                "开始安装", "取消");
        }
        catch { go = true; }
        if (!go) return;
        _updaterPhase = "Applying";
        _updaterMsg = "正在退出并安装（请勿手动启动，会自动重启）…";
        StateHasChanged();
        await PostJsonAsync("/api/maui/update/apply", new JsonObject());
    }

    private async Task CancelUpdate()
    {
        await PostJsonAsync("/api/maui/update/clear", new JsonObject());
        _updaterPhase = "";
        _updaterPercent = 0;
        _updaterMsg = "";
        StateHasChanged();
    }

    /// <summary>POST to the MAUI bridge and read the JSON reply (bridge is POST-only).</summary>
    private async Task<JsonObject?> PostJsonReadAsync(string path, JsonObject body)
    {
        try
        {
            using var resp = await Http.PostAsync(Base + path,
                new StringContent(body.ToJsonString(), Encoding.UTF8, "application/json"));
            var txt = await resp.Content.ReadAsStringAsync();
            if (!resp.IsSuccessStatusCode) return null;
            return JsonNode.Parse(txt) as JsonObject;
        }
        catch { return null; }
    }

    private async Task<JsonObject?> GetJsonAsync(string path)
    {
        using var resp = await Http.GetAsync(Base + path);
        var txt = await resp.Content.ReadAsStringAsync();
        if (!resp.IsSuccessStatusCode) return null;
        return JsonNode.Parse(txt) as JsonObject;
    }

    private static string ApiError(string body)
    {
        try
        {
            if (JsonNode.Parse(body) is JsonObject o && o["error"] is JsonValue v && v.TryGetValue<string>(out var e))
                return e ?? "";
        }
        catch { }
        return "";
    }

    private static bool GetBool(JsonObject o, string key, bool def)
        => o.TryGetPropertyValue(key, out var v) && v is JsonValue jv && jv.TryGetValue<bool>(out var b) ? b : def;

    private static string GetStr(JsonObject o, string key, string def)
        => o.TryGetPropertyValue(key, out var v) && v is JsonValue jv && jv.TryGetValue<string>(out var s) && !string.IsNullOrEmpty(s) ? s : def;

    private static double GetNum(JsonObject o, string key, double def)
        => o.TryGetPropertyValue(key, out var v) && v is JsonValue jv && jv.TryGetValue<double>(out var d) ? d : def;

    private async Task OpenBiliBrowser()
    {
        var rid = Live.IsRunning ? Hub.LastStatus.RealRoomId : _roomId.Trim();
        var url = long.TryParse(rid, out _) ? $"https://live.bilibili.com/{rid}" : "https://live.bilibili.com/";
        MainPage.Current?.ShowBiliBrowser(url);
        _idleNote = "";   // the user reopened it — the idle notice no longer applies
        // 浏览器面板展开后主面板会收窄：每个会话只提示一次，避免反复打扰。
        if (!_narrowTipShown)
        {
            _narrowTipShown = true;
            await UI.ToastAsync("B站页面已显示在右侧，主面板暂时收窄；点「隐藏浏览器」可恢复全宽", true);
        }
    }

    private void HideBiliBrowser() => MainPage.Current?.HideBiliBrowser();
    private void CloseBiliBrowser() => MainPage.Current?.CloseBiliBrowser();

    /// <summary>危险操作：先二次确认，再清空本机保存的登录 Cookie（文案对齐原版 confirm）。</summary>
    private async Task ClearLogin()
    {
        if (!_disclaimerAgreed) return;   // gate: the button is disabled anyway
        if (!await UI.ConfirmAsync("确定要清除已保存的登录 Cookie 吗？")) return;
        try
        {
            Config.SetBiliCookie("", "");
            _view.Clear();
            Hub.PublishStatus(Hub.LastStatus); // refresh trigger
            StateHasChanged();
            await UI.ToastAsync("已清除登录 Cookie", true);
        }
        catch (Exception ex)
        {
            await UI.ToastAsync("清除登录 Cookie 失败：" + ex.Message, false);
        }
    }

