@inherits LayoutComponentBase
@implements IDisposable
@using BiLi_live_Tool.Services
@inject EventHub Hub
@inject KestrelHost Api
@inject AppConfig Config
@inject IJSRuntime JS
@inject AudioService Audio
@inject TtsSpeaker Speaker
@inject PanelSoundPlayer Sounds
@inject SongPlayer Song
@inject UiBridge Ui
@inject UpdateChecker Upd
@inject VerifyService Verify
@inject NavigationManager Nav

<div class="blt-app">
    <div class="blt-side">
        <div class="blt-brand"><b>@AppIdentity.Name</b><span>@AppIdentity.BrandTagline</span></div>

        <div class="blt-navgroup @Fold("live")" @onclick="ToggleLive">直播控制</div>
        <div class="blt-navfold @FoldHide("live")">
            <NavLink class="blt-navitem" href="/tts"><BltIcon Emoji="🎙" /> 语音念弹幕</NavLink>
            <NavLink class="blt-navitem" href="/autodanmu"><BltIcon Emoji="💬" /> 自动弹幕</NavLink>
            <NavLink class="blt-navitem" href="/pk"><BltIcon Emoji="⚔" /> PK/连线</NavLink>
            <NavLink class="blt-navitem" href="/song"><BltIcon Emoji="🎵" /> 点歌功能</NavLink>
        </div>

        <div class="blt-navgroup @Fold("show")" @onclick="ToggleShow">实时与展示</div>
        <div class="blt-navfold @FoldHide("show")">
            <NavLink class="blt-navitem" href="/realtime"><BltIcon Emoji="⚡" /> 实时展示</NavLink>
            <NavLink class="blt-navitem" href="/gifts"><BltIcon Emoji="🎁" /> 礼物截图生成</NavLink>
        </div>

        <div class="blt-navgroup @Fold("logs")" @onclick="ToggleLogs">日志记录</div>
        <div class="blt-navfold @FoldHide("logs")">
            <NavLink class="blt-navitem" href="/logs/danmu"><BltIcon Emoji="📄" /> 弹幕记录 <span class="blt-badge @(RecOn("danmu"))">@(RecOn("danmu") ? "REC" : "OFF")</span></NavLink>
            <NavLink class="blt-navitem" href="/logs/gifts"><BltIcon Emoji="🎁" /> 礼物记录 <span class="blt-badge @(RecOn("gifts"))">@(RecOn("gifts") ? "REC" : "OFF")</span></NavLink>
            <NavLink class="blt-navitem" href="/logs/blindbox"><BltIcon Emoji="📦" /> 盲盒记录 <span class="blt-badge @(RecOn("blindbox"))">@(RecOn("blindbox") ? "REC" : "OFF")</span></NavLink>
            <NavLink class="blt-navitem" href="/logs/guard"><BltIcon Emoji="🛡" /> 舰长记录 <span class="blt-badge @(RecOn("guard"))">@(RecOn("guard") ? "REC" : "OFF")</span></NavLink>
            <NavLink class="blt-navitem" href="/logs/superchat"><BltIcon Emoji="⚡" /> SC 记录 <span class="blt-badge @(RecOn("superchat"))">@(RecOn("superchat") ? "REC" : "OFF")</span></NavLink>
        </div>

        <div class="blt-navgroup @Fold("obs")" @onclick="ToggleObs">OBS 浮层</div>
        <div class="blt-navfold @FoldHide("obs")">
            <NavLink class="blt-navitem" href="/alert"><BltIcon Emoji="🖼" /> 提醒特效墙</NavLink>
            <NavLink class="blt-navitem" href="/widgets"><BltIcon Emoji="📋" /> 文字挂件</NavLink>
            <NavLink class="blt-navitem" href="/keyview"><BltIcon Emoji="🎮" /> 键鼠手柄可视化</NavLink>
        </div>

        <div class="blt-navgroup @Fold("sys")" @onclick="ToggleSys">设置</div>
        <div class="blt-navfold @FoldHide("sys")">
            <NavLink class="blt-navitem" href="/" Match="NavLinkMatch.All"><BltIcon Emoji="🎛" /> 房间管理</NavLink>
            <NavLink class="blt-navitem" href="/help"><BltIcon Emoji="📘" /> 使用教程</NavLink>
            <NavLink class="blt-navitem" href="/diagnostics"><BltIcon Emoji="🩺" /> 网络诊断</NavLink>
        </div>
    </div>

    <div class="blt-main">
        <div class="blt-topstrip">
            <span class="seg">
                <button class="blt-btn" style="padding:1px 8px;font-size:10.5px" @onclick="HideBili">隐藏浏览器</button>
                <button class="blt-btn" style="padding:1px 8px;font-size:10.5px" @onclick="CloseBili">关闭浏览器</button>
                <button class="blt-btn" style="padding:1px 8px;font-size:10.5px" @onclick="ShowBili">打开浏览器</button>
            </span>
            <span class="seg">🏠 房间 <b>@(string.IsNullOrEmpty(Hub.LastStatus.RealRoomId) ? (string.IsNullOrEmpty(Config.RoomId) ? "—" : Config.RoomId) : Hub.LastStatus.RealRoomId)</b></span>
            <span class="seg">WS <b class="@WsClass()">@WsText()</b></span>
            <span class="seg">在线 <b class="green">@FmtPop()</b></span>
            <span class="seg">HTTP <b>127.0.0.1:@Api.Port</b> @ApiState()</span>
            <span class="seg">
                🎨 主题
                <select class="blt-input" style="width:138px;padding:1px 6px;font-size:11px" value="@_theme" @onchange="OnThemeChanged">
                    <option value="classic">★ 经典默认（旧版）</option>
                    <option value="console">C 专业控制台</option>
                    <option value="neon">A 暗夜霓虹</option>
                    <option value="workbench">B 清爽工作台</option>
                    <option value="bili">D B站应援</option>
                    <option value="vibrancy">E 灵动玻璃</option>
                    <option value="brutal">F 新粗野主义</option>
                    <option value="hud">G 电竞 HUD</option>
                    <option value="editorial">H 杂志编辑风</option>
                </select>
            </span>
            @if (UpdateBadgeVisible())
            {
                <span class="seg amber" title="@UpdateBadgeTitle()"><BltIcon Name="download" /> 有新版本</span>
            }
            @if (Verify.Locked)
            {
                <span class="seg" style="color:var(--red)"><BltIcon Name="lock" /> 未授权</span>
            }
            <span class="seg amber">BUILD @KestrelHost.VersionText</span>
            <span class="seg" style="margin-left:auto"><BltIcon Name="clock" /> <b id="blt-clock">--:--:--</b></span>
        </div>
        @if (Verify.Locked)
        {
            <div class="blt-panel" style="border-color:var(--red);background:var(--red-dim);position:relative;z-index:30">
                <div class="blt-panel-head" style="border-bottom-color:rgba(245,110,110,.35)">
                    <span class="t" style="color:var(--red)">🔒 账号待授权</span>
                    <span class="en">VERIFY LOCKED</span>
                    <span class="right"><span>@Verify.State.CheckedAt</span></span>
                </div>
                <div class="blt-panel-body">
                    <div class="blt-hint" style="color:var(--ink-2);margin:0">
                        @Verify.State.Message
                        <br />本工具为作者白名单授权制：你的 B站账号 UID <b>@Verify.State.Uid</b> 需要加入作者的白名单后才能连接直播间。
                        在授权通过前，除登录/授权相关操作外其余功能临时锁定（<b>已保存的配置不会丢失，授权后自动恢复</b>）。
                    </div>
                    <div class="blt-hint" style="color:var(--ink-2);margin-top:6px">
                        获取授权：联系作者 <b>B站UID <span style="font-family:var(--mono)">@VerifyService.AuthorUid</span></b>，说明你的来意即可申请。
                    </div>
                    <div style="display:flex;gap:8px;flex-wrap:wrap;margin-top:10px">
                        <button class="blt-btn primary" @onclick="CopyAuthorUid">📋 复制作者B站ID</button>
                        <button class="blt-btn" @onclick="OpenAuthorSpace">🔗 打开作者B站主页</button>
                        <button class="blt-btn" @onclick="RetryVerify">↻ 重试验证</button>
                        <button class="blt-btn" @onclick="OpenLoginBrowser">🔑 重新登录</button>
                        <button class="blt-btn" @onclick="ClearLogin">🚪 清除登录态</button>
                        <span class="blt-hint" style="align-self:center;margin:0">@_verifyNote</span>
                    </div>
                </div>
            </div>
        }
        @if (Verify.Locked && !IsHelpRoute())
        {
            @* 未授权门禁：遮罩挡住正文所有交互，仅锁卡内的授权/登录按钮可用 *@
            <div style="position:relative">
                <div style="position:absolute;inset:0;z-index:20;background:rgba(10,12,16,.55);backdrop-filter:blur(1.5px);cursor:not-allowed"
                     title="账号未授权：请先完成授权或更换已授权账号"></div>
                <div style="position:absolute;inset:0;z-index:21;display:flex;align-items:center;justify-content:center;pointer-events:none">
                    <span class="blt-badge red" style="font-size:12px;padding:4px 10px">🔒 未授权 · 功能已锁定（请用上方按钮完成授权/重新登录）</span>
                </div>
                @Body
            </div>
        }
        else
        {
            @Body
        }
    </div>

    <div class="blt-foot">
        <span>BLT CONSOLE @KestrelHost.VersionText</span><span class="sep">|</span>
        <span>WS @WsText()</span><span class="sep">|</span>
        <span>事件 @EventCount</span><span class="sep">|</span>
        <span>🔊 队列 @Speaker.QueueCount @(Speaker.Speaking ? "· 正在念…" : "")</span><span class="sep">|</span>
        <span>端口 @Api.Port @ApiState()</span><span class="sep">|</span>
        <span>模式 MAUI</span>
    </div>
</div>

@code {
    private System.Threading.Timer? _timer;
    private long _eventCount;
    private string _theme = "console";
    private bool _themeApplied;
    private bool _audioStarted;
    private bool _clockStarted;
    private bool _uiReady;

    // Sidebar group fold state (localStorage 'blt_nav_fold', like the legacy panel).
    private readonly Dictionary<string, bool> _fold = new();
    private bool _foldLoaded;

    private string _verifyNote = "";

    private bool IsHelpRoute()
    {
        var path = Nav.ToBaseRelativePath(Nav.Uri);
        return path.StartsWith("help", StringComparison.OrdinalIgnoreCase);
    }

    /// <summary>授权/登录相关操作：未授权时也允许（用户需要它们才能解锁）。</summary>
    private async Task OpenLoginBrowser()
    {
        try
        {
            // Must be the in-app browser: the cookie capture reads that WebView2's
            // cookie jar, so an external browser login would never reach the app.
            MainPage.Current?.ShowBiliBrowser("https://passport.bilibili.com/login");
            _verifyNote = "已打开应用内 B站 登录页：登录后 Cookie 会自动捕获并重新校验（约 5 秒）";
        }
        catch { _verifyNote = "打开登录页失败"; }
        await Task.CompletedTask;
        StateHasChanged();
    }

    private async Task ClearLogin()
    {
        try
        {
            var cfg = MauiProgram.Services?.GetService(typeof(AppConfig)) as AppConfig;
            cfg?.SetBiliCookie("", "");
            Verify.Reset();
            var st = await Verify.RefreshAsync(force: true);
            _verifyNote = st.Locked ? "已清除登录态：请用「重新登录」换号" : "登录态已清除";
        }
        catch { _verifyNote = "清除失败"; }
        StateHasChanged();
    }

    private async Task CopyAuthorUid()
    {
        var text = AppIdentity.AuthorContact;
        try { await JS.InvokeVoidAsync("navigator.clipboard.writeText", text); _verifyNote = "已复制作者B站ID"; }
        catch { _verifyNote = "复制失败，请手动记下 UID " + VerifyService.AuthorUid; }
        StateHasChanged();
    }

    private async Task OpenAuthorSpace()
    {
        try
        {
            await JS.InvokeVoidAsync("bltOpenExternal", "https://space.bilibili.com/" + VerifyService.AuthorUid);
            _verifyNote = "已打开作者主页";
        }
        catch { _verifyNote = "打开失败：https://space.bilibili.com/" + VerifyService.AuthorUid; }
        StateHasChanged();
    }

    private async Task RetryVerify()
    {
        _verifyNote = "正在重新验证…";
        StateHasChanged();
        try
        {
            var r = await JS.InvokeAsync<string>("bltFetchVerifyRefresh");
            _verifyNote = string.IsNullOrEmpty(r) ? "已提交重试" : r;
        }
        catch { _verifyNote = "重试请求失败"; }
        StateHasChanged();
    }

    private bool UpdateBadgeVisible() => Upd.LastResult?.HasUpdate == true;

    private string UpdateBadgeTitle()
    {
        var info = Upd.LastResult;
        return info == null ? "" : $"有新版本 {info.Latest}（当前 {info.Current}）· 到「房间管理 → 检查更新」处理";
    }

    private string Fold(string g) => _fold.TryGetValue(g, out var v) && v ? "folded" : "";
    private string FoldHide(string g) => _fold.TryGetValue(g, out var v) && v ? "hidden" : "";

    private Task ToggleLive() => ToggleFold("live");
    private Task ToggleShow() => ToggleFold("show");
    private Task ToggleLogs() => ToggleFold("logs");
    private Task ToggleObs() => ToggleFold("obs");
    private Task ToggleSys() => ToggleFold("sys");

    private async Task ToggleFold(string g)
    {
        var now = !(_fold.TryGetValue(g, out var v) && v);
        _fold[g] = now;
        await PersistFoldAsync();
        StateHasChanged();
    }

    private async Task PersistFoldAsync()
    {
        try
        {
            var json = System.Text.Json.JsonSerializer.Serialize(_fold);
            await JS.InvokeVoidAsync("bltSetJson", "blt_nav_fold", json);
        }
        catch { }
    }

    private async Task LoadFoldAsync()
    {
        if (_foldLoaded) return;
        _foldLoaded = true;
        try
        {
            var raw = await JS.InvokeAsync<string>("bltGetJson", "blt_nav_fold");
            if (!string.IsNullOrWhiteSpace(raw))
            {
                var map = System.Text.Json.JsonSerializer.Deserialize<Dictionary<string, bool>>(raw);
                if (map != null)
                    foreach (var kv in map) _fold[kv.Key] = kv.Value;
            }
            else
            {
                _fold["logs"] = true;   // sensible default: log pages folded away
            }
        }
        catch { }
    }

    private static readonly string[] Themes =
    {
        "classic", "console", "neon", "workbench", "bili", "vibrancy", "brutal", "hud", "editorial",
    };

    protected override void OnInitialized()
    {
        Hub.OnEvent += OnEvent;
        Hub.StatusChanged += OnStatus;
        var skin = (Config.GetNode("skin") as System.Text.Json.Nodes.JsonValue)?.GetValue<string>() ?? "";
        if (skin.Length == 0 || skin == "default") skin = "console";
        if (Themes.Contains(skin)) _theme = skin;
        // Layout re-render tick: the clock updates itself in JS every second
        // (see #blt-clock in blt-panels.js), so the expensive full-layout diff only
        // needs to run for connection/status freshness. 5s keeps the top strip honest
        // while cutting the per-second render garbage that showed up in the renderer.
        _timer = new System.Threading.Timer(_ => InvokeAsync(StateHasChanged), null, 5000, 5000);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_foldLoaded)
        {
            await LoadFoldAsync();
            StateHasChanged();
        }
        if (!_clockStarted)
        {
            _clockStarted = true;
            try { await JS.InvokeVoidAsync("bltStartClock"); } catch { }
        }
        if (!_uiReady)
        {
            // First paint complete → dismiss the native startup overlay. The native
            // side must be told through DI (a relative fetch from this page can't
            // reach the loopback service); the JS call only clears the in-page boot state.
            _uiReady = true;
            try { Api.NotifyUiReady(); } catch { }
            try { await JS.InvokeVoidAsync("bltHideBootSpinner"); } catch { }
        }
        if (!_themeApplied)
        {
            _themeApplied = true;
            await ApplyThemeAsync(_theme);
        }
        if (!_audioStarted)
        {
            _audioStarted = true;
            try
            {
                Audio.Attach(JS);
                await Song.InitAsync(JS);
                Speaker.Changed += OnSpeakerChanged;
                Speaker.Start();
                Sounds.Start();
            }
            catch { }
            // Debug/verification bridge: lets the loopback API run JS here.
            Ui.Register(js => JS.InvokeAsync<string>("bltEval", js).AsTask());
        }
    }

    private void OnSpeakerChanged() => InvokeAsync(StateHasChanged);

    private async Task OnThemeChanged(ChangeEventArgs e)
    {
        var t = e.Value?.ToString() ?? "console";
        if (!Themes.Contains(t)) t = "console";
        _theme = t;
        await ApplyThemeAsync(t);
        // Persist in the config document (same field the legacy panel used).
        var doc = Config.Snapshot();
        doc["skin"] = t;
        Config.ReplaceFrom(doc);
        StateHasChanged();
    }

    private async Task ApplyThemeAsync(string t)
    {
        try { await JS.InvokeVoidAsync("bltSetTheme", t); } catch { }
#if WINDOWS
        // Keep the native title bar in step with the theme.
        App.ApplyTitleBarForTheme(t);
#endif
    }

    private void OnEvent(LiveEvent ev) => InvokeAsync(() => { _eventCount++; StateHasChanged(); });
    private void OnStatus(LiveStatusInfo st) => InvokeAsync(StateHasChanged);

    private long EventCount => Interlocked.Read(ref _eventCount);

    private string WsText() => Hub.LastStatus.State switch
    {
        "connected" => "CONNECTED",
        "idle" => "IDLE",
        "error" => "ERROR",
        _ => Hub.LastStatus.State.ToUpperInvariant(),
    };

    private string WsClass() => Hub.LastStatus.State switch
    {
        "connected" => "green",
        "error" => "red",
        _ => "amber",
    };

    private string FmtPop() => Hub.LastStatus.Popularity > 0 ? Hub.LastStatus.Popularity.ToString("N0") : "—";

    private string ApiState() => Api.IsRunning ? "OK" : (Api.LastError != null ? "FAIL" : "…");

    private bool RecOn(string type)
    {
        var rec = Config.GetNode("recording") as System.Text.Json.Nodes.JsonObject;
        return rec?.TryGetPropertyValue(type, out var v) == true && v is System.Text.Json.Nodes.JsonValue val && val.TryGetValue<bool>(out var b) && b;
    }

    private void HideBili() => MainPage.Current?.HideBiliBrowser();
    private void CloseBili() => MainPage.Current?.CloseBiliBrowser();

    private void ShowBili()
    {
        var rid = string.IsNullOrEmpty(Hub.LastStatus.RealRoomId) ? Config.RoomId : Hub.LastStatus.RealRoomId;
        MainPage.Current?.ShowBiliBrowser(long.TryParse(rid, out _) ? $"https://live.bilibili.com/{rid}" : "https://live.bilibili.com/");
    }

    public void Dispose()
    {
        Hub.OnEvent -= OnEvent;
        Hub.StatusChanged -= OnStatus;
        Speaker.Changed -= OnSpeakerChanged;
        Speaker.Stop();
        Sounds.Stop();
        _timer?.Dispose();
        Ui.Unregister();
    }
}
